{
  "name": "web-publica-v2",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:headed": "playwright test --headed --project=desktop-chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "cap:prepare": "npm run build && node scripts/capacitor-prepare.mjs",
    "cap:sync": "npm run cap:sync:prod",
    "cap:open": "cap open android",
    "cap:run": "npm run cap:sync && cap run android",
    "cap:doctor": "cap doctor android",
    "cap:sync:dev": "npm run build && node scripts/capacitor-sync.mjs dev",
    "cap:sync:prod": "npm run cap:prepare && node scripts/capacitor-sync.mjs prod"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "dompurify": "3.4.17",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3"
  }
}
