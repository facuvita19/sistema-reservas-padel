---
import Encabezado from '../components/Encabezado.astro';
import PiePagina from '../components/PiePagina.astro';
import ModalAutenticacion from '../components/ModalAutenticacion.astro';
import '../styles/global.css';
interface Props { titulo:string; descripcion?:string; actual?:'inicio'|'reservar'|'torneos'|'reservas'|'cuenta'; indexable?:boolean; }
const { titulo, descripcion='Reservas, torneos y experiencia de pádel en un solo lugar.', actual='inicio', indexable=true }=Astro.props;
const sitio=(import.meta.env.PUBLIC_SITE_URL||'').trim().replace(/\/$/,'');
const ruta=Astro.url.pathname==='/'?'':Astro.url.pathname.replace(/\/$/,'');
const canonical=sitio?`${sitio}${ruta||'/'}`:'';
---
<!doctype html>
<html lang="es-AR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="description" content={descripcion} />
  <meta name="theme-color" content="#080d0f" />
  <meta name="color-scheme" content="dark" />
  <meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_AR" />
  <meta property="og:site_name" content="Pádel Reservas" />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descripcion} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={titulo} />
  <meta name="twitter:description" content={descripcion} />
  {canonical && <link rel="canonical" href={canonical} />}
  {canonical && <meta property="og:url" content={canonical} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <title>{titulo}</title>
</head>
<body>
  <a href="#contenido-principal" class="fixed left-3 top-3 z-[120] -translate-y-20 rounded-lg bg-brand-500 px-4 py-2 font-black text-white focus:translate-y-0">Saltar al contenido</a>
  <Encabezado actual={actual}/>
  <main id="contenido-principal"><slot/></main>
  <PiePagina/>
  <ModalAutenticacion/>
  <script>import '../scripts/sesion-global';import '../scripts/autenticacion';import '../scripts/menu-cuenta-global';import { cargarComplejo } from '../scripts/configuracion-publica';cargarComplejo().catch(()=>{});</script>
</body>
<script>import '../scripts/calendario-premium';</script>
<script>import '../scripts/selector-premium';</script>
</html>
