---
import Encabezado from '../components/Encabezado.astro';
import PiePagina from '../components/PiePagina.astro';
import ModalAutenticacion from '../components/ModalAutenticacion.astro';
import '../styles/global.css';
interface Props { titulo:string; descripcion?:string; actual?:'inicio'|'reservar'|'torneos'|'reservas'|'cuenta'; }
const { titulo, descripcion='Reservas, torneos y experiencia de pádel en un solo lugar.', actual='inicio' }=Astro.props;
---
<!doctype html>
<html lang="es-AR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="description" content={descripcion} />
  <meta name="theme-color" content="#080d0f" />
  <meta name="color-scheme" content="dark" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><rect rx=%2216%22 width=%2264%22 height=%2264%22 fill=%22%233d9b70%22/><path d=%22M19 47V17h15c8 0 13 5 13 12s-5 12-13 12h-7v6zm8-13h7c3 0 5-2 5-5s-2-5-5-5h-7z%22 fill=%22white%22/></svg>" />
  <title>{titulo}</title>
</head>
<body>
  <a href="#contenido-principal" class="fixed left-3 top-3 z-[120] -translate-y-20 rounded-lg bg-brand-500 px-4 py-2 font-black text-white focus:translate-y-0">Saltar al contenido</a>
  <Encabezado actual={actual}/>
  <main id="contenido-principal"><slot/></main>
  <PiePagina/>
  <ModalAutenticacion/>
  <script>import '../scripts/autenticacion';import { cargarComplejo } from '../scripts/configuracion-publica';cargarComplejo().catch(()=>{});</script>
</body>
</html>
