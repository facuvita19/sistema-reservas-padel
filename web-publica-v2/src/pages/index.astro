---
import LayoutPrincipal from '../layouts/LayoutPrincipal.astro';
---
<!-- inicio-operativo-premium-v64-20261011 -->
<LayoutPrincipal titulo="Arena Pádel | Reservas y torneos" descripcion="Encontrá disponibilidad real, reservá tu cancha y seguí toda la actividad del club." actual="inicio">
<section class="hx-hero" aria-labelledby="hx-title">
 <div class="hx-atmosphere" aria-hidden="true"><i></i><i></i><i></i></div>
 <div class="container-site hx-hero-grid">
  <div class="hx-copy">
   <p class="hx-eyebrow"><span></span><b id="hxClubEstado">Club online</b><em id="hxClubDia">Consultando agenda</em></p>
   <h1 id="hx-title">Tu próximo partido <strong>empieza acá.</strong></h1>
   <p>Elegí el momento ideal, encontrá una cancha disponible y reservá online en <b id="nombreComplejo">tu club</b>.</p>
   <div class="hx-actions"><a class="btn btn-primary" href="#disponibilidad">Ver horarios disponibles</a><a id="accionReservasHero" class="btn btn-secondary" href="/mis-reservas">Ver mis reservas</a><a class="hx-text-link" href="/w2/torneos">Explorar torneos <span>→</span></a></div>
   <ul class="hx-proof" aria-label="Beneficios"><li>Disponibilidad real</li><li>Reserva protegida</li><li>Seguimiento online</li></ul>
  </div>
  <aside id="hxAvailabilityPanel" class="hx-live" aria-live="polite" aria-busy="true">
   <div class="hx-live-loading"><span></span><p><small>Próxima disponibilidad</small><b>Revisando la agenda del club</b></p></div>
  </aside>
 </div>
</section>
<section id="disponibilidad" class="container-site hx-finder" aria-labelledby="hx-finder-title">
 <header><div><p class="site-kicker">Disponibilidad en vivo</p><h2 id="hx-finder-title">Elegí cuándo querés jugar</h2><p>Consultamos todas las canchas y reunimos los mejores horarios para vos.</p></div><div class="hx-finder-date"><input id="fechaRapida" class="field-web" type="date" aria-label="Fecha del partido"></div></header>
 <div id="hxFinderState" class="hx-finder-state" aria-live="polite"><span class="hx-spinner"></span><p><b>Preparando horarios</b><small>Esto puede tardar unos segundos.</small></p></div>
 <div id="hxSlots" class="hx-slots hidden" role="list"></div>
 <div class="hx-finder-footer"><p id="hxFinderSummary">Consultando disponibilidad…</p><a id="hxAllAvailability" class="btn btn-primary" href="/reservar">Ver todos los horarios</a></div>
</section>
<section class="container-site hx-courts-section" id="canchas"><header class="hx-section-head"><div><p class="site-kicker">Nuestras canchas</p><h2>Todo listo para jugar</h2></div><div><p id="direccionComplejo">Cargando ubicación…</p><a href="/reservar">Ver disponibilidad →</a></div></header><div id="estadoPortada" class="hx-inline-state" aria-live="polite"><span class="hx-spinner"></span><p><b>Conectando con el complejo</b><small>Preparando canchas y condiciones.</small></p></div><div id="canchasDestacadas" class="hx-courts"></div></section>
<section id="hxPersonalSection" class="container-site hx-personal hidden" aria-labelledby="hx-personal-title">
 <header class="hx-section-head"><div><p class="site-kicker">Tu actividad</p><h2 id="hx-personal-title">Todo bajo control</h2></div><a href="/mis-reservas">Abrir Mis reservas →</a></header>
 <div id="hxPersonalMetrics" class="hx-personal-metrics" aria-live="polite"></div>
</section>
<section id="hxJourney" class="hx-journey"><div class="container-site"><p class="site-kicker">Reservar es simple</p><ol><li><span>01</span><div><b>Elegí un horario</b><small>Disponibilidad real para cada cancha.</small></div></li><li><span>02</span><div><b>Protegé tu turno</b><small>Completá tus datos y generá la solicitud.</small></div></li><li><span>03</span><div><b>Acreditá la seña</b><small>Confirmá y seguí todo online.</small></div></li></ol></div></section>
<section class="container-site hx-section"><header class="hx-section-head"><div><p class="site-kicker gold">Competencia</p><h2>Viví cada instancia</h2></div><a href="/w2/torneos">Ver todos los torneos →</a></header><div id="torneoDestacado" class="hx-tournament"><div class="hx-inline-state"><span class="hx-spinner"></span><p><b>Buscando la próxima competencia</b><small>Preparando categorías y cupos.</small></p></div></div></section>
<section id="contacto" class="container-site hx-section"><div class="hx-contact"><div><p class="site-kicker">Tu club</p><h2>Todo lo importante, cerca</h2><p id="contactoDescripcion">Ubicación y canales directos para resolver lo que necesites.</p></div><div id="contactoComplejo" class="hx-contact-links"><span>Cargando datos de contacto…</span></div></div></section>
<script>import '../scripts/portada';</script>
</LayoutPrincipal>