---
import LayoutPrincipal from '../layouts/LayoutPrincipal.astro';
---
<LayoutPrincipal titulo="Pádel Reservas" descripcion="Reservá tu cancha y participá en torneos de pádel." actual="inicio">
  <section class="relative overflow-hidden border-b border-ink-700 bg-[radial-gradient(circle_at_78%_22%,rgba(82,127,156,.32),transparent_30%),linear-gradient(145deg,#071018,#102632)]">
    <div class="container-site grid min-h-[610px] items-center gap-14 py-20 lg:grid-cols-[1.08fr_.92fr]">
      <div><p class="mb-5 inline-flex rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1.5 text-xs font-black uppercase tracking-widest text-emerald-300">Disponibilidad en tiempo real</p><h1 class="max-w-3xl text-5xl font-black leading-[.96] tracking-[-.045em] text-white sm:text-6xl lg:text-7xl">Tu próximo partido empieza acá</h1><p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">Reservá en <strong id="nombreComplejo">tu complejo</strong>, consultá tus solicitudes y descubrí los próximos torneos.</p><div class="mt-9 flex flex-wrap gap-3"><a class="focus-ring rounded-xl bg-brand-500 px-6 py-4 font-black text-white transition hover:-translate-y-0.5 hover:bg-brand-600" href="/reservar">Reservar cancha</a><a class="focus-ring rounded-xl border border-ink-700 bg-ink-900/70 px-6 py-4 font-black text-white transition hover:-translate-y-0.5 hover:border-brand-300" href="/torneos">Ver torneos</a></div></div>
      <div class="surface-card grid gap-3 p-6 sm:grid-cols-3 lg:grid-cols-1"><div class="rounded-xl bg-black/20 p-5"><small class="text-slate-400">Canchas activas</small><strong id="datoCanchas" class="mt-1 block text-3xl">-</strong></div><div class="rounded-xl bg-black/20 p-5"><small class="text-slate-400">Turnos desde</small><strong id="datoTurno" class="mt-1 block text-2xl">-</strong></div><div class="rounded-xl bg-black/20 p-5"><small class="text-slate-400">Seña requerida</small><strong id="datoSenia" class="mt-1 block text-3xl">-</strong></div></div>
    </div>
  </section>
  <section class="container-site py-20"><div class="mb-9 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between"><div><p class="text-xs font-black uppercase tracking-[.2em] text-brand-300">Nuestras canchas</p><h2 class="mt-3 text-4xl font-black">Elegí dónde jugar</h2></div><p id="direccionComplejo" class="text-slate-400">Cargando ubicación...</p></div><div id="estadoPortada" class="surface-card mb-5 p-6 text-slate-400">Conectando con el complejo...</div><div id="canchasDestacadas" class="grid gap-5 lg:grid-cols-3"></div></section>
  <script>
  import '../scripts/portada';
</script>
</LayoutPrincipal>