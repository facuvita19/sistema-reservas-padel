---
import LayoutPrincipal from '../layouts/LayoutPrincipal.astro';
---
<LayoutPrincipal titulo="Mis datos | Pádel Reservas" actual="cuenta">
  <section class="border-b border-ink-700 bg-ink-900"><div class="container-site py-14"><p class="text-xs font-black uppercase tracking-[.2em] text-brand-300">Cuenta de cliente</p><h1 class="mt-3 text-5xl font-black">Mis datos</h1><p class="mt-4 max-w-2xl text-lg text-slate-400">Actualizá tu información personal y tu posición preferida en la cancha.</p></div></section>
  <section class="container-site py-12">
    <div id="cargandoDatos" class="surface-card p-8 text-slate-400">Cargando tus datos...</div>
    <div id="contenidoDatos" class="hidden grid gap-6 lg:grid-cols-2">
      <form id="formDatos" class="surface-card p-6 sm:p-8" novalidate>
        <p class="text-xs font-black uppercase tracking-widest text-brand-300">Perfil</p><h2 class="mt-2 text-3xl font-black">Información personal</h2>
        <div class="mt-7 grid gap-4 sm:grid-cols-2">
          <label><span class="etiqueta-web">Nombre *</span><input id="datosNombre" class="field-web" maxlength="100" autocomplete="given-name" /></label>
          <label><span class="etiqueta-web">Apellido *</span><input id="datosApellido" class="field-web" maxlength="100" autocomplete="family-name" /></label>
          <label><span class="etiqueta-web">Documento</span><input id="datosDocumento" class="field-web opacity-70" disabled /></label>
          <label><span class="etiqueta-web">Teléfono *</span><input id="datosTelefono" class="field-web" maxlength="30" inputmode="tel" autocomplete="tel" /></label>
          <label class="sm:col-span-2"><span class="etiqueta-web">Correo electrónico *</span><input id="datosEmail" class="field-web" type="email" maxlength="150" autocomplete="email" /></label>
        </div>
        <fieldset class="mt-7 border-t border-ink-700 pt-6"><legend class="text-lg font-black">Posición preferida</legend><p class="mt-2 text-sm text-slate-400">Podés cambiarla cuando quieras.</p><div class="mt-4 grid gap-3 sm:grid-cols-3"><label class="opcion-posicion"><input type="radio" name="posicionPreferida" value="" /><span>Sin preferencia</span></label><label class="opcion-posicion"><input type="radio" name="posicionPreferida" value="DRIVE" /><span>Drive</span></label><label class="opcion-posicion"><input type="radio" name="posicionPreferida" value="REVES" /><span>Revés</span></label></div></fieldset>
        <div id="mensajeDatos" class="mt-5 hidden rounded-xl p-4 text-sm font-bold" role="status"></div>
        <button id="guardarDatos" class="mt-6 w-full rounded-xl bg-brand-500 px-6 py-3 font-black text-white transition hover:bg-brand-600 disabled:cursor-wait disabled:opacity-60" type="submit">Guardar cambios</button>
      </form>
      <form id="formPassword" class="surface-card self-start p-6 sm:p-8" novalidate>
        <p class="text-xs font-black uppercase tracking-widest text-brand-300">Seguridad</p><h2 class="mt-2 text-3xl font-black">Cambiar contraseña</h2><p class="mt-3 text-slate-400">La nueva contraseña debe tener al menos 8 caracteres.</p>
        <div class="mt-7 space-y-4"><label class="block"><span class="etiqueta-web">Contraseña actual</span><input id="passwordActual" class="field-web" type="password" autocomplete="current-password" /></label><label class="block"><span class="etiqueta-web">Nueva contraseña</span><input id="passwordNuevo" class="field-web" type="password" minlength="8" autocomplete="new-password" /></label><label class="block"><span class="etiqueta-web">Repetir nueva contraseña</span><input id="passwordRepetido" class="field-web" type="password" minlength="8" autocomplete="new-password" /></label></div>
        <div id="mensajePassword" class="mt-5 hidden rounded-xl p-4 text-sm font-bold" role="status"></div>
        <button id="guardarPassword" class="mt-6 w-full rounded-xl border border-brand-300 px-6 py-3 font-black text-brand-100 transition hover:bg-brand-500/15 disabled:cursor-wait disabled:opacity-60" type="submit">Actualizar contraseña</button>
      </form>
    </div>
    <div id="sinSesionDatos" class="surface-card hidden p-8"><h2 class="text-2xl font-black">Necesitás iniciar sesión</h2><p class="mt-3 text-slate-400">Ingresá desde el botón del encabezado para consultar y editar tus datos.</p><a class="mt-5 inline-flex rounded-xl bg-brand-500 px-6 py-3 font-black text-white" href="/">Volver al inicio</a></div>
  </section>
  <script>import '../scripts/mis-datos';</script>
</LayoutPrincipal>
