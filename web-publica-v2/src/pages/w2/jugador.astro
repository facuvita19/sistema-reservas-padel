---
import W2Layout from '../../w2/layouts/W2Layout.astro';
import AuditoriaDeportiva from '../../w2/components/AuditoriaDeportiva.astro';
import '../../w2/styles/w2-jugador.css';
---
<W2Layout titulo="Perfil deportivo | Pádel Las Flores" actual="jugador">
<main class="w2jp-page">
 <section id="profileLoading" class="w2-container w2jp-loading" aria-live="polite"><span></span><b>Preparando perfil deportivo</b><small>Conectando ranking, trayectoria y actividad oficial.</small></section>
 <section id="profileError" class="w2-container w2jp-error hidden"><span aria-hidden="true">◇</span><p class="w2-kicker">Perfil deportivo</p><h1>No pudimos abrir este perfil</h1><p id="profileErrorText"></p><div><a class="w2-button primary" href="/w2/rankings">Explorar rankings</a><a href="/w2">Volver al inicio →</a></div></section>
 <div id="profileContent" class="hidden">
  <nav class="w2-container w2jp-context" aria-label="Contexto del perfil"><a id="w2pBackToRanking" href="/w2/rankings"><span aria-hidden="true">←</span> Volver al ranking</a><span id="w2pContextLabel">Perfil público</span></nav>
  <section id="w2jpHero" class="w2jp-hero" aria-labelledby="profileName" data-publication="SIN_CATEGORIA">
   <div class="w2jp-hero-atmosphere" aria-hidden="true"><i></i><i></i><span>W2</span><b></b></div>
   <div class="w2-container w2jp-hero-grid">
    <div class="w2jp-identity">
     <div class="w2jp-monogram" aria-hidden="true"><span id="profileInitials">PJ</span><i></i></div>
     <div class="w2jp-identity-copy">
      <div class="w2jp-identity-overline"><p class="w2-kicker"><span></span> Identidad deportiva pública</p><span id="w2jpPublicationBadge">PERFIL PÚBLICO</span></div>
      <h1 id="profileName">Jugador</h1>
      <p id="w2jpIdentitySummary" class="w2jp-identity-summary">Perfil competitivo público con trayectoria y resultados oficiales.</p>
      <div class="w2jp-badges" aria-label="Información deportiva principal"><b id="profileCategory">SIN CATEGORÍA</b><em id="profilePosition">FLEXIBLE</em><span id="w2jpCommunityState">FUERA DE COMUNIDAD</span></div>
     </div>
    </div>
    <aside class="w2jp-hero-metrics" aria-label="Resumen competitivo del jugador">
     <header><span>RESUMEN COMPETITIVO</span><b id="w2jpHeroCategoryLabel">CATEGORÍA SIN PUBLICAR</b></header>
     <div class="w2jp-hero-metric-grid">
      <article class="w2jp-rank-metric"><small>PUESTO ACTUAL</small><strong id="profileRank">—</strong><span id="profileRankHelp">Sin posición publicada</span></article>
      <article><small>PUNTOS PUBLICADOS</small><strong id="profilePoints">0</strong><a id="w2pAuditPoints" href="/w2/rankings">Cómo se forman →</a></article>
      <article><small>EFECTIVIDAD</small><strong id="profileEffectiveness">0%</strong><span id="profileRecord">Sin partidos oficiales</span></article>
     </div>
     <footer><span><i></i> Datos oficiales y auditables</span><a id="w2jpHeroRankingLink" href="/w2/rankings">Ver categoría →</a></footer>
    </aside>
   </div>
  </section>
  <section class="w2-container w2jp-body">
   <main>
    <section id="profileReadyNotice" class="w2jp-ready hidden" data-ready-state="ready"><span id="profileReadyIcon">✓</span><div><b id="profileReadyTitle">Perfil listo para competir</b><p id="profileReadyText">El ranking se actualizará automáticamente cuando se publiquen resultados oficiales.</p></div></section>
    <section id="w2jpPerformance" class="w2jp-card w2jp-trajectory" data-performance="empty" data-rate-band="empty"><header><div><p class="w2-kicker">Trayectoria oficial</p><h2>Balance competitivo</h2><p class="w2jp-performance-intro">Lectura directa del rendimiento publicado y sus criterios de desempate.</p></div><span id="seasonSummary">0 partidos auditados</span></header><div class="w2jp-performance-grid"><article class="w2jp-record"><header><div><small>REGISTRO OFICIAL</small><strong aria-label="Registro de victorias y derrotas"><span id="metricWins">0</span><i>–</i><span id="metricLosses">0</span></strong></div><span id="performanceLabel">Sin resultados</span></header><p id="performanceNarrative">El balance aparecerá cuando se publiquen partidos oficiales.</p><div id="performanceMeter" class="w2jp-performance-meter" role="img" aria-label="Sin partidos oficiales"><i id="performanceWinBar"></i><b id="performanceLossBar"></b></div><footer><span><i></i> Victorias <b id="performanceWinsRate">0%</b></span><span><i></i> Derrotas <b id="performanceLossesRate">0%</b></span></footer></article><div class="w2jp-performance-facts"><article class="w2jp-fact-primary"><small>PARTIDOS</small><strong id="metricMatches">0</strong><span>resultados oficiales</span></article><article class="w2jp-fact-primary"><small>BALANCE</small><strong id="metricDifference">0</strong><span>victorias − derrotas</span></article><article><small>DIF. SETS</small><strong id="metricSets">—</strong><span>primer desempate</span></article><article><small>DIF. GAMES</small><strong id="metricGames">—</strong><span>segundo desempate</span></article></div></div><footer class="w2jp-performance-foot"><span><i></i><b>Lectura auditable</b> Cada dato proviene de resultados oficiales publicados.</span><a id="w2jpPerformanceAudit" href="/w2/rankings">Ver puntos auditados →</a></footer></section>
    <section id="w2jpActivity" class="w2jp-card w2jp-activity" data-expanded="false"><header><div><p class="w2-kicker">Actividad reciente</p><h2>Últimos partidos oficiales</h2><p id="profileMatchesSummary" class="w2jp-activity-summary">Resultados oficiales más recientes.</p></div><div class="w2jp-activity-actions"><span id="profileActivityRecord">Sin actividad publicada</span><button id="profileMatchesTopToggle" class="w2jp-activity-collapse hidden" type="button" aria-expanded="false" aria-controls="profileMatches">Mostrar solo los 3 más recientes <b aria-hidden="true">↑</b></button><a href="/w2/torneos">Explorar torneos →</a></div></header><div id="profileMatches" class="w2jp-matches" role="list"></div><button id="profileMatchesToggle" class="w2jp-matches-toggle hidden" type="button" aria-expanded="false" aria-controls="profileMatches"><span>Ver actividad completa</span><b aria-hidden="true">↓</b></button><div id="profileMatchesEmpty" class="w2jp-empty"><span>◇</span><div><b>La actividad aparecerá acá</b><p>Cuando se publiquen resultados oficiales, vas a ver torneo, fase, compañero, rivales y marcador.</p></div></div><footer class="w2jp-activity-foot"><span><i></i>Resultados oficiales ordenados del más reciente al más antiguo.</span><a href="/w2/rankings">Consultar ranking →</a></footer></section>
   </main>
   <aside class="w2jp-side" aria-label="Información deportiva complementaria">
    <section id="w2jpCategoryCard" class="w2jp-card w2jp-ranking"><header><div><p class="w2-kicker">Categoría actual</p><h3 id="rankingCategory">Sin categoría vigente</h3></div><span id="rankingStatus">SIN PUBLICAR</span></header><div class="w2jp-category-snapshot"><span><small>PUESTO</small><strong id="sideRank">—</strong></span><span><small>PUNTOS</small><strong id="sidePoints">0</strong></span></div><dl><div><dt>Vigente desde</dt><dd id="rankingSince">Sin fecha</dd></div><div><dt>Estado competitivo</dt><dd id="rankingState">Sin resultados publicados</dd></div></dl><p id="rankingDetail">El perfil se incorporará al ranking cuando tenga categoría y resultados oficiales.</p><a id="rankingLink" href="/w2/rankings">Ver ranking completo →</a></section><nav class="w2jp-card w2jp-profile-index" aria-label="Navegación dentro del perfil"><header><div><p class="w2-kicker">Recorrido del perfil</p><h3>Explorar información</h3></div><span>3 SECCIONES</span></header><a href="#w2jpPerformance"><span><b>01</b><em>Balance competitivo</em></span><i aria-hidden="true">→</i></a><a href="#w2jpActivity"><span><b>02</b><em>Actividad reciente</em></span><i aria-hidden="true">→</i></a><a href="#w2jpCategoryCard"><span><b>03</b><em>Categoría y recorrido</em></span><i aria-hidden="true">→</i></a><footer><span><i></i>Perfil público verificable</span><a id="w2jpSideAudit" href="/w2/rankings">Auditar puntos →</a></footer></nav>
    <section class="w2jp-card w2jp-category-history"><header><div><p class="w2-kicker">Recorrido deportivo</p><h3>Historial de categorías</h3></div><span id="categoryHistoryCount">0 etapas</span></header><ol id="profileCategories"></ol><p id="profileCategoriesEmpty" class="w2jp-empty-copy">Sin movimientos de categoría.</p></section>
    <section class="w2jp-card w2jp-community"><header><div><p class="w2-kicker">Comunidad deportiva</p><h3>Disponibilidad pública</h3></div><span id="communityBadge">NO DISPONIBLE</span></header><p id="communityText">Este perfil no está disponible para convocatorias.</p><ul class="w2p-community-flags"><li id="w2pTurnsFlag">No busca completar partidos</li><li id="w2pTournamentsFlag">No busca pareja para torneos</li><li id="w2pInvitesFlag">No acepta invitaciones</li></ul><small id="communityHelp">En Comunidad se puede completar partidos o encontrar pareja antes de inscribirse juntos a torneos.</small><button id="w2jpInviteOpen" class="w2jp-invite-open hidden" type="button">Invitar a jugar <span aria-hidden="true">→</span></button><p id="w2jpInviteAvailability" class="w2jp-invite-availability" role="status"></p></section>
   </aside>
  </section>
 </div>
</main>
<div id="w2jpInviteBackdrop" class="w2jp-invite-backdrop hidden"></div>
<section id="w2jpInviteDialog" class="w2jp-invite-dialog hidden" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="w2jpInviteTitle" aria-describedby="w2jpInviteIntro" inert>
 <button id="w2jpInviteClose" class="w2jp-invite-close" type="button" aria-label="Cerrar invitación">×</button>
 <div id="w2jpInviteFormState">
  <p class="w2-kicker">COMUNIDAD DEPORTIVA</p>
  <h2 id="w2jpInviteTitle">Invitar a jugar</h2>
  <p id="w2jpInviteIntro">Elegí una propuesta compatible con la disponibilidad publicada.</p>
  <form id="w2jpInviteForm">
   <fieldset id="w2jpInviteObjectives"><legend>¿Qué querés proponer?</legend>
    <label id="w2jpInviteTurnOption"><input type="radio" name="objetivo" value="COMPLETAR_PARTIDO"><span><b>Completar u organizar un partido</b><small>Coordinar un turno o sumar personas para jugar.</small></span></label>
    <label id="w2jpInviteTournamentOption"><input type="radio" name="objetivo" value="FORMAR_PAREJA_TORNEO"><span><b>Formar pareja para un torneo</b><small>Conversar antes de inscribirse juntos.</small></span></label>
   </fieldset>
   <label class="w2jp-invite-message"><span>Mensaje privado <small>opcional</small></span><textarea id="w2jpInviteMessage" maxlength="300" rows="4" placeholder="Ej.: ¿Te interesa coordinar un partido esta semana?"></textarea><small><span>No incluyas datos personales.</span><b id="w2jpInviteCount">0 / 300</b></small></label>
   <p id="w2jpInviteStatus" class="w2jp-invite-status" role="status" aria-live="polite"></p>
   <div class="w2jp-invite-actions"><button id="w2jpInviteCancel" type="button">Volver</button><button id="w2jpInviteSubmit" class="primary" type="submit">Enviar invitación</button></div>
  </form>
 </div>
 <div id="w2jpInviteSuccess" class="w2jp-invite-success hidden" role="status"><span aria-hidden="true">✓</span><p class="w2-kicker">INVITACIÓN ENVIADA</p><h2>La propuesta quedó pendiente</h2><p>La otra persona podrá aceptarla o rechazarla desde su cuenta. Los datos de contacto siguen protegidos.</p><div><a href="/w2/cuenta?seccion=deporte">Ir a Mi cuenta</a><button id="w2jpInviteDone" type="button">Seguir viendo el perfil</button></div></div>
</section>
<AuditoriaDeportiva/>
<script>import '../../w2/scripts/jugador';</script>
</W2Layout>
