---
import W2Layout from '../../w2/layouts/W2Layout.astro';
import AuditoriaDeportiva from '../../w2/components/AuditoriaDeportiva.astro';
import '../../w2/styles/w2-jugador.css';
---
<W2Layout titulo="Perfil deportivo W2" actual="jugador">
<main class="w2jp-page">
 <section id="profileLoading" class="w2-container w2jp-loading" aria-live="polite"><span></span><b>Preparando perfil deportivo</b><small>Conectando ranking, trayectoria y actividad oficial.</small></section>
 <section id="profileError" class="w2-container w2jp-error hidden"><span aria-hidden="true">W2</span><p class="w2-kicker">Perfil deportivo</p><h1>No pudimos abrir este perfil</h1><p id="profileErrorText"></p><div><a class="w2-button primary" href="/w2/rankings">Explorar rankings</a><a href="/w2">Volver a Plataforma W2 →</a></div></section>
 <div id="profileContent" class="hidden">
  <nav class="w2-container w2jp-context" aria-label="Contexto del perfil"><a id="w2pBackToRanking" href="/w2/rankings">← Volver al ranking</a><span id="w2pContextLabel">Perfil público</span></nav>
  <section id="w2jpHero" class="w2jp-hero" aria-labelledby="profileName" data-publication="SIN_CATEGORIA">
   <div class="w2jp-hero-atmosphere" aria-hidden="true"><i></i><i></i></div>
   <div class="w2-container w2jp-hero-grid">
    <div class="w2jp-identity">
     <div class="w2jp-monogram" aria-hidden="true"><span id="profileInitials">PJ</span><i></i></div>
     <div class="w2jp-identity-copy">
      <p class="w2-kicker"><span></span> Identidad deportiva pública</p>
      <h1 id="profileName">Jugador W2</h1>
      <div class="w2jp-badges" aria-label="Información deportiva principal"><b id="profileCategory">SIN CATEGORÍA</b><em id="profilePosition">FLEXIBLE</em><span id="w2jpPublicationBadge">PERFIL PÚBLICO</span></div>
     </div>
    </div>
    <aside class="w2jp-hero-metrics" aria-label="Resumen competitivo del jugador">
     <article class="w2jp-rank-metric"><small>PUESTO ACTUAL</small><strong id="profileRank">—</strong><span id="profileRankHelp">Sin posición publicada</span></article>
     <article><small>PUNTOS PUBLICADOS</small><strong id="profilePoints">0</strong><a id="w2pAuditPoints" href="/w2/rankings">Cómo se forman →</a></article>
     <article><small>EFECTIVIDAD</small><strong id="profileEffectiveness">0%</strong><span id="profileRecord">Sin partidos oficiales</span></article>
    </aside>
   </div>
  </section>
  <section class="w2-container w2jp-body">
   <main>
    <section id="profileReadyNotice" class="w2jp-ready hidden"><span>✓</span><div><b>Perfil listo para competir</b><p>El ranking se actualizará automáticamente cuando se publiquen resultados oficiales.</p></div></section>
    <section id="w2jpPerformance" class="w2jp-card w2jp-trajectory" data-performance="empty"><header><div><p class="w2-kicker">Trayectoria oficial</p><h2>Balance competitivo</h2></div><span id="seasonSummary">0 partidos auditados</span></header><div class="w2jp-performance-grid"><article class="w2jp-record"><header><div><small>REGISTRO OFICIAL</small><strong><span id="metricWins">0</span><i>–</i><span id="metricLosses">0</span></strong></div><span id="performanceLabel">Sin resultados</span></header><p id="performanceNarrative">El balance aparecerá cuando se publiquen partidos oficiales.</p><div id="performanceMeter" class="w2jp-performance-meter" role="img" aria-label="Sin partidos oficiales"><i id="performanceWinBar"></i></div><footer><span><i></i> Victorias</span><span><i></i> Derrotas</span></footer></article><div class="w2jp-performance-facts"><article><small>PARTIDOS</small><strong id="metricMatches">0</strong><span>resultados oficiales</span></article><article><small>BALANCE</small><strong id="metricDifference">0</strong><span>victorias − derrotas</span></article><article><small>DIF. SETS</small><strong id="metricSets">—</strong><span>criterio de desempate</span></article><article><small>DIF. GAMES</small><strong id="metricGames">—</strong><span>criterio de desempate</span></article></div></div></section>
    <section id="w2jpActivity" class="w2jp-card w2jp-activity" data-expanded="false"><header><div><p class="w2-kicker">Actividad reciente</p><h2>Últimos partidos oficiales</h2><p id="profileMatchesSummary" class="w2jp-activity-summary">Resultados oficiales más recientes.</p></div><a href="/w2/torneos">Explorar torneos →</a></header><div id="profileMatches" class="w2jp-matches"></div><button id="profileMatchesToggle" class="w2jp-matches-toggle hidden" type="button" aria-expanded="false" aria-controls="profileMatches"><span>Ver actividad completa</span><b aria-hidden="true">↓</b></button><div id="profileMatchesEmpty" class="w2jp-empty"><span>◇</span><div><b>La actividad aparecerá acá</b><p>Cuando se publiquen resultados oficiales, vas a ver torneo, fase, compañero, rivales y marcador.</p></div></div></section>
   </main>
   <aside class="w2jp-side">
    <section id="w2jpCategoryCard" class="w2jp-card w2jp-ranking"><header><div><p class="w2-kicker">Categoría actual</p><h3 id="rankingCategory">Sin categoría vigente</h3></div><span id="rankingStatus">SIN PUBLICAR</span></header><dl><div><dt>Vigente desde</dt><dd id="rankingSince">Sin fecha</dd></div><div><dt>Estado competitivo</dt><dd id="rankingState">Sin resultados publicados</dd></div></dl><p id="rankingDetail">El perfil se incorporará al ranking cuando tenga categoría y resultados oficiales.</p><a id="rankingLink" href="/w2/rankings">Ver ranking completo →</a></section>
    <section class="w2jp-card"><p class="w2-kicker">Recorrido deportivo</p><h3>Historial de categorías</h3><ol id="profileCategories"></ol><p id="profileCategoriesEmpty" class="w2jp-empty-copy">Sin movimientos de categoría.</p></section>
    <section class="w2jp-card w2jp-community"><header><div><p class="w2-kicker">Comunidad W2</p><h3>Disponibilidad pública</h3></div><span id="communityBadge">NO DISPONIBLE</span></header><p id="communityText">Este perfil no está disponible para convocatorias.</p><ul class="w2p-community-flags"><li id="w2pAvailableFlag">No disponible para jugar</li><li id="w2pInvitesFlag">No acepta invitaciones</li></ul><small>Comunidad permitirá encontrar pareja antes de inscribirse juntos a un torneo.</small></section>
   </aside>
  </section>
 </div>
</main>
<AuditoriaDeportiva/>
<script>import '../../w2/scripts/jugador';</script>
</W2Layout>
