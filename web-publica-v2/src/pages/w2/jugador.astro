---
import W2Layout from '../../w2/layouts/W2Layout.astro';
---
<W2Layout titulo="Perfil deportivo W2" actual="jugador">
<div id="profileLoading" class="w2-container w2-empty">Cargando perfil deportivo…</div>
<section id="profileError" class="w2-container w2-profile-error hidden"><div class="w2-profile-error-mark" aria-hidden="true"><span>W2</span><i></i></div><p class="w2-kicker">Perfil deportivo</p><strong>No pudimos abrir este perfil.</strong><p id="profileErrorText"></p><div class="w2-profile-error-actions"><a class="w2-button primary" href="/w2/rankings">Explorar rankings</a><a class="w2-profile-error-link" href="/w2">Volver a Plataforma W2 →</a></div></section>
<div id="profileContent" class="hidden"><nav class="w2p-context" aria-label="Contexto del perfil"><a id="w2pBackToRanking" href="/w2/rankings">← Volver al ranking</a><span id="w2pContextLabel">Perfil público</span></nav>
<section class="w2c2-profile-hero"><div class="w2-container"><div class="w2c2-profile-id"><div class="w2c2-monogram" id="profileInitials">PJ<i></i></div><div><p class="w2-kicker">Perfil deportivo W2</p><h1 id="profileName">Jugador W2</h1><p class="w2-profile-badges"><span id="profilePosition">FLEXIBLE</span><b id="profileCategory">SIN CATEGORÍA</b></p></div></div><aside><div><small>RANKING ACTUAL</small><strong id="profileRank">—</strong><span id="profileRankHelp">Sin posición</span></div><div><small>PUNTOS</small><strong id="profilePoints">0</strong><span>Puntos publicados</span><a id="w2pAuditPoints" class="w2p-audit-link" href="/w2/rankings">Ver cómo se forman →</a></div><div><small>EFECTIVIDAD</small><strong id="profileEffectiveness">0%</strong><span id="profileRecord">Sin partidos</span></div></aside></div></section>
<section class="w2-container w2c2-profile-layout"><main><section class="w2c2-season"><header><div><p class="w2-kicker">Rendimiento oficial</p><h2 id="seasonTitle">Historial competitivo</h2></div><span id="seasonSummary">0 partidos oficiales</span></header><div class="w2c2-metrics"><article><small>PARTIDOS</small><strong id="metricMatches">0</strong><span>finalizados</span></article><article><small>VICTORIAS</small><strong id="metricWins">0</strong><span>oficiales</span></article><article><small>DERROTAS</small><strong id="metricLosses">0</strong><span>oficiales</span></article><article><small>BALANCE</small><strong id="metricDifference">0</strong><span>victorias - derrotas</span></article></div></section><section class="w2c2-matches"><header><div><p class="w2-kicker">Últimos partidos</p><h2>Actividad reciente</h2></div><a href="/w2/torneos">Ver competencia →</a></header><div id="profileMatches"></div><div id="profileMatchesEmpty" class="w2-profile-empty"><span aria-hidden="true">⌁</span><div><strong>Sin actividad oficial</strong><p>Este jugador todavía no registra partidos finalizados.</p></div></div></section></main><aside class="w2c2-profile-side"><section><p class="w2-kicker">Puntos verificables</p><h3 id="rankingCategory">Sin categoría vigente</h3><p id="rankingDetail">El perfil aparecerá en el ranking cuando tenga una categoría y resultados oficiales.</p><a id="rankingLink" href="/w2/rankings">Ver ranking →</a></section><section><p class="w2-kicker">Historial de categoría</p><h3>Recorrido deportivo</h3><ol id="profileCategories"></ol><p id="profileCategoriesEmpty" class="w2-empty">Sin movimientos de categoría.</p></section><section class="w2c2-community-status"><span id="communityBadge">NO DISPONIBLE</span><h3>Comunidad W2</h3><p id="communityText">Este perfil no está disponible para convocatorias.</p><ul class="w2p-community-flags"><li id="w2pAvailableFlag">No disponible para jugar</li><li id="w2pInvitesFlag">No acepta invitaciones</li></ul><button disabled aria-disabled="true">PRÓXIMAMENTE</button></section></aside></section>
</div>
<script>
import { api } from '../../scripts/api';
type Categoria={id:number;nombre:string;color:string;desde:string};type Ranking={posicion:number;puntos:number;partidos:number;victorias:number;derrotas:number;efectividad:number;diferenciaSets:number;diferenciaGames:number};type Partido={partidoId:number;resultado:string;torneo:string;categoria:string;fase:string;companero:string|null;rivales:string|null;marcador:string|null;fecha:string|null};type Movimiento={categoria:string;estado:string;desde:string;hasta:string|null};type Perfil={perfilId:number;nombre:string;iniciales:string;posicion:string|null;disponibleParaJugar:boolean;aceptaInvitaciones:boolean;categoria:Categoria|null;ranking:Ranking|null;partidos:number;victorias:number;derrotas:number;efectividad:number;historial:Partido[];categorias:Movimiento[]};
const el=(id:string)=>document.getElementById(id)!;const contexto=()=>{const q=new URLSearchParams(location.search),categoria=q.get('categoria')||'',buscar=q.get('buscar')||'';const ranking=new URL('/w2/rankings',location.origin);if(categoria)ranking.searchParams.set('categoria',categoria);if(buscar)ranking.searchParams.set('buscar',buscar);return{categoria,buscar,ranking:ranking.pathname+ranking.search}};const esc=(v:unknown)=>String(v??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[c]||c));const fecha=(v:string|null)=>v?new Intl.DateTimeFormat('es-AR',{day:'2-digit',month:'short',year:'numeric'}).format(new Date(v+'T12:00:00')):'Sin fecha';
function render(p:Perfil){const ctx=contexto();el('w2pBackToRanking').setAttribute('href',ctx.ranking);el('w2pContextLabel').textContent=ctx.buscar?`Volver a resultados para “${ctx.buscar}”`:p.categoria?`${p.categoria.nombre} · Perfil público`:'Perfil público';const audit=new URL(ctx.ranking,location.origin);if(p.categoria)audit.searchParams.set('categoria',String(p.categoria.id));audit.searchParams.set('auditoria',String(p.perfilId));audit.searchParams.set('volver',location.pathname+location.search);el('w2pAuditPoints').setAttribute('href',audit.pathname+audit.search);el('profileInitials').firstChild!.textContent=p.iniciales;el('profileName').textContent=p.nombre;el('profilePosition').textContent=p.posicion==='REVES'?'REVÉS':p.posicion==='DRIVE'?'DRIVE':'FLEXIBLE';el('profileCategory').textContent=p.categoria?p.categoria.nombre.toUpperCase():'SIN CATEGORÍA';el('profileRank').textContent=p.ranking?`#${p.ranking.posicion}`:'—';el('profileRankHelp').textContent=p.ranking?`${p.ranking.partidos} partidos incluidos`:'Sin posición';el('profilePoints').textContent=String(p.ranking?.puntos??0);el('profileEffectiveness').textContent=`${p.efectividad}%`;el('profileRecord').textContent=p.partidos?`${p.victorias} victorias · ${p.derrotas} derrotas`:'Sin partidos';el('seasonSummary').textContent=`${p.partidos} partidos computados`;el('metricMatches').textContent=String(p.partidos);el('metricWins').textContent=String(p.victorias);el('metricLosses').textContent=String(p.derrotas);const balance=p.victorias-p.derrotas;el('metricDifference').textContent=`${balance>0?'+':''}${balance}`;el('rankingCategory').textContent=p.categoria?`${p.categoria.nombre} categoría`:'Sin categoría vigente';el('rankingDetail').textContent=p.ranking?`Ocupa el puesto ${p.ranking.posicion} con ${p.ranking.puntos} puntos. Diferencia de sets ${p.ranking.diferenciaSets>=0?'+':''}${p.ranking.diferenciaSets} y games ${p.ranking.diferenciaGames>=0?'+':''}${p.ranking.diferenciaGames}.`:p.categoria?'Todavía no registra resultados oficiales en esta categoría.':'Este perfil necesita una categoría vigente para incorporarse al ranking oficial.';el('rankingLink').setAttribute('href',p.categoria?`/w2/rankings?categoriaId=${p.categoria.id}`:'/w2/rankings');el('profileMatches').innerHTML=p.historial.slice(0,8).map(x=>`<article><span class="${x.resultado==='GANADOR'?'win':''}">${x.resultado==='GANADOR'?'Victoria':'Derrota'}</span><strong>${esc(x.marcador||'Sin marcador')}</strong><p>${esc(x.torneo)}<small>${esc(x.fase)} · ${esc(x.companero?'con '+x.companero:'sin compañero')}</small></p><time>${fecha(x.fecha)}</time></article>`).join('');el('profileMatchesEmpty').classList.toggle('hidden',p.historial.length>0);el('profileCategories').innerHTML=p.categorias.map((x,i)=>`<li class="${i===0&&x.estado==='VIGENTE'?'active':''}"><b>${esc(x.categoria)}</b><span>${fecha(x.desde)} · ${x.hasta?fecha(x.hasta):'Actual'}</span></li>`).join('');el('profileCategoriesEmpty').classList.toggle('hidden',p.categorias.length>0);el('communityBadge').textContent=p.disponibleParaJugar?'DISPONIBLE':'NO DISPONIBLE';el('communityText').textContent=p.disponibleParaJugar?`Perfil visible para convocatorias${p.categoria?' compatibles con '+p.categoria.nombre:''}.`:'Este perfil no está disponible para convocatorias.';el('w2pAvailableFlag').textContent=p.disponibleParaJugar?'Disponible para jugar':'No disponible para jugar';el('w2pAvailableFlag').classList.toggle('active',p.disponibleParaJugar);el('w2pInvitesFlag').textContent=p.aceptaInvitaciones?'Acepta invitaciones':'No acepta invitaciones';el('w2pInvitesFlag').classList.toggle('active',p.aceptaInvitaciones);el('profileContent').classList.remove('hidden');el('profileLoading').classList.add('hidden');}
async function start(){const id=Number(new URLSearchParams(location.search).get('perfilId'));if(!Number.isInteger(id)||id<=0){el('profileLoading').classList.add('hidden');el('profileError').classList.remove('hidden');el('profileErrorText').textContent='Seleccioná un jugador desde el ranking para consultar su perfil.';return}try{render(await api<Perfil>(`/jugadores/${id}`))}catch(e){el('profileLoading').classList.add('hidden');el('profileError').classList.remove('hidden');el('profileErrorText').textContent=e instanceof Error?e.message:'No pudimos cargar el perfil.'}}start();
</script>
<style>
.w2p-context{max-width:1180px;margin:0 auto;padding:1rem 1.25rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;color:#7f9289;font-size:.72rem}.w2p-context a{color:#c8d3ce;font-weight:850}.w2p-context a:hover,.w2p-context a:focus-visible{color:#f0d98a}.w2p-audit-link{display:block;margin-top:.45rem;color:#f0d98a;font-size:.66rem;font-weight:850}.w2p-community-flags{list-style:none;display:grid;gap:.45rem;margin:1rem 0;padding:0}.w2p-community-flags li{padding:.55rem .7rem;border:1px solid #303b40;border-radius:10px;color:#788b82;font-size:.72rem}.w2p-community-flags li.active{border-color:rgba(105,213,160,.42);background:rgba(105,213,160,.08);color:#8fe0b4}@media(max-width:700px){.w2p-context{align-items:flex-start;flex-direction:column;padding-top:.8rem}.w2p-context span{font-size:.64rem}}
  #profileLoading{min-height:55vh;padding-top:8rem;text-align:center}
.w2-profile-error{min-height:calc(100vh - 12rem);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding-block:5rem}
.w2-profile-error-mark{width:7rem;height:7rem;border:1px solid #29353c;border-radius:2rem;background:#11171c;display:grid;place-items:center;position:relative;margin-bottom:1.5rem;box-shadow:0 1.6rem 4rem rgba(0,0,0,.28)}
.w2-profile-error-mark span{font-size:1.75rem;font-weight:900;color:#f2f4f2}.w2-profile-error-mark i{position:absolute;right:.7rem;bottom:.7rem;width:.85rem;height:.85rem;border-radius:50%;background:#e71939;border:3px solid #11171c}
.w2-profile-error>strong{display:block;font-size:clamp(2rem,4vw,3.7rem);line-height:1.05;margin:.45rem 0 1rem;color:#f4f5f3}.w2-profile-error>p:not(.w2-kicker){max-width:43rem;color:#91a69d;font-size:1.05rem}
.w2-profile-error-actions{display:flex;align-items:center;gap:1.25rem;margin-top:1.8rem;flex-wrap:wrap;justify-content:center}.w2-profile-error-actions .w2-button{display:inline-flex}.w2-profile-error-link{color:#b7c6c0;font-weight:800}
.w2-profile-badges{display:flex!important;align-items:center;gap:.65rem!important;flex-wrap:wrap}.w2-profile-badges>span,.w2-profile-badges>b{display:inline-flex;align-items:center;min-height:1.7rem;padding:.25rem .65rem;border-radius:999px;font-size:.7rem!important;font-weight:900!important;letter-spacing:.04em}
.w2-profile-badges>span{background:#183528;color:#73d2a1}.w2-profile-badges>b{background:#1a2025;border:1px solid #344049;color:#b8c5c0}
.w2-profile-empty{min-height:11rem;display:flex;align-items:center;justify-content:center;gap:1rem;text-align:left;color:#8ea39a}.w2-profile-empty>span{display:grid;place-items:center;width:3.2rem;height:3.2rem;border:1px solid #334139;border-radius:1rem;background:#151c20;color:#68c995;font-size:1.4rem}.w2-profile-empty strong{display:block;color:#e7ebe8;font-size:1rem;margin-bottom:.2rem}.w2-profile-empty p{margin:0}
.w2c2-matches>div>article time{font-size:.75rem;color:#81958c}.w2c2-matches>div:empty{display:none}.w2c2-community-status button:disabled{background:#171d21!important;border:1px solid #303a40!important;color:#707d82!important;box-shadow:none!important;cursor:default!important;opacity:1!important}
@media(max-width:700px){.w2-profile-error-actions{flex-direction:column}.w2-profile-error-actions a{width:100%;justify-content:center}.w2-profile-empty{min-height:9rem;padding:1rem}}
</style>
</W2Layout>
