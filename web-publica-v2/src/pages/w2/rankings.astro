---
import W2Layout from '../../w2/layouts/W2Layout.astro';
const players=[['1','Martina Ríos','MR','14','11','2.480','+1','MASTER'],['2','Sofía Lagos','SL','15','10','2.315','-1','MASTER'],['3','Carla Méndez','CM','12','9','2.160','0','MASTER'],['4','Lucía Ferraro','LF','13','8','1.980','+2','MASTER'],['5','Ana Vitale','AV','10','7','1.845','+3','CORTE'],['6','Valentina Paz','VP','11','6','1.720','-2',''],['7','Julieta Solís','JS','9','6','1.650','0',''],['8','Camila Norte','CN','10','5','1.540','+1','']];
---
<W2Layout titulo="Rankings W2" actual="rankings">
<section class="w2c2-rank-hero"><img src="/w2/w2-ranking-hero.png" alt="Paleta y pelota de pádel junto a la red de una cancha conceptual" width="1536" height="1024"/><div></div><div class="w2-container"><p class="w2-kicker">Ranking oficial por categoría</p><h1>La temporada se mide<br/><strong>partido a partido.</strong></h1><p>Posiciones auditables, evolución y clasificación al Master en una ventana móvil de 12 meses.</p><aside><span><small>CATEGORÍA</small><b>6.ª</b></span><span><small>JUGADORES</small><b>48</b></span><span><small>ACTUALIZADO</small><b>Hoy</b></span></aside></div></section>
<section class="w2-container w2c2-rank-layout"><aside class="w2c2-categories"><header><p class="w2-kicker">Circuito 2026</p><h2>Categorías</h2></header>{['1.ª','2.ª','3.ª','4.ª','5.ª','6.ª','7.ª','8.ª'].map((c,i)=><button class:list={[c==='6.ª'&&'active']} data-category={c}><span>{c}<small>{58-i*2} jugadores</small></span><b>→</b></button>)}<footer><span>Ventana de puntuación</span><b>Últimos 12 meses</b></footer></aside><main><header class="w2c2-rank-head"><div><p class="w2-kicker">6.ª categoría</p><h2>Ranking general</h2><p>Los cuatro primeros clasifican actualmente al Master.</p></div><label><span>Buscar jugador</span><input id="w2RankingSearch" type="search" placeholder="Nombre o apellido"/></label></header><section class="w2c2-podium"><article><span>02</span><div class="w2c2-avatar">SL</div><b>Sofía Lagos</b><small>2.315 puntos</small><em>-1</em></article><article class="winner"><i>CLASIFICADA</i><span>01</span><div class="w2c2-avatar">MR</div><b>Martina Ríos</b><small>2.480 puntos</small><em>+1</em></article><article><span>03</span><div class="w2c2-avatar">CM</div><b>Carla Méndez</b><small>2.160 puntos</small><em>0</em></article></section><section class="w2c2-my-position"><div class="w2c2-avatar">AV</div><p><small>TU POSICIÓN DEMOSTRATIVA</small><b>Ana Vitale · #5</b><span>A 135 puntos de la clasificación directa</span></p><strong>+3 <small>esta fecha</small></strong><a href="/w2/jugador">Ver perfil →</a></section><div class="w2c2-table-head"><span>POS.</span><span>JUGADOR</span><span>TORNEOS</span><span>VICTORIAS</span><span>PUNTOS</span><span>VAR.</span></div><div id="w2RankingRows" class="w2c2-table">{players.map(([p,n,a,t,w,pts,d,tag])=><article data-player={n.toLowerCase()} class:list={[n==='Ana Vitale'&&'self']}><b>{p}</b><div class="w2c2-avatar small">{a}</div><span>{n}<small>{tag||'Temporada activa'}</small></span><em>{t}</em><em>{w}</em><strong>{pts}</strong><i class:list={[d.startsWith('+')&&'up']}>{d}</i></article>)}</div><p id="w2RankingEmpty" class="w2-empty hidden">No encontramos jugadores con esa búsqueda.</p><section class="w2c2-audit"><div><p class="w2-kicker">Ranking transparente</p><h3>Cómo se construye tu posición</h3></div><dl><div><dt>01</dt><dd><b>Resultados oficiales</b><span>Solo partidos confirmados por la organización.</span></dd></div><div><dt>02</dt><dd><b>Ventana móvil</b><span>Los puntos permanecen activos durante 12 meses.</span></dd></div><div><dt>03</dt><dd><b>Trazabilidad</b><span>Cada movimiento puede rastrearse hasta su torneo.</span></dd></div></dl></section></main></section>
<script>
const rankingInput=document.querySelector<HTMLInputElement>('#w2RankingSearch');
const rankingRows=[...document.querySelectorAll<HTMLElement>('[data-player]')];
const rankingEmpty=document.querySelector<HTMLElement>('#w2RankingEmpty');
rankingInput?.addEventListener('input',()=>{const query=rankingInput.value.trim().toLowerCase();let visible=0;rankingRows.forEach(row=>{const show=(row.dataset.player??'').includes(query);row.classList.toggle('hidden',!show);if(show)visible++});rankingEmpty?.classList.toggle('hidden',visible>0)});
const categoryButtons=[...document.querySelectorAll<HTMLButtonElement>('[data-category]')];categoryButtons.forEach(button=>button.addEventListener('click',()=>{categoryButtons.forEach(item=>item.classList.remove('active'));button.classList.add('active')}));
</script>
</W2Layout>
