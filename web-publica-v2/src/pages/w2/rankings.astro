---
import W2Layout from '../../w2/layouts/W2Layout.astro';
import '../../w2/styles/w2-rankings.css';
---
<W2Layout titulo="Rankings W2" actual="rankings">
<section class="w2c2-rank-hero" aria-labelledby="rankTitle"><img src="/w2/w2-ranking-hero.png" alt="Paleta y pelota de pádel junto a la red" width="1536" height="1024"/><div></div><div class="w2-container"><p class="w2-kicker">Ranking oficial por categoría</p><h1 id="rankTitle">La temporada se mide<br/><strong>partido a partido.</strong></h1><p>Posiciones transparentes, construidas exclusivamente con resultados oficiales.</p><aside aria-label="Resumen del ranking"><span><small>CATEGORÍA</small><b id="rankHeroCategory">—</b></span><span><small>JUGADORES</small><b id="rankHeroPlayers">0</b></span><span><small>ÚLTIMO RESULTADO</small><b id="rankHeroUpdated">—</b></span></aside></div></section>
<section class="w2-container w2c2-rank-layout" id="rankingsContent" aria-busy="true"><aside class="w2c2-categories"><header><p class="w2-kicker">Circuito W2</p><h2>Categorías</h2></header><div id="rankCategories" role="listbox" aria-label="Categorías del ranking"><p class="w2-empty">Cargando categorías…</p></div><footer><span>Puntuación oficial</span><b>Historial auditable</b></footer></aside><main><header class="w2c2-rank-head"><div><p id="rankKicker" class="w2-kicker">Ranking deportivo</p><h2>Ranking general</h2><p id="rankSummary" aria-live="polite">Cargando resultados oficiales…</p></div><label><span>Buscar jugador</span><input id="w2RankingSearch" type="search" placeholder="Nombre o apellido" autocomplete="off" disabled/></label></header><section id="rankPodium" class="w2c2-podium" aria-label="Podio de la categoría"></section><div class="w2c2-table-head" aria-hidden="true"><span>POS.</span><span>JUGADOR</span><span>PARTIDOS</span><span>VICTORIAS</span><span>PUNTOS</span><span>EFECT.</span></div><div id="w2RankingRows" class="w2c2-table" aria-live="polite"></div><p id="w2RankingEmpty" class="w2-empty">Cargando ranking…</p><button id="rankRetry" class="hidden" type="button">REINTENTAR</button><section class="w2c2-audit"><div><p class="w2-kicker">Ranking transparente</p><h3>Cómo se construye cada posición</h3></div><dl><div><dt>01</dt><dd><b>Resultados oficiales</b><span>Solo partidos finalizados y auditados.</span></dd></div><div><dt>02</dt><dd><b>Una fórmula única</b><span>La administración y la web comparten el mismo cálculo.</span></dd></div><div><dt>03</dt><dd><b>Trazabilidad</b><span>Cada punto puede rastrearse hasta su partido.</span></dd></div></dl></section></main></section>
<script>import '../../w2/scripts/rankings';</script>
</W2Layout>
