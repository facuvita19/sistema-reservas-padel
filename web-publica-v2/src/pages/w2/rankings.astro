---
import W2Layout from '../../w2/layouts/W2Layout.astro';
---
<W2Layout titulo="Rankings W2" actual="rankings">
<section class="w2c2-rank-hero"><img src="/w2/w2-ranking-hero.png" alt="Paleta y pelota de pádel junto a la red" width="1536" height="1024"/><div></div><div class="w2-container"><p class="w2-kicker">Ranking oficial por categoría</p><h1>La temporada se mide<br/><strong>partido a partido.</strong></h1><p>Posiciones transparentes, construidas exclusivamente con resultados oficiales.</p><aside><span><small>CATEGORÍA</small><b id="rankHeroCategory">—</b></span><span><small>JUGADORES</small><b id="rankHeroPlayers">0</b></span><span><small>ÚLTIMO RESULTADO</small><b id="rankHeroUpdated">—</b></span></aside></div></section>
<section class="w2-container w2c2-rank-layout"><aside class="w2c2-categories"><header><p class="w2-kicker">Circuito W2</p><h2>Categorías</h2></header><div id="rankCategories"><p class="w2-empty">Cargando categorías…</p></div><footer><span>Puntuación oficial</span><b>Historial auditable</b></footer></aside><main><header class="w2c2-rank-head"><div><p id="rankKicker" class="w2-kicker">Ranking deportivo</p><h2>Ranking general</h2><p id="rankSummary">Cargando resultados oficiales…</p></div><label><span>Buscar jugador</span><input id="w2RankingSearch" type="search" placeholder="Nombre o apellido" disabled/></label></header><section id="rankPodium" class="w2c2-podium"></section><div class="w2c2-table-head"><span>POS.</span><span>JUGADOR</span><span>PARTIDOS</span><span>VICTORIAS</span><span>PUNTOS</span><span>EFECT.</span></div><div id="w2RankingRows" class="w2c2-table"></div><p id="w2RankingEmpty" class="w2-empty">Cargando ranking…</p><button id="rankRetry" class="hidden" type="button">REINTENTAR</button><section class="w2c2-audit"><div><p class="w2-kicker">Ranking transparente</p><h3>Cómo se construye cada posición</h3></div><dl><div><dt>01</dt><dd><b>Resultados oficiales</b><span>Solo partidos finalizados y auditados.</span></dd></div><div><dt>02</dt><dd><b>Una fórmula única</b><span>La administración y la web comparten el mismo cálculo.</span></dd></div><div><dt>03</dt><dd><b>Trazabilidad</b><span>Cada punto puede rastrearse hasta su partido.</span></dd></div></dl></section></main></section>
<script>
import { api } from '../../scripts/api';
type Categoria={id:number;codigo:string;nombre:string;color:string;participantes:number};
type Fila={posicion:number;perfilId:number;jugador:string;iniciales:string;puntos:number;partidos:number;victorias:number;derrotas:number;efectividad:number;diferenciaSets:number;diferenciaGames:number};
type Ranking={categoria:Categoria;participantes:number;partidosAuditados:number;ultimoResultado:string|null;posiciones:Fila[]};
const $=<T extends HTMLElement>(s:string)=>document.querySelector<T>(s);let actual=0,filas:Fila[]=[];
const escapar=(v:string)=>v.replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[c]||c));
function pintarFilas(){const q=($('#w2RankingSearch') as HTMLInputElement).value.trim().toLowerCase();const visibles=filas.filter(x=>x.jugador.toLowerCase().includes(q));$('#w2RankingRows')!.innerHTML=visibles.map(x=>`<a href="/w2/jugador?perfilId=${x.perfilId}" data-player="${escapar(x.jugador.toLowerCase())}"><b>${x.posicion}</b><div class="w2c2-avatar small">${escapar(x.iniciales)}</div><span>${escapar(x.jugador)}<small>${x.diferenciaSets>=0?'+':''}${x.diferenciaSets} sets · ${x.diferenciaGames>=0?'+':''}${x.diferenciaGames} games</small></span><em>${x.partidos}</em><em>${x.victorias}</em><strong>${x.puntos}</strong><i>${x.efectividad}%</i></a>`).join('');const empty=$('#w2RankingEmpty')!;empty.textContent=filas.length?'No encontramos jugadores con esa búsqueda.':'Todavía no hay resultados oficiales para esta categoría.';empty.classList.toggle('hidden',visibles.length>0);}
function pintarPodio(){const p=filas.slice(0,3);$('#rankPodium')!.innerHTML=p.length?p.map((x,i)=>`<a href="/w2/jugador?perfilId=${x.perfilId}" class="${i===0?'winner':''}"><span>${String(x.posicion).padStart(2,'0')}</span><div class="w2c2-avatar">${escapar(x.iniciales)}</div><b>${escapar(x.jugador)}</b><small>${x.puntos} puntos</small><em>${x.efectividad}%</em></a>`).join(''):'';}
async function cargar(id:number){actual=id;$('#w2RankingEmpty')!.classList.remove('hidden');$('#w2RankingEmpty')!.textContent='Cargando ranking…';$('#rankRetry')!.classList.add('hidden');try{const r=await api<Ranking>(`/rankings?categoriaId=${id}`);filas=r.posiciones;$('#rankHeroCategory')!.textContent=r.categoria.nombre;$('#rankHeroPlayers')!.textContent=String(r.participantes);$('#rankHeroUpdated')!.textContent=r.ultimoResultado?new Date(r.ultimoResultado).toLocaleDateString('es-AR'):'Sin resultados';$('#rankKicker')!.textContent=`${r.categoria.nombre} categoría`;$('#rankSummary')!.textContent=r.participantes?`${r.participantes} jugadores · ${r.partidosAuditados} partidos auditados`:'Esta categoría todavía no registra resultados oficiales.';document.querySelectorAll('[data-category]').forEach(x=>x.classList.toggle('active',Number((x as HTMLElement).dataset.category)===id));($('#w2RankingSearch') as HTMLInputElement).disabled=false;pintarPodio();pintarFilas();}catch(e){filas=[];$('#rankPodium')!.innerHTML='';$('#w2RankingRows')!.innerHTML='';$('#w2RankingEmpty')!.textContent=e instanceof Error?e.message:'No pudimos cargar el ranking.';$('#rankRetry')!.classList.remove('hidden');}}
async function iniciar(){try{const c=await api<Categoria[]>('/rankings/categorias');$('#rankCategories')!.innerHTML=c.map(x=>`<button data-category="${x.id}"><span>${escapar(x.nombre)}<small>${x.participantes} jugadores</small></span><b>→</b></button>`).join('');document.querySelectorAll<HTMLButtonElement>('[data-category]').forEach(b=>b.addEventListener('click',()=>cargar(Number(b.dataset.category))));if(c.length)cargar((c.find(x=>x.codigo==='5TA')||c[0]).id);else $('#w2RankingEmpty')!.textContent='No hay categorías deportivas disponibles.';}catch(e){$('#rankCategories')!.innerHTML='<p class="w2-empty">No pudimos cargar las categorías.</p>';$('#w2RankingEmpty')!.textContent=e instanceof Error?e.message:'No pudimos conectar con la API.';$('#rankRetry')!.classList.remove('hidden');}}
$('#w2RankingSearch')?.addEventListener('input',pintarFilas);$('#rankRetry')?.addEventListener('click',()=>actual?cargar(actual):iniciar());iniciar();
</script>
<style>
#rankCategories{max-height:34rem;overflow-y:auto;overscroll-behavior:contain;padding-right:.2rem;scrollbar-width:thin;scrollbar-color:#e71939 #11171c}#rankCategories::-webkit-scrollbar{width:6px}#rankCategories::-webkit-scrollbar-track{background:#11171c}#rankCategories::-webkit-scrollbar-thumb{background:#e71939;border-radius:999px}.w2c2-categories{align-self:start;position:sticky;top:7rem}.w2c2-categories footer{margin-top:.7rem}@media(max-width:900px){#rankCategories{max-height:none;overflow:visible}.w2c2-categories{position:static}}
</style>
</W2Layout>
