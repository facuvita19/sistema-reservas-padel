---
import '../../styles/global.css';
import '../../w2/styles/w2-tournaments.css';
import W2Layout from '../../w2/layouts/W2Layout.astro';
import ModalInscripcionTorneo from '../../components/ModalInscripcionTorneo.astro';
import ModalCuadroTorneo from '../../components/ModalCuadroTorneo.astro';
---
<W2Layout titulo="Torneos | Plataforma Deportiva W2" actual="torneos">
  <section class="w2t-shell">
    <div id="vistaCatalogoTorneos" class="w2t-catalog">
      <header class="w2t-hero">
        <div class="w2-container w2t-hero-grid">
          <div class="w2t-hero-copy">
            <p class="w2-kicker">Circuito competitivo W2</p>
            <h1>Elegí el desafío.<br/><strong>Seguí cada punto.</strong></h1>
            <p>Descubrí competencias, inscribí a tu pareja y acompañá el torneo desde el primer partido hasta la definición.</p>
            <div id="resumenTorneos" class="w2t-season-signals" aria-live="polite"></div>
          </div>
          <aside id="torneoDestacado" class="w2t-featured" aria-live="polite">
            <div class="w2t-featured-loading"><span></span><b>Preparando el próximo desafío</b><small>Consultando el calendario oficial.</small></div>
          </aside>
        </div>
        <span class="w2t-court-mark" aria-hidden="true"></span>
      </header>

      <section class="w2-container w2t-explorer" aria-labelledby="w2tExplorerTitle">
        <header class="w2t-section-head">
          <div><p class="w2-kicker">Calendario oficial</p><h2 id="w2tExplorerTitle">Competencias W2</h2></div>
          <p>Filtrá por estado, rama o formato. Cada inscripción de pádel se realiza exclusivamente por pareja.</p>
        </header>
        <nav id="pestanasTorneos" class="w2t-state-tabs" aria-label="Estados de torneos"></nav>
        <div class="w2t-tools">
          <label class="w2t-search"><span>Buscar competencia</span><div><input id="buscarTorneo" type="search" placeholder="Torneo, categoría, rama o formato" autocomplete="off"/><i aria-hidden="true">⌕</i></div></label>
          <aside id="panelFiltrosTorneos" class="w2t-filters" aria-label="Filtros de torneos">
            <header><div><p class="w2-kicker">Afiná la búsqueda</p><h3>Filtros</h3></div><button id="cerrarFiltrosTorneos" type="button" aria-label="Cerrar filtros">×</button></header>
            <label class="w2t-field"><span>Rama</span><select id="filtroRama" data-premium-select="Rama"><option value="">Todas las ramas</option></select></label>
            <label class="w2t-field"><span>Formato</span><select id="filtroFormato" data-premium-select="Formato"><option value="">Todos los formatos</option></select></label>
            <label class="w2t-open-only"><input id="filtroInscripcion" type="checkbox"/><span><b>Solo con inscripción abierta</b><small>Mostrar oportunidades disponibles</small></span></label>
            <footer><button id="limpiarFiltrosTorneos" type="button">Limpiar</button><button id="aplicarFiltrosTorneos" class="w2t-apply" type="button">Aplicar filtros</button></footer>
          </aside>
          <button id="abrirFiltrosTorneos" class="w2t-filter-trigger" type="button" aria-controls="panelFiltrosTorneos" aria-expanded="false">Filtros <span id="cantidadFiltrosTorneos" class="hidden">0</span></button>
        </div>
        <div class="w2t-results-head"><div id="estadoCatalogoTorneos" class="w2t-results-meta"></div><div class="w2t-active-filters"><div id="chipsFiltrosTorneos" aria-live="polite"></div><button id="limpiarFiltrosTorneosInline" class="hidden" type="button">Limpiar todo</button></div></div>
        <main class="w2t-results"><div id="listaTorneos" class="w2t-grid"></div><button id="mostrarMasTorneos" class="w2t-more hidden" type="button">Mostrar más competencias</button></main>
      </section>

      <section class="w2t-journey"><div class="w2-container"><div><p class="w2-kicker">Una experiencia conectada</p><h2>De la inscripción<br/>a la final.</h2><p>La competencia deja de ser una sucesión de mensajes. Todo el recorrido oficial vive en W2.</p></div><ol><li><span>01</span><b>Elegí la competencia</b><small>Rama, categoría, formato y cupos claros.</small></li><li><span>02</span><b>Inscribí a tu pareja</b><small>Una única solicitud con todos los datos.</small></li><li><span>03</span><b>Seguí el torneo</b><small>Posiciones, partidos y resultados oficiales.</small></li><li><span>04</span><b>Viví la definición</b><small>Cuadro, recorrido y campeones.</small></li></ol></div></section>
    </div>
    <div id="vistaDetalleTorneo" class="tournament-detail-view hidden"><div id="detalleTorneoHost"></div></div>
    <div id="fondoFiltrosTorneos" class="w2t-filter-backdrop hidden"></div>
  </section>
  <ModalInscripcionTorneo />
  <ModalCuadroTorneo />
  <script>import '../../scripts/torneos';</script>
</W2Layout>