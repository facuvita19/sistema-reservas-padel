---
import W2Layout from '../../w2/layouts/W2Layout.astro';
import AuditoriaDeportiva from '../../w2/components/AuditoriaDeportiva.astro';
import '../../w2/styles/w2-account.css';
import '../../w2/styles/w2-account-community.css';
---
<W2Layout titulo="Mi cuenta | Pádel Las Flores" actual="cuenta">
<main class="w2a-page">
 <section id="w2AccountLoading" class="w2-container w2a-state"><span></span><p><b>Preparando tu centro personal</b><small>Conectando cuenta, reservas e identidad deportiva.</small></p></section>
 <section id="w2AccountGuest" class="w2-container w2a-guest hidden"><p class="w2-kicker">Centro privado</p><h1>Tu actividad,<br/><strong>en un solo lugar.</strong></h1><p>Ingresá para consultar reservas, datos, seguridad y evolución deportiva.</p><button id="w2AccountLogin" class="w2-button primary" type="button">Ingresar o crear cuenta</button><a href="/w2">Volver al inicio →</a></section>
 <div id="w2AccountContent" class="hidden">
  <section class="w2a-hero"><div class="w2-container w2a-hero-grid"><div class="w2a-identity"><span id="w2aAvatar">PR</span><div><p class="w2-kicker">Centro personal</p><h1 id="w2aName">Mi cuenta</h1><p id="w2aEmail">Sesión protegida</p></div></div><aside><span><small>PRÓXIMAS</small><b id="w2aNextCount">0</b></span><span><small>HISTORIAL</small><b id="w2aHistoryCount">0</b></span><span><small>POSICIÓN</small><b id="w2aPosition">—</b></span></aside></div></section>
  <div class="w2-container w2a-shell">
   <aside class="w2a-nav" aria-label="Secciones de Mi cuenta"><p>TU CUENTA</p><a href="?seccion=resumen" data-account-section="resumen"><i>01</i><span><b>Resumen</b><small>Actividad y próximos pasos</small></span></a><a href="?seccion=reservas" data-account-section="reservas"><i>02</i><span><b>Reservas</b><small>Próximas e historial</small></span></a><a href="?seccion=datos" data-account-section="datos"><i>03</i><span><b>Datos personales</b><small>Contacto y preferencias</small></span></a><a href="?seccion=seguridad" data-account-section="seguridad"><i>04</i><span><b>Seguridad</b><small>Contraseña de acceso</small></span></a><a href="?seccion=deporte" data-account-section="deporte"><i>05</i><span><b>Perfil deportivo</b><small>Categoría, ranking e historial</small></span></a>
   </aside>
   <section class="w2a-content">
    <div id="w2aSectionNav" class="w2a-mobile-nav"><span>SECCIÓN ACTUAL</span><button id="w2aSectionTrigger" type="button" aria-expanded="false" aria-controls="w2aSectionList"><b id="w2aSectionLabel">Resumen</b><i aria-hidden="true"></i></button><div id="w2aSectionList" class="w2a-section-list hidden" role="listbox" aria-label="Secciones de Mi cuenta"><button type="button" role="option" data-mobile-section="resumen" aria-selected="true"><i>01</i><span><b>Resumen</b><small>Actividad y próximos pasos</small></span><em>✓</em></button><button type="button" role="option" data-mobile-section="reservas" aria-selected="false"><i>02</i><span><b>Reservas</b><small>Próximas e historial</small></span><em>✓</em></button><button type="button" role="option" data-mobile-section="datos" aria-selected="false"><i>03</i><span><b>Datos personales</b><small>Contacto y preferencias</small></span><em>✓</em></button><button type="button" role="option" data-mobile-section="seguridad" aria-selected="false"><i>04</i><span><b>Seguridad</b><small>Contraseña de acceso</small></span><em>✓</em></button><button type="button" role="option" data-mobile-section="deporte" aria-selected="false"><i>05</i><span><b>Perfil deportivo</b><small>Categoría, ranking e historial</small></span><em>✓</em></button></div></div>
    <section data-account-panel="resumen"><header class="w2a-heading"><div><p class="w2-kicker">Hoy en tu cuenta</p><h2>Todo listo para<br/><strong>tu próxima jugada.</strong></h2></div><a href="/w2/reservar">Reservar cancha →</a></header><div class="w2a-grid"><article id="w2aNext" class="w2a-card featured"></article><article class="w2a-card"><p class="w2-kicker">Actividad</p><h3>Tu recorrido en el club</h3><div id="w2aMetrics" class="w2a-metrics"></div></article><article class="w2a-card sport"><p class="w2-kicker">Identidad deportiva</p><h3 id="w2aSportTitle">Perfil deportivo</h3><p id="w2aSportText">Tu posición preferida y tu actividad competitiva viven en una identidad deportiva única.</p><a href="?seccion=deporte">Ver identidad deportiva <span>→</span></a></article><article class="w2a-card actions"><p class="w2-kicker">Accesos rápidos</p><a href="?seccion=reservas"><i aria-hidden="true">R</i><span><b>Mis reservas</b><small>Estados, pagos e historial</small></span><em>→</em></a><a href="?seccion=datos"><i aria-hidden="true">D</i><span><b>Mis datos</b><small>Contacto y preferencias</small></span><em>→</em></a><a href="?seccion=seguridad"><i aria-hidden="true">S</i><span><b>Seguridad</b><small>Actualizar contraseña</small></span><em>→</em></a></article></div></section>
    <section data-account-panel="reservas" class="hidden w2r-section"><header class="w2r-head"><div><p class="w2-kicker">Reservas W2</p><h2>Tu agenda,<br/><strong>bajo control.</strong></h2><p id="w2rSummary">Consultando tu actividad…</p></div><a class="w2-button primary" href="/w2/reservar">Reservar cancha</a></header><div id="w2rMetrics" class="w2r-metrics"></div><div class="w2r-switch"><div role="tablist" aria-label="Vistas de reservas"><button type="button" role="tab" data-w2r-tab="proximas" aria-selected="true">Próximas <b id="w2rUpcomingCount">0</b></button><button type="button" role="tab" data-w2r-tab="historial" aria-selected="false">Historial <b id="w2rHistoryCount">0</b></button></div><div class="w2r-update"><span id="w2rUpdated">Actualizando…</span><button id="w2rRefresh" type="button">Actualizar <i aria-hidden="true">↻</i></button></div></div><div id="w2rFilters" class="hidden w2r-filters"><div class="w2r-filter-state"><span>Estado</span><button id="w2rStatusTrigger" type="button" aria-expanded="false" aria-controls="w2rStatusMenu"><b id="w2rStatusLabel">Todos los estados</b><i></i></button><div id="w2rStatusMenu" class="hidden" role="listbox" aria-label="Filtrar historial por estado"></div></div><label class="w2r-search"><span>Buscar cancha</span><div><i aria-hidden="true"></i><input id="w2rSearch" type="search" placeholder="Nombre de la cancha"/><button id="w2rSearchClear" class="hidden" type="button" aria-label="Limpiar búsqueda">×</button></div></label><button id="w2rClear" class="hidden" type="button">Limpiar filtros</button><p id="w2rResultText"><b id="w2rResults">0</b> resultados</p><div id="w2rChips" class="hidden w2r-chips"></div></div><div id="w2rList" class="w2r-list" aria-live="polite"></div><div id="w2rMore" class="hidden w2r-more"><button type="button">Mostrar más</button><span></span></div><details class="w2r-lookup"><summary><span><b>¿No encontrás una reserva?</b><small>Consultá un código que no figure en tu cuenta.</small></span><strong>Consultar mediante código <i></i></strong></summary><form id="w2rLookupForm" novalidate><label><span>Código de seguimiento</span><input id="w2rCode" autocomplete="off" spellcheck="false" placeholder="Pegá el código completo"/><small>Lo encontrás en la confirmación que recibiste al reservar.</small></label><button id="w2rLookupSubmit" type="submit">Consultar</button><small id="w2rCodeError"></small></form><div id="w2rLookupResult"></div></details></section>
    <section data-account-panel="datos" class="hidden w2a-coming"><p class="w2-kicker">Datos personales</p><h2>Tu identidad y contacto</h2><p>Mientras trasladamos la edición completa al nuevo centro, tus datos continúan disponibles sin pérdida funcional.</p><a class="w2-button primary" href="/mis-datos">Abrir edición actual</a></section>
    <section data-account-panel="seguridad" class="hidden w2a-coming"><p class="w2-kicker">Seguridad</p><h2>Protegé tu acceso</h2><p>El cambio de contraseña seguirá disponible en la pantalla actual hasta integrarse aquí con paridad completa.</p><a class="w2-button primary" href="/mis-datos">Administrar contraseña</a></section>
    <section data-account-panel="deporte" class="hidden w2d-section"><div id="w2dLoading" class="w2d-state"><b>Preparando tu perfil deportivo</b><span>Conectando categoría, puntos y trayectoria oficial.</span></div><div id="w2dEmpty" class="hidden w2d-state"><p class="w2-kicker">Identidad deportiva</p><h2>Tu perfil todavía no está vinculado</h2><p>Cuando tu identidad deportiva quede asociada a la cuenta, acá vas a encontrar categoría, ranking e historial sin ingresar ningún identificador.</p><a class="w2-button" href="/w2/rankings">Explorar rankings</a></div><div id="w2dContent" class="hidden"><header id="w2dHero" class="w2d-hero w2d-hero-premium" data-publication="SIN_CATEGORIA"><div class="w2d-hero-atmosphere" aria-hidden="true"><i></i><i></i></div><div class="w2d-person"><span id="w2dAvatar" aria-hidden="true">PJ</span><div class="w2d-person-copy"><p class="w2-kicker"><span></span> Mi identidad deportiva</p><h2 id="w2dName">Jugador</h2><div class="w2d-badges" aria-label="Estado deportivo personal"><b id="w2dCategory">Sin categoría</b><em id="w2dPosition">Flexible</em><span id="w2dPublicationBadge">PERFIL DEPORTIVO</span></div><p id="w2dHeroNarrative" class="w2d-hero-narrative">Tu categoría, ranking y trayectoria oficial en un único lugar.</p></div></div><div class="w2d-actions" aria-label="Acciones del perfil deportivo"><a id="w2dPublicProfile" href="/w2/jugador"><span>Ver mi perfil público</span><b aria-hidden="true">↗</b></a><a id="w2dPointsDetail" class="primary" href="/w2/rankings"><span>Cómo se forman mis puntos</span><b aria-hidden="true">→</b></a></div></header><div id="w2dReadyNotice" class="w2d-ready hidden" role="status"><span aria-hidden="true">✓</span><div><b>Tu identidad deportiva ya está lista</b><p>El puesto, los puntos y la efectividad se calcularán automáticamente cuando se publiquen tus primeros resultados oficiales.</p></div></div><section id="w2dSummary" class="w2d-summary" data-performance="empty" aria-labelledby="w2dSummaryTitle"><header><div><p class="w2-kicker">Resumen deportivo</p><h3 id="w2dSummaryTitle">Tu situación competitiva</h3></div><span id="w2dSummaryStatus">SIN RESULTADOS</span></header><div class="w2d-summary-grid"><article class="w2d-standing"><div><small>PUESTO ACTUAL</small><strong id="w2dRank">—</strong><span id="w2dRankHelp">Sin posición publicada</span></div><div><small>PUNTOS PUBLICADOS</small><strong id="w2dPoints">0</strong><a id="w2dPointsSummaryLink" href="/w2/rankings">Ver detalle auditable →</a></div></article><article class="w2d-form"><header><div><small>RENDIMIENTO OFICIAL</small><strong id="w2dEffectiveness">0%</strong></div><span id="w2dPerformanceLabel">SIN RESULTADOS</span></header><p id="w2dSummaryNarrative">Tu rendimiento aparecerá cuando se publiquen partidos oficiales.</p><div class="w2d-form-meter" role="img" id="w2dFormMeter" aria-label="Sin partidos oficiales"><i id="w2dFormBar"></i></div><footer><span><small>PARTIDOS</small><b id="w2dMatches">0</b></span><span><small>REGISTRO</small><b id="w2dRecord">Sin partidos oficiales</b></span><span><small>BALANCE</small><b id="w2dBalance">0</b></span></footer></article></div></section><div class="w2d-grid"><main><section class="w2d-card"><header><div><p class="w2-kicker">Actividad reciente</p><h3>Últimos partidos oficiales</h3></div><div class="w2d-activity-meta"><span id="w2dHistoryCount">0 partidos</span><button id="w2dMatchesCollapseTop" class="hidden" type="button" aria-controls="w2dMatchesList">Mostrar solo los 3 más nuevos ↑</button></div></header><p id="w2dMatchesSummary" class="w2d-matches-summary">Resultados oficiales más recientes.</p><div id="w2dMatchesList" class="w2d-matches" data-expanded="false"></div><button id="w2dMatchesToggle" class="w2d-matches-toggle hidden" type="button" aria-expanded="false" aria-controls="w2dMatchesList"><span>Ver actividad completa</span><b aria-hidden="true">↓</b></button><div id="w2dMatchesEmpty" class="w2d-empty-state hidden"><span aria-hidden="true">◇</span><div><b>Tu actividad aparecerá acá</b><p>Cuando se publiquen tus primeros resultados oficiales, vas a ver cada partido, torneo e instancia en este espacio.</p><a href="/w2/torneos">Explorar torneos →</a></div></div></section></main><aside><section class="w2d-card"><p class="w2-kicker">Recorrido deportivo</p><h3>Historial de categorías</h3><ol id="w2dCategories" aria-label="Historial de categorías"></ol><p id="w2dCategoriesEmpty" class="w2d-empty hidden">Todavía no hay movimientos de categoría.</p></section></aside></div><section id="w2iPanel" class="w2i-panel" aria-labelledby="w2iTitle">
<header><div><p class="w2-kicker">Comunidad privada</p><h3 id="w2iTitle">Invitaciones para jugar</h3><p>Revisá propuestas recibidas y seguí las que enviaste. Los datos de contacto continúan protegidos.</p></div><span id="w2iPendingBadge"><b id="w2iPendingCount">0</b> POR RESPONDER</span></header>
<div class="w2i-tabs" role="tablist" aria-label="Bandeja de invitaciones"><button type="button" role="tab" data-w2i-tab="recibidas" aria-selected="true">Recibidas <b id="w2iReceivedCount">0</b></button><button type="button" role="tab" data-w2i-tab="enviadas" aria-selected="false">Enviadas <b id="w2iSentCount">0</b></button><button id="w2iRefresh" type="button">Actualizar <span aria-hidden="true">↻</span></button></div>
<div id="w2iStatus" class="w2i-status" role="status" aria-live="polite">Preparando invitaciones…</div><div id="w2iList" class="w2i-list" aria-live="polite"></div>
</section><div id="w2dCommunityPanel" data-r33c2-layout="full-width" class="w2dc-panel" data-state="loading"><header><div><p class="w2-kicker">Comunidad deportiva</p><h3>Tu disponibilidad pública</h3><p>Elegí cómo querés participar. Ningún teléfono se publica en el catálogo.</p></div><span id="w2dcPublication"><i aria-hidden="true"></i><b>CONSULTANDO</b></span></header><div id="w2dcNotice" class="w2dc-notice" role="status" aria-live="polite"><b>Preparando tus preferencias</b><span>Consultando el estado confirmado por el servidor.</span></div><form id="w2dCommunityForm" class="w2d-community-form w2dc-form"><fieldset><legend>Presencia en Comunidad</legend><label class="w2dc-option primary"><span><b>Disponible para jugar</b><small id="w2dAvailableHelp">Controla si tu perfil puede participar de Comunidad.</small></span><input id="w2dAvailable" type="checkbox" role="switch" aria-describedby="w2dAvailableHelp"/><i aria-hidden="true"></i></label><label class="w2dc-option"><span><b>Aceptar invitaciones</b><small id="w2dInvitesHelp">Permití futuras invitaciones internas cuando estés disponible.</small></span><input id="w2dInvites" type="checkbox" role="switch" aria-describedby="w2dInvitesHelp"/><i aria-hidden="true"></i></label></fieldset><fieldset id="w2dcObjectives"><legend>¿Qué estás buscando?</legend><label class="w2dc-goal"><span class="w2dc-icon" aria-hidden="true">4</span><span><b>Completar turnos reservados</b><small id="w2dcTurnosHelp">Aparecé para sumarte a partidos que necesitan jugadores.</small></span><input id="w2dcTurnos" type="checkbox" aria-describedby="w2dcTurnosHelp"/><i aria-hidden="true">✓</i></label><label class="w2dc-goal"><span class="w2dc-icon" aria-hidden="true">T</span><span><b>Formar pareja para torneos</b><small id="w2dcTorneosHelp">Mostrá que estás disponible para coordinar una pareja antes de inscribirse.</small></span><input id="w2dcTorneos" type="checkbox" aria-describedby="w2dcTorneosHelp"/><i aria-hidden="true">✓</i></label></fieldset><fieldset><legend>Contacto protegido</legend><label class="w2dc-option whatsapp"><span><b>Permitir contacto por WhatsApp</b><small id="w2dcWhatsappHelp">El número nunca aparece en el listado. El servidor autorizará cada contacto según tu consentimiento.</small></span><input id="w2dcWhatsapp" type="checkbox" role="switch" aria-describedby="w2dcWhatsappHelp"/><i aria-hidden="true"></i></label><p id="w2dcConsent" class="w2dc-consent">WhatsApp no autorizado.</p></fieldset><div class="w2d-community-actions"><p id="w2dCommunityStatus" role="status" aria-live="polite">Tus preferencias están sincronizadas.</p><div><a href="/w2/comunidad">Ver Comunidad <b aria-hidden="true">↗</b></a><button id="w2dCommunitySave" type="submit" disabled>Guardar cambios</button></div></div></form><footer><span><i aria-hidden="true"></i><b>Privacidad bajo control</b> Podés pausar tu publicación cuando quieras.</span><small id="w2dcUpdated">Sin cambios guardados todavía.</small></footer></div></div></section>
   </section>
  </div>
 </div>
<AuditoriaDeportiva/>
<div id="w2rDetailBackdrop" class="hidden w2r-detail-backdrop"></div><aside id="w2rDetail" class="hidden w2r-detail" role="dialog" aria-modal="true" aria-labelledby="w2rDetailTitle" tabindex="-1"><header class="w2r-detail-header"><div><span>DETALLE DE RESERVA</span><small id="w2rDetailContext">Gestión del turno</small></div><button id="w2rDetailClose" type="button" aria-label="Cerrar detalle"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 7l10 10M17 7L7 17"/></svg></button></header><div id="w2rDetailBody"></div></aside></main><script>import '../../w2/scripts/cuenta';</script>
<style>
.w2d-section{min-width:0}.w2d-state{min-height:28rem;display:grid;place-content:center;gap:.45rem;text-align:center;border:1px solid #2b373d;border-radius:22px;background:#10161a;padding:2rem}.w2d-state b,.w2d-state h2{color:#f3f5f3}.w2d-state span,.w2d-state p{color:#8fa39a}.w2d-hero{display:flex;align-items:center;justify-content:space-between;gap:1.2rem;padding:1.4rem;border:1px solid #2b373d;border-radius:22px;background:linear-gradient(145deg,#131a1e,#0c1114)}.w2d-person{display:flex;align-items:center;gap:1rem}.w2d-person>span{display:grid;place-items:center;width:4.4rem;height:4.4rem;border:1px solid #d7ad4a;border-radius:18px;background:#2a2315;color:#f0d98a;font-weight:900;font-size:1.1rem}.w2d-person h2{margin:.2rem 0;font-size:clamp(1.7rem,3vw,2.8rem)}.w2d-person p:last-child{display:flex;gap:.45rem;flex-wrap:wrap}.w2d-person p b,.w2d-person p em{padding:.28rem .58rem;border:1px solid #334047;border-radius:999px;color:#aebdb6;font-size:.65rem;font-style:normal}.w2d-actions{display:flex;gap:.55rem;flex-wrap:wrap;justify-content:flex-end}.w2d-actions a{display:inline-flex;align-items:center;justify-content:center;min-height:2.8rem;padding:.65rem .9rem;border:1px solid #36444a;border-radius:12px;color:#c7d2cd;font-weight:850;font-size:.72rem}.w2d-actions a.primary{border-color:#d7ad4a;color:#f0d98a;background:rgba(215,173,74,.09)}.w2d-score{display:grid;grid-template-columns:repeat(4,1fr);gap:.7rem;margin:1rem 0}.w2d-score article,.w2d-card{border:1px solid #2b373d;border-radius:18px;background:#0f1518;padding:1rem}.w2d-score small{color:#71857b;font-size:.62rem;font-weight:900}.w2d-score strong{display:block;margin:.35rem 0;color:#fff;font-size:1.7rem}.w2d-score span{color:#7f9289;font-size:.67rem}.w2d-grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(17rem,.75fr);gap:1rem}.w2d-grid aside{display:grid;gap:1rem;align-content:start}.w2d-card>header{display:flex;justify-content:space-between;gap:1rem;align-items:end;margin-bottom:.8rem}.w2d-card h3{margin:.2rem 0 0}.w2d-card>header>span{color:#74887e;font-size:.68rem}.w2d-matches{display:grid;gap:.55rem}.w2d-match{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:.75rem;align-items:center;padding:.8rem;border:1px solid #29353b;border-radius:13px;background:#0a0f12}.w2d-match>span{min-width:4.7rem;padding:.34rem .5rem;border-radius:999px;background:#2b181a;color:#e78d97;text-align:center;font-size:.61rem;font-weight:900}.w2d-match>span.win{background:#11281e;color:#79d6a5}.w2d-match b{display:block}.w2d-match p{margin:.22rem 0 0;color:#7f9289;font-size:.68rem}.w2d-match time{color:#82968c;font-size:.66rem}.w2d-card ol{list-style:none;display:grid;gap:.5rem;margin:1rem 0 0;padding:0}.w2d-card ol li{display:flex;justify-content:space-between;gap:.7rem;padding:.7rem;border-left:2px solid #39474d;background:#0a1013;color:#879a90}.w2d-card ol li.active{border-left-color:#69d5a0;color:#cfdbd5}.w2d-card ol span{font-size:.65rem}.w2d-flags{list-style:none;display:grid;gap:.5rem;margin:1rem 0;padding:0}.w2d-flags li{padding:.65rem;border:1px solid #303c42;border-radius:11px;color:#778a80;font-size:.7rem}.w2d-flags li.active{border-color:rgba(105,213,160,.4);background:rgba(105,213,160,.07);color:#8edfb3}.w2d-card>p:last-child,.w2d-empty{color:#7d9087;font-size:.7rem;line-height:1.5}
@media(max-width:900px){.w2d-hero{align-items:flex-start;flex-direction:column}.w2d-actions{width:100%;justify-content:stretch}.w2d-actions a{flex:1}.w2d-score{grid-template-columns:repeat(2,1fr)}.w2d-grid{grid-template-columns:1fr}.w2d-match{grid-template-columns:auto minmax(0,1fr)}:global(.w2d-match time){grid-column:2}}
