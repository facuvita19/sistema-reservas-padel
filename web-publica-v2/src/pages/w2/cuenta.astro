---
import W2Layout from '../../w2/layouts/W2Layout.astro';
import AuditoriaDeportiva from '../../w2/components/AuditoriaDeportiva.astro';
import '../../w2/styles/w2-account.css';
---
<W2Layout titulo="Mi cuenta W2" actual="cuenta">
<main class="w2a-page">
 <section id="w2AccountLoading" class="w2-container w2a-state"><span></span><p><b>Preparando tu centro personal</b><small>Conectando cuenta, reservas e identidad deportiva.</small></p></section>
 <section id="w2AccountGuest" class="w2-container w2a-guest hidden"><p class="w2-kicker">Centro privado</p><h1>Tu actividad,<br/><strong>en un solo lugar.</strong></h1><p>Ingresá para consultar reservas, datos, seguridad y evolución deportiva.</p><button id="w2AccountLogin" class="w2-button primary" type="button">Ingresar o crear cuenta</button><a href="/w2">Volver al inicio →</a></section>
 <div id="w2AccountContent" class="hidden">
  <section class="w2a-hero"><div class="w2-container w2a-hero-grid"><div class="w2a-identity"><span id="w2aAvatar">PR</span><div><p class="w2-kicker">Centro personal W2</p><h1 id="w2aName">Mi cuenta</h1><p id="w2aEmail">Sesión protegida</p></div></div><aside><span><small>PRÓXIMAS</small><b id="w2aNextCount">0</b></span><span><small>HISTORIAL</small><b id="w2aHistoryCount">0</b></span><span><small>POSICIÓN</small><b id="w2aPosition">—</b></span></aside></div></section>
  <div class="w2-container w2a-shell">
   <aside class="w2a-nav" aria-label="Secciones de Mi cuenta"><p>TU CUENTA</p><a href="?seccion=resumen" data-account-section="resumen"><i>01</i><span><b>Resumen</b><small>Actividad y próximos pasos</small></span></a><a href="?seccion=reservas" data-account-section="reservas"><i>02</i><span><b>Reservas</b><small>Próximas e historial</small></span></a><a href="?seccion=datos" data-account-section="datos"><i>03</i><span><b>Datos personales</b><small>Contacto y preferencias</small></span></a><a href="?seccion=seguridad" data-account-section="seguridad"><i>04</i><span><b>Seguridad</b><small>Contraseña de acceso</small></span></a><a href="?seccion=deporte" data-account-section="deporte"><i>05</i><span><b>Perfil deportivo</b><small>Categoría, ranking e historial</small></span></a>
   </aside>
   <section class="w2a-content">
    <div id="w2aSectionNav" class="w2a-mobile-nav"><span>SECCIÓN ACTUAL</span><button id="w2aSectionTrigger" type="button" aria-expanded="false" aria-controls="w2aSectionList"><b id="w2aSectionLabel">Resumen</b><i aria-hidden="true"></i></button><div id="w2aSectionList" class="w2a-section-list hidden" role="listbox" aria-label="Secciones de Mi cuenta"><button type="button" role="option" data-mobile-section="resumen" aria-selected="true"><i>01</i><span><b>Resumen</b><small>Actividad y próximos pasos</small></span><em>✓</em></button><button type="button" role="option" data-mobile-section="reservas" aria-selected="false"><i>02</i><span><b>Reservas</b><small>Próximas e historial</small></span><em>✓</em></button><button type="button" role="option" data-mobile-section="datos" aria-selected="false"><i>03</i><span><b>Datos personales</b><small>Contacto y preferencias</small></span><em>✓</em></button><button type="button" role="option" data-mobile-section="seguridad" aria-selected="false"><i>04</i><span><b>Seguridad</b><small>Contraseña de acceso</small></span><em>✓</em></button><button type="button" role="option" data-mobile-section="deporte" aria-selected="false"><i>05</i><span><b>Perfil deportivo</b><small>Categoría, ranking e historial</small></span><em>✓</em></button></div></div>
    <section data-account-panel="resumen"><header class="w2a-heading"><div><p class="w2-kicker">Hoy en tu cuenta</p><h2>Todo listo para<br/><strong>tu próxima jugada.</strong></h2></div><a href="/w2/reservar">Reservar cancha →</a></header><div class="w2a-grid"><article id="w2aNext" class="w2a-card featured"></article><article class="w2a-card"><p class="w2-kicker">Actividad</p><h3>Tu recorrido en el club</h3><div id="w2aMetrics" class="w2a-metrics"></div></article><article class="w2a-card sport"><p class="w2-kicker">Identidad deportiva</p><h3 id="w2aSportTitle">Perfil W2</h3><p id="w2aSportText">Tu posición preferida y tu actividad competitiva viven en una identidad deportiva única.</p><a href="?seccion=deporte">Ver identidad deportiva <span>→</span></a></article><article class="w2a-card actions"><p class="w2-kicker">Accesos rápidos</p><a href="?seccion=reservas"><i aria-hidden="true">R</i><span><b>Mis reservas</b><small>Estados, pagos e historial</small></span><em>→</em></a><a href="?seccion=datos"><i aria-hidden="true">D</i><span><b>Mis datos</b><small>Contacto y preferencias</small></span><em>→</em></a><a href="?seccion=seguridad"><i aria-hidden="true">S</i><span><b>Seguridad</b><small>Actualizar contraseña</small></span><em>→</em></a></article></div></section>
    <section data-account-panel="reservas" class="hidden w2r-section"><header class="w2r-head"><div><p class="w2-kicker">Reservas W2</p><h2>Tu agenda,<br/><strong>bajo control.</strong></h2><p id="w2rSummary">Consultando tu actividad…</p></div><a class="w2-button primary" href="/w2/reservar">Reservar cancha</a></header><div id="w2rMetrics" class="w2r-metrics"></div><div class="w2r-switch"><div role="tablist" aria-label="Vistas de reservas"><button type="button" role="tab" data-w2r-tab="proximas" aria-selected="true">Próximas <b id="w2rUpcomingCount">0</b></button><button type="button" role="tab" data-w2r-tab="historial" aria-selected="false">Historial <b id="w2rHistoryCount">0</b></button></div><div class="w2r-update"><span id="w2rUpdated">Actualizando…</span><button id="w2rRefresh" type="button">Actualizar <i aria-hidden="true">↻</i></button></div></div><div id="w2rFilters" class="hidden w2r-filters"><div class="w2r-filter-state"><span>Estado</span><button id="w2rStatusTrigger" type="button" aria-expanded="false" aria-controls="w2rStatusMenu"><b id="w2rStatusLabel">Todos los estados</b><i></i></button><div id="w2rStatusMenu" class="hidden" role="listbox" aria-label="Filtrar historial por estado"></div></div><label class="w2r-search"><span>Buscar cancha</span><div><i aria-hidden="true"></i><input id="w2rSearch" type="search" placeholder="Nombre de la cancha"/><button id="w2rSearchClear" class="hidden" type="button" aria-label="Limpiar búsqueda">×</button></div></label><button id="w2rClear" class="hidden" type="button">Limpiar filtros</button><p id="w2rResultText"><b id="w2rResults">0</b> resultados</p><div id="w2rChips" class="hidden w2r-chips"></div></div><div id="w2rList" class="w2r-list" aria-live="polite"></div><div id="w2rMore" class="hidden w2r-more"><button type="button">Mostrar más</button><span></span></div><details class="w2r-lookup"><summary><span><b>¿No encontrás una reserva?</b><small>Consultá un código que no figure en tu cuenta.</small></span><strong>Consultar mediante código <i></i></strong></summary><form id="w2rLookupForm" novalidate><label><span>Código de seguimiento</span><input id="w2rCode" autocomplete="off" spellcheck="false" placeholder="Pegá el código completo"/><small>Lo encontrás en la confirmación que recibiste al reservar.</small></label><button id="w2rLookupSubmit" type="submit">Consultar</button><small id="w2rCodeError"></small></form><div id="w2rLookupResult"></div></details></section>
    <section data-account-panel="datos" class="hidden w2a-coming"><p class="w2-kicker">Datos personales</p><h2>Tu identidad y contacto</h2><p>Mientras trasladamos la edición completa al nuevo centro, tus datos continúan disponibles sin pérdida funcional.</p><a class="w2-button primary" href="/mis-datos">Abrir edición actual</a></section>
    <section data-account-panel="seguridad" class="hidden w2a-coming"><p class="w2-kicker">Seguridad</p><h2>Protegé tu acceso</h2><p>El cambio de contraseña seguirá disponible en la pantalla actual hasta integrarse aquí con paridad completa.</p><a class="w2-button primary" href="/mis-datos">Administrar contraseña</a></section>
    <section data-account-panel="deporte" class="hidden w2d-section"><div id="w2dLoading" class="w2d-state"><b>Preparando tu perfil deportivo</b><span>Conectando categoría, puntos y trayectoria oficial.</span></div><div id="w2dEmpty" class="hidden w2d-state"><p class="w2-kicker">Identidad deportiva</p><h2>Tu perfil todavía no está vinculado</h2><p>Cuando tu identidad deportiva quede asociada a la cuenta, acá vas a encontrar categoría, ranking e historial sin ingresar ningún identificador.</p><a class="w2-button" href="/w2/rankings">Explorar rankings</a></div><div id="w2dContent" class="hidden"><header class="w2d-hero"><div class="w2d-person"><span id="w2dAvatar">PJ</span><div><p class="w2-kicker">Mi perfil deportivo</p><h2 id="w2dName">Jugador</h2><p><b id="w2dPosition">Flexible</b><em id="w2dCategory">Sin categoría</em></p></div></div><div class="w2d-actions"><a id="w2dPublicProfile" href="/w2/jugador">Ver mi perfil público</a><a id="w2dPointsDetail" class="primary" href="/w2/rankings">Cómo se forman mis puntos</a></div></header><div id="w2dReadyNotice" class="w2d-ready hidden" role="status"><span aria-hidden="true">✓</span><div><b>Tu identidad deportiva ya está lista</b><p>El puesto, los puntos y la efectividad se calcularán automáticamente cuando se publiquen tus primeros resultados oficiales.</p></div></div><section class="w2d-score"><article><small>PUESTO ACTUAL</small><strong id="w2dRank">—</strong><span id="w2dRankHelp">Sin posición publicada</span></article><article><small>PUNTOS PUBLICADOS</small><strong id="w2dPoints">0</strong><span>Resultados + extra por instancia</span></article><article><small>EFECTIVIDAD</small><strong id="w2dEffectiveness">0%</strong><span id="w2dRecord">Sin partidos oficiales</span></article><article><small>PARTIDOS OFICIALES</small><strong id="w2dMatches">0</strong><span>Incluidos en tu trayectoria</span></article></section><div class="w2d-grid"><main><section class="w2d-card"><header><div><p class="w2-kicker">Actividad reciente</p><h3>Últimos partidos oficiales</h3></div><span id="w2dHistoryCount">0 partidos</span></header><div id="w2dMatchesList" class="w2d-matches"></div><div id="w2dMatchesEmpty" class="w2d-empty-state hidden"><span aria-hidden="true">◇</span><div><b>Tu actividad aparecerá acá</b><p>Cuando se publiquen tus primeros resultados oficiales, vas a ver cada partido, torneo e instancia en este espacio.</p><a href="/w2/torneos">Explorar torneos →</a></div></div></section></main><aside><section class="w2d-card"><p class="w2-kicker">Recorrido deportivo</p><h3>Historial de categorías</h3><ol id="w2dCategories" aria-label="Historial de categorías"></ol><p id="w2dCategoriesEmpty" class="w2d-empty hidden">Todavía no hay movimientos de categoría.</p></section><section class="w2d-card"><p class="w2-kicker">Comunidad deportiva</p><h3>Tu disponibilidad</h3><ul class="w2d-flags"><li id="w2dAvailable">No disponible para jugar</li><li id="w2dInvites">No acepta invitaciones</li></ul><p>Estos estados preparan tu identidad para las futuras convocatorias de Comunidad.</p></section></aside></div></div></section>
   </section>
  </div>
 </div>
<AuditoriaDeportiva/>
<div id="w2rDetailBackdrop" class="hidden w2r-detail-backdrop"></div><aside id="w2rDetail" class="hidden w2r-detail" role="dialog" aria-modal="true" aria-labelledby="w2rDetailTitle" tabindex="-1"><button id="w2rDetailClose" type="button" aria-label="Cerrar detalle">×</button><div id="w2rDetailBody"></div></aside></main><script>import '../../w2/scripts/cuenta';</script>
<style>
.w2d-section{min-width:0}.w2d-state{min-height:28rem;display:grid;place-content:center;gap:.45rem;text-align:center;border:1px solid #2b373d;border-radius:22px;background:#10161a;padding:2rem}.w2d-state b,.w2d-state h2{color:#f3f5f3}.w2d-state span,.w2d-state p{color:#8fa39a}.w2d-hero{display:flex;align-items:center;justify-content:space-between;gap:1.2rem;padding:1.4rem;border:1px solid #2b373d;border-radius:22px;background:linear-gradient(145deg,#131a1e,#0c1114)}.w2d-person{display:flex;align-items:center;gap:1rem}.w2d-person>span{display:grid;place-items:center;width:4.4rem;height:4.4rem;border:1px solid #d7ad4a;border-radius:18px;background:#2a2315;color:#f0d98a;font-weight:900;font-size:1.1rem}.w2d-person h2{margin:.2rem 0;font-size:clamp(1.7rem,3vw,2.8rem)}.w2d-person p:last-child{display:flex;gap:.45rem;flex-wrap:wrap}.w2d-person p b,.w2d-person p em{padding:.28rem .58rem;border:1px solid #334047;border-radius:999px;color:#aebdb6;font-size:.65rem;font-style:normal}.w2d-actions{display:flex;gap:.55rem;flex-wrap:wrap;justify-content:flex-end}.w2d-actions a{display:inline-flex;align-items:center;justify-content:center;min-height:2.8rem;padding:.65rem .9rem;border:1px solid #36444a;border-radius:12px;color:#c7d2cd;font-weight:850;font-size:.72rem}.w2d-actions a.primary{border-color:#d7ad4a;color:#f0d98a;background:rgba(215,173,74,.09)}.w2d-score{display:grid;grid-template-columns:repeat(4,1fr);gap:.7rem;margin:1rem 0}.w2d-score article,.w2d-card{border:1px solid #2b373d;border-radius:18px;background:#0f1518;padding:1rem}.w2d-score small{color:#71857b;font-size:.62rem;font-weight:900}.w2d-score strong{display:block;margin:.35rem 0;color:#fff;font-size:1.7rem}.w2d-score span{color:#7f9289;font-size:.67rem}.w2d-grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(17rem,.75fr);gap:1rem}.w2d-grid aside{display:grid;gap:1rem;align-content:start}.w2d-card>header{display:flex;justify-content:space-between;gap:1rem;align-items:end;margin-bottom:.8rem}.w2d-card h3{margin:.2rem 0 0}.w2d-card>header>span{color:#74887e;font-size:.68rem}.w2d-matches{display:grid;gap:.55rem}.w2d-match{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:.75rem;align-items:center;padding:.8rem;border:1px solid #29353b;border-radius:13px;background:#0a0f12}.w2d-match>span{min-width:4.7rem;padding:.34rem .5rem;border-radius:999px;background:#2b181a;color:#e78d97;text-align:center;font-size:.61rem;font-weight:900}.w2d-match>span.win{background:#11281e;color:#79d6a5}.w2d-match b{display:block}.w2d-match p{margin:.22rem 0 0;color:#7f9289;font-size:.68rem}.w2d-match time{color:#82968c;font-size:.66rem}.w2d-card ol{list-style:none;display:grid;gap:.5rem;margin:1rem 0 0;padding:0}.w2d-card ol li{display:flex;justify-content:space-between;gap:.7rem;padding:.7rem;border-left:2px solid #39474d;background:#0a1013;color:#879a90}.w2d-card ol li.active{border-left-color:#69d5a0;color:#cfdbd5}.w2d-card ol span{font-size:.65rem}.w2d-flags{list-style:none;display:grid;gap:.5rem;margin:1rem 0;padding:0}.w2d-flags li{padding:.65rem;border:1px solid #303c42;border-radius:11px;color:#778a80;font-size:.7rem}.w2d-flags li.active{border-color:rgba(105,213,160,.4);background:rgba(105,213,160,.07);color:#8edfb3}.w2d-card>p:last-child,.w2d-empty{color:#7d9087;font-size:.7rem;line-height:1.5}
@media(max-width:900px){.w2d-hero{align-items:flex-start;flex-direction:column}.w2d-actions{width:100%;justify-content:stretch}.w2d-actions a{flex:1}.w2d-score{grid-template-columns:repeat(2,1fr)}.w2d-grid{grid-template-columns:1fr}.w2d-match{grid-template-columns:auto minmax(0,1fr)}.w2d-match time{grid-column:2}}
@media(max-width:520px){.w2d-score{grid-template-columns:1fr 1fr}.w2d-score article{padding:.8rem}.w2d-person>span{width:3.7rem;height:3.7rem}.w2d-actions{flex-direction:column}.w2d-match{grid-template-columns:1fr}.w2d-match time{grid-column:auto}}

/* R1.4D - cierre premium del centro deportivo */
.w2d-ready{display:flex;align-items:flex-start;gap:.85rem;margin:1rem 0;padding:1rem 1.1rem;border:1px solid rgba(105,213,160,.32);border-radius:16px;background:linear-gradient(135deg,rgba(105,213,160,.09),rgba(15,21,24,.96))}.w2d-ready>span{display:grid;place-items:center;flex:0 0 auto;width:2rem;height:2rem;border-radius:50%;background:rgba(105,213,160,.15);color:#8fe0b4;font-weight:900}.w2d-ready b{color:#dce7e1;font-size:.82rem}.w2d-ready p{margin:.3rem 0 0;color:#82968c;font-size:.7rem;line-height:1.5}.w2d-empty-state{display:flex;align-items:center;gap:1rem;min-height:8.5rem;padding:1rem;border:1px dashed #334148;border-radius:14px;background:linear-gradient(135deg,#0b1114,#0e1518)}.w2d-empty-state>span{display:grid;place-items:center;flex:0 0 auto;width:3.2rem;height:3.2rem;border:1px solid #3b494f;border-radius:14px;color:#d7ad4a;background:#17170f;font-size:1.4rem}.w2d-empty-state b{color:#e8ece9}.w2d-empty-state p{max-width:40rem;margin:.3rem 0;color:#81948b;font-size:.7rem;line-height:1.5}.w2d-empty-state a{display:inline-flex;margin-top:.25rem;color:#f0d98a;font-size:.67rem;font-weight:850}.w2d-card ol li{align-items:center;min-width:0}.w2d-card ol li>b{display:flex;align-items:center;gap:.45rem;min-width:4rem;color:#e7ece9}.w2d-card ol li.active>b::after{content:'VIGENTE';padding:.18rem .38rem;border:1px solid rgba(105,213,160,.36);border-radius:999px;background:rgba(105,213,160,.08);color:#8fe0b4;font-size:.52rem;letter-spacing:.06em}.w2d-card ol li>span{min-width:0;text-align:right;white-space:normal;line-height:1.35}.w2d-score strong{font-variant-numeric:tabular-nums}.w2d-actions a{transition:border-color .18s ease,background .18s ease,color .18s ease,transform .18s ease}.w2d-actions a:hover,.w2d-actions a:focus-visible{transform:translateY(-1px);outline:none;border-color:#66777f;color:#fff}.w2d-actions a.primary:hover,.w2d-actions a.primary:focus-visible{border-color:#f0d98a;background:rgba(215,173,74,.15);color:#fff4c6}
body:has([data-account-panel="deporte"]:not(.hidden)) .w2a-hero{padding-block:2.1rem!important}body:has([data-account-panel="deporte"]:not(.hidden)) .w2a-hero-grid{min-height:auto!important}body:has([data-account-panel="deporte"]:not(.hidden)) .w2a-identity>span{width:4.2rem!important;height:4.2rem!important}body:has([data-account-panel="deporte"]:not(.hidden)) .w2a-identity h1{font-size:clamp(2.6rem,5vw,4.2rem)!important}
/* R1.4D fix - estados y separacion movil */
@media(max-width:900px){.w2d-card ol li{align-items:flex-start;flex-direction:column;gap:.55rem}.w2d-card ol li>span{text-align:left}.w2d-empty-state{align-items:flex-start}.w2d-ready{margin-top:.8rem}}
@media(max-width:520px){.w2d-empty-state{flex-direction:column;min-height:0}.w2d-ready{padding:.85rem}.w2d-card ol li.active>b::after{font-size:.48rem}}


/* R1.4D fix definitivo - historial de categorias */
.w2d-card ol li{display:grid!important;grid-template-columns:minmax(7rem,auto) minmax(0,1fr)!important;align-items:center!important;column-gap:1rem!important;row-gap:.45rem!important}.w2d-category-head{display:flex;align-items:center;gap:.45rem;min-width:0}.w2d-category-head b{color:#e7ece9}.w2d-category-head em{padding:.18rem .38rem;border:1px solid rgba(105,213,160,.36);border-radius:999px;background:rgba(105,213,160,.08);color:#8fe0b4;font-size:.52rem;font-style:normal;font-weight:900;letter-spacing:.06em}.w2d-card ol li.active>b::after,.w2d-card ol li.active .w2d-category-head>b::after{content:none!important}.w2d-card ol li>span{min-width:0!important;text-align:right!important;line-height:1.4!important}
@media(max-width:900px){.w2d-card ol li{grid-template-columns:1fr!important;align-items:start!important;row-gap:.65rem!important}.w2d-card ol li>span{text-align:left!important;display:block!important}.w2d-category-head{width:100%;flex-wrap:wrap}}


/* R1.4D cierre final - categorias apiladas */
.w2d-card ol li{grid-template-columns:minmax(0,1fr)!important;align-items:start!important;row-gap:.75rem!important}.w2d-card ol li>span{display:block!important;text-align:left!important;color:#82968c!important}.w2d-category-head{width:100%;justify-content:space-between}.w2d-category-head b{font-size:.94rem}.w2d-category-head em{flex:0 0 auto}
@media(max-width:900px){.w2d-card ol li{row-gap:.75rem!important}}


/* R1.4E - estilos globales para contenido dinamico */
:global(#w2dCategories li){display:grid;grid-template-columns:minmax(0,1fr);align-items:start;gap:.72rem;padding:.82rem .9rem;border-left:2px solid #39474d;border-radius:0 12px 12px 0;background:#0a1013;color:#879a90}
:global(#w2dCategories li.active){border-left-color:#69d5a0;color:#cfdbd5}
:global(.w2d-category-head){display:flex;align-items:center;justify-content:space-between;gap:.75rem;min-width:0;width:100%}
:global(.w2d-category-head b){color:#e7ece9;font-size:.94rem;line-height:1.2}
:global(.w2d-category-head em){display:inline-flex;align-items:center;flex:0 0 auto;padding:.2rem .46rem;border:1px solid rgba(105,213,160,.42);border-radius:999px;background:rgba(105,213,160,.1);color:#8fe0b4;font-size:.52rem;font-style:normal;font-weight:900;letter-spacing:.07em;line-height:1.2}
:global(#w2dCategories li>span){display:block;color:#82968c;font-size:.66rem;line-height:1.45;text-align:left}
@media(max-width:520px){:global(#w2dCategories li){gap:.65rem;padding:.75rem}:global(.w2d-category-head){gap:.55rem;flex-wrap:wrap}}

</style>
</W2Layout>