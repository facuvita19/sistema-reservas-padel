--- import W2Layout from '../../w2/layouts/W2Layout.astro'; const slots=[['18:00','Central','$28.000'],['19:30','Central','$28.000'],['20:00','Norte','$25.000'],['21:00','Panorámica','$30.000'],['22:30','Central','$28.000']]; ---
<W2Layout titulo="Reserva inteligente W2" actual="reservar"><section class="w2-page-hero reserve"><div class="w2-container"><p class="w2-kicker">Reserva inteligente</p><h1>Encontrá tu mejor<br/><strong>momento para jugar.</strong></h1><p>Compará canchas y horarios sin avanzar pantalla por pantalla.</p></div></section><section class="w2-container w2-booking"><main><div class="w2-booking-filters"><label>Fecha<input type="date" value="2026-10-14"/></label><label>Franja<select><option>Tarde y noche</option><option>Mañana</option></select></label><label>Duración<select><option>90 minutos</option></select></label></div><div class="w2-heading compact"><div><p class="w2-kicker">Miércoles 14 de octubre</p><h2>5 turnos disponibles</h2></div></div><div class="w2-slot-grid">{slots.map(([time,court,price],i)=><button class:list={['w2-slot',i===1&&'recommended']} data-w2-slot data-time={time} data-court={court} data-price={price}><small>{i===1?'Recomendado':'Disponible'}</small><strong>{time}</strong><span>{court}</span><b>{price}</b></button>)}</div><section class="w2-card alternatives"><p class="w2-kicker">También podría servirte</p><h3>Alternativas cercanas</h3><p>Jueves 15 · 18:30 en Cancha Norte · $25.000</p></section></main><aside class="w2-booking-summary"><p class="w2-kicker">Tu selección</p><h2>Resumen</h2><div id="w2Summary"><span>Elegí un turno para ver sus detalles.</span></div><button id="w2Continue" disabled>Continuar en reserva real</button><small>Este prototipo no crea solicitudes ni procesa pagos.</small></aside></section><script>
const slotButtons=[...document.querySelectorAll<HTMLButtonElement>('[data-w2-slot]')];
const bookingSummary=document.querySelector<HTMLElement>('#w2Summary');
const continueButton=document.querySelector<HTMLButtonElement>('#w2Continue');
slotButtons.forEach(button=>button.addEventListener('click',()=>{
 slotButtons.forEach(item=>item.classList.remove('selected'));
 button.classList.add('selected');
 const time=button.dataset.time??'';
 const court=button.dataset.court??'';
 const price=button.dataset.price??'';
 if(bookingSummary)bookingSummary.innerHTML='<dl><div><dt>Fecha</dt><dd>14/10/2026</dd></div><div><dt>Horario</dt><dd>'+time+'</dd></div><div><dt>Cancha</dt><dd>'+court+'</dd></div><div><dt>Total</dt><dd>'+price+'</dd></div><div><dt>Seña estimada</dt><dd>$7.000</dd></div></dl>';
 if(continueButton){
  continueButton.disabled=false;
  continueButton.onclick=()=>{location.href='/reservar?fecha=2026-10-14&hora='+encodeURIComponent(time)};
 }
}));
</script></W2Layout>