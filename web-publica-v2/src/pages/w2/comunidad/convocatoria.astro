---
import W2Layout from '../../../w2/layouts/W2Layout.astro';
import '../../../w2/styles/w2-convocatoria.css';
---
<W2Layout titulo="Convocatoria | Pádel Las Flores" actual="comunidad">
<div class="w2cv-page"><section id="w2cvLoading" class="w2cv-state"><b>Consultando convocatoria…</b></section><section id="w2cvError" class="w2cv-state hidden" role="alert"><h1>No pudimos abrir esta convocatoria</h1><p id="w2cvErrorText"></p><a href="/w2/comunidad?vista=TURNOS">Volver a Turnos abiertos</a></section><article id="w2cvContent" class="w2cv-card hidden"><a class="w2cv-back" href="/w2/comunidad?vista=TURNOS">← Turnos abiertos</a><header><p>CONVOCATORIA DE COMUNIDAD</p><h1 id="w2cvTitle">Turno abierto</h1><span id="w2cvStatus"></span></header><div class="w2cv-grid"><section><small>FECHA Y HORARIO</small><b id="w2cvDate"></b><span id="w2cvTime"></span></section><section><small>CANCHA</small><b id="w2cvCourt"></b></section><section><small>CUPO</small><b id="w2cvQuota"></b><span id="w2cvLevel"></span></section></div><blockquote id="w2cvComment" class="hidden"></blockquote><footer><div><span id="w2cvAvatar"></span><p><small>CONVOCA</small><b id="w2cvOwner"></b><em id="w2cvOwnerCategory"></em></p></div><a id="w2cvProfile">Ver perfil deportivo →</a></footer><section id="w2cvAction" class="w2cv-action"><p id="w2cvActionText" aria-live="polite"></p><textarea id="w2cvMessage" maxlength="300" rows="3" placeholder="Podés agregar un mensaje breve."></textarea><button id="w2cvSubmit" type="button">Solicitar unirme</button><button id="w2cvLogin" class="hidden" type="button">Ingresar para solicitar</button><button id="w2cvWithdraw" class="hidden" type="button">Retirar solicitud</button></section></article></div><script>import '../../../w2/scripts/convocatoria-comunidad';</script>
</W2Layout>
