---
import LayoutPrincipal from '../layouts/LayoutPrincipal.astro';
---
<LayoutPrincipal titulo="Página no encontrada | Pádel Reservas" descripcion="La página solicitada no existe o cambió de ubicación." actual="inicio" indexable={false}>
  <main class="error-page container-site" aria-labelledby="error-page-title">
    <div class="error-page-content">
      <p class="site-kicker">Error 404</p>
      <h1 id="error-page-title">Esta pelota quedó fuera.</h1>
      <p>La dirección no existe o fue movida. Volvé al inicio, consultá disponibilidad o explorá los torneos del club.</p>
      <nav class="error-page-actions" aria-label="Opciones para continuar">
        <a class="btn btn-primary" href="/">Volver al inicio</a>
        <a class="btn btn-secondary" href="/reservar">Reservar cancha</a>
        <a class="btn btn-secondary" href="/w2/torneos">Ver torneos</a>
      </nav>
    </div>
  </main>
</LayoutPrincipal>
