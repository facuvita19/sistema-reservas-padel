---
import LayoutPrincipal from '../layouts/LayoutPrincipal.astro';
import ModalInscripcionTorneo from '../components/ModalInscripcionTorneo.astro';
import ModalCuadroTorneo from '../components/ModalCuadroTorneo.astro';

---
<LayoutPrincipal titulo="Torneos | Pádel Reservas" actual="torneos">
  <section class="tournaments-hero"><div class="container-site tournaments-hero-grid"><div><p class="site-kicker">Competencia pública</p><h1>Viví cada etapa del torneo</h1><p>Inscribí tu pareja, seguí los grupos, consultá posiciones y recorré el cuadro eliminatorio desde un único lugar.</p></div><div class="tournaments-hero-flow"><span><b>01</b> Inscripción</span><span><b>02</b> Grupos</span><span><b>03</b> Eliminatorias</span></div></div></section>
  <section class="container-site tournaments-shell">
    <div id="resumenTorneos" class="tournaments-metrics hidden"></div>
    <div class="tournaments-heading"><div><p class="site-kicker">Calendario competitivo</p><h2>Torneos publicados</h2></div><p>La información se actualiza con los resultados y la programación registrada por la organización.</p></div>
    <div id="listaTorneos" class="tournaments-list"></div>
  </section>
  <ModalInscripcionTorneo />
  <ModalCuadroTorneo />

  <script>
    import '../scripts/torneos';
  </script>
</LayoutPrincipal>