---
import '../styles/w2.css';
import '../styles/w2-header-authoritative.css';
import '../styles/w2-notifications.css';
import '../styles/w2-auth.css';
import '../styles/w2-command-header.css';
import '../styles/w2-account-menu.css';
import '../styles/w2-mobile-navigation.css';
import '../styles/w2-ui-unification.css';
import '../styles/w2-route-transitions.css';
import W2Header from '../components/W2Header.astro';
import W2ThemeScript from '../components/W2ThemeScript.astro';
import ModalAutenticacion from '../../components/ModalAutenticacion.astro';
interface Props { titulo:string; actual?:'inicio'|'reservar'|'torneos'|'rankings'|'comunidad'|'jugador'|'cuenta'; }
const {titulo,actual='inicio'}=Astro.props;
---
<!doctype html><html lang="es-AR" data-logout-redirect="/w2"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><W2ThemeScript/><style is:inline data-w2-no-geometry-transition>.w2-header .w2-nav,.w2-header .w2-links{transition:none!important;animation:none!important;will-change:auto!important}.w2-header .w2-nav{contain:layout style!important}</style><style is:inline data-w2-viewport-center>.w2-header .w2-nav{width:min(var(--w2-max),calc(100vw - 40px));margin-left:50vw;margin-right:0;transform:translateX(-50%)}@media(max-width:650px){.w2-header .w2-nav{width:min(var(--w2-max),calc(100vw - 24px))}}</style><style is:inline data-w2-shell-grid-critical>@media(min-width:1101px){.w2-nav{display:grid;grid-template-columns:142px minmax(0,1fr) 42px 42px 125px 132px;align-items:center;column-gap:16px}.w2-brand{grid-column:1}.w2-links{grid-column:2;justify-self:center;margin:0}.w2-theme-toggle{grid-column:3;margin:0}.w2-cta{grid-column:5;margin:0;width:125px;min-width:125px}.w2-notifications{grid-column:4;grid-row:1;width:42px;min-width:42px;margin:0;order:initial}.w2-auth-slot{grid-column:6;grid-row:1;width:132px;min-width:132px;margin:0;order:initial}}</style><style is:inline data-w2-logo-picture>.w2-brand-picture{display:block;width:100%;height:100%}.w2-brand-picture>img{display:block;width:100%;height:100%;object-fit:contain}.w2-logo-light{display:none}html[data-w2-theme="light"] .w2-logo-dark{display:none!important}html[data-w2-theme="light"] .w2-logo-light{display:block!important}</style><style is:inline data-w2-first-frame-critical>.w2-theme-toggle{box-sizing:border-box;display:grid;width:42px;height:42px;min-width:42px;max-width:42px;min-height:42px;max-height:42px;flex:0 0 42px;place-items:center;aspect-ratio:1/1;border-radius:999px;padding:0;overflow:hidden}.w2-theme-sun,.w2-theme-moon{grid-area:1/1;width:20px;height:20px}.w2-theme-sun{display:block!important}.w2-theme-moon{display:none!important}html[data-w2-theme="light"] .w2-theme-sun{display:none!important}html[data-w2-theme="light"] .w2-theme-moon{display:block!important}.w2-a11y-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}@media(min-width:901px){.w2-auth-slot,.w2-account-trigger,.w2-session-check,.w2-login{box-sizing:border-box;min-width:132px;width:132px}.w2-notifications{box-sizing:border-box;width:42px;min-width:42px}}</style><script is:inline>try{const raw=sessionStorage.getItem('padel.sesion.snapshot.v1');if(raw){const s=JSON.parse(raw),vence=s?.vencimiento?Date.parse(s.vencimiento):NaN;if(s?.autenticado&&s?.perfil&&(!Number.isFinite(vence)||vence>Date.now()))document.documentElement.dataset.session='authenticated';else sessionStorage.removeItem('padel.sesion.snapshot.v1')}}catch{try{sessionStorage.removeItem('padel.sesion.snapshot.v1')}catch{}}</script><meta name="theme-color" content="#07100d"/><meta name="application-name" content="Plataforma Deportiva W2"/><meta name="mobile-web-app-capable" content="yes"/><meta name="apple-mobile-web-app-capable" content="yes"/><meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/><link rel="manifest" href="/w2/manifest.webmanifest"/><link rel="icon" href="/w2/padel-las-flores.svg" type="image/svg+xml"/><link rel="apple-touch-icon" sizes="192x192" href="/w2/icons/icon-192.png"/><link rel="stylesheet" href="/w2/pwa-status.css?v=4"/><script src="/w2/pwa-register.js?v=4" defer></script><title>{titulo}</title></head><body class="w2-body" data-w2-route-shell><aside id="w2PwaStatus" class="w2-pwa-status hidden" role="status" aria-live="polite" aria-atomic="true"><span id="w2PwaMessage"></span><button id="w2PwaUpdate" class="hidden" type="button">Actualizar ahora</button><button id="w2PwaInstall" class="hidden" type="button">Instalar W2</button><button id="w2PwaIos" class="hidden secondary" type="button" aria-label="Cómo instalar W2 en iPhone o iPad">Ver indicación</button><button id="w2PwaDismiss" class="secondary" type="button" aria-label="Cerrar aviso">Cerrar</button></aside><a class="w2-skip" href="#w2-content">Saltar al contenido</a><W2Header actual={actual}/><main id="w2-content" tabindex="-1" data-w2-route-content><slot/></main><footer class="w2-footer" data-w2-route-footer><div class="w2-container"><strong>Pádel Las Flores</strong><span>Plataforma deportiva conectada con resultados oficiales y datos auditables.</span><a href="/">Volver al sitio principal</a></div></footer><ModalAutenticacion/><script>
import { estadoSesion } from '../../scripts/sesion-global';
import '../../scripts/autenticacion';
import '../../scripts/menu-cuenta-global';
import '../scripts/notificaciones';

import { cargarComplejo } from '../../scripts/configuracion-publica';
cargarComplejo().catch(()=>{});
const w2Header=document.querySelector<HTMLElement>('[data-w2-header]');
const syncW2Header=()=>{if(!w2Header)return;const compact=scrollY>28;w2Header.classList.toggle('is-compact',compact);const mobile=matchMedia('(max-width:900px)').matches,stableHeight=mobile?81:94;document.documentElement.style.setProperty('--w2-header-height',stableHeight+'px');document.documentElement.style.setProperty('--w2-header-bottom',(stableHeight+8)+'px')};
let w2HeaderFrame=0;addEventListener('scroll',()=>{if(w2HeaderFrame)return;w2HeaderFrame=requestAnimationFrame(()=>{syncW2Header();w2HeaderFrame=0})},{passive:true});addEventListener('resize',syncW2Header,{passive:true});if(w2Header)new ResizeObserver(syncW2Header).observe(w2Header);syncW2Header();
const menuButton=document.querySelector<HTMLButtonElement>('[data-w2-menu]');const menuPanel=document.querySelector<HTMLElement>('#w2Menu');const backdrop=document.querySelector<HTMLElement>('#w2MenuBackdrop');const closeButton=document.querySelector<HTMLButtonElement>('[data-w2-menu-close]');let focusBefore:HTMLElement|null=null;
if(backdrop&&backdrop.parentElement!==document.body)document.body.appendChild(backdrop);if(menuPanel&&menuPanel.parentElement!==document.body)document.body.appendChild(menuPanel);
function closeW2Menu(returnFocus=false){const focusInside=Boolean(menuPanel?.contains(document.activeElement));if(focusInside)menuButton?.focus({preventScroll:true});menuPanel?.setAttribute('inert','');menuPanel?.classList.remove('open');backdrop?.classList.remove('open');menuPanel?.setAttribute('aria-hidden','true');menuButton?.setAttribute('aria-expanded','false');document.body.classList.remove('w2-menu-open');document.documentElement.classList.remove('w2-menu-open');if(returnFocus&&!focusInside)focusBefore?.focus({preventScroll:true})}
function openW2Menu(){focusBefore=document.activeElement as HTMLElement;menuPanel?.removeAttribute('inert');menuPanel?.classList.add('open');backdrop?.classList.add('open');menuPanel?.setAttribute('aria-hidden','false');menuButton?.setAttribute('aria-expanded','true');document.body.classList.add('w2-menu-open');document.documentElement.classList.add('w2-menu-open');requestAnimationFrame(()=>closeButton?.focus())}
menuButton?.addEventListener('click',()=>menuPanel?.classList.contains('open')?closeW2Menu(true):openW2Menu());closeButton?.addEventListener('click',()=>closeW2Menu(true));backdrop?.addEventListener('click',()=>closeW2Menu(true));menuPanel?.querySelectorAll<HTMLAnchorElement>('a').forEach(link=>link.addEventListener('click',()=>closeW2Menu(false)));document.querySelector('#abrirAutenticacionMovil')?.addEventListener('click',()=>closeW2Menu(false));
document.addEventListener('keydown',event=>{if(event.key==='Escape'&&menuPanel?.classList.contains('open')){event.preventDefault();closeW2Menu(true)}if(event.key==='Tab'&&menuPanel?.classList.contains('open')){const f=[...menuPanel.querySelectorAll<HTMLElement>('a,button:not([disabled])')].filter(x=>x.offsetParent!==null);if(!f.length)return;if(event.shiftKey&&document.activeElement===f[0]){event.preventDefault();f.at(-1)?.focus()}else if(!event.shiftKey&&document.activeElement===f.at(-1)){event.preventDefault();f[0].focus()}}});
const syncSessionCheck=()=>{const check=document.querySelector<HTMLElement>('#w2SessionCheck'),state=estadoSesion();if(check)check.classList.toggle('hidden',!state.cargando&&!state.error)};syncSessionCheck();addEventListener('sesion-cliente-cambiada',(event:any)=>{syncSessionCheck();if(!event.detail?.autenticado)closeW2Menu(false)});addEventListener('sesion-cliente-error',()=>{const check=document.querySelector<HTMLElement>('#w2SessionCheck'),state=estadoSesion();if(!check)return;if(state.sesion?.autenticado){check.classList.add('hidden');return}check.classList.add('hidden')});
</script></body></html>
