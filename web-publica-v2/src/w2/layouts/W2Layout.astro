---
import '../styles/w2.css';
import '../styles/w2-auth.css';
import W2Header from '../components/W2Header.astro';
import W2ThemeScript from '../components/W2ThemeScript.astro';
import ModalAutenticacion from '../../components/ModalAutenticacion.astro';
interface Props { titulo:string; actual?:'inicio'|'reservar'|'torneos'|'rankings'|'comunidad'|'jugador'|'cuenta'; }
const {titulo,actual='inicio'}=Astro.props;
---
<!doctype html><html lang="es-AR" data-logout-redirect="/w2"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/><meta name="robots" content="noindex,nofollow"/><W2ThemeScript/><meta name="theme-color" content="#07100d"/><meta name="application-name" content="Plataforma Deportiva W2"/><meta name="mobile-web-app-capable" content="yes"/><meta name="apple-mobile-web-app-capable" content="yes"/><meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/><link rel="manifest" href="/w2/manifest.webmanifest"/><link rel="icon" href="/w2/padel-las-flores.svg" type="image/svg+xml"/><link rel="apple-touch-icon" sizes="192x192" href="/w2/icons/icon-192.png"/><link rel="stylesheet" href="/w2/pwa-status.css"/><script src="/w2/pwa-register.js" defer></script><title>{titulo}</title></head><body class="w2-body"><aside id="w2PwaStatus" class="w2-pwa-status hidden" role="status" aria-live="polite" aria-atomic="true"><span id="w2PwaMessage"></span><button id="w2PwaUpdate" class="hidden" type="button">Actualizar ahora</button><button id="w2PwaInstall" class="hidden" type="button">Instalar W2</button><button id="w2PwaIos" class="hidden secondary" type="button" aria-label="Cómo instalar W2 en iPhone o iPad">Ver indicación</button><button id="w2PwaDismiss" class="secondary" type="button" aria-label="Cerrar aviso">Cerrar</button></aside><a class="w2-skip" href="#w2-content">Saltar al contenido</a><W2Header actual={actual}/><main id="w2-content" tabindex="-1"><slot/></main><footer class="w2-footer"><div class="w2-container"><strong>Pádel Las Flores</strong><span>Plataforma deportiva conectada con resultados oficiales y datos auditables.</span><a href="/">Volver al sitio principal</a></div></footer><ModalAutenticacion/><script>
import { estadoSesion } from '../../scripts/sesion-global';
import '../../scripts/autenticacion';
import '../../scripts/menu-cuenta-global';
import '../scripts/notificaciones';
import { cargarComplejo } from '../../scripts/configuracion-publica';
cargarComplejo().catch(()=>{});
const menuButton=document.querySelector<HTMLButtonElement>('[data-w2-menu]');const menuPanel=document.querySelector<HTMLElement>('#w2Menu');const backdrop=document.querySelector<HTMLElement>('#w2MenuBackdrop');const closeButton=document.querySelector<HTMLButtonElement>('[data-w2-menu-close]');let focusBefore:HTMLElement|null=null;
if(backdrop&&backdrop.parentElement!==document.body)document.body.appendChild(backdrop);if(menuPanel&&menuPanel.parentElement!==document.body)document.body.appendChild(menuPanel);
function closeW2Menu(returnFocus=false){const focusInside=Boolean(menuPanel?.contains(document.activeElement));if(focusInside)menuButton?.focus({preventScroll:true});menuPanel?.setAttribute('inert','');menuPanel?.classList.remove('open');backdrop?.classList.remove('open');menuPanel?.setAttribute('aria-hidden','true');menuButton?.setAttribute('aria-expanded','false');document.body.classList.remove('w2-menu-open');document.documentElement.classList.remove('w2-menu-open');if(returnFocus&&!focusInside)focusBefore?.focus({preventScroll:true})}
function openW2Menu(){focusBefore=document.activeElement as HTMLElement;menuPanel?.removeAttribute('inert');menuPanel?.classList.add('open');backdrop?.classList.add('open');menuPanel?.setAttribute('aria-hidden','false');menuButton?.setAttribute('aria-expanded','true');document.body.classList.add('w2-menu-open');document.documentElement.classList.add('w2-menu-open');requestAnimationFrame(()=>closeButton?.focus())}
menuButton?.addEventListener('click',()=>menuPanel?.classList.contains('open')?closeW2Menu(true):openW2Menu());closeButton?.addEventListener('click',()=>closeW2Menu(true));backdrop?.addEventListener('click',()=>closeW2Menu(true));menuPanel?.querySelectorAll<HTMLAnchorElement>('a').forEach(link=>link.addEventListener('click',()=>closeW2Menu(false)));document.querySelector('#abrirAutenticacionMovil')?.addEventListener('click',()=>{closeW2Menu(false);(document.querySelector('#abrirAutenticacion') as HTMLButtonElement)?.click()});
document.addEventListener('keydown',event=>{if(event.key==='Escape'&&menuPanel?.classList.contains('open')){event.preventDefault();closeW2Menu(true)}if(event.key==='Tab'&&menuPanel?.classList.contains('open')){const f=[...menuPanel.querySelectorAll<HTMLElement>('a,button:not([disabled])')].filter(x=>x.offsetParent!==null);if(!f.length)return;if(event.shiftKey&&document.activeElement===f[0]){event.preventDefault();f.at(-1)?.focus()}else if(!event.shiftKey&&document.activeElement===f.at(-1)){event.preventDefault();f[0].focus()}}});
const syncSessionCheck=()=>{const check=document.querySelector<HTMLElement>('#w2SessionCheck'),state=estadoSesion();if(check)check.classList.toggle('hidden',!state.cargando&&!state.error)};syncSessionCheck();addEventListener('sesion-cliente-cambiada',(event:any)=>{syncSessionCheck();if(!event.detail?.autenticado)closeW2Menu(false)});addEventListener('sesion-cliente-error',()=>{const check=document.querySelector<HTMLElement>('#w2SessionCheck');if(check){check.classList.remove('hidden');check.innerHTML='<span>!</span><span>Sesión no disponible</span>'}});
</script></body></html>