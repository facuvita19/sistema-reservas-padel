<button class="w2-theme-toggle" type="button" data-w2-theme-toggle aria-label="Cambiar tema" title="Cambiar entre modo oscuro y claro"><span class="sun" aria-hidden="true">○</span><span class="moon" aria-hidden="true">●</span><b data-w2-theme-label>Tema</b></button>
<script>
const root=document.documentElement;const button=document.querySelector<HTMLButtonElement>('[data-w2-theme-toggle]');const label=document.querySelector<HTMLElement>('[data-w2-theme-label]');
function sync(){const light=root.dataset.w2Theme==='light';button?.setAttribute('aria-pressed',String(light));if(label)label.textContent=light?'Claro':'Oscuro';document.querySelector('meta[name="theme-color"]')?.setAttribute('content',light?'#f7f7f6':'#070809')}
sync();button?.addEventListener('click',()=>{const next=root.dataset.w2Theme==='light'?'dark':'light';root.dataset.w2Theme=next;localStorage.setItem('w2-theme',next);sync()});
</script>
