<button class="w2-theme-toggle" type="button" data-w2-theme-toggle aria-label="Cambiar a modo claro" title="Cambiar tema"><svg class="w2-theme-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"/></svg><svg class="w2-theme-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.2A8 8 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z"/></svg><span class="sr-only" data-w2-theme-label>Oscuro</span></button>
<script is:inline>
(()=>{const root=document.documentElement,button=document.querySelector('[data-w2-theme-toggle]'),label=button?.querySelector('[data-w2-theme-label]');const sync=()=>{const light=root.dataset.w2Theme==='light';button?.setAttribute('aria-pressed',String(light));button?.setAttribute('aria-label',light?'Cambiar a modo oscuro':'Cambiar a modo claro');if(label)label.textContent=light?'Claro':'Oscuro';document.querySelector('meta[name="theme-color"]')?.setAttribute('content',light?'#f7f7f6':'#070809')};sync();button?.addEventListener('click',()=>{const next=root.dataset.w2Theme==='light'?'dark':'light';root.dataset.w2Theme=next;localStorage.setItem('w2-theme',next);sync()})})();
</script>
