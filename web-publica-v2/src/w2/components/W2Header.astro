---
import W2ThemeToggle from './W2ThemeToggle.astro';
interface Props { actual?:string } const {actual='inicio'}=Astro.props;
const links=[['inicio','/w2','Inicio'],['reservar','/w2/reservar','Reservar'],['competir','/torneos','Competir'],['rankings','/w2/rankings','Rankings'],['comunidad','/w2#comunidad','Comunidad']];
---
<header class="w2-header"><nav class="w2-container w2-nav" aria-label="Navegación W2"><a class="w2-brand" href="/w2" aria-label="Pádel Las Flores, inicio"><img src="/w2/padel-las-flores.svg" width="760" height="260" alt="Pádel Las Flores"/></a><div class="w2-links">{links.map(([id,href,label])=><a href={href} class:list={[actual===id&&'active']}>{label}</a>)}</div><W2ThemeToggle/><a class="w2-cta" href="/w2/reservar">Reservar <span>→</span></a><button data-w2-menu class="w2-menu-button" aria-expanded="false" aria-controls="w2Menu">Menú</button></nav><aside id="w2Menu" class="w2-menu" aria-hidden="true">{links.map(([id,href,label])=><a href={href} class:list={[actual===id&&'active']}>{label}<span>→</span></a>)}<a href="/">Web actual <span>↗</span></a></aside></header>
