---
import W2ThemeToggle from './W2ThemeToggle.astro';
interface Props { actual?:string } const {actual='inicio'}=Astro.props;
const links=[
 ['inicio','/w2','Inicio','M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6h-4v6H5a1 1 0 0 1-1-1z'],
 ['reservar','/w2/reservar','Reservar','M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1zM8 13h3v3H8z'],
 ['torneos','/w2/torneos','Torneos','M8 4h8v3a4 4 0 0 1-3 3.87V14h3v3H8v-3h3v-3.13A4 4 0 0 1 8 7zm0 2H5v1a3 3 0 0 0 3 3m8-4h3v1a3 3 0 0 1-3 3'],
 ['rankings','/w2/rankings','Rankings','M5 20V10h4v10M10 20V4h4v16M15 20v-7h4v7M3 20h18'],
 ['comunidad','/w2/comunidad','Comunidad','M16 19v-1.5A3.5 3.5 0 0 0 12.5 14h-5A3.5 3.5 0 0 0 4 17.5V19M10 10a3 3 0 1 0 0-6 3 3 0 0 0 0 6M17 11a2.5 2.5 0 0 0 0-5M18 14c1.3.2 2 1.1 2 2.5V18']
] as const;
---
<header class="w2-header" data-w2-header>
 <nav class="w2-container w2-nav" aria-label="Navegación principal">
  <a class="w2-brand" href="/w2" aria-label="Pádel Las Flores, inicio"><picture class="w2-brand-picture w2-logo-dark"><source type="image/webp" srcset="/w2/w2-logo-clean-160.webp 160w, /w2/w2-logo-clean-284.webp 284w, /w2/w2-logo-clean-426.webp 426w, /w2/w2-logo-clean-636.webp 636w" sizes="(min-width: 901px) 142px, 140px"/><img src="/w2/w2-logo-clean-636.png" width="636" height="340" alt="Pádel Las Flores" decoding="async" fetchpriority="high"/></picture><picture class="w2-brand-picture w2-logo-light"><source type="image/webp" srcset="/w2/w2-logo-light-v8-160.webp 160w, /w2/w2-logo-light-v8-284.webp 284w, /w2/w2-logo-light-v8-426.webp 426w, /w2/w2-logo-light-v8-636.webp 636w" sizes="(min-width: 901px) 142px, 140px"/><img src="/w2/w2-logo-light-v8-636.webp" width="636" height="340" alt="" aria-hidden="true" decoding="async"/></picture></a>
  <div class="w2-links">{links.map(([id,href,label,icon])=><a href={href} class:list={[actual===id&&'active']} aria-current={actual===id?'page':undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon}/></svg><span>{label}</span></a>)}</div>
  <W2ThemeToggle/>
  <a class="w2-cta" href="/w2/reservar"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1z"/></svg><span class="w2-cta-copy"><b>Reservar</b><small>Ver disponibilidad</small></span><i aria-hidden="true">→</i></a>
  <div id="w2Notifications" class="w2-notifications hidden">
   <button id="w2NotificationsTrigger" class="w2-notifications-trigger" type="button" aria-expanded="false" aria-controls="w2NotificationsPanel" aria-label="Notificaciones"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9a6 6 0 0 1 12 0v4l2 3H4l2-3V9M10 20h4"/></svg><b id="w2NotificationsCount" class="hidden">0</b></button>
   <div id="w2NotificationsBackdrop" class="w2-notifications-backdrop hidden" aria-hidden="true"></div>
   <section id="w2NotificationsPanel" class="w2-notifications-panel hidden" aria-hidden="true" aria-labelledby="w2NotificationsTitle" inert>
    <span class="w2-notifications-handle" aria-hidden="true"></span><header><div><small>CENTRO DE ACTIVIDAD</small><h2 id="w2NotificationsTitle">Notificaciones</h2><p id="w2NotificationsSummary">Tu actividad deportiva reciente</p></div><button id="w2NotificationsClose" type="button" aria-label="Cerrar notificaciones">×</button></header>
    <div class="w2-notifications-tools"><span id="w2NotificationsStatus" role="status">Actualizando…</span><button id="w2NotificationsReadAll" type="button" class="hidden" aria-label="Marcar todas las notificaciones como leídas">Leer todas</button></div>
    <div id="w2NotificationsList" class="w2-notifications-list"></div>
   </section>
  </div>
  <div class="w2-auth-slot" aria-live="polite">
   <span class="w2-session-check" id="w2SessionCheck"><i></i><span>Verificando</span></span>
   <button id="abrirAutenticacion" class="w2-login hidden" type="button"><span aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3"/><path d="M5.5 19c.7-3.4 2.9-5.3 6.5-5.3s5.8 1.9 6.5 5.3"/></svg></span><b>Ingresar</b></button>
   <div id="menuUsuario" class="w2-account hidden">
    <button id="botonUsuario" class="w2-account-trigger" type="button" aria-expanded="false" aria-controls="desplegableUsuario">
     <span id="avatarUsuario" class="w2-account-avatar" aria-hidden="true">PR</span><span><small>Mi cuenta</small><strong id="nombreUsuario">Cuenta</strong></span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 9 5 5 5-5"/></svg>
    </button>
    <div id="desplegableUsuario" class="w2-account-menu hidden" role="menu" aria-label="Opciones de la cuenta" aria-hidden="true">
     <header><span id="avatarUsuarioMenu">PR</span><div><small>Cuenta activa</small><strong id="nombreUsuarioMenu">Cuenta</strong><em id="correoUsuarioMenu">Perfil de cliente</em></div></header>
     <a href="/w2/cuenta?seccion=reservas" role="menuitem"><span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3v3M18 3v3M4 8h16M5 5h14v16H5zM8 12h3v3H8z"/></svg></span><div><b>Mis reservas</b><small>Turnos, pagos y seguimiento</small></div><i>→</i></a>
     <a href="/w2/cuenta?seccion=datos" role="menuitem"><span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3"/><path d="M5.5 19c.7-3.4 2.9-5.3 6.5-5.3s5.8 1.9 6.5 5.3M18 5l1 1 2-2"/></svg></span><div><b>Mis datos y seguridad</b><small>Información personal y acceso</small></div><i>→</i></a>
     <a href="/w2/cuenta?seccion=deporte" role="menuitem"><span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4h10l2 4-2 12H7L5 8zM8 8h8M12 8v8M9 13h6"/></svg></span><div><b>Mi perfil deportivo</b><small>Categoría, ranking e historial personal</small></div><i>→</i></a>
     <button id="cerrarSesion" type="button" role="menuitem"><span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 5H5v14h5M14 8l4 4-4 4M8 12h10"/></svg></span><div><b>Cerrar sesión</b><small>Salir de esta cuenta</small></div></button>
    </div>
   </div>
  </div>
  <button data-w2-menu class="w2-menu-button" type="button" aria-expanded="false" aria-controls="w2Menu" aria-label="Abrir menú">Menú</button>
 </nav>
 <div id="w2MenuBackdrop" class="w2-menu-backdrop" aria-hidden="true"></div>
 <aside id="w2Menu" class="w2-menu" aria-hidden="true" inert>
  <header><a href="/w2"><picture class="w2-brand-picture w2-logo-dark"><source type="image/webp" srcset="/w2/w2-logo-clean-160.webp 160w, /w2/w2-logo-clean-284.webp 284w, /w2/w2-logo-clean-426.webp 426w, /w2/w2-logo-clean-636.webp 636w" sizes="(min-width: 901px) 142px, 140px"/><img src="/w2/w2-logo-clean-636.png" width="636" height="340" alt="Pádel Las Flores" decoding="async" fetchpriority="high"/></picture><picture class="w2-brand-picture w2-logo-light"><source type="image/webp" srcset="/w2/w2-logo-light-v8-160.webp 160w, /w2/w2-logo-light-v8-284.webp 284w, /w2/w2-logo-light-v8-426.webp 426w, /w2/w2-logo-light-v8-636.webp 636w" sizes="(min-width: 901px) 142px, 140px"/><img src="/w2/w2-logo-light-v8-636.webp" width="636" height="340" alt="" aria-hidden="true" decoding="async"/></picture></a><button data-w2-menu-close type="button" aria-label="Cerrar menú">×</button></header>
  <nav aria-label="Navegación móvil">{links.map(([id,href,label],index)=><a href={href} class:list={[actual===id&&'active']}><i>{String(index+1).padStart(2,'0')}</i><b>{label}</b><span>→</span></a>)}</nav>
  <a class="w2-mobile-reserve" href="/w2/reservar">Reservar una cancha <span>→</span></a>
  <button id="abrirAutenticacionMovil" class="w2-mobile-login hidden" type="button">Ingresar o crear cuenta</button>
  <div id="cuentaUsuarioMovil" class="w2-mobile-account hidden">
   <button id="w2NotificationsMobile" class="w2-mobile-notifications" type="button"><i><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9a6 6 0 0 1 12 0v4l2 3H4l2-3V9M10 20h4"/></svg></i><span>Notificaciones</span><b id="w2NotificationsMobileCount" class="hidden">0</b></button>
   <div><span id="avatarUsuarioMovil">PR</span><p><small>Tu cuenta</small><strong id="nombreUsuarioMovil">Cuenta</strong><em id="correoUsuarioMovil">Sesión activa</em></p></div>
   <a href="/w2/cuenta?seccion=reservas"><i><svg viewBox="0 0 24 24"><path d="M6 3v3M18 3v3M4 8h16M5 5h14v16H5z"/></svg></i><span>Mis reservas</span><b>→</b></a><a href="/w2/cuenta?seccion=datos"><i><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3"/><path d="M5.5 19c.7-3.4 2.9-5.3 6.5-5.3s5.8 1.9 6.5 5.3"/></svg></i><span>Mis datos y seguridad</span><b>→</b></a><a href="/w2/cuenta?seccion=deporte"><i><svg viewBox="0 0 24 24"><path d="M7 4h10l2 4-2 12H7L5 8zM8 8h8M12 8v8"/></svg></i><span>Mi perfil deportivo</span><b>→</b></a>
   <button id="cerrarSesionMovil" type="button">Cerrar sesión</button>
  </div>
  <footer><span>Sesión segura</span><span>Pádel Las Flores</span></footer>
 </aside>
</header>
