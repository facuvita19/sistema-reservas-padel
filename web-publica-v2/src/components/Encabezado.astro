---
interface Props { actual?: 'inicio'|'reservar'|'torneos'|'reservas'|'cuenta'; }
const { actual='inicio' }=Astro.props;
const enlaces=[
  ['inicio','/','Inicio','M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6h-4v6H5a1 1 0 0 1-1-1z'],
  ['reservar','/reservar','Reservar','M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1zM8 13h3v3H8z'],
  ['torneos','/w2/torneos','Torneos','M8 4h8v3a4 4 0 0 1-3 3.87V14h3v3H8v-3h3v-3.13A4 4 0 0 1 8 7zm0 2H5v1a3 3 0 0 0 3 3m8-4h3v1a3 3 0 0 1-3 3'],
  ['reservas','/mis-reservas','Mis reservas','M5 5h14v14H5zM8 2v5M16 2v5M8 11h8M8 15h5']
] as const;
---
<!-- encabezado-global-premium-v59-20261011 -->
<header data-site-header class="site-header-v59" data-header-version="59">
  <div class="site-header-v59-glow" aria-hidden="true"></div>
  <nav class="container-site site-header-v59-inner" aria-label="Navegación principal">
    <a href="/" class="site-brand-v59 focus-ring" aria-label="Ir al inicio de Arena Pádel">
      <span class="site-brand-v59-mark" aria-hidden="true"><i></i><b>AP</b></span>
      <span class="site-brand-v59-copy"><strong id="marcaNombre">Pádel Reservas</strong><small>Jugá. Competí. Volvé.</small></span>
    </a>

    <div class="site-nav-v59" aria-label="Secciones principales">
      {enlaces.map(([id,href,texto,d])=>
        <a href={href} class:list={['site-nav-v59-link',actual===id&&'active']} aria-current={actual===id?'page':undefined}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={d}></path></svg><span>{texto}</span>
        </a>)}
    </div>

    <div class="site-actions-v59">
      <a href="/reservar" class:list={['site-reserve-v59',actual==='reservar'&&'current']}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1z"></path></svg><span>Reservar ahora</span><b aria-hidden="true">→</b>
      </a>
      <button id="abrirAutenticacion" class="site-login-v59" type="button"><span class="site-login-v59-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M15 8a3 3 0 1 1-6 0 3 3 0 0 1 6 0ZM6.5 19c.7-3.1 2.5-5 5.5-5s4.8 1.9 5.5 5M18 5l2 2-2 2M20 7h-4"></path></svg></span><span>Ingresar</span></button>
      <div id="menuUsuario" class="site-account-v59 hidden">
        <button id="botonUsuario" class="site-account-v59-trigger" type="button" aria-expanded="false" aria-controls="desplegableUsuario">
          <span id="avatarUsuario" class="site-account-v59-avatar" aria-hidden="true">PR</span>
          <span class="site-account-v59-copy"><small>Mi cuenta</small><strong id="nombreUsuario">Cuenta</strong></span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 9 5 5 5-5"></path></svg>
        </button>
        <div id="desplegableUsuario" class="site-account-v59-menu hidden" role="menu" aria-label="Opciones de la cuenta" aria-hidden="true">
          <header><span id="avatarUsuarioMenu" aria-hidden="true">PR</span><div><small>Cuenta activa</small><strong id="nombreUsuarioMenu">Cuenta</strong><em id="correoUsuarioMenu">Tu perfil de jugador</em></div></header>
          <a href="/mis-reservas" role="menuitem"><span aria-hidden="true">⌁</span><div><b>Mis reservas</b><small>Turnos, pagos y seguimiento</small></div><i>→</i></a>
          <a href="/mis-datos" role="menuitem"><span aria-hidden="true">◎</span><div><b>Mis datos</b><small>Perfil y seguridad</small></div><i>→</i></a>
          <button id="cerrarSesion" type="button" role="menuitem"><span aria-hidden="true">↗</span><div><b>Cerrar sesión</b><small>Salir de esta cuenta</small></div></button>
        </div>
      </div>
    </div>

    <button id="menuButton" class="site-menu-v59-button" type="button" aria-expanded="false" aria-controls="mainMenu" aria-label="Abrir menú principal"><span></span><span></span><span></span></button>
  </nav>

  <div id="mainMenuBackdrop" class="site-menu-v59-backdrop" aria-hidden="true"></div>
  <div id="mainMenu" class="site-menu-v59-panel" aria-hidden="true" inert>
    <header><a href="/" class="site-menu-v59-brand"><span class="site-brand-v59-mark"><i></i><b>AP</b></span><div><strong id="marcaNombreMovil">Pádel Reservas</strong><small>Tu club, siempre cerca.</small></div></a><button id="cerrarMenuMovil" type="button" aria-label="Cerrar menú">×</button></header>
    <div class="site-menu-v59-status"><span></span><div><small>Club online</small><b>Reservas disponibles</b></div></div>
    <nav aria-label="Navegación móvil">
      {enlaces.map(([id,href,texto,d])=><a href={href} class:list={[actual===id&&'active']} aria-current={actual===id?'page':undefined}><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={d}></path></svg><span>{texto}</span><b aria-hidden="true">→</b></a>)}
    </nav>
    <a class="site-menu-v59-primary" href="/reservar"><span>Reservar una cancha</span><b>→</b></a>
    <button id="abrirAutenticacionMovil" class="site-menu-v59-login" type="button">Ingresar o crear cuenta</button>
    <div id="cuentaUsuarioMovil" class="site-menu-v59-account hidden">
      <div><span id="avatarUsuarioMovil">PR</span><p><small>Cuenta activa</small><strong id="nombreUsuarioMovil">Cuenta</strong></p></div>
      <a href="/mis-reservas">Mis reservas <b>→</b></a><a href="/mis-datos">Mis datos <b>→</b></a>
      <button id="cerrarSesionMovil" type="button">Cerrar sesión</button>
    </div>
    <footer><span>Experiencia segura</span><span>Datos actualizados</span></footer>
  </div>
</header>
<script>
 /* correccion-menu-movil-v63-20261011 */
 const header=document.querySelector<HTMLElement>('[data-site-header]'),menuButton=document.querySelector<HTMLButtonElement>('#menuButton'),mainMenu=document.querySelector<HTMLElement>('#mainMenu'),backdrop=document.querySelector<HTMLElement>('#mainMenuBackdrop'),closeButton=document.querySelector<HTMLButtonElement>('#cerrarMenuMovil');let menuFocus:HTMLElement|null=null;
 // El panel y su fondo deben escapar del contexto de apilado del encabezado.
 // Como son nodos globales y conservan sus referencias, moverlos a body no altera los eventos.
 if(backdrop&&backdrop.parentElement!==document.body)document.body.appendChild(backdrop);
 if(mainMenu&&mainMenu.parentElement!==document.body)document.body.appendChild(mainMenu);
 /* sincronizacion-marca-menu-v63b-20261011 */
 const marcaPrincipal=document.querySelector<HTMLElement>('#marcaNombre'),marcaMovil=document.querySelector<HTMLElement>('#marcaNombreMovil');
 const sincronizarMarcaMovil=()=>{if(marcaPrincipal&&marcaMovil&&marcaPrincipal.textContent)marcaMovil.textContent=marcaPrincipal.textContent};
 sincronizarMarcaMovil();
 if(marcaPrincipal)new MutationObserver(sincronizarMarcaMovil).observe(marcaPrincipal,{childList:true,subtree:true,characterData:true});
 const updateHeight=()=>{if(header)document.documentElement.style.setProperty('--header-height',header.getBoundingClientRect().height+'px')};
 const closeMenu=()=>{mainMenu?.setAttribute('inert','');mainMenu?.classList.remove('open');backdrop?.classList.remove('open');mainMenu?.setAttribute('aria-hidden','true');menuButton?.setAttribute('aria-expanded','false');document.body.classList.remove('no-scroll');menuFocus?.focus()};
 const openMenu=()=>{menuFocus=document.activeElement as HTMLElement;mainMenu?.removeAttribute('inert');mainMenu?.classList.add('open');backdrop?.classList.add('open');mainMenu?.setAttribute('aria-hidden','false');menuButton?.setAttribute('aria-expanded','true');document.body.classList.add('no-scroll');setTimeout(()=>closeButton?.focus(),30)};
 menuButton?.addEventListener('click',()=>menuButton.getAttribute('aria-expanded')==='true'?closeMenu():openMenu());closeButton?.addEventListener('click',closeMenu);backdrop?.addEventListener('click',closeMenu);mainMenu?.querySelectorAll('a').forEach(a=>a.addEventListener('click',closeMenu));
 document.addEventListener('keydown',e=>{if(e.key==='Escape'&&mainMenu?.classList.contains('open'))closeMenu();if(e.key==='Tab'&&mainMenu?.classList.contains('open')){const f=[...mainMenu.querySelectorAll<HTMLElement>('a,button:not([disabled])')].filter(x=>x.offsetParent!==null);if(!f.length)return;if(e.shiftKey&&document.activeElement===f[0]){e.preventDefault();f.at(-1)?.focus()}else if(!e.shiftKey&&document.activeElement===f.at(-1)){e.preventDefault();f[0].focus()}}});
 document.querySelector('#abrirAutenticacionMovil')?.addEventListener('click',()=>{closeMenu();(document.querySelector('#abrirAutenticacion') as HTMLButtonElement)?.click()});
 let ticking=false;const onScroll=()=>{if(ticking)return;ticking=true;requestAnimationFrame(()=>{header?.classList.toggle('compact',scrollY>32);updateHeight();ticking=false})};addEventListener('scroll',onScroll,{passive:true});addEventListener('resize',updateHeight,{passive:true});new ResizeObserver(updateHeight).observe(header!);updateHeight();onScroll();
</script>
