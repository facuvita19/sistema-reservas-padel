<div id="modalInscripcion" class="fixed inset-0 z-[80] hidden items-center justify-center bg-black/75 p-4 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="tituloInscripcion">
  <section class="max-h-[92vh] w-full max-w-3xl overflow-y-auto rounded-3xl border border-ink-700 bg-ink-900 shadow-2xl">
    <header class="sticky top-0 z-10 flex items-start justify-between gap-5 border-b border-ink-700 bg-ink-900/95 px-6 py-5 backdrop-blur-xl sm:px-8">
      <div>
        <p class="text-xs font-black uppercase tracking-[.2em] text-brand-300">Inscripción de pareja</p>
        <h2 id="tituloInscripcion" class="mt-2 text-2xl font-black text-white">Completar inscripción</h2>
        <p id="resumenInscripcion" class="mt-1 text-sm text-slate-400"></p>
      </div>
      <button id="cerrarInscripcion" class="focus-ring grid size-11 shrink-0 place-items-center rounded-full border border-ink-700 text-2xl text-slate-300 transition hover:border-rose-400/60 hover:bg-rose-500/10 hover:text-white active:scale-95" type="button" aria-label="Cerrar inscripción">×</button>
    </header>

    <form id="formInscripcion" class="space-y-7 p-6 sm:p-8" novalidate>
      <input id="torneoCategoriaId" type="hidden" />

      <div class="rounded-2xl border border-brand-500/30 bg-brand-500/10 p-4 text-sm text-slate-300">
        La solicitud quedará <strong class="text-white">pendiente de revisión</strong>. Los dos integrantes deben usar teléfonos diferentes.
      </div>

      <fieldset class="space-y-4">
        <legend class="text-lg font-black text-white">Responsable</legend>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block"><span class="mb-2 block text-xs font-black uppercase tracking-wide text-slate-400">Nombre *</span><input id="responsableNombre" class="field-web" maxlength="100" autocomplete="given-name" /></label>
          <label class="block"><span class="mb-2 block text-xs font-black uppercase tracking-wide text-slate-400">Apellido *</span><input id="responsableApellido" class="field-web" maxlength="100" autocomplete="family-name" /></label>
          <label class="block sm:col-span-2"><span class="mb-2 block text-xs font-black uppercase tracking-wide text-slate-400">Teléfono *</span><input id="responsableTelefono" class="field-web" maxlength="30" inputmode="tel" autocomplete="tel" placeholder="Ejemplo: 11 5555-5555" /></label>
        </div>
      </fieldset>

      <fieldset class="space-y-4 border-t border-ink-700 pt-6">
        <legend class="text-lg font-black text-white">Segundo integrante</legend>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block"><span class="mb-2 block text-xs font-black uppercase tracking-wide text-slate-400">Nombre *</span><input id="parejaNombre" class="field-web" maxlength="100" /></label>
          <label class="block"><span class="mb-2 block text-xs font-black uppercase tracking-wide text-slate-400">Apellido *</span><input id="parejaApellido" class="field-web" maxlength="100" /></label>
          <label class="block sm:col-span-2"><span class="mb-2 block text-xs font-black uppercase tracking-wide text-slate-400">Teléfono *</span><input id="parejaTelefono" class="field-web" maxlength="30" inputmode="tel" placeholder="Debe ser diferente al responsable" /></label>
        </div>
      </fieldset>

      <label class="block border-t border-ink-700 pt-6"><span class="mb-2 block text-xs font-black uppercase tracking-wide text-slate-400">Comentarios opcionales</span><textarea id="comentariosInscripcion" class="field-web min-h-28 resize-y" maxlength="500" placeholder="Información adicional para la organización"></textarea><small id="contadorComentarios" class="mt-2 block text-right text-xs text-slate-500">0 / 500</small></label>

      <div id="errorInscripcion" class="hidden rounded-xl border border-rose-500/30 bg-rose-500/10 p-4 text-sm font-bold text-rose-200" role="alert"></div>
      <div id="exitoInscripcion" class="hidden rounded-2xl border border-emerald-500/30 bg-emerald-500/10 p-5 text-emerald-100" role="status"></div>

      <div class="flex flex-col-reverse gap-3 border-t border-ink-700 pt-6 sm:flex-row sm:justify-end">
        <button id="cancelarInscripcion" class="focus-ring rounded-xl border border-ink-700 px-5 py-3 font-black text-slate-200 transition hover:bg-ink-800 active:scale-[.98]" type="button">Cancelar</button>
        <button id="enviarInscripcion" class="focus-ring rounded-xl bg-brand-500 px-6 py-3 font-black text-white transition hover:bg-brand-600 active:scale-[.98] disabled:cursor-wait disabled:opacity-60" type="submit">Enviar inscripción</button>
      </div>
    </form>
  </section>
</div>