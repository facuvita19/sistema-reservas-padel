<div id="modalInscripcion" class="fixed inset-0 z-[80] hidden items-center justify-center bg-black/78 p-2 backdrop-blur-md sm:p-4" role="dialog" aria-modal="true" aria-labelledby="tituloInscripcion" aria-describedby="resumenInscripcion">
  <section class="modal-shell registration-modal-shell max-w-3xl">
    <header class="modal-header registration-modal-header">
      <div>
        <p class="site-kicker">Inscripción de pareja</p>
        <h2 id="tituloInscripcion" class="site-title">Completar inscripción</h2>
        <p id="resumenInscripcion" class="registration-summary"></p>
      </div>
      <button id="cerrarInscripcion" class="modal-close" type="button" aria-label="Cerrar inscripción">×</button>
    </header>

    <form id="formInscripcion" class="modal-body registration-modal-body" novalidate>
      <input id="torneoCategoriaId" type="hidden"/>

      <div id="contenidoFormularioInscripcion" class="registration-form-content">
        <div class="registration-notice" role="note">
          <span aria-hidden="true">i</span>
          <p><strong>La inscripción quedará pendiente de revisión.</strong> La organización confirmará la solicitud después de revisar los datos.</p>
        </div>

        <fieldset class="registration-person-card">
          <legend><b>1</b><span>Primer integrante<small>Recibirá las comunicaciones relacionadas con la solicitud.</small></span></legend>
          <div class="registration-fields">
            <label for="responsableNombre">
              <span class="etiqueta-web">Nombre *</span>
              <input id="responsableNombre" class="field-web" maxlength="100" autocomplete="given-name" aria-describedby="error-responsableNombre"/>
              <small id="error-responsableNombre" class="registration-field-error hidden"></small>
            </label>
            <label for="responsableApellido">
              <span class="etiqueta-web">Apellido *</span>
              <input id="responsableApellido" class="field-web" maxlength="100" autocomplete="family-name" aria-describedby="error-responsableApellido"/>
              <small id="error-responsableApellido" class="registration-field-error hidden"></small>
            </label>
            <label class="registration-field-wide" for="responsableTelefono">
              <span class="etiqueta-web">Teléfono *</span>
              <input id="responsableTelefono" class="field-web" maxlength="30" inputmode="tel" autocomplete="tel" placeholder="Ejemplo: 11 5555-5555" aria-describedby="ayuda-responsableTelefono error-responsableTelefono"/>
              <small id="ayuda-responsableTelefono" class="registration-field-help">Se usará para contactar a la pareja.</small>
              <small id="error-responsableTelefono" class="registration-field-error hidden"></small>
            </label>
          </div>
        </fieldset>

        <fieldset class="registration-person-card">
          <legend><b>2</b><span>Segundo integrante<small>Completá los datos de la otra persona que integra la pareja.</small></span></legend>
          <div class="registration-fields">
            <label for="parejaNombre">
              <span class="etiqueta-web">Nombre *</span>
              <input id="parejaNombre" class="field-web" maxlength="100" autocomplete="given-name" aria-describedby="error-parejaNombre"/>
              <small id="error-parejaNombre" class="registration-field-error hidden"></small>
            </label>
            <label for="parejaApellido">
              <span class="etiqueta-web">Apellido *</span>
              <input id="parejaApellido" class="field-web" maxlength="100" autocomplete="family-name" aria-describedby="error-parejaApellido"/>
              <small id="error-parejaApellido" class="registration-field-error hidden"></small>
            </label>
            <label class="registration-field-wide" for="parejaTelefono">
              <span class="etiqueta-web">Teléfono *</span>
              <input id="parejaTelefono" class="field-web" maxlength="30" inputmode="tel" autocomplete="tel" placeholder="Ejemplo: 11 4444-4444" aria-describedby="ayuda-parejaTelefono error-parejaTelefono"/>
              <small id="ayuda-parejaTelefono" class="registration-field-help">Debe ser diferente al teléfono del primer integrante.</small>
              <small id="error-parejaTelefono" class="registration-field-error hidden"></small>
            </label>
          </div>
        </fieldset>

        <label class="registration-comments" for="comentariosInscripcion">
          <span><b class="etiqueta-web">Comentarios opcionales</b><small id="contadorComentarios">0/500</small></span>
          <textarea id="comentariosInscripcion" class="field-web" maxlength="500" rows="3" placeholder="Información adicional para la organización" aria-describedby="error-comentariosInscripcion"></textarea>
          <small id="error-comentariosInscripcion" class="registration-field-error hidden"></small>
        </label>

        <div id="errorInscripcion" class="registration-global-error hidden" role="alert" tabindex="-1"></div>
      </div>

      <section id="exitoInscripcion" class="registration-success hidden" role="status" aria-live="polite" tabindex="-1"></section>

      <footer class="registration-footer">
        <button id="cancelarInscripcion" class="btn btn-secondary" type="button">Cancelar</button>
        <button id="enviarInscripcion" class="btn btn-primary" type="submit">Enviar inscripción</button>
        <button id="cerrarExitoInscripcion" class="btn btn-primary hidden" type="button">Cerrar</button>
      </footer>
    </form>
  </section>
</div>
