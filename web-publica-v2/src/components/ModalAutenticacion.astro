<div id="modalAutenticacion" class="fixed inset-0 z-[90] hidden items-center justify-center bg-black/75 p-4 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="tituloAutenticacion">
  <section class="max-h-[92vh] w-full max-w-xl overflow-y-auto rounded-3xl border border-ink-700 bg-ink-900 shadow-2xl">
    <header class="sticky top-0 z-10 flex items-start justify-between gap-5 border-b border-ink-700 bg-ink-900/95 px-6 py-5 backdrop-blur-xl sm:px-8">
      <div><p class="text-xs font-black uppercase tracking-[.2em] text-brand-300">Cuenta de cliente</p><h2 id="tituloAutenticacion" class="mt-2 text-2xl font-black">Ingresar</h2></div>
      <button id="cerrarAutenticacion" class="focus-ring grid size-11 place-items-center rounded-full border border-ink-700 text-2xl text-slate-300 transition hover:border-rose-400/60 hover:bg-rose-500/10 hover:text-white active:scale-95" type="button" aria-label="Cerrar">×</button>
    </header>
    <div class="p-6 sm:p-8">
      <div class="mb-6 grid grid-cols-2 rounded-xl border border-ink-700 bg-ink-950 p-1">
        <button id="tabLogin" class="tab-auth activo" type="button">Ingresar</button>
        <button id="tabRegistro" class="tab-auth" type="button">Crear cuenta</button>
      </div>
      <div id="errorAutenticacion" class="mb-5 hidden rounded-xl border border-rose-500/30 bg-rose-500/10 p-4 text-sm font-bold text-rose-200" role="alert"></div>
      <form id="formLogin" class="space-y-4" novalidate>
        <label class="block"><span class="etiqueta-web">Correo electrónico</span><input id="loginEmail" class="field-web" type="email" autocomplete="email" /></label>
        <label class="block"><span class="etiqueta-web">Contraseña</span><input id="loginPassword" class="field-web" type="password" autocomplete="current-password" /></label>
        <button id="enviarLogin" class="w-full rounded-xl bg-brand-500 px-6 py-3 font-black text-white transition hover:bg-brand-600 active:scale-[.98] disabled:cursor-wait disabled:opacity-60" type="submit">Ingresar</button>
        <button id="abrirRecuperacion" class="w-full text-sm font-bold text-brand-300 transition hover:text-white" type="button">¿Olvidaste tu contraseña?</button>
      </form>
      <form id="formRecuperacion" class="hidden space-y-4" novalidate>
        <p class="text-sm leading-6 text-slate-400">Ingresá el correo de tu cuenta. Si existe una cuenta asociada, recibirás instrucciones para continuar.</p>
        <label class="block"><span class="etiqueta-web">Correo electrónico</span><input id="recuperacionEmail" class="field-web" type="email" autocomplete="email" /></label>
        <div id="resultadoRecuperacion" class="hidden rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-4 text-sm text-emerald-100" role="status"></div>
        <button id="enviarRecuperacion" class="w-full rounded-xl bg-brand-500 px-6 py-3 font-black text-white transition hover:bg-brand-600 active:scale-[.98] disabled:cursor-wait disabled:opacity-60" type="submit">Enviar instrucciones</button>
        <button id="volverLogin" class="w-full text-sm font-bold text-brand-300 transition hover:text-white" type="button">Volver a ingresar</button>
      </form>
      <form id="formRegistro" class="hidden space-y-4" novalidate>
        <div class="grid gap-4 sm:grid-cols-2">
          <label><span class="etiqueta-web">Nombre *</span><input id="registroNombre" class="field-web" maxlength="100" autocomplete="given-name" /></label>
          <label><span class="etiqueta-web">Apellido *</span><input id="registroApellido" class="field-web" maxlength="100" autocomplete="family-name" /></label>
          <label><span class="etiqueta-web">Documento *</span><input id="registroDocumento" class="field-web" inputmode="numeric" maxlength="10" /></label>
          <label><span class="etiqueta-web">Teléfono *</span><input id="registroTelefono" class="field-web" inputmode="tel" maxlength="30" autocomplete="tel" /></label>
          <label class="sm:col-span-2"><span class="etiqueta-web">Correo electrónico *</span><input id="registroEmail" class="field-web" type="email" maxlength="150" autocomplete="email" /></label>
          <label class="sm:col-span-2"><span class="etiqueta-web">Posición preferida</span><select id="registroPosicion" class="field-web"><option value="">Sin preferencia</option><option value="DRIVE">Drive</option><option value="REVES">Revés</option></select></label>
          <label><span class="etiqueta-web">Contraseña *</span><input id="registroPassword" class="field-web" type="password" minlength="8" autocomplete="new-password" /></label>
          <label><span class="etiqueta-web">Repetir contraseña *</span><input id="registroPasswordRepetido" class="field-web" type="password" minlength="8" autocomplete="new-password" /></label>
        </div>
        <p class="text-xs text-slate-500">La posición es opcional. La contraseña debe tener al menos 8 caracteres.</p>
        <button id="enviarRegistro" class="w-full rounded-xl bg-brand-500 px-6 py-3 font-black text-white transition hover:bg-brand-600 active:scale-[.98] disabled:cursor-wait disabled:opacity-60" type="submit">Crear cuenta</button>
      </form>
    </div>
  </section>
</div>
