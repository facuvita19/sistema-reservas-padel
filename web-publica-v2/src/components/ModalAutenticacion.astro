<div id="modalAutenticacion" class="fixed inset-0 z-[90] hidden items-center justify-center bg-black/78 p-2 backdrop-blur-md sm:p-4" role="dialog" aria-modal="true" aria-labelledby="tituloAutenticacion">
<section class="modal-shell max-w-xl"><header class="modal-header"><div><p class="site-kicker">Cuenta de cliente</p><h2 id="tituloAutenticacion" class="site-title mt-2 text-2xl font-black">Ingresar</h2></div><button id="cerrarAutenticacion" class="modal-close" type="button" aria-label="Cerrar">×</button></header>
<div class="modal-body p-5 sm:p-8"><div class="mb-6 grid grid-cols-2 rounded-xl border border-ink-700 bg-ink-950 p-1"><button id="tabLogin" class="tab-auth activo" type="button">Ingresar</button><button id="tabRegistro" class="tab-auth" type="button">Crear cuenta</button></div><div id="errorAutenticacion" class="mb-5 hidden rounded-xl border border-rose-500/30 bg-rose-500/10 p-4 text-sm font-bold text-rose-200" role="alert"></div>
<form id="formLogin" class="space-y-4" novalidate><label class="block"><span class="etiqueta-web">Correo electrónico</span><input id="loginEmail" class="field-web" type="email" autocomplete="email" /></label><label class="block"><span class="etiqueta-web">Contraseña</span><input id="loginPassword" class="field-web" type="password" autocomplete="current-password" /></label><button id="enviarLogin" class="btn btn-primary w-full" type="submit">Ingresar</button><button id="abrirRecuperacion" class="btn btn-ghost w-full text-sm" type="button">¿Olvidaste tu contraseña?</button></form>
<form id="formRecuperacion" class="hidden space-y-4" novalidate><p class="text-sm leading-6 text-slate-400">Ingresá el correo de tu cuenta. Si existe una cuenta asociada, recibirás instrucciones para continuar.</p><label class="block"><span class="etiqueta-web">Correo electrónico</span><input id="recuperacionEmail" class="field-web" type="email" autocomplete="email" /></label><div id="resultadoRecuperacion" class="hidden rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-4 text-sm text-emerald-100" role="status"></div><button id="enviarRecuperacion" class="btn btn-primary w-full" type="submit">Enviar instrucciones</button><button id="volverLogin" class="btn btn-ghost w-full text-sm" type="button">Volver a ingresar</button></form>
<form id="formRegistro" class="hidden space-y-4" novalidate><div class="grid gap-4 sm:grid-cols-2"><label><span class="etiqueta-web">Nombre *</span><input id="registroNombre" class="field-web" maxlength="100" autocomplete="given-name" /></label><label><span class="etiqueta-web">Apellido *</span><input id="registroApellido" class="field-web" maxlength="100" autocomplete="family-name" /></label><label><span class="etiqueta-web">Documento *</span><input id="registroDocumento" class="field-web" inputmode="numeric" maxlength="10" /></label><label><span class="etiqueta-web">Teléfono *</span><input id="registroTelefono" class="field-web" inputmode="tel" maxlength="30" autocomplete="tel" /></label><label class="sm:col-span-2"><span class="etiqueta-web">Correo electrónico *</span><input id="registroEmail" class="field-web" type="email" maxlength="150" autocomplete="email" /></label><label class="sm:col-span-2"><span class="etiqueta-web">Posición preferida</span><select id="registroPosicion" class="field-web"><option value="">Sin preferencia</option><option value="DRIVE">Drive</option><option value="REVES">Revés</option></select></label><label><span class="etiqueta-web">Contraseña *</span><input id="registroPassword" class="field-web" type="password" minlength="8" autocomplete="new-password" /></label><label><span class="etiqueta-web">Repetir contraseña *</span><input id="registroPasswordRepetido" class="field-web" type="password" minlength="8" autocomplete="new-password" /></label></div><p class="text-xs text-slate-500">La posición es opcional. La contraseña debe tener al menos 8 caracteres.</p><button id="enviarRegistro" class="btn btn-primary w-full" type="submit">Crear cuenta</button></form></div></section></div>
