<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="vista.controlador.JugadoresController" styleClass="module-root, players-root">
 <top><HBox alignment="CENTER_LEFT" spacing="16" styleClass="module-header, players-header"><padding><Insets top="12" right="24" bottom="12" left="24"/></padding>
  <Button onAction="#volver" minWidth="42" prefWidth="42" maxWidth="42" minHeight="42" prefHeight="42" maxHeight="42" styleClass="players-back"><graphic><SVGPath content="M14 6 L8 12 L14 18 M8 12 L20 12" styleClass="players-line-icon"/></graphic></Button>
  <StackPane minWidth="42" prefWidth="42" maxWidth="42" minHeight="42" prefHeight="42" maxHeight="42" styleClass="players-module-icon"><SVGPath content="M12 3 C9.2 3 7 5.2 7 8 C7 10.8 9.2 13 12 13 C14.8 13 17 10.8 17 8 C17 5.2 14.8 3 12 3 Z M4 22 C4 16.5 7.5 14 12 14 C16.5 14 20 16.5 20 22 M19 5 L22 8 L19 11" styleClass="players-line-icon, players-accent-icon"/></StackPane>
  <VBox spacing="2"><Label text="Jugadores" styleClass="page-title"/><Label text="Perfiles deportivos, categorías e historial competitivo." styleClass="page-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/>
  <Label fx:id="etiquetaEstado" text="Preparando jugadores..." styleClass="players-status"/><Button text="REGISTRAR SIN FICHA" onAction="#nuevoPerfilProvisional" styleClass="players-header-secondary-v10"><graphic><StackPane minWidth="18" prefWidth="18" maxWidth="18" minHeight="18" prefHeight="18" maxHeight="18" styleClass="players-header-action-icon-slot-v10"><SVGPath content="M12 3 C9.3 3 7 5.2 7 8 C7 10.8 9.3 13 12 13 C14.7 13 17 10.8 17 8 C17 5.2 14.7 3 12 3 Z M4 22 C4 16.5 7.5 14 12 14 C14.2 14 16.2 14.6 17.6 16 M19 14 L19 20 M16 17 L22 17" styleClass="players-header-action-icon-v10"/></StackPane></graphic><tooltip><Tooltip text="Registrar un jugador que todavía no tiene ficha de cliente"/></tooltip></Button><Button text="NUEVO JUGADOR" onAction="#nuevoJugadorVinculado" styleClass="players-header-primary-v10"><graphic><StackPane minWidth="18" prefWidth="18" maxWidth="18" minHeight="18" prefHeight="18" maxHeight="18" styleClass="players-header-action-icon-slot-v10"><SVGPath content="M9 11 C6.8 11 5 9.2 5 7 C5 4.8 6.8 3 9 3 C11.2 3 13 4.8 13 7 C13 9.2 11.2 11 9 11 Z M3 21 C3 16 6 13 9 13 C12 13 15 16 15 21 M18 12 L18 18 M15 15 L21 15" styleClass="players-header-action-icon-v10"/></StackPane></graphic><tooltip><Tooltip text="Crear un perfil desde una ficha de cliente existente"/></tooltip></Button>
 </HBox></top>
 <center><SplitPane dividerPositions="0.405" styleClass="module-split, players-split">
  <VBox spacing="10" styleClass="players-list"><padding><Insets top="22" right="18" bottom="22" left="28"/></padding>
   <HBox spacing="8"><StackPane HBox.hgrow="ALWAYS" styleClass="players-search-shell"><TextField fx:id="campoBuscar" promptText="Buscar por nombre, documento o teléfono..." maxWidth="Infinity" styleClass="modern-field, players-search"/><SVGPath content="M10.5 4 A6.5 6.5 0 1 0 10.5 17 A6.5 6.5 0 1 0 10.5 4 M15.5 15.5 L21 21" mouseTransparent="true" StackPane.alignment="CENTER_LEFT" styleClass="players-muted-icon, players-search-overlay-icon"/></StackPane><Button text="LIMPIAR" onAction="#limpiarFiltros" minWidth="118" prefWidth="118" maxWidth="118" styleClass="players-secondary"><graphic><SVGPath content="M6 6 L18 18 M18 6 L6 18" styleClass="players-button-icon"/></graphic></Button><Button fx:id="botonActualizar" text="ACTUALIZAR" onAction="#cargar" minWidth="140" prefWidth="140" maxWidth="140" styleClass="players-secondary, players-update-inline"><graphic><SVGPath content="M19 8 A8 8 0 1 0 20 13 M19 4 L19 8 L15 8" styleClass="players-button-icon"/></graphic></Button></HBox>
   <HBox spacing="10" styleClass="players-filter-row"><ComboBox fx:id="filtroIdentidad" promptText="Vinculación" minWidth="0" prefWidth="220" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="modern-combo, players-filter-identity"/><ComboBox fx:id="filtroCategoria" promptText="Todas las categorías" minWidth="0" prefWidth="248" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="modern-combo, players-filter-category"/><ComboBox fx:id="filtroEstado" promptText="Estado" minWidth="0" prefWidth="220" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="modern-combo, players-filter-state"/></HBox>
   <HBox alignment="CENTER_LEFT" spacing="7" styleClass="players-scope"><ToggleButton fx:id="botonTodos" text="TODOS" onAction="#mostrarTodos" styleClass="players-scope-button"/><ToggleButton fx:id="botonConCategoria" text="CON CATEGORÍA" onAction="#mostrarConCategoria" styleClass="players-scope-button"/><ToggleButton fx:id="botonSinCategoria" text="SIN CATEGORÍA" onAction="#mostrarSinCategoria" styleClass="players-scope-button"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="etiquetaResultados" text="0 jugadores visibles" styleClass="players-results"/></HBox>
   <TableView fx:id="tablaJugadores" VBox.vgrow="ALWAYS" styleClass="modern-table, players-table"><columns><TableColumn fx:id="columnaJugador" text="JUGADOR" prefWidth="190"/><TableColumn fx:id="columnaCategoria" text="CATEGORÍA" prefWidth="105"/><TableColumn fx:id="columnaIdentidad" text="VINCULACIÓN" prefWidth="110"/><TableColumn fx:id="columnaPosicion" text="POSICIÓN" prefWidth="100"/><TableColumn fx:id="columnaEstado" text="ESTADO" prefWidth="90"/></columns><placeholder><Label text="Todavía no hay perfiles deportivos." styleClass="empty-state"/></placeholder></TableView>
  </VBox>
  <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" pannable="false" styleClass="players-detail-scroll"><StackPane styleClass="players-detail-stage">
   <VBox fx:id="panelEstadoVacio" alignment="CENTER" spacing="13" styleClass="players-empty-state"><StackPane minWidth="72" prefWidth="72" maxWidth="72" minHeight="72" prefHeight="72" maxHeight="72" styleClass="players-empty-icon"><SVGPath content="M12 3 C9.2 3 7 5.2 7 8 C7 10.8 9.2 13 12 13 C14.8 13 17 10.8 17 8 C17 5.2 14.8 3 12 3 Z M4 22 C4 16.5 7.5 14 12 14 C16.5 14 20 16.5 20 22" styleClass="players-line-icon, players-accent-icon"/></StackPane><Label text="Seleccioná un jugador" styleClass="players-empty-title"/><Label text="Consultá su vinculación, categoría vigente y evolución deportiva." wrapText="true" maxWidth="420" textAlignment="CENTER" styleClass="players-empty-description"/></VBox>
   <VBox fx:id="panelDetalleJugador" visible="false" managed="false" spacing="12" styleClass="players-detail"><padding><Insets top="18" right="24" bottom="24" left="24"/></padding>
   <HBox alignment="CENTER_LEFT" spacing="12" styleClass="players-hero"><StackPane minWidth="54" prefWidth="54" maxWidth="54" minHeight="54" prefHeight="54" maxHeight="54" styleClass="players-avatar"><SVGPath content="M12 3 C9.2 3 7 5.2 7 8 C7 10.8 9.2 13 12 13 C14.8 13 17 10.8 17 8 C17 5.2 14.8 3 12 3 Z M4 22 C4 16.5 7.5 14 12 14 C16.5 14 20 16.5 20 22" styleClass="players-line-icon, players-accent-icon"/></StackPane><VBox spacing="3"><Label fx:id="etiquetaIdentidad" text="VINCULACIÓN DEL JUGADOR" styleClass="players-eyebrow"/><Label fx:id="etiquetaNombre" text="Seleccioná un jugador" styleClass="players-name"/><Label fx:id="etiquetaVinculacion" text="—" styleClass="players-copy"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="EDITAR" onAction="#editarPerfil" styleClass="players-detail-action"><graphic><SVGPath content="M5 17 L5 20 L8 20 L19 9 L16 6 Z M14.5 7.5 L17.5 10.5" styleClass="players-action-icon"/></graphic></Button><Button fx:id="botonVincular" text="ASOCIAR FICHA" onAction="#vincularCliente" styleClass="players-detail-action"><graphic><SVGPath content="M9 14 L7 16 C5.3 17.7 5.3 20.3 7 22 C8.7 23.7 11.3 23.7 13 22 L16 19 M15 10 L17 8 C18.7 6.3 21.3 6.3 23 8 C24.7 9.7 24.7 12.3 23 14 L20 17 M10 20 L20 10" styleClass="players-action-icon"/></graphic></Button><Button fx:id="botonEstadoPerfil" text="DESACTIVAR PERFIL" onAction="#cambiarEstadoPerfil" styleClass="players-detail-danger"><graphic><SVGPath content="M6 7 L18 7 L18 20 L6 20 Z M9 4 L15 4 M10 10 L10 17 M14 10 L14 17" styleClass="players-action-icon, players-action-icon-danger"/></graphic></Button></HBox>
   <HBox spacing="10"><HBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="16" styleClass="players-category-card"><VBox spacing="3"><Label text="CATEGORÍA VIGENTE" styleClass="players-metric-label"/><Label fx:id="etiquetaCategoria" text="SIN SELECCIÓN" styleClass="players-category-value"/><Label fx:id="etiquetaCategoriaDesde" text="Consultá categoría e historial" styleClass="players-copy"/></VBox><Region HBox.hgrow="ALWAYS"/><HBox alignment="CENTER_RIGHT" spacing="7"><Button fx:id="botonAsignarCategoria" text="ASIGNAR CATEGORÍA" onAction="#asignarCategoria" styleClass="players-category-action"><graphic><SVGPath content="M4 5 L14 5 L21 12 L14 19 L4 19 Z M8 9 A1.5 1.5 0 1 0 8 12 A1.5 1.5 0 1 0 8 9" styleClass="players-action-icon, players-action-icon-primary"/></graphic></Button><Button fx:id="botonSuspenderCategoria" text="SUSPENDER" onAction="#suspenderCategoria" styleClass="players-category-secondary"><graphic><SVGPath content="M8 5 L8 19 M16 5 L16 19" styleClass="players-action-icon, players-action-icon-warning"/></graphic></Button><Button fx:id="botonFinalizarCategoria" text="FINALIZAR" onAction="#finalizarCategoria" styleClass="players-category-secondary"><graphic><SVGPath content="M5 21 L5 4 M6 5 L18 5 L15 9 L18 13 L6 13 Z" styleClass="players-action-icon"/></graphic></Button></HBox></HBox><VBox minWidth="170" styleClass="players-metric-card"><Label text="POSICIÓN" styleClass="players-metric-label"/><Label fx:id="etiquetaPosicion" text="—" styleClass="players-metric-value"/></VBox></HBox>
   <GridPane hgap="10" vgap="10"><columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
    <VBox styleClass="players-info-card"><Label text="DOCUMENTO" styleClass="players-metric-label"/><Label fx:id="etiquetaDocumento" text="—" styleClass="players-info-value"/></VBox><VBox GridPane.columnIndex="1" styleClass="players-info-card"><Label text="TELÉFONO" styleClass="players-metric-label"/><Label fx:id="etiquetaTelefono" text="—" styleClass="players-info-value"/></VBox>
    <VBox GridPane.rowIndex="1" styleClass="players-info-card"><Label text="CORREO" styleClass="players-metric-label"/><Label fx:id="etiquetaEmail" text="—" wrapText="true" styleClass="players-info-value"/></VBox><VBox GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="players-info-card"><Label text="COMUNIDAD" styleClass="players-metric-label"/><Label fx:id="etiquetaDisponibilidad" text="—" styleClass="players-info-value"/><Label fx:id="etiquetaInvitaciones" text="—" styleClass="players-copy"/></VBox>
   </GridPane>
   <Separator/><VBox spacing="3"><Label text="Historial de categorías" styleClass="section-title"/><Label fx:id="etiquetaHistorialAyuda" text="Cada cambio conserva vigencia, origen y motivo administrativo." styleClass="players-copy"/></VBox>
   <Label fx:id="etiquetaHistorialVacio" text="Seleccioná un jugador para consultar su evolución deportiva." wrapText="true" styleClass="players-empty-copy"/>
   <TableView fx:id="tablaHistorial" prefHeight="280" minHeight="240" styleClass="modern-table, players-history"><columns><TableColumn fx:id="columnaHistorialCategoria" text="CATEGORÍA" prefWidth="90"/><TableColumn fx:id="columnaHistorialPeriodo" text="VIGENCIA" prefWidth="155"/><TableColumn fx:id="columnaHistorialEstado" text="ESTADO" prefWidth="100"/><TableColumn fx:id="columnaHistorialOrigen" text="ORIGEN" prefWidth="120"/><TableColumn fx:id="columnaHistorialMotivo" text="MOTIVO" prefWidth="210"/></columns></TableView>
  </VBox></StackPane></ScrollPane>
 </SplitPane></center>
</BorderPane>
