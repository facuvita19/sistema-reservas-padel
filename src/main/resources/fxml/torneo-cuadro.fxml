<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="vista.controlador.TorneoCuadroController" styleClass="bracket-root-v2">
 <top><HBox alignment="CENTER_LEFT" spacing="14" styleClass="bracket-header-v2"><Button onAction="#volver" minWidth="42" prefWidth="42" maxWidth="42" minHeight="42" prefHeight="42" maxHeight="42" styleClass="bracket-back-button-v17"><tooltip><Tooltip text="Volver a Torneos"/></tooltip><graphic><SVGPath content="M14 6 L8 12 L14 18 M8 12 L20 12" styleClass="bracket-back-icon-v17"/></graphic></Button><StackPane minWidth="42" prefWidth="42" maxWidth="42" minHeight="42" prefHeight="42" maxHeight="42" styleClass="bracket-module-icon-shell-v17"><SVGPath content="M5 4 L9 4 L9 8 L13 8 M5 20 L9 20 L9 16 L13 16 M13 8 L13 16 M13 12 L19 12" styleClass="bracket-module-icon-v17"/></StackPane><VBox spacing="2" alignment="CENTER_LEFT" styleClass="bracket-title-block-v17"><Label text="Cuadro del torneo" styleClass="bracket-title-v2"/><Label fx:id="etiquetaContexto" text="Categoría seleccionada" styleClass="bracket-subtitle-v2"/></VBox><Region HBox.hgrow="ALWAYS"/><Label fx:id="etiquetaModo" text="MODO GESTIÓN" styleClass="bracket-mode-v7"/><Button fx:id="botonIrAGrupos" text="GRUPOS" onAction="#irAGrupos" styleClass="bracket-action-secondary"><graphic><SVGPath content="M7 10 C5.3 10 4 8.7 4 7 C4 5.3 5.3 4 7 4 C8.7 4 10 5.3 10 7 C10 8.7 8.7 10 7 10 Z M2 20 C2 15.5 4.5 13 7 13 C9.5 13 12 15.5 12 20 M17 11 C15.5 11 14.5 10 14.5 8.5 C14.5 7 15.5 6 17 6 C18.5 6 19.5 7 19.5 8.5 C19.5 10 18.5 11 17 11 Z M14 14 C17 13 21 15.5 21 20" styleClass="bracket-action-icon-v17"/></graphic></Button><Button fx:id="botonGenerar" text="GENERAR CUADRO" onAction="#generarCuadro" styleClass="bracket-action-primary"/><Button fx:id="botonImprimir" text="IMPRIMIR" onAction="#imprimirCuadro" styleClass="bracket-action-secondary"><graphic><SVGPath content="M7 8 L7 3 L17 3 L17 8 M7 17 L5 17 C4 17 3 16 3 15 L3 10 C3 9 4 8 5 8 L19 8 C20 8 21 9 21 10 L21 15 C21 16 20 17 19 17 L17 17 M7 14 L17 14 L17 21 L7 21 Z" styleClass="bracket-action-icon-v17"/></graphic></Button><Button fx:id="botonInvalidar" text="INVALIDAR" onAction="#invalidarCuadro" styleClass="bracket-action-danger"/></HBox></top>
 <center><VBox spacing="12" styleClass="bracket-content-v2"><padding><Insets top="15" right="20" bottom="18" left="20"/></padding>

  <HBox spacing="10" alignment="CENTER_LEFT" styleClass="bracket-toolbar-v20"><VBox spacing="1" alignment="TOP_LEFT"><Label text="FASE" styleClass="bracket-filter-label-v17"/><ComboBox fx:id="filtroFase" promptText="Todas las fases" minWidth="210" prefWidth="210" maxWidth="210" styleClass="bracket-filter-v2"/></VBox><VBox spacing="1" alignment="TOP_LEFT"><Label text="ESTADO" styleClass="bracket-filter-label-v17"/><ComboBox fx:id="filtroEstado" promptText="Todos los estados" minWidth="210" prefWidth="210" maxWidth="210" styleClass="bracket-filter-v2"/></VBox><VBox spacing="1" alignment="TOP_LEFT"><Label text="ACCIONES" styleClass="bracket-filter-label-v17"/><HBox spacing="8" alignment="CENTER_LEFT" styleClass="bracket-filter-actions-v19"><Button text="LIMPIAR" onAction="#limpiarFiltros" minWidth="112" prefWidth="112" maxWidth="112" styleClass="bracket-clear-v2"><graphic><SVGPath content="M7 7 L17 17 M17 7 L7 17" styleClass="bracket-toolbar-icon-v19"/></graphic></Button><Button text="ACTUALIZAR" onAction="#cargar" minWidth="128" prefWidth="128" maxWidth="128" styleClass="bracket-refresh-v19"><graphic><SVGPath content="M19 7 A8 8 0 1 0 20 15 M19 3 L19 7 L15 7" styleClass="bracket-toolbar-icon-v19"/></graphic></Button></HBox></VBox><Region HBox.hgrow="ALWAYS"/><VBox spacing="0" alignment="CENTER_RIGHT"><Label fx:id="etiquetaResumen" text="Sin partidos" styleClass="bracket-summary-v2"/><HBox fx:id="tarjetaCampeona" visible="false" managed="false"><Label fx:id="etiquetaTrofeo" text=""/><Label fx:id="etiquetaCampeona" text=""/><Label fx:id="etiquetaResultadoFinal" text=""/></HBox></VBox></HBox>
  <SplitPane dividerPositions="0.69" VBox.vgrow="ALWAYS" styleClass="bracket-split-v2"><items>
   <VBox spacing="8" styleClass="bracket-card-v2"><Label text="PARTIDOS ELIMINATORIOS" styleClass="bracket-overline-v2"/><TableView fx:id="tablaPartidos" VBox.vgrow="ALWAYS" fixedCellSize="58" focusTraversable="false" styleClass="bracket-table-v2"><columns><TableColumn fx:id="colFase" text="FASE" prefWidth="125"/><TableColumn fx:id="colOrden" text="PARTIDO" prefWidth="66"/><TableColumn fx:id="colPareja1" text="PAREJA 1" prefWidth="230"/><TableColumn fx:id="colPareja2" text="PAREJA 2" prefWidth="230"/><TableColumn fx:id="colResultado" text="RESULTADO" prefWidth="145"/><TableColumn fx:id="colEstado" text="ESTADO" prefWidth="112"/></columns><placeholder><VBox alignment="CENTER" spacing="6"><Label text="Todavía no hay cuadro eliminatorio" styleClass="bracket-empty-title-v2"/><Label text="Usá la acción superior para generar la etapa competitiva cuando se cumplan los requisitos." maxWidth="520" wrapText="true" styleClass="bracket-empty-copy-v2"/></VBox></placeholder></TableView></VBox>
   <StackPane minWidth="470" prefWidth="490" styleClass="bracket-detail-shell-v2">
    <VBox fx:id="panelDetalleVacio" alignment="CENTER" spacing="8" styleClass="bracket-detail-empty-v2"><Label text="SELECCIONÁ UN PARTIDO" styleClass="bracket-detail-empty-title"/><Label text="Elegí un cruce para consultar su programación, resultado y acciones disponibles." maxWidth="285" wrapText="true" styleClass="bracket-detail-empty-copy"/></VBox>
    <ScrollPane fx:id="scrollDetallePartido" visible="false" managed="false" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="bracket-detail-scroll-v18"><VBox fx:id="panelGestionPartido" spacing="10" styleClass="bracket-detail-v2"><padding><Insets top="16" right="16" bottom="16" left="16"/></padding><Label fx:id="etiquetaTituloPanel" text="DETALLE DEL PARTIDO" styleClass="bracket-overline-v2"/><Label fx:id="etiquetaPartido" wrapText="true" maxWidth="Infinity" minHeight="48" styleClass="bracket-detail-title-v2"/><Label fx:id="etiquetaEnfrentamiento" text="" wrapText="true" maxWidth="Infinity" minHeight="52" styleClass="bracket-match-text-v2"/>
     <VBox fx:id="panelProgramacion" spacing="8" styleClass="bracket-section-v2"><Label text="PROGRAMACIÓN" styleClass="bracket-section-title-v2"/><Label text="Cancha" styleClass="bracket-field-label-v2"/><ComboBox fx:id="comboCancha" maxWidth="Infinity" styleClass="bracket-input-v2, bracket-reservation-combo-v24"/><Label text="Fecha" styleClass="bracket-field-label-v2"/><DatePicker fx:id="selectorFecha" maxWidth="Infinity" styleClass="bracket-input-v2, bracket-reservation-date-v24"/><HBox spacing="8"><VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Inicio" styleClass="bracket-field-label-v2"/><ComboBox fx:id="comboInicio" maxWidth="Infinity" styleClass="bracket-input-v2, bracket-reservation-combo-v24"/></VBox><VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Fin" styleClass="bracket-field-label-v2"/><ComboBox fx:id="comboFin" maxWidth="Infinity" styleClass="bracket-input-v2, bracket-reservation-combo-v24"/></VBox></HBox><Button fx:id="botonProgramar" text="GUARDAR PROGRAMACIÓN" onAction="#programar" maxWidth="Infinity" styleClass="bracket-action-primary"/><Button fx:id="botonQuitar" text="QUITAR PROGRAMACIÓN" onAction="#quitarProgramacion" maxWidth="Infinity" styleClass="bracket-action-danger-outline"/></VBox>
     <VBox fx:id="panelResultado" visible="false" managed="false" spacing="6" styleClass="bracket-section-v2 bracket-result-v2"><Label text="RESULTADO" styleClass="bracket-section-title-v2"/><Label fx:id="etiquetaMarcador" text="-" wrapText="true" styleClass="bracket-score-v2"/><Label text="GANADORES" styleClass="bracket-field-label-v2"/><Label fx:id="etiquetaGanadora" text="-" wrapText="true" styleClass="bracket-winner-v2"/><Label fx:id="etiquetaFinalizacion" text="-" wrapText="true" styleClass="bracket-meta-v2"/><Label fx:id="etiquetaObservaciones" text="" wrapText="true" styleClass="bracket-meta-v2"/></VBox>
     <Button fx:id="botonResultado" text="REGISTRAR RESULTADO" onAction="#registrarResultado" maxWidth="Infinity" styleClass="bracket-action-result-secondary"/><HBox fx:id="bloqueCorreccionResultado" spacing="12" alignment="CENTER_LEFT" styleClass="bracket-correction-row-v18"><Label text="La corrección puede alterar ganadores y cruces posteriores." wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="bracket-correction-copy-v18"/><Button fx:id="botonCorregirResultado" text="CORREGIR RESULTADO" onAction="#corregirResultado" minWidth="184" prefWidth="184" maxWidth="184" styleClass="bracket-action-danger-outline"/></HBox>
     <ScrollPane fx:id="scrollHistorial" visible="false" managed="false" fitToWidth="true" vbarPolicy="NEVER" hbarPolicy="NEVER" pannable="false" styleClass="bracket-history-flat-v21"><VBox><VBox fx:id="panelHistorial" visible="false" managed="false" spacing="7" styleClass="bracket-history-v2"><Label text="HISTORIAL DE CORRECCIONES" styleClass="bracket-field-label-v2"/><VBox fx:id="contenedorHistorial" spacing="7"/></VBox><Label fx:id="etiquetaSinHistorial" text="Este partido no tiene correcciones registradas." visible="false" managed="false" wrapText="true" styleClass="bracket-history-empty-v2"/></VBox></ScrollPane>
     <Region VBox.vgrow="ALWAYS"/><Label fx:id="etiquetaMensaje" wrapText="true" styleClass="bracket-message-v2"/>
    </VBox></ScrollPane>
   </StackPane>
  </items>
  </SplitPane>
 </VBox></center>
</BorderPane>
