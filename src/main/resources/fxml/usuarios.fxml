<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<!-- compactar-usuarios-unificado-v1 -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="vista.controlador.UsuariosController" styleClass="module-root, users-root">
 <top>
  <HBox alignment="CENTER_LEFT" spacing="16" styleClass="module-header, users-module-header-v1"><padding><Insets top="12" right="24" bottom="12" left="24"/></padding>
   <Button onAction="#volver" minWidth="42" prefWidth="42" maxWidth="42" minHeight="42" prefHeight="42" maxHeight="42" styleClass="users-back-button-v1"><tooltip><Tooltip text="Volver al inicio"/></tooltip><graphic><SVGPath content="M14 6 L8 12 L14 18 M8 12 L20 12" styleClass="users-back-icon-v1"/></graphic></Button>
   <StackPane minWidth="42" prefWidth="42" maxWidth="42" minHeight="42" prefHeight="42" maxHeight="42" styleClass="users-module-icon-shell-v1"><SVGPath content="M9 11 C6.8 11 5 9.2 5 7 C5 4.8 6.8 3 9 3 C11.2 3 13 4.8 13 7 C13 9.2 11.2 11 9 11 Z M3 21 C3 16 6 13 9 13 C12 13 15 16 15 21 M17 8 L21 8 L21 18 L17 18 Z" styleClass="users-module-icon-v1"/></StackPane>
   <VBox spacing="2" styleClass="users-title-block-v1"><Label text="Gestión de usuarios" styleClass="page-title"/><Label text="Administrá accesos, roles y contraseñas del personal." styleClass="page-subtitle"/></VBox>
   <Region HBox.hgrow="ALWAYS"/>
   <HBox alignment="CENTER_LEFT" spacing="8" styleClass="user-session-card-v1"><StackPane minWidth="26" prefWidth="26" maxWidth="26" minHeight="26" prefHeight="26" maxHeight="26" styleClass="user-session-icon-shell-v1"><SVGPath content="M12 3 C9.8 3 8 4.8 8 7 C8 9.2 9.8 11 12 11 C14.2 11 16 9.2 16 7 C16 4.8 14.2 3 12 3 Z M5 21 C5 16 8 13 12 13 C16 13 19 16 19 21" styleClass="user-session-icon-v1"/></StackPane><VBox spacing="0"><Label text="SESIÓN ACTUAL" styleClass="user-session-eyebrow-v1"/><Label fx:id="etiquetaSesion" styleClass="user-session-value-v1"/></VBox></HBox>
   <Button text="NUEVO USUARIO" onAction="#nuevoUsuario" styleClass="users-new-button-v1"><graphic><StackPane minWidth="18" prefWidth="18" maxWidth="18" minHeight="18" prefHeight="18" maxHeight="18"><SVGPath content="M9 11 C6.8 11 5 9.2 5 7 C5 4.8 6.8 3 9 3 C11.2 3 13 4.8 13 7 C13 9.2 11.2 11 9 11 Z M3 21 C3 16 6 13 9 13 C12 13 15 16 15 21 M18 12 L18 18 M15 15 L21 15" styleClass="users-action-icon-v1"/></StackPane></graphic></Button>
  </HBox>
 </top>
 <center>
  <SplitPane dividerPositions="0.60" styleClass="module-split, users-split-v1">
   <VBox spacing="10" styleClass="list-panel, users-list-v1"><padding><Insets top="16" right="18" bottom="18" left="24"/></padding>
    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="users-filter-row-v1">
     <StackPane alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="users-search-shell-v1"><TextField fx:id="campoBuscar" promptText="Buscar por usuario, rol o estado..." maxWidth="Infinity" styleClass="users-search-field-v1"/><StackPane mouseTransparent="true" minWidth="40" prefWidth="40" maxWidth="40" minHeight="40" prefHeight="40" maxHeight="40" StackPane.alignment="CENTER_LEFT"><SVGPath content="M10.5 4 A6.5 6.5 0 1 0 10.5 17 A6.5 6.5 0 1 0 10.5 4 M15.5 15.5 L21 21" styleClass="users-search-icon-v1"/></StackPane></StackPane>
     <CheckBox fx:id="checkMostrarInactivos" text="INACTIVOS" styleClass="user-filter-check, users-inactive-filter-v1"><tooltip><Tooltip text="Mostrar también usuarios inactivos"/></tooltip></CheckBox>
     <Button text="LIMPIAR" onAction="#limpiarFiltros" styleClass="users-filter-button-v1"><graphic><SVGPath content="M6 6 L18 18 M18 6 L6 18" styleClass="users-button-icon-v1"/></graphic></Button>
     <Button text="ACTUALIZAR" onAction="#cargarUsuarios" styleClass="users-refresh-button-v1"><graphic><SVGPath content="M16.5 6 A6.5 6.5 0 1 0 17.5 13 M16.5 6 L16.5 2.5 M16.5 6 L13 6" styleClass="users-refresh-icon-v1"/></graphic></Button>
    </HBox>
    <HBox alignment="CENTER_LEFT" styleClass="users-results-bar-v1"><Label fx:id="etiquetaResultados" text="0 usuarios visibles" styleClass="users-results-text-v1"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="etiquetaAyudaListado" text="Seleccioná un usuario para editarlo" styleClass="users-results-hint-v1"/></HBox>
    <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS" styleClass="modern-table, users-table-v1"><columns><TableColumn fx:id="columnaNombre" text="USUARIO" prefWidth="190" styleClass="user-name-column-v1"/><TableColumn fx:id="columnaRol" text="ROL" prefWidth="145" styleClass="user-centered-column-v1"/><TableColumn fx:id="columnaActivo" text="ESTADO" prefWidth="110" styleClass="user-centered-column-v1"/><TableColumn fx:id="columnaFecha" text="CREADO" prefWidth="155" styleClass="user-centered-column-v1"/></columns><placeholder><Label text="No hay usuarios para mostrar." styleClass="empty-state"/></placeholder></TableView>
   </VBox>
   <ScrollPane fx:id="scrollDetalleUsuario" fitToWidth="true" hbarPolicy="NEVER" styleClass="form-scroll"><VBox spacing="10" styleClass="form-card, users-form-v1"><padding><Insets top="16" right="22" bottom="22" left="22"/></padding>
    <VBox spacing="6" styleClass="user-detail-header"><HBox alignment="CENTER_LEFT" spacing="10"><StackPane minWidth="36" prefWidth="36" maxWidth="36" minHeight="36" prefHeight="36" maxHeight="36" styleClass="user-detail-icon-shell-v1"><SVGPath content="M9 11 C6.8 11 5 9.2 5 7 C5 4.8 6.8 3 9 3 C11.2 3 13 4.8 13 7 C13 9.2 11.2 11 9 11 Z M3 21 C3 16 6 13 9 13 C12 13 15 16 15 21 M17 8 L21 8 L21 18 L17 18 Z" styleClass="user-detail-icon-v1"/></StackPane><VBox spacing="1"><Label fx:id="etiquetaModoUsuario" text="NUEVO USUARIO" styleClass="user-detail-eyebrow-v1"/><Label fx:id="tituloFormulario" text="Nuevo usuario del personal" styleClass="section-title"/></VBox><Region HBox.hgrow="ALWAYS"/><Label fx:id="insigniaEstadoUsuario" text="ACTIVO" visible="false" managed="false" styleClass="user-detail-status"/></HBox><Label fx:id="subtituloFormulario" text="Creá una cuenta individual para el personal." wrapText="true" styleClass="user-detail-subtitle"/></VBox>
    <Label text="Nombre de usuario *" styleClass="field-label"/><TextField fx:id="campoNombreUsuario" promptText="Ejemplo: operador.turno" styleClass="modern-field"/>
    <Label text="Rol *" styleClass="field-label"/><ComboBox fx:id="comboRol" maxWidth="Infinity" styleClass="modern-combo"/>
    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="user-role-note"><StackPane minWidth="30" prefWidth="30" maxWidth="30" minHeight="30" prefHeight="30" maxHeight="30" styleClass="user-role-icon-shell-v1"><SVGPath content="M12 3 L20 6 L20 12 C20 17 16 20 12 22 C8 20 4 17 4 12 L4 6 Z M8 12 L11 15 L16 9" styleClass="user-role-icon-v1"/></StackPane><VBox spacing="3" HBox.hgrow="ALWAYS"><Label text="PERMISOS DEL ROL" styleClass="metric-label"/><Label fx:id="etiquetaPermisos" wrapText="true" styleClass="user-role-copy"/></VBox></HBox>
    <VBox fx:id="contenedorPasswordAlta" spacing="6"><Label text="Contraseña *" styleClass="field-label"/><PasswordField fx:id="campoPassword" promptText="Mínimo 8 caracteres" styleClass="modern-field"/><Label text="Confirmar contraseña *" styleClass="field-label"/><PasswordField fx:id="campoConfirmarPassword" promptText="Repetir contraseña" styleClass="modern-field"/><Label fx:id="etiquetaAyudaPassword" wrapText="true" styleClass="user-password-help-v1"/></VBox>
    <HBox fx:id="contenedorPasswordEdicion" alignment="CENTER_LEFT" spacing="9" visible="false" managed="false" styleClass="user-password-note"><StackPane minWidth="28" prefWidth="28" maxWidth="28" minHeight="28" prefHeight="28" maxHeight="28" styleClass="user-password-icon-shell-v1"><SVGPath content="M8 11 L16 11 L16 21 L8 21 Z M10 11 L10 8 C10 5 14 5 14 8 L14 11 M12 15 L12 18" styleClass="user-password-icon-v1"/></StackPane><Label fx:id="etiquetaPasswordEdicion" text="La contraseña se gestiona desde Restablecer contraseña." wrapText="true" HBox.hgrow="ALWAYS"/></HBox>
    <Label fx:id="etiquetaMensaje" wrapText="true" visible="false" managed="false" styleClass="user-form-message-v1"/>
    <HBox spacing="12" styleClass="user-primary-actions-v1"><Button fx:id="botonGuardar" text="CREAR USUARIO" onAction="#guardar" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="user-save-button-v1"><graphic><SVGPath content="M4 3 L18 3 L21 6 L21 21 L3 21 L3 3 Z M7 3 L7 9 L17 9 L17 3 M7 15 L17 15 L17 21 L7 21 Z" styleClass="users-button-icon-v1"/></graphic></Button><Button fx:id="botonEstado" text="DESACTIVAR USUARIO" onAction="#cambiarEstado" visible="false" managed="false" styleClass="user-state-button-v1"><graphic><SVGPath fx:id="iconoEstadoUsuario" content="M12 3 C7 3 3 7 3 12 C3 17 7 21 12 21 C17 21 21 17 21 12 C21 7 17 3 12 3 M7 12 L17 12" styleClass="users-button-icon-v1"/></graphic></Button></HBox>
    <Button fx:id="botonRestablecer" text="RESTABLECER CONTRASEÑA" onAction="#restablecerPassword" visible="false" managed="false" maxWidth="Infinity" styleClass="user-reset-button-v1"><graphic><SVGPath content="M8 11 L16 11 L16 21 L8 21 Z M10 11 L10 8 C10 5 14 5 14 8 L14 11 M19 6 L19 2 L15 2" styleClass="users-button-icon-v1"/></graphic></Button>
   </VBox></ScrollPane>
  </SplitPane>
 </center>
</BorderPane>
