<?xml version="1.0" encoding="UTF-8"?>
<!-- estabilizar-historial-scroll-reservas-v1 -->
<!-- corregir-imperfecciones-reservas-v1 -->
<!-- gestion-reservas-distribucion-final-v2 -->
<!-- corregir-clases-reservas-compactas-v2 -->
<!-- gestion-reservas-compacta-v1 -->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="vista.controlador.ReservasController" styleClass="module-root, reservations-root">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="module-header">
            <padding><Insets top="22" right="28" bottom="22" left="28" /></padding>
            <Button text="INICIO" onAction="#volver" styleClass="admin-home-button" />
            <VBox spacing="3">
                <Label text="Gestión de reservas" styleClass="page-title" />
                <Label text="Consultá disponibilidad y administrá la agenda del complejo." styleClass="page-subtitle" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="NUEVA RESERVA" onAction="#nuevaReserva" styleClass="primary-button" />
        </HBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.68" styleClass="module-split, reservation-split-compact">
            <VBox spacing="10" styleClass="list-panel, reservation-list-compact">
                <padding><Insets top="14" right="14" bottom="14" left="18" /></padding>
                <VBox spacing="8" styleClass="reservation-filter-stack">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Button text="‹" onAction="#diaAnterior" styleClass="reservation-date-button" />
                        <Button text="HOY" onAction="#irHoy" styleClass="secondary-button" />
                        <Button text="›" onAction="#diaSiguiente" styleClass="reservation-date-button" />
                        <DatePicker fx:id="filtroFecha" prefWidth="155" styleClass="modern-date" />
                        <Label fx:id="etiquetaFechaSeleccionada" text="Reservas de hoy" styleClass="reservation-date-label" />
                        <Region HBox.hgrow="ALWAYS" />

                    </HBox>
                    <HBox spacing="10">
                        <TextField fx:id="campoBuscar" promptText="Buscar por cliente, cancha o estado..." HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="modern-field, reservation-search-compact" />
                        <ComboBox fx:id="filtroEstado" promptText="Todos los estados" minWidth="150" prefWidth="150" maxWidth="150" styleClass="modern-combo, reservation-state-compact" />
                        <Button text="LIMPIAR" minWidth="88" prefWidth="88" onAction="#limpiarFiltros" styleClass="secondary-button, reservation-clear-compact" /><Button text="ACTUALIZAR" minWidth="96" prefWidth="96" onAction="#cargarReservas" styleClass="secondary-button, reservation-refresh-compact" />
                    </HBox>
                </VBox>
                <TableView fx:id="tablaReservas" VBox.vgrow="ALWAYS" styleClass="modern-table">
                    <columns>
                        <TableColumn fx:id="columnaFecha" text="FECHA" prefWidth="96" />
                        <TableColumn fx:id="columnaHorario" text="HORARIO" prefWidth="115" />
                        <TableColumn fx:id="columnaCancha" text="CANCHA" prefWidth="145" />
                        <TableColumn fx:id="columnaCliente" text="CLIENTE" prefWidth="175" />
                        <TableColumn fx:id="columnaEstado" text="ESTADO" prefWidth="115" />
                        <TableColumn fx:id="columnaPrecio" text="PRECIO" prefWidth="125" styleClass="reservation-price-column" />
                    </columns>
                    <placeholder><Label text="Todavía no hay reservas registradas." styleClass="empty-state" /></placeholder>
                </TableView>
            </VBox>
            <ScrollPane fx:id="scrollFormulario" fitToWidth="true" hbarPolicy="NEVER" styleClass="form-scroll">
                <VBox spacing="10" styleClass="form-card, reservation-form-compact">
                    <padding><Insets top="14" right="18" bottom="30" left="18" /></padding>
                    <VBox fx:id="avisoModoReprogramacion"
                          visible="false" managed="false" spacing="5"
                          styleClass="reservation-reprogram-banner">
                        <Label text="MODO REPROGRAMACIÓN ACTIVO"
                               styleClass="reservation-reprogram-title" />
                        <Label text="Elegí una nueva cancha, fecha y horario. Después pulsá GUARDAR REPROGRAMACIÓN."
                               wrapText="true" styleClass="reservation-reprogram-text" />
                    </VBox>
                    <VBox spacing="4" styleClass="reservation-detail-header, reservation-detail-header-compact">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="tituloFormulario" text="Nueva reserva" styleClass="section-title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="insigniaOrigenDetalle" text="PERSONAL"
                                   visible="false" managed="false"
                                   styleClass="reservation-origin-badge" />
                            <Label fx:id="insigniaEstadoDetalle" text="Esperando seña"
                                   visible="false" managed="false"
                                   styleClass="reservation-detail-status-badge" />
                        </HBox>
                        <Label fx:id="subtituloFormulario"
                               text="Completá los datos para registrar un nuevo turno."
                               wrapText="true" styleClass="reservation-detail-subtitle" />
                        <Label fx:id="etiquetaVencimientoDetalle"
                               visible="false" managed="false" wrapText="true"
                               styleClass="reservation-expiration-badge" />
                    </VBox>
                    <Label text="Cliente *" styleClass="field-label" />
                    <ComboBox fx:id="comboCliente" maxWidth="Infinity" visibleRowCount="7" promptText="Seleccionar cliente" styleClass="modern-combo" />
                    <Label text="Cancha *" styleClass="field-label" />
                    <ComboBox fx:id="comboCancha" maxWidth="Infinity" visibleRowCount="6" promptText="Seleccionar cancha" styleClass="modern-combo" />
                    <GridPane hgap="12" vgap="10">
                        <columnConstraints><ColumnConstraints percentWidth="50" hgrow="ALWAYS" /><ColumnConstraints percentWidth="50" hgrow="ALWAYS" /></columnConstraints>
                        <VBox spacing="7" GridPane.columnIndex="0"><Label text="Fecha *" styleClass="field-label" /><DatePicker fx:id="selectorFecha" maxWidth="Infinity" styleClass="modern-date" /></VBox>
                        <VBox spacing="7" GridPane.columnIndex="1"><Label text="Horario disponible *" styleClass="field-label" /><ComboBox fx:id="comboHorario" maxWidth="Infinity" visibleRowCount="7" promptText="Seleccionar" styleClass="modern-combo" /></VBox>
                    </GridPane>
                    <GridPane hgap="8" styleClass="price-summary, reservation-metrics">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="36" hgrow="ALWAYS" />
                            <ColumnConstraints percentWidth="36" hgrow="ALWAYS" />
                            <ColumnConstraints percentWidth="28" hgrow="ALWAYS" />
                        </columnConstraints>
                        <VBox spacing="4" GridPane.columnIndex="0" styleClass="reservation-metric-block">
                            <Label text="PRECIO TOTAL" styleClass="metric-label" />
                            <Label fx:id="etiquetaPrecio" text="ARS 0" styleClass="reservation-price" />
                        </VBox>
                        <VBox spacing="4" GridPane.columnIndex="1" styleClass="reservation-metric-block, reservation-balance-block">
                            <Label text="SALDO PENDIENTE" styleClass="metric-label" />
                            <Label fx:id="etiquetaSaldoPendiente" text="ARS 0" styleClass="reservation-balance" />
                        </VBox>
                        <VBox spacing="5" alignment="CENTER_RIGHT" GridPane.columnIndex="2" styleClass="reservation-player-block">
                            <Label text="JUGADORES" styleClass="metric-label" />
                            <Spinner fx:id="spinnerJugadores" prefWidth="92" editable="false" />
                        </VBox>
                    </GridPane>
                    <Label text="Comentarios del cliente" styleClass="field-label" />
                    <TextArea fx:id="campoComentarios" prefRowCount="2" prefHeight="58" minHeight="58" maxHeight="58" wrapText="true" promptText="Ejemplo: partido amistoso..." styleClass="modern-area, reservation-area-compact" />
                    <Label text="Observaciones administrativas" styleClass="field-label" />
                    <TextArea fx:id="campoObservaciones" prefRowCount="2" prefHeight="58" minHeight="58" maxHeight="58" wrapText="true" promptText="Información privada para el personal..." styleClass="modern-area, reservation-area-compact" />
                    <VBox fx:id="contenedorCancelacion" visible="false" managed="false" spacing="6" styleClass="cancellation-detail">
                        <Label text="DETALLE DE CANCELACIÓN" styleClass="metric-label" />
                        <Label fx:id="etiquetaCancelacion" wrapText="true" styleClass="cancellation-detail-text" />
                    </VBox>
                    <VBox fx:id="contenedorAuditoria"
                          visible="false"
                          managed="false"
                          spacing="8"
                          styleClass="audit-panel">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="HISTORIAL DE LA RESERVA"
                                   styleClass="audit-title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="etiquetaCantidadAuditoria"
                                   text="" styleClass="audit-count-badge" />
                            <Label text="Más recientes primero"
                                   styleClass="small-caption" />
                        </HBox>
                        <ListView fx:id="listaAuditoria"
                                  prefHeight="250"
                                  minHeight="250"
                                  maxHeight="250"
                                  maxWidth="Infinity"
                                  styleClass="audit-list" />
                    </VBox>
                    <Label fx:id="etiquetaMensaje" minHeight="22" wrapText="true" />
                    <Button fx:id="botonGuardar" text="GUARDAR RESERVA" onAction="#guardar" maxWidth="Infinity" styleClass="primary-button" />
                    <Button fx:id="botonWhatsApp" text="ABRIR WHATSAPP" onAction="#abrirWhatsApp" maxWidth="Infinity"
                            visible="false" managed="false" styleClass="whatsapp-button" />
                    <VBox fx:id="contenedorAccionesReserva" spacing="7"
                          styleClass="reservation-secondary-actions">
                        <HBox spacing="7">
                            <Button fx:id="botonAccionPrincipal" text="CONFIRMAR RESERVA" onAction="#ejecutarAccionPrincipal" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="status-confirm-button" />
                            <Button fx:id="botonPagos" text="ABRIR PAGOS" onAction="#abrirPagos" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="payment-button" />
                        </HBox>
                        <HBox spacing="7">
                            <Button fx:id="botonReprogramar" text="REPROGRAMAR" onAction="#iniciarReprogramacion" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="reschedule-button" />
                            <Button fx:id="botonCancelar" text="CANCELAR RESERVA" onAction="#cancelarReserva" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="danger-button" />
                        </HBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </SplitPane>
    </center>
</BorderPane>
