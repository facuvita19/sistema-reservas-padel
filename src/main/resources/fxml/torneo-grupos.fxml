<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="vista.controlador.TorneoGruposController"
            styleClass="groups-root">
    <top>
        <HBox spacing="14" alignment="CENTER_LEFT" styleClass="groups-header">
            <padding><Insets top="18" right="24" bottom="18" left="24"/></padding>
            <Button text="VOLVER A TORNEOS" onAction="#volver"/>
            <Button text="IR AL CUADRO" onAction="#irAlCuadro"/>
            <VBox><Label text="GESTIÓN DE GRUPOS" styleClass="groups-overline"/><Label fx:id="titulo" text="Categoría" styleClass="groups-title"/></VBox>
            <Region HBox.hgrow="ALWAYS"/><Label fx:id="resumen"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="groups-scroll">
            <content>
                <VBox spacing="16" styleClass="groups-content">
                    <padding><Insets top="18" right="24" bottom="22" left="24"/></padding>
                    <GridPane hgap="16">
                        <columnConstraints><ColumnConstraints percentWidth="33.333" minWidth="0"/><ColumnConstraints percentWidth="33.333" minWidth="0"/><ColumnConstraints percentWidth="33.334" minWidth="0"/></columnConstraints>
                        <VBox spacing="10" styleClass="groups-card" GridPane.columnIndex="0" maxWidth="Infinity">
                            <Label text="PAREJAS SIN ASIGNAR" styleClass="groups-section"/><ListView fx:id="sinAsignar" fixedCellSize="48" prefHeight="250" minWidth="0"/><Button text="AGREGAR AL GRUPO" onAction="#agregar" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="10" styleClass="groups-card" GridPane.columnIndex="1" maxWidth="Infinity">
                            <Label text="GRUPOS" styleClass="groups-section"/><ListView fx:id="listaGrupos" fixedCellSize="48" prefHeight="250" minWidth="0"/><ComboBox fx:id="cabeza" promptText="Seleccionar cabeza de serie" maxWidth="Infinity" minWidth="0"/><Button text="MARCAR CABEZA DE SERIE" onAction="#agregarCabeza" maxWidth="Infinity"/><Button text="SORTEAR RESTO" onAction="#sortear" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="10" styleClass="groups-card" GridPane.columnIndex="2" maxWidth="Infinity">
                            <Label text="INTEGRANTES" styleClass="groups-section"/><ListView fx:id="integrantes" fixedCellSize="48" prefHeight="250" minWidth="0"/><Button text="QUITAR DEL GRUPO" onAction="#quitar" maxWidth="Infinity"/><ComboBox fx:id="modo" maxWidth="Infinity" minWidth="0"/><Button fx:id="confirmar" text="CONFIRMAR GRUPOS" onAction="#confirmar" maxWidth="Infinity"/><Button fx:id="generarPartidos" text="GENERAR PARTIDOS" onAction="#generarPartidos" maxWidth="Infinity"/><Label fx:id="mensaje" wrapText="true"/>
                        </VBox>
                    </GridPane>
                    <VBox spacing="12" styleClass="groups-card, groups-matches-card">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <VBox>
                                <Label text="PARTIDOS DEL GRUPO" styleClass="groups-section"/>
                                <Label fx:id="resumenPartidos" text="Selecciona un grupo"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="GRUPO" styleClass="groups-section"/>
                            <ComboBox fx:id="selectorGrupoPartidos"
                                      promptText="Seleccionar grupo"
                                      prefWidth="190"
                                      styleClass="groups-quick-selector"/>
                        </HBox>
                        <TableView fx:id="tablaPartidos" prefHeight="260" fixedCellSize="48">
                            <columns><TableColumn fx:id="colTipo" text="TIPO" prefWidth="210"/><TableColumn fx:id="colOrden" text="#" prefWidth="55"/><TableColumn fx:id="colPareja1" text="PAREJA 1" prefWidth="230"/><TableColumn fx:id="colPareja2" text="PAREJA 2" prefWidth="230"/><TableColumn fx:id="colResultado" text="RESULTADO" prefWidth="150"/><TableColumn fx:id="colEstado" text="ESTADO" prefWidth="130"/></columns>
                        </TableView>
                        <GridPane hgap="10" vgap="8">
                            <columnConstraints><ColumnConstraints percentWidth="25"/><ColumnConstraints percentWidth="25"/><ColumnConstraints percentWidth="25"/><ColumnConstraints percentWidth="25"/></columnConstraints>
                            <ComboBox fx:id="comboCancha" promptText="Cancha" maxWidth="Infinity" GridPane.columnIndex="0"/><DatePicker fx:id="selectorFecha" promptText="Fecha" maxWidth="Infinity" GridPane.columnIndex="1"/><ComboBox fx:id="comboInicio" promptText="Inicio" maxWidth="Infinity" GridPane.columnIndex="2"/><ComboBox fx:id="comboFin" promptText="Fin" maxWidth="Infinity" GridPane.columnIndex="3"/>
                        </GridPane>
                        <FlowPane hgap="9" vgap="9"><Button fx:id="botonProgramar" text="PROGRAMAR" onAction="#programarPartido"/><Button fx:id="botonQuitarProgramacion" text="QUITAR PROGRAMACIÓN" onAction="#quitarProgramacion"/><Button fx:id="botonResultado" text="REGISTRAR RESULTADO" onAction="#registrarResultado"/><Button fx:id="botonCorregir" text="CORREGIR RESULTADO" onAction="#corregirResultado"/></FlowPane>
                    </VBox>
                    <VBox spacing="10" styleClass="groups-card, groups-positions-card">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="POSICIONES DEL GRUPO" styleClass="groups-section"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="estadoPosiciones" text="Posiciones provisorias" styleClass="groups-positions-state"/>
                        </HBox>
                        <TableView fx:id="tablaPosiciones" prefHeight="225" fixedCellSize="44">
                            <columns>
                                <TableColumn fx:id="colPosicion" text="POS." prefWidth="55"/>
                                <TableColumn fx:id="colParejaPosicion" text="PAREJA" prefWidth="260"/>
                                <TableColumn fx:id="colPJ" text="PJ" prefWidth="48"/>
                                <TableColumn fx:id="colPG" text="PG" prefWidth="48"/>
                                <TableColumn fx:id="colPP" text="PP" prefWidth="48"/>
                                <TableColumn fx:id="colSets" text="SETS" prefWidth="75"/>
                                <TableColumn fx:id="colDifSets" text="DIF. S" prefWidth="65"/>
                                <TableColumn fx:id="colGames" text="GAMES" prefWidth="85"/>
                                <TableColumn fx:id="colDifGames" text="DIF. G" prefWidth="65"/>
                                <TableColumn fx:id="colClasificacion" text="ESTADO" prefWidth="155"/>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
