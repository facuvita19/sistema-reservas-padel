<?xml version="1.0" encoding="UTF-8"?>
<!-- resaltar-boton-cuadro-torneos-v1 -->
<!-- torneos-distribucion-compacta-v2 -->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="vista.controlador.TorneosController" styleClass="tournaments-root-v2">
 <top><HBox alignment="CENTER_LEFT" spacing="14" styleClass="tournaments-header-v2"><padding><Insets top="16" right="22" bottom="16" left="22"/></padding><Button text="INICIO" onAction="#volver" styleClass="admin-home-button"/><VBox spacing="2"><Label text="Torneos" styleClass="tournaments-title-v2"/><Label text="Gestioná el calendario, las categorías y el ciclo competitivo." styleClass="tournaments-subtitle-v2"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="INSCRIPCIONES" onAction="#verInscripciones" styleClass="tournaments-action-secondary"/><Button text="NUEVO TORNEO" onAction="#nuevoTorneo" styleClass="tournaments-action-primary"/></HBox></top>
 <center><SplitPane dividerPositions="0.33" styleClass="tournaments-split-v2, tournaments-split-compact"><items>
  <VBox spacing="10" styleClass="tournaments-list-pane, tournaments-list-pane-compact"><padding><Insets top="14" right="14" bottom="14" left="18"/></padding>
   <VBox spacing="2"><Label text="LISTADO GENERAL" styleClass="tournaments-overline-v2"/><Label text="Torneos registrados" styleClass="tournaments-section-title-v2"/></VBox>
   <HBox spacing="8"><TextField fx:id="campoBuscar" promptText="Buscar torneo" HBox.hgrow="ALWAYS" styleClass="modern-field, tournaments-search-v2"/><ComboBox fx:id="filtroEstado" promptText="Estado" minWidth="150" prefWidth="150" maxWidth="150" styleClass="modern-combo, tournaments-filter-v2"/><Button fx:id="botonLimpiar" text="LIMPIAR" onAction="#limpiarFiltros" styleClass="tournaments-clear-v2"/></HBox>
   <TableView fx:id="tablaTorneos" VBox.vgrow="ALWAYS" fixedCellSize="52" focusTraversable="false" styleClass="tournaments-table-v2 tournaments-list-v2"><columns><TableColumn fx:id="colNombre" text="TORNEO" prefWidth="240"/><TableColumn fx:id="colInicio" text="INICIO" prefWidth="96"/><TableColumn fx:id="colFin" text="FIN" prefWidth="96"/><TableColumn fx:id="colEstado" text="ESTADO" prefWidth="145"/></columns><placeholder><VBox alignment="CENTER" spacing="6"><Label text="Sin torneos para mostrar" styleClass="tournaments-empty-title-v2"/><Label text="Creá un torneo o modificá los filtros." styleClass="tournaments-empty-copy-v2"/></VBox></placeholder></TableView>
   <HBox alignment="CENTER_LEFT"><Label fx:id="etiquetaMensaje" styleClass="tournaments-result-v2"/></HBox>
  </VBox>
  <StackPane styleClass="tournaments-detail-shell-v2">
   <VBox fx:id="panelSinSeleccion" alignment="CENTER" spacing="10" styleClass="tournaments-empty-detail-v2"><Label text="SELECCIONÁ UN TORNEO" styleClass="tournaments-empty-detail-title"/><Label text="Elegí un torneo del listado para consultar sus fechas, categorías, cupos y acciones disponibles." maxWidth="440" wrapText="true" styleClass="tournaments-empty-detail-copy"/><Button text="NUEVO TORNEO" onAction="#nuevoTorneo" styleClass="tournaments-action-primary"/></VBox>
   <ScrollPane fx:id="scrollDetalle" visible="false" managed="false" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="tournaments-detail-scroll-v2, tournaments-detail-scroll-compact"><VBox fx:id="panelDetalle" spacing="10" styleClass="tournaments-detail-v2, tournaments-detail-compact"><padding><Insets top="14" right="18" bottom="16" left="18"/></padding>
    <VBox spacing="9" styleClass="tournaments-summary-v2, tournaments-summary-compact"><HBox alignment="CENTER_LEFT" spacing="12"><VBox spacing="4"><Label text="TORNEO SELECCIONADO" styleClass="tournaments-overline-v2"/><Label fx:id="detalleNombre" styleClass="tournaments-detail-title-v2"/><Label fx:id="detalleEstado" styleClass="tournament-state-v2"/></VBox><Region HBox.hgrow="ALWAYS"/><Button fx:id="botonEditar" text="EDITAR DATOS" onAction="#editarTorneo" styleClass="tournaments-action-secondary"/></HBox>
     <HBox spacing="8" styleClass="tournaments-metrics-compact"><VBox HBox.hgrow="ALWAYS" styleClass="tournaments-mini-v2 tournaments-mini-wide"><Label text="FECHAS" styleClass="tournaments-mini-label"/><Label fx:id="detalleFechas" wrapText="true" styleClass="tournaments-mini-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="tournaments-mini-v2 tournaments-mini-wide"><Label text="INSCRIPCIONES" styleClass="tournaments-mini-label"/><Label fx:id="detalleInscripcion" wrapText="true" styleClass="tournaments-mini-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="tournaments-mini-v2"><Label text="CATEGORÍAS" styleClass="tournaments-mini-label"/><Label fx:id="detalleCantidadCategorias" text="0" styleClass="tournaments-mini-number"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="tournaments-mini-v2"><Label text="PAREJAS" styleClass="tournaments-mini-label"/><Label fx:id="detalleParejas" text="0" styleClass="tournaments-mini-number"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="tournaments-mini-v2"><Label text="CUPOS LIBRES" styleClass="tournaments-mini-label"/><Label fx:id="detalleCupos" text="0" styleClass="tournaments-mini-number"/></VBox></HBox>
    </VBox>
    <VBox spacing="7" styleClass="tournaments-next-v2, tournaments-next-compact"><HBox alignment="CENTER_LEFT"><VBox spacing="2"><Label text="SIGUIENTE PASO" styleClass="tournaments-overline-v2"/><Label fx:id="etiquetaAccionTitulo" text="Acción disponible" styleClass="tournaments-next-title"/><Label fx:id="etiquetaAccionAyuda" wrapText="true" styleClass="tournaments-next-copy"/></VBox><Region HBox.hgrow="ALWAYS"/><Button fx:id="botonPublicar" text="PUBLICAR" onAction="#publicar" styleClass="tournaments-action-primary"/><Button fx:id="botonAbrir" text="ABRIR INSCRIPCIONES" onAction="#abrirInscripciones" styleClass="tournaments-action-primary"/><Button fx:id="botonCerrar" text="CERRAR INSCRIPCIONES" onAction="#cerrarInscripciones" styleClass="tournaments-action-primary"/><Button fx:id="botonIniciar" text="INICIAR TORNEO" onAction="#iniciarTorneo" styleClass="tournaments-action-primary"/><Button fx:id="botonFinalizar" text="FINALIZAR TORNEO" onAction="#finalizarTorneo" styleClass="tournaments-action-primary"/><Button fx:id="botonCancelar" text="CANCELAR TORNEO" onAction="#cancelarTorneo" styleClass="tournaments-action-danger"/></HBox></VBox>
    <VBox spacing="8" styleClass="tournaments-categories-v2, tournaments-categories-compact"><HBox alignment="CENTER_LEFT"><VBox spacing="2"><Label text="CATEGORÍAS" styleClass="tournaments-overline-v2"/><Label text="Cupos, ocupación y precios" styleClass="tournaments-section-title-v2"/></VBox><Region HBox.hgrow="ALWAYS"/><Button fx:id="botonNuevaCategoria" text="NUEVA CATEGORÍA" onAction="#nuevaCategoria" styleClass="tournaments-action-primary"/></HBox>
     <TableView fx:id="tablaCategorias" prefHeight="180" minHeight="170" maxHeight="180" fixedCellSize="44" focusTraversable="false" styleClass="tournaments-table-v2 tournaments-categories-table-v2"><columns><TableColumn fx:id="colCategoria" text="CATEGORÍA" prefWidth="150"/><TableColumn fx:id="colRama" text="RAMA" prefWidth="115"/><TableColumn fx:id="colCupo" text="CUPO" prefWidth="72"/><TableColumn fx:id="colConfirmadas" text="CONFIRMADAS" prefWidth="110"/><TableColumn fx:id="colDisponibles" text="DISPONIBLES" prefWidth="105"/><TableColumn fx:id="colPrecio" text="PRECIO" prefWidth="130"/></columns><placeholder><VBox alignment="CENTER" spacing="6"><Label text="Todavía no hay categorías" styleClass="tournaments-empty-title-v2"/><Label text="Agregá la primera categoría para abrir inscripciones." styleClass="tournaments-empty-copy-v2"/></VBox></placeholder></TableView>
     <HBox fx:id="panelAccionesCategoria" visible="false" managed="true" minHeight="52" prefHeight="52" maxHeight="52" spacing="8" alignment="CENTER_LEFT" styleClass="tournaments-category-actions-v2, tournaments-category-actions-stable"><Label fx:id="etiquetaCategoriaSeleccionada" text="ACCIONES DE CATEGORÍA" styleClass="tournaments-category-selected"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="botonEditarCategoria" text="EDITAR" onAction="#editarCategoria" styleClass="tournaments-action-secondary"/><Button fx:id="botonGestionarGrupos" text="GRUPOS" onAction="#gestionarGrupos" styleClass="tournaments-action-secondary, tournaments-category-navigation"/><Button fx:id="botonGestionarCuadro" text="CUADRO" onAction="#gestionarCuadro" styleClass="tournaments-action-secondary, tournaments-category-navigation, tournaments-category-bracket"/><Button fx:id="botonDesactivarCategoria" text="DESACTIVAR" onAction="#desactivarCategoria" styleClass="tournaments-action-danger-outline"/></HBox>
    </VBox>
   </VBox></ScrollPane>
  </StackPane>
 </items></SplitPane></center>
</BorderPane>