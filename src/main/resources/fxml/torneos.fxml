<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="vista.controlador.TorneosController" styleClass="tournaments-admin-root">
 <top><HBox alignment="CENTER_LEFT" spacing="12" styleClass="module-header"><padding><Insets top="16" right="22" bottom="16" left="22"/></padding><Button text="Inicio" onAction="#volver" styleClass="back-button"/><VBox><Label text="Administración de torneos" styleClass="page-title"/><Label text="Gestioná datos, categorías y ciclo de vida." styleClass="page-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="VER INSCRIPCIONES" onAction="#verInscripciones" styleClass="secondary-button"/><Button text="NUEVO TORNEO" onAction="#nuevoTorneo" styleClass="primary-button"/></HBox></top>
 <center><SplitPane dividerPositions="0.34"><items>
  <VBox spacing="10" styleClass="tournaments-admin-panel"><padding><Insets top="16" right="14" bottom="16" left="18"/></padding><HBox spacing="8"><TextField fx:id="campoBuscar" promptText="Buscar torneo..." HBox.hgrow="ALWAYS"/><ComboBox fx:id="filtroEstado" promptText="Estado" prefWidth="165"/><Button text="LIMPIAR" onAction="#limpiarFiltros"/></HBox><TableView fx:id="tablaTorneos" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="colNombre" text="TORNEO" prefWidth="210"/><TableColumn fx:id="colInicio" text="INICIO" prefWidth="105"/><TableColumn fx:id="colFin" text="FIN" prefWidth="105"/><TableColumn fx:id="colEstado" text="ESTADO" prefWidth="145"/></columns></TableView><Label fx:id="etiquetaMensaje" wrapText="true" styleClass="small-caption"/></VBox>
  <ScrollPane fitToWidth="true" hbarPolicy="NEVER"><content><VBox spacing="14" styleClass="tournaments-admin-detail"><padding><Insets top="18" right="20" bottom="22" left="20"/></padding><HBox alignment="CENTER_LEFT"><VBox><Label fx:id="detalleNombre" text="Seleccioná un torneo" styleClass="section-title"/><Label fx:id="detalleEstado" text="-" styleClass="tournament-state"/></VBox><Region HBox.hgrow="ALWAYS"/><Button fx:id="botonEditar" text="EDITAR" onAction="#editarTorneo" disable="true"/></HBox><GridPane hgap="12" vgap="9"><Label text="FECHAS" styleClass="field-label"/><Label fx:id="detalleFechas" GridPane.columnIndex="1" text="-"/><Label text="INSCRIPCIÓN" GridPane.rowIndex="1" styleClass="field-label"/><Label fx:id="detalleInscripcion" GridPane.rowIndex="1" GridPane.columnIndex="1" text="-"/></GridPane><HBox spacing="7"><Button fx:id="botonPublicar" text="PUBLICAR" onAction="#publicar"/><Button fx:id="botonAbrir" text="ABRIR INSCRIPCIONES" onAction="#abrirInscripciones"/><Button fx:id="botonCerrar" text="CERRAR INSCRIPCIONES" onAction="#cerrarInscripciones"/><Button fx:id="botonIniciar" text="INICIAR" onAction="#iniciarTorneo"/><Button fx:id="botonFinalizar" text="FINALIZAR" onAction="#finalizarTorneo"/><Button fx:id="botonCancelar" text="CANCELAR" onAction="#cancelarTorneo" styleClass="danger-button"/></HBox><Separator/><HBox alignment="CENTER_LEFT"><Label text="Categorías" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="botonNuevaCategoria" text="NUEVA CATEGORÍA" onAction="#nuevaCategoria"/></HBox><TableView fx:id="tablaCategorias" prefHeight="320" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="colCategoria" text="CATEGORÍA" prefWidth="140"/><TableColumn fx:id="colRama" text="RAMA" prefWidth="120"/><TableColumn fx:id="colCupo" text="CUPO" prefWidth="70"/><TableColumn fx:id="colConfirmadas" text="CONFIRMADAS" prefWidth="105"/><TableColumn fx:id="colDisponibles" text="DISPONIBLES" prefWidth="100"/><TableColumn fx:id="colPrecio" text="PRECIO" prefWidth="130"/></columns></TableView><HBox spacing="8"><Button fx:id="botonEditarCategoria" text="EDITAR CATEGORÍA" onAction="#editarCategoria" disable="true"/><Button fx:id="botonDesactivarCategoria" text="DESACTIVAR" onAction="#desactivarCategoria" disable="true" styleClass="danger-button"/></HBox></VBox></content></ScrollPane>
 </items></SplitPane></center>
</BorderPane>
