<?xml version="1.0" encoding="UTF-8"?>
<!-- pagos-unificacion-estructural-v3 -->
<!-- mover-actualizar-pagos-inscripciones-v4 -->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<!-- corregir-registro-senia-pagos-v9 -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="vista.controlador.PagosController"
            styleClass="module-root,payments-root-v3">
 <top>
  <HBox alignment="CENTER_LEFT" spacing="14" styleClass="payments-header-v3">
   <padding><Insets top="12" right="24" bottom="12" left="24"/></padding>
   <Button onAction="#volver" minWidth="42" prefWidth="42" maxWidth="42" minHeight="42" prefHeight="42" maxHeight="42" styleClass="payments-back-v3"><tooltip><Tooltip text="Volver a Inicio"/></tooltip><graphic><SVGPath content="M14 6 L8 12 L14 18 M8 12 L20 12" styleClass="payments-back-icon-v3"/></graphic></Button>
   <StackPane minWidth="42" prefWidth="42" maxWidth="42" minHeight="42" prefHeight="42" maxHeight="42" styleClass="payments-module-icon-shell-v3"><SVGPath content="M4 7 L20 7 L20 18 L4 18 Z M4 11 L20 11 M7 15 L11 15 M16 4 L16 8 M8 4 L8 8" styleClass="payments-module-icon-v3"/></StackPane>
   <VBox alignment="CENTER_LEFT" spacing="2" styleClass="payments-title-block-v3"><Label text="Gestión de pagos" styleClass="payments-title-v3"/><Label text="Consultá, filtrá y registrá movimientos financieros." styleClass="payments-subtitle-v3"/></VBox>
   <Region HBox.hgrow="ALWAYS"/>
   <Button fx:id="botonNuevoMovimiento" text="NUEVO MOVIMIENTO" onAction="#nuevoPago" styleClass="payments-primary-v3"><graphic><StackPane minWidth="18" prefWidth="18" maxWidth="18" minHeight="18" prefHeight="18" maxHeight="18"><SVGPath content="M12 4 L12 20 M4 12 L20 12" styleClass="payments-button-icon-v3,payments-button-icon-primary-v3"/></StackPane></graphic></Button>
  </HBox>
 </top>
 <center>
  <HBox styleClass="payments-content-v3">
   <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="payments-list-v3">
    <padding><Insets top="16" right="16" bottom="18" left="22"/></padding>
    <HBox spacing="8" styleClass="payments-metrics-v3">
     <Button fx:id="botonPendientes" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#verPendientes" styleClass="payments-metric-v3,payments-metric-pending-v3"><graphic><VBox alignment="CENTER_LEFT" spacing="3"><HBox alignment="CENTER_LEFT" spacing="8"><StackPane minWidth="15" prefWidth="15" minHeight="15" prefHeight="15"><SVGPath content="M12 4 C16.4 4 20 7.6 20 12 C20 16.4 16.4 20 12 20 C7.6 20 4 16.4 4 12 C4 7.6 7.6 4 12 4 Z M12 7 L12 12 L16 14" styleClass="payments-metric-icon-v3"/></StackPane><Label text="PENDIENTES" styleClass="payments-metric-label-v3"/></HBox><Label fx:id="etiquetaPendientes" text="0" styleClass="payments-metric-value-v3"/><Label text="Esperando acreditación" styleClass="payments-metric-detail-v3"/></VBox></graphic></Button>
     <Button fx:id="botonAcreditados" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#verAcreditados" styleClass="payments-metric-v3,payments-metric-accredited-v3"><graphic><VBox alignment="CENTER_LEFT" spacing="3"><HBox alignment="CENTER_LEFT" spacing="8"><StackPane minWidth="15" prefWidth="15" minHeight="15" prefHeight="15"><SVGPath content="M5 12 L10 17 L19 7" styleClass="payments-metric-icon-v3"/></StackPane><Label text="ACREDITADOS" styleClass="payments-metric-label-v3"/></HBox><Label fx:id="etiquetaAcreditados" text="0" styleClass="payments-metric-value-v3"/><Label text="Movimientos confirmados" styleClass="payments-metric-detail-v3"/></VBox></graphic></Button>
     <Button fx:id="botonReembolsados" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#verReembolsados" styleClass="payments-metric-v3,payments-metric-refunded-v3"><graphic><VBox alignment="CENTER_LEFT" spacing="3"><HBox alignment="CENTER_LEFT" spacing="8"><StackPane minWidth="15" prefWidth="15" minHeight="15" prefHeight="15"><SVGPath content="M7 8 L3 12 L7 16 M4 12 L14 12 C18 12 20 10 20 7" styleClass="payments-metric-icon-v3"/></StackPane><Label text="REEMBOLSADOS" styleClass="payments-metric-label-v3"/></HBox><Label fx:id="etiquetaReembolsados" text="0" styleClass="payments-metric-value-v3"/><Label text="Importes devueltos" styleClass="payments-metric-detail-v3"/></VBox></graphic></Button>
     <Button fx:id="botonAnulados" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#verAnulados" styleClass="payments-metric-v3,payments-metric-cancelled-v3"><graphic><VBox alignment="CENTER_LEFT" spacing="3"><HBox alignment="CENTER_LEFT" spacing="8"><StackPane minWidth="15" prefWidth="15" minHeight="15" prefHeight="15"><SVGPath content="M6 6 L18 18 M18 6 L6 18" styleClass="payments-metric-icon-v3"/></StackPane><Label text="ANULADOS" styleClass="payments-metric-label-v3"/></HBox><Label fx:id="etiquetaAnulados" text="0" styleClass="payments-metric-value-v3"/><Label text="Movimientos cancelados" styleClass="payments-metric-detail-v3"/></VBox></graphic></Button>
    </HBox>
    <HBox spacing="9"><StackPane HBox.hgrow="ALWAYS" styleClass="payments-search-shell-v3"><TextField fx:id="campoBuscar" promptText="Buscar por cliente, reserva, cancha o referencia" maxWidth="Infinity" styleClass="payments-search-v3"/><SVGPath content="M10.5 4 C6.9 4 4 6.9 4 10.5 C4 14.1 6.9 17 10.5 17 C14.1 17 17 14.1 17 10.5 C17 6.9 14.1 4 10.5 4 Z M15.5 15.5 L21 21" mouseTransparent="true" StackPane.alignment="CENTER_LEFT" styleClass="payments-search-icon-v3"/></StackPane><ComboBox fx:id="filtroMetodo" promptText="Todos los métodos" minWidth="180" prefWidth="180" maxWidth="180" styleClass="payments-combo-v3"/><Button text="LIMPIAR" onAction="#limpiarFiltros" minWidth="108" prefWidth="108" maxWidth="108" styleClass="payments-clear-v3"><graphic><SVGPath content="M6 6 L18 18 M18 6 L6 18" styleClass="payments-button-icon-v3"/></graphic></Button><Button text="ACTUALIZAR" onAction="#cargarPagos" styleClass="payments-refresh-v3"><graphic><StackPane minWidth="18" prefWidth="18" maxWidth="18" minHeight="18" prefHeight="18" maxHeight="18"><SVGPath content="M19 8 A8 8 0 1 0 20 13 M19 4 L19 8 L15 8" styleClass="payments-button-icon-v3"/></StackPane></graphic></Button></HBox>
    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="payments-extra-filters-v3"><HBox spacing="0"><Button fx:id="botonTodos" text="TODOS" onAction="#verTodos" styleClass="payments-period-v3,payments-period-left-v3"/><Button fx:id="botonHoy" text="HOY" onAction="#verHoy" styleClass="payments-period-v3,payments-period-right-v3"/></HBox><DatePicker fx:id="filtroDesde" promptText="Desde" minWidth="145" prefWidth="145" maxWidth="145" styleClass="payments-date-v3"/><DatePicker fx:id="filtroHasta" promptText="Hasta" minWidth="145" prefWidth="145" maxWidth="145" styleClass="payments-date-v3"/><CheckBox fx:id="checkConSaldo" text="Solo con saldo pendiente" styleClass="payments-balance-filter-v3"/><Region HBox.hgrow="ALWAYS"/></HBox>
    <HBox alignment="CENTER_LEFT" minHeight="24" prefHeight="24" maxHeight="24" styleClass="payments-results-v3"><Label fx:id="etiquetaCantidad" text="0 movimientos visibles" styleClass="payments-result-count-v3"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="etiquetaActualizacion" text="Sin actualizar" styleClass="payments-updated-v3"/><Label fx:id="etiquetaAyudaResultados" text="Doble clic para abrir la reserva" styleClass="payments-help-v3"/></HBox>
    <TableView fx:id="tablaPagos" fixedCellSize="50" focusTraversable="false" VBox.vgrow="ALWAYS" styleClass="payments-table-v3"><columns><TableColumn fx:id="columnaReserva" text="RESERVA Y CLIENTE" prefWidth="280" minWidth="190" styleClass="payments-col-reservation-v3"/><TableColumn fx:id="columnaTurno" text="TURNO" prefWidth="155" minWidth="125"/><TableColumn fx:id="columnaImporte" text="IMPORTE" prefWidth="120" minWidth="100" styleClass="payments-col-amount-v3"/><TableColumn fx:id="columnaMetodo" text="MÉTODO" prefWidth="130" minWidth="105"/><TableColumn fx:id="columnaEstado" text="ESTADO" prefWidth="125" minWidth="105"/><TableColumn fx:id="columnaFecha" text="REGISTRADO" prefWidth="175" minWidth="145"/><TableColumn fx:id="columnaAcreditado" text="ACREDITADO" visible="false"/><TableColumn fx:id="columnaReferencia" text="REFERENCIA" visible="false"/></columns><placeholder><VBox alignment="CENTER" spacing="7" styleClass="payments-empty-v3"><StackPane minWidth="46" prefWidth="46" minHeight="46" prefHeight="46" styleClass="payments-empty-icon-shell-v3"><SVGPath content="M4 7 L20 7 L20 18 L4 18 Z M4 11 L20 11 M7 15 L11 15" styleClass="payments-empty-icon-v3"/></StackPane><Label text="No hay movimientos para mostrar" styleClass="payments-empty-title-v3"/><Label text="Probá cambiar los filtros o actualizar la información." styleClass="payments-empty-copy-v3"/></VBox></placeholder></TableView>
   </VBox>
   <StackPane prefWidth="390" minWidth="370" maxWidth="420" styleClass="payments-detail-shell-v3">
    <VBox fx:id="panelDetalleVacio" alignment="TOP_CENTER" spacing="9" styleClass="payments-detail-empty-v3"><StackPane minWidth="48" prefWidth="48" maxWidth="48" minHeight="48" prefHeight="48" maxHeight="48" styleClass="payments-detail-empty-icon-shell-v3"><SVGPath content="M4 7 L20 7 L20 18 L4 18 Z M4 11 L20 11 M7 15 L11 15" styleClass="payments-detail-empty-icon-v3"/></StackPane><Label text="SELECCIONÁ UN MOVIMIENTO" styleClass="payments-detail-empty-title-v3"/><Label text="Elegí una fila para consultar la reserva, el movimiento y las acciones disponibles." wrapText="true" maxWidth="285" styleClass="payments-detail-empty-copy-v3"/></VBox>
    <ScrollPane fx:id="scrollPanelDerecho" visible="false" managed="false" fitToWidth="true" hbarPolicy="NEVER" styleClass="payments-detail-scroll-v3"><content><VBox fx:id="panelDetalle" spacing="10" styleClass="payments-detail-v3"><padding><Insets top="18" right="18" bottom="18" left="18"/></padding><VBox spacing="7" styleClass="payments-detail-header-v3"><HBox alignment="CENTER_LEFT" spacing="10"><StackPane minWidth="36" prefWidth="36" maxWidth="36" minHeight="36" prefHeight="36" maxHeight="36" styleClass="payments-detail-icon-shell-v3"><SVGPath content="M4 7 L20 7 L20 18 L4 18 Z M4 11 L20 11 M7 15 L11 15" styleClass="payments-detail-icon-v3"/></StackPane><VBox spacing="1" HBox.hgrow="ALWAYS"><Label text="MOVIMIENTO SELECCIONADO" styleClass="payments-detail-eyebrow-v3"/><Label fx:id="detalleTitulo" text="Movimiento" styleClass="payments-detail-title-v3"/></VBox><Label fx:id="detalleEstadoCabecera" text="PENDIENTE" styleClass="payment-detail-status"/></HBox><Label text="Detalle financiero y reserva asociada." styleClass="payments-detail-note-v3"/></VBox><Separator/>
     <VBox spacing="5" styleClass="payments-detail-card-v3"><Label text="RESERVA" styleClass="payments-detail-label-v3"/><Label fx:id="detalleReserva" text="-" wrapText="true" styleClass="payments-detail-main-v3"/><Label fx:id="detalleCliente" text="-" wrapText="true" styleClass="payments-detail-secondary-v3"/><Label fx:id="detalleTurno" text="-" styleClass="payments-detail-secondary-v3"/></VBox>
     <VBox spacing="7" styleClass="payments-detail-card-v3"><Label text="MOVIMIENTO" styleClass="payments-detail-label-v3"/><Label fx:id="detalleImporte" text="-" styleClass="payments-detail-amount-v3"/><GridPane hgap="12" vgap="8"><Label text="Método" styleClass="payments-finance-label-v3"/><Label fx:id="detalleMetodo" GridPane.columnIndex="1" styleClass="payments-finance-value-v3"/><Label text="Registrado" GridPane.rowIndex="1" styleClass="payments-finance-label-v3"/><Label fx:id="detalleRegistrado" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="payments-finance-value-v3"/><Label text="Acreditado" GridPane.rowIndex="2" styleClass="payments-finance-label-v3"/><Label fx:id="detalleAcreditado" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="payments-finance-value-v3"/><Label text="Referencia" GridPane.rowIndex="3" styleClass="payments-finance-label-v3"/><Label fx:id="detalleReferencia" GridPane.rowIndex="3" GridPane.columnIndex="1" wrapText="true" styleClass="payments-finance-value-v3"/></GridPane></VBox>
     <VBox spacing="7" styleClass="payments-detail-card-v3"><Label text="RESUMEN DE LA RESERVA" styleClass="payments-detail-label-v3"/><GridPane hgap="12" vgap="8"><Label text="Precio" styleClass="payments-finance-label-v3"/><Label fx:id="detallePrecioReserva" GridPane.columnIndex="1" styleClass="payments-finance-value-v3"/><Label text="Acreditado" GridPane.rowIndex="1" styleClass="payments-finance-label-v3"/><Label fx:id="detalleTotalAcreditado" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="payments-paid-v3"/><Label text="Saldo" GridPane.rowIndex="2" styleClass="payments-finance-label-v3"/><Label fx:id="detalleSaldoReserva" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="payments-balance-v3"/></GridPane><HBox alignment="CENTER_LEFT" spacing="8"><ProgressBar fx:id="detalleProgresoPago" progress="0" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="payments-progress-v3"/><Label fx:id="detallePorcentajePago" text="0 % acreditado" styleClass="payments-percent-v3"/></HBox></VBox>
     <VBox spacing="4"><Label text="SITUACIÓN DEL MOVIMIENTO" styleClass="payments-detail-label-v3"/><Label fx:id="detalleSituacionTitulo" text="-" styleClass="payments-situation-title-v3"/><Label fx:id="detalleSituacionAyuda" text="-" wrapText="true" styleClass="payments-detail-note-v3"/></VBox><Label fx:id="etiquetaAccionesPago" text="" visible="false" managed="false"/><Label fx:id="etiquetaMensaje" text="" wrapText="true" styleClass="payments-message-v3"/><Region prefHeight="8" minHeight="8"/><Button fx:id="botonAbrirReserva" text="ABRIR RESERVA" onAction="#abrirReservaSeleccionada" maxWidth="Infinity" styleClass="payments-open-v3"><graphic><SVGPath content="M5 6 L19 6 L19 20 L5 20 Z M8 3 L8 8 M16 3 L16 8 M5 10 L19 10" styleClass="payments-button-icon-v3,payments-button-icon-primary-v3"/></graphic></Button><HBox spacing="9"><Button fx:id="botonAcreditar" text="ACREDITAR MOVIMIENTO" onAction="#acreditar" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="payments-accredit-v3"/><Button fx:id="botonAnular" text="ANULAR" onAction="#anular" minWidth="120" prefWidth="120" maxWidth="120" styleClass="payments-cancel-v3"/></HBox>
    </VBox></content></ScrollPane>
    <ScrollPane fx:id="scrollPanelFormulario" fitToWidth="true" visible="false" managed="false" hbarPolicy="NEVER" styleClass="payments-detail-scroll-v3"><content><VBox fx:id="panelFormulario" spacing="12" styleClass="payments-form-v3"><padding><Insets top="18" right="18" bottom="18" left="18"/></padding><HBox alignment="CENTER_LEFT" spacing="10"><VBox spacing="1" HBox.hgrow="ALWAYS"><Label text="MODO CREACIÓN" styleClass="payments-detail-eyebrow-v3"/><Label fx:id="tituloFormulario" text="Nuevo movimiento" styleClass="payments-detail-title-v3"/></VBox><Button text="CANCELAR" onAction="#cancelarFormulario" styleClass="payments-clear-v3"/></HBox><Label text="Registrá un pago, seña o ajuste asociado a una reserva." wrapText="true" styleClass="payments-detail-note-v3"/><VBox spacing="8" styleClass="payments-detail-card-v3"><Label text="RESERVA" styleClass="payments-detail-label-v3"/><ComboBox fx:id="comboReserva" maxWidth="Infinity" promptText="Seleccionar reserva" styleClass="payments-combo-v3"/><Label fx:id="etiquetaReservaDetalle" text="Seleccioná una reserva para ver el saldo." wrapText="true" styleClass="payments-detail-note-v3"/><GridPane hgap="12" vgap="8"><Label text="Precio" styleClass="payments-finance-label-v3"/><Label fx:id="etiquetaPrecioTotal" GridPane.columnIndex="1" text="ARS 0" styleClass="payments-finance-value-v3"/><Label text="Acreditado" GridPane.rowIndex="1" styleClass="payments-finance-label-v3"/><Label fx:id="etiquetaTotalAcreditado" GridPane.rowIndex="1" GridPane.columnIndex="1" text="ARS 0" styleClass="payments-paid-v3"/><Label text="Saldo" GridPane.rowIndex="2" styleClass="payments-finance-label-v3"/><Label fx:id="etiquetaSaldo" GridPane.rowIndex="2" GridPane.columnIndex="1" text="ARS 0" styleClass="payments-balance-v3"/></GridPane></VBox><VBox spacing="8" styleClass="payments-detail-card-v3"><Label text="MOVIMIENTO" styleClass="payments-detail-label-v3"/><Label text="Importe *" styleClass="payments-field-label-v3"/><TextField fx:id="campoImporte" promptText="Importe del movimiento" styleClass="payments-field-v3"/><Label text="Método *" styleClass="payments-field-label-v3"/><ComboBox fx:id="comboMetodo" maxWidth="Infinity" styleClass="payments-combo-v3"/><Label text="Estado inicial *" styleClass="payments-field-label-v3"/><ComboBox fx:id="comboEstadoInicial" maxWidth="Infinity" styleClass="payments-combo-v3"/><Label text="Referencia" styleClass="payments-field-label-v3"/><TextField fx:id="campoReferencia" promptText="Transferencia, cupón o detalle" styleClass="payments-field-v3"/></VBox><Button fx:id="botonGuardarMovimiento" text="GUARDAR MOVIMIENTO" onAction="#guardar" maxWidth="Infinity" styleClass="payments-primary-v3"/></VBox></content></ScrollPane>
   </StackPane>
  </HBox>
 </center>
</BorderPane>
