<?xml version="1.0" encoding="UTF-8"?>
<!-- pagos-combos-formulario-estables-v1 -->
<!-- gestion-pagos-modo-creacion-v1 -->
<!-- gestion-pagos-integral-v1 -->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="vista.controlador.PagosController" styleClass="module-root, payments-root">
 <top><HBox alignment="CENTER_LEFT" spacing="16" styleClass="module-header"><padding><Insets top="18" right="28" bottom="18" left="28"/></padding><Button text="INICIO" onAction="#volver" styleClass="admin-home-button"/><VBox spacing="3"><Label text="Gestión de pagos" styleClass="page-title"/><Label text="Consultá, filtrá y registrá movimientos financieros." styleClass="page-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button fx:id="botonNuevoMovimiento" text="NUEVO MOVIMIENTO" onAction="#nuevoPago" styleClass="primary-button, payment-new-button"/></HBox></top>
 <center><SplitPane dividerPositions="0.69" styleClass="module-split">
  <VBox spacing="10" styleClass="list-panel, payments-list-compact"><padding><Insets top="14" right="16" bottom="16" left="20"/></padding>
   <HBox spacing="8"><Button fx:id="botonPendientes" text="PENDIENTES" onAction="#verPendientes" styleClass="payment-view-button, payment-view-pending"/><Button fx:id="botonAcreditados" text="ACREDITADOS" onAction="#verAcreditados" styleClass="payment-view-button, payment-view-accredited"/><Button fx:id="botonReembolsados" text="REEMBOLSADOS" onAction="#verReembolsados" styleClass="payment-view-button, payment-view-refunded"/><Button fx:id="botonAnulados" text="ANULADOS" onAction="#verAnulados" styleClass="payment-view-button, payment-view-cancelled"/><Button fx:id="botonHoy" text="HOY" onAction="#verHoy" styleClass="payment-view-button, payment-view-neutral"/><Button fx:id="botonTodos" text="TODOS" onAction="#verTodos" styleClass="payment-view-button, payment-view-neutral"/></HBox>
   <HBox spacing="8" styleClass="payments-search-row"><TextField fx:id="campoBuscar" promptText="Cliente, reserva, cancha o referencia..." HBox.hgrow="ALWAYS" styleClass="modern-field, payments-search"/><ComboBox fx:id="filtroMetodo" prefWidth="180" minWidth="180" maxWidth="180" promptText="Método de pago" styleClass="modern-combo, payments-method-filter"/></HBox>
   <HBox alignment="CENTER_LEFT" spacing="8" styleClass="payments-filter-row"><DatePicker fx:id="filtroDesde" prefWidth="150" minWidth="150" maxWidth="150" promptText="Desde" styleClass="modern-date, payments-date"/><DatePicker fx:id="filtroHasta" prefWidth="150" minWidth="150" maxWidth="150" promptText="Hasta" styleClass="modern-date, payments-date"/><CheckBox fx:id="checkConSaldo" text="Sólo con saldo pendiente" styleClass="payment-check"/><Region HBox.hgrow="ALWAYS"/><Button text="LIMPIAR" onAction="#limpiarFiltros" minWidth="88" prefWidth="88" maxWidth="88" styleClass="secondary-button, payments-filter-action"/><Button text="ACTUALIZAR" onAction="#cargarPagos" minWidth="100" prefWidth="100" maxWidth="100" styleClass="secondary-button, payments-filter-action"/></HBox>
   <Label fx:id="etiquetaCantidad" text="0 movimientos" minHeight="22" prefHeight="22" maxHeight="22" styleClass="small-caption, payments-result-count"/>
   <TableView fx:id="tablaPagos" VBox.vgrow="ALWAYS" fixedCellSize="54" focusTraversable="false" styleClass="modern-table, payments-table"><columns><TableColumn fx:id="columnaReserva" text="RESERVA Y CLIENTE" prefWidth="250" minWidth="150"/><TableColumn fx:id="columnaTurno" text="TURNO" prefWidth="155" minWidth="115"/><TableColumn fx:id="columnaImporte" text="IMPORTE" prefWidth="120" minWidth="95" styleClass="payment-amount-column"/><TableColumn fx:id="columnaMetodo" text="MÉTODO" prefWidth="125" minWidth="95"/><TableColumn fx:id="columnaEstado" text="ESTADO" prefWidth="120" minWidth="100"/><TableColumn fx:id="columnaFecha" text="REGISTRADO" prefWidth="165" minWidth="125"/><TableColumn fx:id="columnaAcreditado" text="ACREDITADO" visible="false"/><TableColumn fx:id="columnaReferencia" text="REFERENCIA" visible="false"/></columns><placeholder><Label text="No hay movimientos para los filtros seleccionados." styleClass="empty-state"/></placeholder></TableView>
  </VBox>
  <ScrollPane fitToWidth="true" styleClass="form-scroll"><StackPane>
   <VBox fx:id="panelDetalle" spacing="12" styleClass="form-card, payment-detail-panel"><padding><Insets top="18" right="20" bottom="22" left="20"/></padding><VBox spacing="5" styleClass="payment-detail-header">
    <HBox alignment="CENTER_LEFT" spacing="8">
     <Label fx:id="detalleTitulo" text="Seleccioná un movimiento" styleClass="section-title"/>
     <Region HBox.hgrow="ALWAYS"/>
     <Label fx:id="detalleEstadoCabecera" text="ACREDITADO" visible="false" managed="false" styleClass="payment-detail-status"/>
    </HBox>
    <Label text="Detalle del movimiento seleccionado." wrapText="true" styleClass="payment-detail-subtitle"/>
   </VBox><VBox spacing="7" styleClass="payment-info-card, payment-reservation-card"><Label text="RESERVA" styleClass="payment-card-title"/><Label fx:id="detalleReserva" text="-" wrapText="true" styleClass="payment-detail-value, payment-detail-primary"/><Label fx:id="detalleCliente" text="-" wrapText="true" styleClass="payment-detail-value"/><Label fx:id="detalleTurno" text="-" styleClass="payment-detail-value"/></VBox><VBox spacing="8" styleClass="payment-info-card"><Label text="MOVIMIENTO" styleClass="payment-card-title"/><GridPane hgap="12" vgap="9"><Label text="IMPORTE" styleClass="field-label"/><Label fx:id="detalleImporte" GridPane.columnIndex="1" styleClass="payment-detail-money"/><Label text="MÉTODO" GridPane.rowIndex="1" styleClass="field-label"/><Label fx:id="detalleMetodo" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="payment-detail-value"/><Label text="REGISTRADO" GridPane.rowIndex="2" styleClass="field-label"/><Label fx:id="detalleRegistrado" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="payment-detail-value"/><Label text="ACREDITADO" GridPane.rowIndex="3" styleClass="field-label"/><Label fx:id="detalleAcreditado" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="payment-detail-value"/><Label text="REFERENCIA" GridPane.rowIndex="4" styleClass="field-label"/><Label fx:id="detalleReferencia" GridPane.rowIndex="4" GridPane.columnIndex="1" wrapText="true" styleClass="payment-detail-value"/></GridPane></VBox><Label fx:id="etiquetaAccionesPago" text="" visible="false" managed="false" wrapText="true" styleClass="payment-action-help"/><Region VBox.vgrow="ALWAYS"/><HBox spacing="8" styleClass="payment-detail-actions"><Button fx:id="botonAcreditar" text="ACREDITAR" onAction="#acreditar" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="status-confirm-button"/><Button fx:id="botonAnular" text="ANULAR" onAction="#anular" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="secondary-button"/></HBox><Label fx:id="etiquetaMensaje" minHeight="22" wrapText="true"/></VBox>
   <VBox fx:id="panelFormulario" visible="false" managed="false" spacing="12" styleClass="form-card, payment-form-panel, payment-creation-mode"><padding><Insets top="18" right="20" bottom="22" left="20"/></padding><HBox alignment="CENTER_LEFT"><VBox spacing="4"><Label text="MODO CREACIÓN" styleClass="payment-creation-badge"/><Label fx:id="tituloFormulario" text="Nuevo movimiento" styleClass="section-title, payment-creation-title"/><Label text="Registrá un pago, seña o ajuste asociado a una reserva." wrapText="true" styleClass="payment-detail-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="CANCELAR" onAction="#cancelarFormulario" minWidth="96" prefWidth="96" maxWidth="96" styleClass="secondary-button, payment-cancel-form"/></HBox><VBox spacing="8" styleClass="payment-info-card, payment-form-card"><Label text="RESERVA" styleClass="payment-card-title"/><Label text="Reserva *" styleClass="field-label"/><ComboBox fx:id="comboReserva" maxWidth="Infinity" promptText="Seleccionar reserva" styleClass="modern-combo"/><Label fx:id="etiquetaReservaDetalle" text="Seleccioná una reserva para ver el saldo." wrapText="true" styleClass="payment-reservation-detail"/><GridPane hgap="8" vgap="8"><columnConstraints><ColumnConstraints percentWidth="33.33"/><ColumnConstraints percentWidth="33.33"/><ColumnConstraints percentWidth="33.34"/></columnConstraints><VBox styleClass="payment-summary-card"><Label text="PRECIO TOTAL" styleClass="metric-label"/><Label fx:id="etiquetaPrecioTotal" text="ARS 0" styleClass="payment-summary-value"/></VBox><VBox GridPane.columnIndex="1" styleClass="payment-summary-card"><Label text="ACREDITADO" styleClass="metric-label"/><Label fx:id="etiquetaTotalAcreditado" text="ARS 0" styleClass="payment-summary-value"/></VBox><VBox GridPane.columnIndex="2" styleClass="payment-summary-card, payment-balance-card"><Label text="SALDO" styleClass="metric-label"/><Label fx:id="etiquetaSaldo" text="ARS 0" styleClass="payment-balance-value"/></VBox></GridPane></VBox><VBox spacing="8" styleClass="payment-info-card, payment-form-card"><Label text="MOVIMIENTO" styleClass="payment-card-title"/><Label text="Importe *" styleClass="field-label"/><TextField fx:id="campoImporte" promptText="Importe del movimiento" styleClass="modern-field"/><HBox spacing="10"><VBox spacing="6" HBox.hgrow="ALWAYS"><Label text="Método *" styleClass="field-label"/><ComboBox fx:id="comboMetodo" minHeight="38" prefHeight="38" maxHeight="38" maxWidth="Infinity" styleClass="modern-combo, payment-form-combo"/></VBox><VBox spacing="6" HBox.hgrow="ALWAYS"><Label text="Estado inicial *" styleClass="field-label"/><ComboBox fx:id="comboEstadoInicial" minHeight="38" prefHeight="38" maxHeight="38" maxWidth="Infinity" styleClass="modern-combo, payment-form-combo"/></VBox></HBox><Label text="Referencia" styleClass="field-label"/><TextField fx:id="campoReferencia" promptText="Transferencia, cupón o detalle" styleClass="modern-field"/></VBox><Region VBox.vgrow="ALWAYS"/><Button fx:id="botonGuardarMovimiento" text="GUARDAR MOVIMIENTO" onAction="#guardar" maxWidth="Infinity" styleClass="primary-button, payment-save-button"/></VBox>
  </StackPane></ScrollPane>
 </SplitPane></center>
</BorderPane>
