<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="vista.controlador.PagosController" styleClass="module-root">
 <top><HBox alignment="CENTER_LEFT" spacing="16" styleClass="module-header"><padding><Insets top="18" right="28" bottom="18" left="28"/></padding><Button text="INICIO" onAction="#volver" styleClass="admin-home-button"/><VBox spacing="3"><Label text="Gestión de pagos" styleClass="page-title"/><Label text="Consultá, filtrá y registrá movimientos financieros." styleClass="page-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="NUEVO MOVIMIENTO" onAction="#nuevoPago" styleClass="primary-button"/></HBox></top>
 <center><SplitPane dividerPositions="0.70" styleClass="module-split">
  <VBox spacing="12" styleClass="list-panel"><padding><Insets top="18" right="18" bottom="18" left="24"/></padding>
   <HBox spacing="8"><Button fx:id="botonPendientes" text="PENDIENTES" onAction="#verPendientes" styleClass="payment-view-button"/><Button fx:id="botonAcreditados" text="ACREDITADOS" onAction="#verAcreditados" styleClass="payment-view-button"/><Button fx:id="botonReembolsados" text="REEMBOLSADOS" onAction="#verReembolsados" styleClass="payment-view-button"/><Button fx:id="botonAnulados" text="ANULADOS" onAction="#verAnulados" styleClass="payment-view-button"/><Button fx:id="botonHoy" text="HOY" onAction="#verHoy" styleClass="payment-view-button"/><Button fx:id="botonTodos" text="TODOS" onAction="#verTodos" styleClass="payment-view-button"/></HBox>
   <HBox spacing="9"><TextField fx:id="campoBuscar" promptText="Cliente, reserva, cancha o referencia..." HBox.hgrow="ALWAYS" styleClass="modern-field"/><ComboBox fx:id="filtroEstado" prefWidth="145" promptText="Estado" styleClass="modern-combo"/><ComboBox fx:id="filtroMetodo" prefWidth="145" promptText="Método" styleClass="modern-combo"/></HBox>
   <HBox alignment="CENTER_LEFT" spacing="9"><DatePicker fx:id="filtroDesde" prefWidth="145" promptText="Desde" styleClass="modern-date"/><DatePicker fx:id="filtroHasta" prefWidth="145" promptText="Hasta" styleClass="modern-date"/><CheckBox fx:id="checkConSaldo" text="Sólo con saldo pendiente" styleClass="payment-check"/><Region HBox.hgrow="ALWAYS"/><Button text="LIMPIAR" onAction="#limpiarFiltros" styleClass="secondary-button"/><Button text="ACTUALIZAR" onAction="#cargarPagos" styleClass="secondary-button"/></HBox>
   <Label fx:id="etiquetaCantidad" text="0 movimientos" styleClass="small-caption"/>
   <TableView fx:id="tablaPagos" VBox.vgrow="ALWAYS" styleClass="modern-table"><columns><TableColumn fx:id="columnaReserva" text="RESERVA" prefWidth="175"/><TableColumn fx:id="columnaTurno" text="TURNO" prefWidth="125"/><TableColumn fx:id="columnaImporte" text="IMPORTE" prefWidth="110"/><TableColumn fx:id="columnaMetodo" text="MÉTODO" prefWidth="110"/><TableColumn fx:id="columnaEstado" text="ESTADO" prefWidth="110"/><TableColumn fx:id="columnaFecha" text="REGISTRADO" prefWidth="140"/><TableColumn fx:id="columnaAcreditado" text="ACREDITADO" prefWidth="140"/><TableColumn fx:id="columnaReferencia" text="REFERENCIA" prefWidth="145"/></columns><placeholder><Label text="No hay movimientos para los filtros seleccionados." styleClass="empty-state"/></placeholder></TableView>
  </VBox>
  <ScrollPane fitToWidth="true" styleClass="form-scroll"><StackPane>
   <VBox fx:id="panelDetalle" spacing="13" styleClass="form-card"><padding><Insets top="22" right="26" bottom="26" left="26"/></padding><Label fx:id="detalleTitulo" text="Seleccioná un movimiento" styleClass="section-title"/><Label text="RESERVA" styleClass="field-label"/><Label fx:id="detalleReserva" text="-" wrapText="true" styleClass="payment-detail-value"/><Label text="CLIENTE" styleClass="field-label"/><Label fx:id="detalleCliente" text="-" wrapText="true" styleClass="payment-detail-value"/><Label text="TURNO" styleClass="field-label"/><Label fx:id="detalleTurno" text="-" styleClass="payment-detail-value"/><Separator/><GridPane hgap="12" vgap="9"><Label text="IMPORTE" styleClass="field-label"/><Label fx:id="detalleImporte" GridPane.columnIndex="1" styleClass="payment-detail-money"/><Label text="MÉTODO" GridPane.rowIndex="1" styleClass="field-label"/><Label fx:id="detalleMetodo" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="payment-detail-value"/><Label text="ESTADO" GridPane.rowIndex="2" styleClass="field-label"/><Label fx:id="detalleEstado" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="payment-detail-value"/><Label text="REGISTRADO" GridPane.rowIndex="3" styleClass="field-label"/><Label fx:id="detalleRegistrado" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="payment-detail-value"/><Label text="ACREDITADO" GridPane.rowIndex="4" styleClass="field-label"/><Label fx:id="detalleAcreditado" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="payment-detail-value"/><Label text="REFERENCIA" GridPane.rowIndex="5" styleClass="field-label"/><Label fx:id="detalleReferencia" GridPane.rowIndex="5" GridPane.columnIndex="1" wrapText="true" styleClass="payment-detail-value"/></GridPane><Region VBox.vgrow="ALWAYS"/><HBox spacing="9"><Button fx:id="botonAcreditar" text="ACREDITAR" onAction="#acreditar" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="status-confirm-button"/><Button fx:id="botonAnular" text="ANULAR" onAction="#anular" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="secondary-button"/></HBox><Label fx:id="etiquetaMensaje" minHeight="22" wrapText="true"/></VBox>
   <VBox fx:id="panelFormulario" visible="false" managed="false" spacing="13" styleClass="form-card"><padding><Insets top="22" right="26" bottom="26" left="26"/></padding><HBox alignment="CENTER_LEFT"><Label fx:id="tituloFormulario" text="Nuevo movimiento" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Button text="CANCELAR" onAction="#cancelarFormulario" styleClass="secondary-button"/></HBox><Label text="Reserva *" styleClass="field-label"/><ComboBox fx:id="comboReserva" maxWidth="Infinity" promptText="Seleccionar reserva" styleClass="modern-combo"/><Label fx:id="etiquetaReservaDetalle" text="Seleccioná una reserva para ver el saldo." wrapText="true" styleClass="payment-reservation-detail"/><GridPane hgap="8" vgap="8"><columnConstraints><ColumnConstraints percentWidth="33.33"/><ColumnConstraints percentWidth="33.33"/><ColumnConstraints percentWidth="33.34"/></columnConstraints><VBox styleClass="payment-summary-card"><Label text="PRECIO TOTAL" styleClass="metric-label"/><Label fx:id="etiquetaPrecioTotal" text="ARS 0" styleClass="payment-summary-value"/></VBox><VBox GridPane.columnIndex="1" styleClass="payment-summary-card"><Label text="ACREDITADO" styleClass="metric-label"/><Label fx:id="etiquetaTotalAcreditado" text="ARS 0" styleClass="payment-summary-value"/></VBox><VBox GridPane.columnIndex="2" styleClass="payment-summary-card, payment-balance-card"><Label text="SALDO" styleClass="metric-label"/><Label fx:id="etiquetaSaldo" text="ARS 0" styleClass="payment-balance-value"/></VBox></GridPane><Label text="Importe *" styleClass="field-label"/><TextField fx:id="campoImporte" styleClass="modern-field"/><HBox spacing="10"><VBox spacing="6" HBox.hgrow="ALWAYS"><Label text="Método *" styleClass="field-label"/><ComboBox fx:id="comboMetodo" maxWidth="Infinity" styleClass="modern-combo"/></VBox><VBox spacing="6" HBox.hgrow="ALWAYS"><Label text="Estado inicial *" styleClass="field-label"/><ComboBox fx:id="comboEstadoInicial" maxWidth="Infinity" styleClass="modern-combo"/></VBox></HBox><Label text="Referencia" styleClass="field-label"/><TextField fx:id="campoReferencia" promptText="Transferencia, cupón o detalle" styleClass="modern-field"/><Region VBox.vgrow="ALWAYS"/><Button text="GUARDAR MOVIMIENTO" onAction="#guardar" maxWidth="Infinity" styleClass="primary-button"/></VBox>
  </StackPane></ScrollPane>
 </SplitPane></center>
</BorderPane>
