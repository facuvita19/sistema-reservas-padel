<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="vista.controlador.CierreCajaController" styleClass="module-root, cash-root">
 <top>
  <VBox styleClass="cash-top-shell">
   <HBox alignment="CENTER_LEFT" spacing="16" styleClass="module-header, cash-header-v3">
    <padding><Insets top="14" right="26" bottom="12" left="26"/></padding>
    <Button text="INICIO" onAction="#volver" styleClass="admin-home-button"/>
    <VBox spacing="2"><Label text="Caja operativa" styleClass="page-title"/><Label text="Pagos, movimientos manuales y cierre diario." styleClass="page-subtitle"/></VBox>
    <Region HBox.hgrow="ALWAYS"/>
    <Label fx:id="etiquetaEstadoCaja" text="CAJA ABIERTA" styleClass="cash-status-open"/>
    <DatePicker fx:id="selectorFecha" prefWidth="190" minWidth="190" maxWidth="190" styleClass="modern-date, cash-date-v3"/>
    <Button text="ACTUALIZAR" onAction="#cargarCaja" minWidth="110" prefWidth="110" styleClass="secondary-button, cash-refresh-v3"/>
   </HBox>
   <HBox spacing="8" styleClass="cash-tabs-v3">
    <padding><Insets top="8" right="26" bottom="8" left="26"/></padding>
    <Button fx:id="botonPestanaResumen" text="RESUMEN" onAction="#mostrarResumenTab" styleClass="cash-tab-v3, cash-tab-active-v3"/>
    <Button fx:id="botonPestanaMovimientos" text="MOVIMIENTOS" onAction="#mostrarMovimientosTab" styleClass="cash-tab-v3"/>
    <Button fx:id="botonPestanaCierre" text="CIERRE" onAction="#mostrarCierreTab" styleClass="cash-tab-v3"/>
   </HBox>
  </VBox>
 </top>
 <center>
  <StackPane styleClass="cash-content-v3">
   <VBox fx:id="panelResumen" spacing="12" styleClass="cash-panel-v3">
    <padding><Insets top="16" right="26" bottom="20" left="26"/></padding>
    <Label fx:id="etiquetaAdvertenciaPendientes" visible="false" managed="false" wrapText="true" styleClass="cash-warning-banner"/>
    <GridPane hgap="10" vgap="10"><columnConstraints><ColumnConstraints percentWidth="16.66"/><ColumnConstraints percentWidth="16.66"/><ColumnConstraints percentWidth="16.66"/><ColumnConstraints percentWidth="16.66"/><ColumnConstraints percentWidth="16.66"/><ColumnConstraints percentWidth="16.66"/></columnConstraints>
     <VBox styleClass="cash-summary-card, cash-total-card"><Label text="TOTAL NETO" styleClass="metric-label"/><Label fx:id="etiquetaTotalAcreditado" text="ARS 0" styleClass="cash-summary-value"/></VBox>
     <VBox GridPane.columnIndex="1" styleClass="cash-summary-card, cash-highlight-card"><Label text="EFECTIVO ESPERADO" styleClass="metric-label"/><Label fx:id="etiquetaEfectivoCalculado" text="ARS 0" styleClass="cash-summary-value"/></VBox>
     <VBox GridPane.columnIndex="2" styleClass="cash-summary-card, cash-refund-card"><Label text="REEMBOLSADO" styleClass="metric-label"/><Label fx:id="etiquetaTotalReembolsado" text="ARS 0" styleClass="cash-summary-value"/></VBox>
     <VBox GridPane.columnIndex="3" styleClass="cash-summary-card, cash-income-card"><Label text="INGRESOS MANUALES" styleClass="metric-label"/><Label fx:id="etiquetaIngresosManuales" text="ARS 0" styleClass="cash-summary-value"/></VBox>
     <VBox GridPane.columnIndex="4" styleClass="cash-summary-card, cash-expense-card"><Label text="EGRESOS MANUALES" styleClass="metric-label"/><Label fx:id="etiquetaEgresosManuales" text="ARS 0" styleClass="cash-summary-value"/></VBox>
     <VBox GridPane.columnIndex="5" styleClass="cash-summary-card"><Label text="PAGOS ACREDITADOS" styleClass="metric-label"/><Label fx:id="etiquetaPagosAcreditados" text="0" styleClass="cash-summary-value"/><Label fx:id="etiquetaPagosAcreditadosDetalle" text="movimientos" styleClass="cash-metric-detail-v3"/></VBox>
    </GridPane>
    <GridPane hgap="14" vgap="14" VBox.vgrow="ALWAYS"><columnConstraints><ColumnConstraints percentWidth="56"/><ColumnConstraints percentWidth="44"/></columnConstraints>
     <VBox spacing="8" styleClass="content-card, cash-fill-card-v3"><Label text="Desglose por medio de pago" styleClass="section-title"/><TableView fx:id="tablaMetodos" VBox.vgrow="ALWAYS" minHeight="150" prefHeight="220" styleClass="modern-table, cash-table-v3"><columns><TableColumn fx:id="columnaMetodo" text="MÉTODO" prefWidth="190"/><TableColumn fx:id="columnaMovimientos" text="MOVIMIENTOS" prefWidth="130"/><TableColumn fx:id="columnaTotal" text="TOTAL" prefWidth="180" styleClass="cash-money-column"/></columns><placeholder><Label text="Sin movimientos para esta fecha." styleClass="empty-state"/></placeholder></TableView></VBox>
     <VBox GridPane.columnIndex="1" spacing="8" styleClass="content-card, cash-fill-card-v3"><Label text="Actividad del día" styleClass="section-title"/><GridPane hgap="10" vgap="10" VBox.vgrow="ALWAYS"><columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints><VBox styleClass="cash-mini-card"><Label text="PAGOS PENDIENTES" styleClass="metric-label"/><Label fx:id="etiquetaPagosPendientes" text="0" styleClass="cash-mini-value"/></VBox><VBox GridPane.columnIndex="1" styleClass="cash-mini-card"><Label text="COMPLETADAS" styleClass="metric-label"/><Label fx:id="etiquetaReservasCompletadas" text="0" styleClass="cash-mini-value"/></VBox><VBox GridPane.rowIndex="1" styleClass="cash-mini-card"><Label text="AUSENCIAS" styleClass="metric-label"/><Label fx:id="etiquetaReservasAusentes" text="0" styleClass="cash-mini-value"/></VBox><VBox GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="cash-mini-card"><Label text="CANCELACIONES" styleClass="metric-label"/><Label fx:id="etiquetaReservasCanceladas" text="0" styleClass="cash-mini-value"/></VBox></GridPane></VBox>
    </GridPane>
   </VBox>

   <ScrollPane fx:id="scrollMovimientos" visible="false" managed="false" fitToWidth="true" hbarPolicy="NEVER" styleClass="cash-movements-scroll-v4">
    <VBox fx:id="panelMovimientos" spacing="12" styleClass="cash-panel-v3, cash-movements-content-v4">
    <padding><Insets top="16" right="26" bottom="20" left="26"/></padding>
    <VBox spacing="8" VBox.vgrow="ALWAYS" styleClass="content-card"><HBox alignment="CENTER_LEFT"><Label text="Pagos acreditados del día" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Label text="Doble clic para abrir los pagos de la reserva" styleClass="small-caption"/></HBox>
     <TableView fx:id="tablaPagosAcreditados" VBox.vgrow="ALWAYS" minHeight="190" prefHeight="260" styleClass="modern-table, cash-table-v3"><columns><TableColumn fx:id="columnaPagoAcreditado" text="ACREDITADO" prefWidth="150"/><TableColumn fx:id="columnaPagoCliente" text="CLIENTE" prefWidth="190"/><TableColumn fx:id="columnaPagoReserva" text="RESERVA" prefWidth="85"/><TableColumn fx:id="columnaPagoTurno" text="TURNO" prefWidth="145"/><TableColumn fx:id="columnaPagoCancha" text="CANCHA" prefWidth="135"/><TableColumn fx:id="columnaPagoMetodo" text="MÉTODO" prefWidth="130"/><TableColumn fx:id="columnaPagoImporte" text="IMPORTE" prefWidth="145" styleClass="cash-money-column"/><TableColumn fx:id="columnaPagoUsuario" text="USUARIO" prefWidth="135"/></columns><placeholder><Label text="No hay pagos acreditados para esta fecha." styleClass="empty-state"/></placeholder></TableView>
    </VBox>
    <VBox fx:id="contenedorNuevoMovimiento" spacing="9" styleClass="cash-close-card, cash-manual-v3"><HBox alignment="CENTER_LEFT"><VBox spacing="2"><Label text="Movimiento manual" styleClass="section-title"/><Label text="Registrá un ingreso o egreso adicional de la jornada." styleClass="small-caption"/></VBox><Region HBox.hgrow="ALWAYS"/><Button fx:id="botonRegistrarMovimiento" text="REGISTRAR MOVIMIENTO" onAction="#registrarMovimiento" minWidth="190" styleClass="primary-button"/></HBox>
     <GridPane hgap="10" vgap="8"><columnConstraints><ColumnConstraints percentWidth="18"/><ColumnConstraints percentWidth="34"/><ColumnConstraints percentWidth="18"/><ColumnConstraints percentWidth="30"/></columnConstraints><ComboBox fx:id="comboTipoMovimiento" promptText="Seleccionar tipo" maxWidth="Infinity" styleClass="modern-combo, cash-combo-v3"/><TextField fx:id="campoConceptoMovimiento" GridPane.columnIndex="1" promptText="Concepto o motivo" styleClass="modern-field"/><TextField fx:id="campoImporteMovimiento" GridPane.columnIndex="2" promptText="ARS 0,00" styleClass="modern-field"/><ComboBox fx:id="comboMedioMovimiento" GridPane.columnIndex="3" promptText="Seleccionar medio" maxWidth="Infinity" styleClass="modern-combo, cash-combo-v3"/><TextArea fx:id="campoObservacionesMovimiento" GridPane.rowIndex="1" GridPane.columnSpan="4" prefRowCount="1" promptText="Observaciones opcionales" wrapText="true" styleClass="modern-area, cash-notes-v3"/></GridPane>
    </VBox>
    <VBox spacing="8" VBox.vgrow="ALWAYS" styleClass="content-card"><Label text="Movimientos manuales del día" styleClass="section-title"/><TableView fx:id="tablaMovimientos" VBox.vgrow="ALWAYS" minHeight="254" prefHeight="324" styleClass="modern-table, cash-table-v3, cash-manual-table-v3"><columns><TableColumn fx:id="columnaMovimientoFecha" text="FECHA" prefWidth="145"/><TableColumn fx:id="columnaMovimientoTipo" text="TIPO" prefWidth="105"/><TableColumn fx:id="columnaMovimientoConcepto" text="CONCEPTO" prefWidth="260" styleClass="cash-concept-centered-v4"/><TableColumn fx:id="columnaMovimientoMedio" text="MEDIO" prefWidth="135"/><TableColumn fx:id="columnaMovimientoImporte" text="IMPORTE" prefWidth="150" styleClass="cash-money-column"/><TableColumn fx:id="columnaMovimientoUsuario" text="USUARIO" prefWidth="140"/></columns><placeholder><VBox alignment="CENTER" spacing="4"><Label text="Sin movimientos manuales" styleClass="empty-state"/><Label text="No se registraron ingresos ni egresos para esta fecha." styleClass="small-caption"/></VBox></placeholder></TableView></VBox>
    </VBox>
   </ScrollPane>

   <VBox fx:id="panelCierre" visible="false" managed="false" spacing="12" styleClass="cash-panel-v3">
    <padding><Insets top="16" right="26" bottom="20" left="26"/></padding>
    <VBox fx:id="contenedorFormularioCierre" spacing="12" styleClass="cash-close-card, cash-close-form-v3"><HBox alignment="CENTER_LEFT"><VBox spacing="2"><Label text="Confirmación de efectivo" styleClass="section-title"/><Label text="Compará el efectivo esperado con el contado antes de consolidar la jornada." styleClass="small-caption"/></VBox><Region HBox.hgrow="ALWAYS"/></HBox>
     <GridPane hgap="12" vgap="10"><columnConstraints><ColumnConstraints percentWidth="33.33"/><ColumnConstraints percentWidth="33.33"/><ColumnConstraints percentWidth="33.34"/></columnConstraints><VBox spacing="5" styleClass="cash-reconcile-card-v3"><Label text="EFECTIVO ESPERADO" styleClass="metric-label"/><Label fx:id="etiquetaCierreEsperado" text="ARS 0" styleClass="cash-reconcile-value-v3"/></VBox><VBox GridPane.columnIndex="1" spacing="5" styleClass="cash-reconcile-card-v3"><Label text="EFECTIVO CONTADO" styleClass="metric-label"/><TextField fx:id="campoEfectivoDeclarado" promptText="ARS 0,00" styleClass="modern-field, cash-counted-v3"/></VBox><VBox GridPane.columnIndex="2" spacing="5" styleClass="cash-reconcile-card-v3"><Label text="DIFERENCIA" styleClass="metric-label"/><Label fx:id="etiquetaDiferencia" text="ARS 0" maxWidth="Infinity" styleClass="cash-difference-ok"/></VBox></GridPane>
     <Label text="OBSERVACIONES" styleClass="field-label"/><TextArea fx:id="campoObservaciones" prefRowCount="3" wrapText="true" promptText="Información opcional del cierre" styleClass="modern-area"/>
     <Label text="El cierre consolida definitivamente la jornada seleccionada. Revisá pagos, movimientos manuales y efectivo contado antes de continuar." wrapText="true" styleClass="cash-final-warning-v3"/>
     <Label fx:id="etiquetaMensaje" minHeight="22" wrapText="true"/>
     <Button fx:id="botonCerrarCaja" text="CONFIRMAR CIERRE DEL DÍA" onAction="#cerrarCaja" maxWidth="Infinity" styleClass="cash-close-button"/>
    </VBox>
    <VBox fx:id="contenedorCierreExistente" visible="false" managed="false" spacing="12" styleClass="cash-closed-card, cash-closed-v3"><HBox alignment="CENTER_LEFT"><VBox spacing="2"><Label text="Cierre confirmado" styleClass="section-title"/><Label text="La jornada quedó consolidada y se encuentra en modo consulta." styleClass="small-caption"/></VBox><Region HBox.hgrow="ALWAYS"/><Label text="CAJA CERRADA" styleClass="cash-status-closed"/></HBox>
     <GridPane hgap="14" vgap="12"><columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints><VBox spacing="4" styleClass="cash-closed-field-v3"><Label text="FECHA DE JORNADA" styleClass="metric-label"/><Label fx:id="etiquetaCierreJornada" text="-" styleClass="cash-closed-value-v3"/></VBox><VBox GridPane.columnIndex="1" spacing="4" styleClass="cash-closed-field-v3"><Label text="CERRADA" styleClass="metric-label"/><Label fx:id="etiquetaCierreFecha" text="-" styleClass="cash-closed-value-v3"/></VBox><VBox GridPane.rowIndex="1" spacing="4" styleClass="cash-closed-field-v3"><Label text="RESPONSABLE" styleClass="metric-label"/><Label fx:id="etiquetaCierreResponsable" text="-" styleClass="cash-closed-value-v3"/></VBox><VBox GridPane.rowIndex="1" GridPane.columnIndex="1" spacing="4" styleClass="cash-closed-field-v3"><Label text="OBSERVACIONES" styleClass="metric-label"/><Label fx:id="etiquetaCierreObservaciones" text="Sin observaciones" wrapText="true" styleClass="cash-closed-value-v3"/></VBox></GridPane>
     <GridPane hgap="12"><columnConstraints><ColumnConstraints percentWidth="33.33"/><ColumnConstraints percentWidth="33.33"/><ColumnConstraints percentWidth="33.34"/></columnConstraints><VBox spacing="4" styleClass="cash-reconcile-card-v3"><Label text="EFECTIVO ESPERADO" styleClass="metric-label"/><Label fx:id="etiquetaCierreEsperadoConfirmado" text="ARS 0" styleClass="cash-reconcile-value-v3"/></VBox><VBox GridPane.columnIndex="1" spacing="4" styleClass="cash-reconcile-card-v3"><Label text="EFECTIVO DECLARADO" styleClass="metric-label"/><Label fx:id="etiquetaCierreDeclarado" text="ARS 0" styleClass="cash-reconcile-value-v3"/></VBox><VBox GridPane.columnIndex="2" spacing="4" styleClass="cash-reconcile-card-v3"><Label text="DIFERENCIA" styleClass="metric-label"/><Label fx:id="etiquetaCierreDiferencia" text="ARS 0" maxWidth="Infinity" styleClass="cash-difference-ok"/></VBox></GridPane>
     <Label fx:id="etiquetaDatosCierre" visible="false" managed="false"/>
    </VBox>
   </VBox>
  </StackPane>
 </center>
</BorderPane>
