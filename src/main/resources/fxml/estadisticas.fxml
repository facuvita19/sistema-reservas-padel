<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="vista.controlador.EstadisticasController" styleClass="stats-root">
 <top><VBox><HBox alignment="CENTER_LEFT" spacing="14" styleClass="module-header"><padding><Insets top="16" right="26" bottom="14" left="26"/></padding><Button text="INICIO" onAction="#volver" styleClass="admin-home-button"/><VBox spacing="2"><Label text="Estadísticas y reportes" styleClass="page-title"/><Label text="Análisis operativo, financiero y comercial del complejo." styleClass="page-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="¿CÓMO LEER ESTAS ESTADÍSTICAS?" onAction="#mostrarAyuda" styleClass="stats-help-button"/><Button text="DESCARGAR GUÍA PDF" onAction="#descargarGuiaPdf" styleClass="stats-guide-button"/><Button text="HOY" onAction="#periodoHoy" styleClass="stats-period-button"/><Button text="ESTE MES" onAction="#periodoMes" styleClass="stats-period-button"/><Button text="30 DÍAS" onAction="#periodoTreinta" styleClass="stats-period-button"/><Button text="ESTE AÑO" onAction="#periodoAnio" styleClass="stats-period-button"/></HBox><HBox alignment="CENTER_LEFT" spacing="10" styleClass="stats-filter-bar"><padding><Insets top="9" right="26" bottom="9" left="26"/></padding><Label text="PERÍODO" styleClass="stats-filter-overline"/><Label text="Desde" styleClass="field-label"/><DatePicker fx:id="fechaDesde" prefWidth="140" styleClass="modern-date"/><Label text="Hasta" styleClass="field-label"/><DatePicker fx:id="fechaHasta" prefWidth="140" styleClass="modern-date"/><Button fx:id="botonActualizar" text="ACTUALIZAR" onAction="#actualizar" styleClass="primary-button"/><Region HBox.hgrow="ALWAYS"/><ProgressIndicator fx:id="indicadorCarga" visible="false" maxWidth="18" maxHeight="18"/><Label fx:id="etiquetaEstado" text="Preparando estadísticas..." styleClass="stats-status"/><Label fx:id="etiquetaPeriodoComparado" styleClass="stats-period-copy"/></HBox><HBox alignment="CENTER_LEFT" spacing="7" styleClass="stats-section-bar"><padding><Insets top="8" right="26" bottom="8" left="26"/></padding><ToggleButton fx:id="botonResumen" text="RESUMEN" onAction="#mostrarResumen" styleClass="stats-section-button"/><ToggleButton fx:id="botonReservas" text="RESERVAS" onAction="#mostrarReservas" styleClass="stats-section-button"/><ToggleButton fx:id="botonFinanzas" text="FINANZAS" onAction="#mostrarFinanzas" styleClass="stats-section-button"/><ToggleButton fx:id="botonClientes" text="CLIENTES" onAction="#mostrarClientes" styleClass="stats-section-button"/><ToggleButton fx:id="botonCanchas" text="CANCHAS" onAction="#mostrarCanchas" styleClass="stats-section-button"/><ToggleButton fx:id="botonWeb" text="WEB" onAction="#mostrarWeb" styleClass="stats-section-button"/></HBox></VBox></top>
 <center><ScrollPane fx:id="scrollEstadisticas" fitToWidth="true" hbarPolicy="NEVER" styleClass="stats-scroll"><VBox minWidth="980" spacing="16" styleClass="stats-content"><padding><Insets top="18" right="24" bottom="30" left="24"/></padding>
  <VBox fx:id="panelProximamente" visible="false" managed="false" alignment="CENTER" spacing="10" styleClass="stats-coming-card"><Label fx:id="tituloProximamente" styleClass="stats-coming-title"/><Label fx:id="textoProximamente" wrapText="true" maxWidth="620" styleClass="stats-coming-copy"/><Label text="La navegación ya está preparada y conservará el período seleccionado." styleClass="stats-coming-note"/></VBox>
  <VBox fx:id="panelReservas" visible="false" managed="false" spacing="16">
   <HBox spacing="12"><VBox HBox.hgrow="ALWAYS" styleClass="stats-hero-card"><Label text="SOLICITUDES" styleClass="metric-label"/><Label fx:id="reservaSolicitudes" text="0" styleClass="stats-hero-value"/><Label text="Todos los registros creados" styleClass="stats-card-note"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="stats-hero-card"><Label text="RESERVAS EFECTIVAS" styleClass="metric-label"/><Label fx:id="reservaEfectivas" text="0" styleClass="stats-hero-value"/><Label text="Sin canceladas ni expiradas" styleClass="stats-card-note"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="stats-hero-card"><Label text="ORIGEN PERSONAL" styleClass="metric-label"/><Label fx:id="reservaPersonal" text="0" styleClass="stats-hero-value"/><Label text="Creadas por el personal" styleClass="stats-card-note"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="stats-hero-card"><Label text="ORIGEN WEB" styleClass="metric-label"/><Label fx:id="reservaWeb" text="0" styleClass="stats-hero-value"/><Label text="Solicitudes desde la web" styleClass="stats-card-note"/></VBox></HBox>
   <GridPane hgap="10" vgap="10"><columnConstraints><ColumnConstraints percentWidth="16.66"/><ColumnConstraints percentWidth="16.67"/><ColumnConstraints percentWidth="16.67"/><ColumnConstraints percentWidth="16.67"/><ColumnConstraints percentWidth="16.67"/><ColumnConstraints percentWidth="16.66"/></columnConstraints><VBox styleClass="stats-metric-card"><Label text="PENDIENTES" styleClass="metric-label"/><Label fx:id="reservaPendientes" text="0" styleClass="stats-metric-value"/></VBox><VBox GridPane.columnIndex="1" styleClass="stats-metric-card"><Label text="CONFIRMADAS" styleClass="metric-label"/><Label fx:id="reservaConfirmadas" text="0" styleClass="stats-metric-value"/></VBox><VBox GridPane.columnIndex="2" styleClass="stats-metric-card"><Label text="COMPLETADAS" styleClass="metric-label"/><Label fx:id="reservaCompletadas" text="0" styleClass="stats-metric-value"/></VBox><VBox GridPane.columnIndex="3" styleClass="stats-metric-card"><Label text="CANCELADAS" styleClass="metric-label"/><Label fx:id="reservaCanceladas" text="0" styleClass="stats-metric-value"/></VBox><VBox GridPane.columnIndex="4" styleClass="stats-metric-card"><Label text="AUSENCIAS" styleClass="metric-label"/><Label fx:id="reservaAusencias" text="0" styleClass="stats-metric-value"/></VBox><VBox GridPane.columnIndex="5" styleClass="stats-metric-card"><Label text="EXPIRADAS" styleClass="metric-label"/><Label fx:id="reservaExpiradas" text="0" styleClass="stats-metric-value"/></VBox></GridPane>
   <GridPane hgap="10" vgap="10"><columnConstraints><ColumnConstraints percentWidth="16.66"/><ColumnConstraints percentWidth="16.67"/><ColumnConstraints percentWidth="16.67"/><ColumnConstraints percentWidth="16.67"/><ColumnConstraints percentWidth="16.67"/><ColumnConstraints percentWidth="16.66"/></columnConstraints><VBox styleClass="stats-rate-card"><Label text="CONFIRMACIÓN" styleClass="metric-label"/><Label fx:id="tasaConfirmacion" text="0 %" styleClass="stats-rate-value"/><Label text="Confirmadas o resueltas / solicitudes" wrapText="true" styleClass="stats-rate-help"/></VBox><VBox GridPane.columnIndex="1" styleClass="stats-rate-card"><Label text="FINALIZACIÓN" styleClass="metric-label"/><Label fx:id="tasaFinalizacion" text="0 %" styleClass="stats-rate-value"/><Label text="Completadas / efectivas" styleClass="stats-rate-help"/></VBox><VBox GridPane.columnIndex="2" styleClass="stats-rate-card"><Label text="CANCELACIÓN" styleClass="metric-label"/><Label fx:id="tasaCancelacion" text="0 %" styleClass="stats-rate-value"/><Label text="Canceladas / solicitudes" styleClass="stats-rate-help"/></VBox><VBox GridPane.columnIndex="3" styleClass="stats-rate-card"><Label text="AUSENCIA" styleClass="metric-label"/><Label fx:id="tasaAusencia" text="0 %" styleClass="stats-rate-value"/><Label text="Ausentes / solicitudes totales" styleClass="stats-rate-help"/></VBox><VBox GridPane.columnIndex="4" styleClass="stats-rate-card"><Label text="EXPIRACIÓN WEB" styleClass="metric-label"/><Label fx:id="tasaExpiracionWeb" text="0 %" styleClass="stats-rate-value"/><Label text="Expiradas / solicitudes web" styleClass="stats-rate-help"/></VBox><VBox GridPane.columnIndex="5" styleClass="stats-rate-card"><Label text="CONFIRMACIÓN WEB" styleClass="metric-label"/><Label fx:id="tasaConversionWeb" text="0 %" styleClass="stats-rate-value"/><Label text="Porcentaje de solicitudes realizadas desde la web que llegaron a confirmarse." wrapText="true" styleClass="stats-rate-help"/></VBox></GridPane>
   <GridPane hgap="14" vgap="14"><columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints><VBox styleClass="stats-chart-card"><Label text="Origen de las solicitudes" styleClass="section-title"/><Label text="Compara reservas administrativas con solicitudes web." styleClass="stats-chart-subtitle"/><PieChart fx:id="graficoReservasOrigen" prefHeight="260"/></VBox><VBox GridPane.columnIndex="1" styleClass="stats-chart-card"><Label text="Cancelaciones por tipo" styleClass="section-title"/><Label text="Cliente, administrativa o sin clasificación histórica." styleClass="stats-chart-subtitle"/><PieChart fx:id="graficoCancelacionesTipo" prefHeight="260"/></VBox><VBox GridPane.rowIndex="1" styleClass="stats-chart-card"><Label text="Solicitudes por día" styleClass="section-title"/><Label text="Incluye días sin actividad dentro del período." styleClass="stats-chart-subtitle"/><LineChart fx:id="graficoEvolucionReservas" prefHeight="270"><xAxis><CategoryAxis/></xAxis><yAxis><NumberAxis label="Solicitudes"/></yAxis></LineChart></VBox><VBox GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="stats-chart-card"><Label text="Incidencias por día" styleClass="section-title"/><Label text="Suma cancelaciones, expiraciones y ausencias." styleClass="stats-chart-subtitle"/><LineChart fx:id="graficoEvolucionIncidencias" prefHeight="270"><xAxis><CategoryAxis/></xAxis><yAxis><NumberAxis label="Incidencias"/></yAxis></LineChart></VBox></GridPane>
   <HBox spacing="14"><VBox HBox.hgrow="ALWAYS" styleClass="stats-explanation-card"><Label text="Cómo se interpreta" styleClass="section-title"/><Label text="Las solicitudes se agrupan por fecha del turno. Las reservas efectivas incluyen pendientes, confirmadas, completadas y ausentes. Las canceladas y expiradas se informan por separado." wrapText="true" styleClass="stats-explanation-copy"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="stats-explanation-card"><Label text="Sobre la conversión web" styleClass="section-title"/><Label text="La conversión considera solicitudes web que alcanzaron confirmación o una resolución posterior. Las expiradas representan turnos liberados por falta de acreditación dentro del plazo." wrapText="true" styleClass="stats-explanation-copy"/></VBox></HBox>
  </VBox>
  <VBox fx:id="panelFinanzas" visible="false" managed="false" spacing="16">
   <HBox spacing="12"><VBox HBox.hgrow="ALWAYS" styleClass="stats-hero-card"><Label text="PAGOS RECIBIDOS" styleClass="metric-label"/><Label fx:id="finPagosRecibidos" text="0" styleClass="stats-hero-value"/><Label text="Pagos acreditados en el período" styleClass="stats-card-note"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="stats-hero-card"><Label text="DINERO REEMBOLSADO" styleClass="metric-label"/><Label fx:id="finReembolsado" text="0" styleClass="stats-hero-value"/><Label text="Dinero devuelto durante el período" styleClass="stats-card-note"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="stats-hero-card"><Label text="INGRESO DESPUÉS DE REEMBOLSOS" styleClass="metric-label"/><Label fx:id="finIngresoFinal" text="0" styleClass="stats-hero-value"/><Label text="Pagos recibidos menos devoluciones" styleClass="stats-card-note"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="stats-hero-card"><Label text="RESULTADO DEL PERÍODO" styleClass="metric-label"/><Label fx:id="finResultadoPeriodo" text="0" styleClass="stats-hero-value"/><Label text="Incluye movimientos manuales de caja" styleClass="stats-card-note"/></VBox></HBox>
   <GridPane hgap="10" vgap="10"><columnConstraints><ColumnConstraints percentWidth="16.66"/><ColumnConstraints percentWidth="16.67"/><ColumnConstraints percentWidth="16.67"/><ColumnConstraints percentWidth="16.67"/><ColumnConstraints percentWidth="16.67"/><ColumnConstraints percentWidth="16.66"/></columnConstraints><VBox styleClass="stats-finance-card"><Label text="CANTIDAD DE PAGOS" styleClass="metric-label"/><Label fx:id="finCantidadPagos" text="0" styleClass="stats-metric-value"/></VBox><VBox GridPane.columnIndex="1" styleClass="stats-finance-card"><Label text="IMPORTE PROMEDIO" styleClass="metric-label"/><Label fx:id="finPagoPromedio" text="0" styleClass="stats-money-value"/></VBox><VBox GridPane.columnIndex="2" styleClass="stats-finance-card"><Label text="INGRESOS DE CAJA" styleClass="metric-label"/><Label fx:id="finIngresosCaja" text="0" styleClass="stats-money-value"/></VBox><VBox GridPane.columnIndex="3" styleClass="stats-finance-card"><Label text="EGRESOS DE CAJA" styleClass="metric-label"/><Label fx:id="finEgresosCaja" text="0" styleClass="stats-money-value"/></VBox><VBox GridPane.columnIndex="4" styleClass="stats-finance-card"><Label text="PAGOS PENDIENTES" styleClass="metric-label"/><Label fx:id="finPagosPendientes" text="0" styleClass="stats-metric-value"/></VBox><VBox GridPane.columnIndex="5" styleClass="stats-finance-card"><Label text="DIFERENCIA DE EFECTIVO" styleClass="metric-label"/><Label fx:id="finDiferenciaCaja" text="0" styleClass="stats-money-value"/></VBox></GridPane>
   <GridPane hgap="14" vgap="14"><columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints><VBox styleClass="stats-chart-card"><Label text="Pagos recibidos por día" styleClass="section-title"/><Label text="Incluye pagos que luego fueron reembolsados." styleClass="stats-chart-subtitle"/><LineChart fx:id="graficoFinPagosDia" prefHeight="270"><xAxis><CategoryAxis/></xAxis><yAxis><NumberAxis label="Importe"/></yAxis></LineChart></VBox><VBox GridPane.columnIndex="1" styleClass="stats-chart-card"><Label text="Dinero reembolsado por día" styleClass="section-title"/><Label text="Se organiza por la fecha en que se realizó la devolución." styleClass="stats-chart-subtitle"/><LineChart fx:id="graficoFinReembolsosDia" prefHeight="270"><xAxis><CategoryAxis/></xAxis><yAxis><NumberAxis label="Importe"/></yAxis></LineChart></VBox><VBox GridPane.rowIndex="1" styleClass="stats-chart-card"><Label text="Ingreso diario después de reembolsos" styleClass="section-title"/><Label text="Pagos recibidos menos dinero devuelto en cada fecha." styleClass="stats-chart-subtitle"/><LineChart fx:id="graficoFinResultadoDia" prefHeight="270"><xAxis><CategoryAxis/></xAxis><yAxis><NumberAxis label="Importe"/></yAxis></LineChart></VBox><VBox GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="stats-chart-card"><Label text="Pagos recibidos por medio" styleClass="section-title"/><Label text="Distribución del dinero recibido según el medio de pago." styleClass="stats-chart-subtitle"/><PieChart fx:id="graficoFinMetodos" prefHeight="270"/></VBox><VBox GridPane.rowIndex="2" styleClass="stats-chart-card"><Label text="Movimientos agregados en caja" styleClass="section-title"/><Label text="Compara ingresos y egresos registrados manualmente." styleClass="stats-chart-subtitle"/><PieChart fx:id="graficoFinCajaTipo" prefHeight="270"/></VBox><VBox GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="stats-chart-card"><Label text="Movimientos manuales por medio" styleClass="section-title"/><Label text="Resultado absoluto agrupado por efectivo, transferencia, tarjeta u otro." styleClass="stats-chart-subtitle"/><PieChart fx:id="graficoFinCajaMedio" prefHeight="270"/></VBox><VBox GridPane.rowIndex="3" GridPane.columnSpan="2" styleClass="stats-chart-card"><Label text="Diferencias de efectivo en cierres" styleClass="section-title"/><Label text="Muestra sobrantes y faltantes registrados al cerrar cada fecha." styleClass="stats-chart-subtitle"/><LineChart fx:id="graficoFinDiferencias" prefHeight="270"><xAxis><CategoryAxis/></xAxis><yAxis><NumberAxis label="Diferencia"/></yAxis></LineChart></VBox></GridPane>
   <VBox spacing="10" styleClass="stats-chart-card"><Label text="Historial de cierres del período" styleClass="section-title"/><TableView fx:id="tablaCierresFinanzas" prefHeight="245" styleClass="modern-table"><placeholder><Label text="El historial detallado se muestra en Resumen y se incorporará aquí en una siguiente mejora visual." wrapText="true" styleClass="empty-state"/></placeholder></TableView></VBox>
   <HBox spacing="14"><VBox HBox.hgrow="ALWAYS" styleClass="stats-explanation-card"><Label text="Cómo se calcula" styleClass="section-title"/><Label text="Pagos recibidos incluye todo pago acreditado en el período, aunque después haya sido reembolsado. El dinero reembolsado se organiza por la fecha de devolución." wrapText="true" styleClass="stats-explanation-copy"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="stats-explanation-card"><Label text="Resultado del período" styleClass="section-title"/><Label text="Se calcula tomando los pagos recibidos, restando reembolsos, sumando ingresos manuales y descontando egresos manuales de caja." wrapText="true" styleClass="stats-explanation-copy"/></VBox></HBox>
