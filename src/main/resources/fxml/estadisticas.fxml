<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="vista.controlador.EstadisticasController" styleClass="stats-root">
 <top><VBox><HBox alignment="CENTER_LEFT" spacing="14" styleClass="module-header"><padding><Insets top="16" right="26" bottom="14" left="26"/></padding><Button text="INICIO" onAction="#volver" styleClass="admin-home-button"/><VBox spacing="2"><Label text="Estadísticas y reportes" styleClass="page-title"/><Label text="Análisis operativo, financiero y comercial del complejo." styleClass="page-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="HOY" onAction="#periodoHoy" styleClass="stats-period-button"/><Button text="ESTE MES" onAction="#periodoMes" styleClass="stats-period-button"/><Button text="30 DÍAS" onAction="#periodoTreinta" styleClass="stats-period-button"/><Button text="ESTE AÑO" onAction="#periodoAnio" styleClass="stats-period-button"/></HBox><HBox alignment="CENTER_LEFT" spacing="10" styleClass="stats-filter-bar"><padding><Insets top="9" right="26" bottom="9" left="26"/></padding><Label text="PERÍODO" styleClass="stats-filter-overline"/><Label text="Desde" styleClass="field-label"/><DatePicker fx:id="fechaDesde" prefWidth="140" styleClass="modern-date"/><Label text="Hasta" styleClass="field-label"/><DatePicker fx:id="fechaHasta" prefWidth="140" styleClass="modern-date"/><Button fx:id="botonActualizar" text="ACTUALIZAR" onAction="#actualizar" styleClass="primary-button"/><Region HBox.hgrow="ALWAYS"/><ProgressIndicator fx:id="indicadorCarga" visible="false" maxWidth="18" maxHeight="18"/><Label fx:id="etiquetaEstado" text="Preparando estadísticas..." styleClass="stats-status"/><Label fx:id="etiquetaPeriodoComparado" styleClass="stats-period-copy"/></HBox><HBox alignment="CENTER_LEFT" spacing="7" styleClass="stats-section-bar"><padding><Insets top="8" right="26" bottom="8" left="26"/></padding><ToggleButton fx:id="botonResumen" text="RESUMEN" onAction="#mostrarResumen" styleClass="stats-section-button"/><ToggleButton fx:id="botonReservas" text="RESERVAS" onAction="#mostrarReservas" styleClass="stats-section-button"/><ToggleButton fx:id="botonFinanzas" text="FINANZAS" onAction="#mostrarFinanzas" styleClass="stats-section-button"/><ToggleButton fx:id="botonClientes" text="CLIENTES" onAction="#mostrarClientes" styleClass="stats-section-button"/><ToggleButton fx:id="botonCanchas" text="CANCHAS" onAction="#mostrarCanchas" styleClass="stats-section-button"/><ToggleButton fx:id="botonWeb" text="WEB" onAction="#mostrarWeb" styleClass="stats-section-button"/></HBox></VBox></top>
 <center><ScrollPane fx:id="scrollEstadisticas" fitToWidth="true" hbarPolicy="NEVER" styleClass="stats-scroll"><VBox minWidth="980" spacing="16" styleClass="stats-content"><padding><Insets top="18" right="24" bottom="30" left="24"/></padding>
  <VBox fx:id="panelProximamente" visible="false" managed="false" alignment="CENTER" spacing="10" styleClass="stats-coming-card"><Label fx:id="tituloProximamente" styleClass="stats-coming-title"/><Label fx:id="textoProximamente" wrapText="true" maxWidth="620" styleClass="stats-coming-copy"/><Label text="La navegación ya está preparada y conservará el período seleccionado." styleClass="stats-coming-note"/></VBox>
  <VBox fx:id="panelResumen" spacing="16">
   <HBox spacing="12"><VBox HBox.hgrow="ALWAYS" styleClass="stats-hero-card"><Label text="INGRESOS NETOS" styleClass="metric-label"/><Label fx:id="etiquetaIngresosNetos" text="\$ 0,00" styleClass="stats-hero-value"/><Label fx:id="etiquetaVariacionIngresos" text="Sin base de comparación" styleClass="stats-trend-flat"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="stats-hero-card"><Label text="RESULTADO OPERATIVO" styleClass="metric-label"/><Label fx:id="etiquetaResultadoOperativo" text="\$ 0,00" styleClass="stats-hero-value"/><Label text="Neto + caja manual" styleClass="stats-card-note"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="stats-hero-card"><Label text="RESERVAS EFECTIVAS" styleClass="metric-label"/><Label fx:id="etiquetaEfectivas" text="0" styleClass="stats-hero-value"/><Label fx:id="etiquetaVariacionReservas" text="Sin base de comparación" styleClass="stats-trend-flat"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="stats-hero-card"><Label text="OCUPACIÓN TEÓRICA" styleClass="metric-label"/><Label fx:id="etiquetaOcupacion" text="0 %" styleClass="stats-hero-value"/><Label text="Según configuración actual" styleClass="stats-card-note"/></VBox></HBox>
   <GridPane hgap="10" vgap="10"><columnConstraints><ColumnConstraints percentWidth="12.5"/><ColumnConstraints percentWidth="12.5"/><ColumnConstraints percentWidth="12.5"/><ColumnConstraints percentWidth="12.5"/><ColumnConstraints percentWidth="12.5"/><ColumnConstraints percentWidth="12.5"/><ColumnConstraints percentWidth="12.5"/><ColumnConstraints percentWidth="12.5"/></columnConstraints>
    <VBox styleClass="stats-metric-card"><Label text="SOLICITUDES" styleClass="metric-label"/><Label fx:id="etiquetaTotalReservas" text="0" styleClass="stats-metric-value"/></VBox><VBox GridPane.columnIndex="1" styleClass="stats-metric-card"><Label text="PENDIENTES" styleClass="metric-label"/><Label fx:id="etiquetaPendientes" text="0" styleClass="stats-metric-value"/></VBox><VBox GridPane.columnIndex="2" styleClass="stats-metric-card"><Label text="CONFIRMADAS" styleClass="metric-label"/><Label fx:id="etiquetaConfirmadas" text="0" styleClass="stats-metric-value"/></VBox><VBox GridPane.columnIndex="3" styleClass="stats-metric-card"><Label text="COMPLETADAS" styleClass="metric-label"/><Label fx:id="etiquetaCompletadas" text="0" styleClass="stats-metric-value"/></VBox><VBox GridPane.columnIndex="4" styleClass="stats-metric-card"><Label text="CANCELADAS" styleClass="metric-label"/><Label fx:id="etiquetaCanceladas" text="0" styleClass="stats-metric-value"/></VBox><VBox GridPane.columnIndex="5" styleClass="stats-metric-card"><Label text="AUSENCIAS" styleClass="metric-label"/><Label fx:id="etiquetaAusencias" text="0" styleClass="stats-metric-value"/></VBox><VBox GridPane.columnIndex="6" styleClass="stats-metric-card"><Label text="EXPIRADAS" styleClass="metric-label"/><Label fx:id="etiquetaExpiradas" text="0" styleClass="stats-metric-value"/></VBox><VBox GridPane.columnIndex="7" styleClass="stats-metric-card"><Label text="PAGOS" styleClass="metric-label"/><Label fx:id="etiquetaPagosAcreditados" text="0" styleClass="stats-metric-value"/></VBox>
   </GridPane>
   <GridPane hgap="10" vgap="10"><columnConstraints><ColumnConstraints percentWidth="16.66"/><ColumnConstraints percentWidth="16.67"/><ColumnConstraints percentWidth="16.67"/><ColumnConstraints percentWidth="16.67"/><ColumnConstraints percentWidth="16.67"/><ColumnConstraints percentWidth="16.66"/></columnConstraints><VBox styleClass="stats-finance-card"><Label text="INGRESOS BRUTOS" styleClass="metric-label"/><Label fx:id="etiquetaIngresos" text="\$ 0,00" styleClass="stats-money-value"/></VBox><VBox GridPane.columnIndex="1" styleClass="stats-finance-card"><Label text="REEMBOLSOS" styleClass="metric-label"/><Label fx:id="etiquetaReembolsado" text="\$ 0,00" styleClass="stats-money-value"/></VBox><VBox GridPane.columnIndex="2" styleClass="stats-finance-card"><Label text="INGRESOS MANUALES" styleClass="metric-label"/><Label fx:id="etiquetaIngresosManuales" text="\$ 0,00" styleClass="stats-money-value"/></VBox><VBox GridPane.columnIndex="3" styleClass="stats-finance-card"><Label text="EGRESOS MANUALES" styleClass="metric-label"/><Label fx:id="etiquetaEgresosManuales" text="\$ 0,00" styleClass="stats-money-value"/></VBox><VBox GridPane.columnIndex="4" styleClass="stats-finance-card"><Label text="PAGO PROMEDIO" styleClass="metric-label"/><Label fx:id="etiquetaTicketPromedio" text="\$ 0,00" styleClass="stats-money-value"/></VBox><VBox GridPane.columnIndex="5" styleClass="stats-finance-card"><Label text="INGRESO NETO" styleClass="metric-label"/><Label text="Bruto - reembolsos" styleClass="stats-card-note"/></VBox></GridPane>
   <HBox spacing="12"><VBox HBox.hgrow="ALWAYS" styleClass="stats-insight-card"><Label text="CANCHA PRINCIPAL" styleClass="metric-label"/><Label fx:id="hallazgoCancha" styleClass="stats-insight-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="stats-insight-card"><Label text="HORARIO PRINCIPAL" styleClass="metric-label"/><Label fx:id="hallazgoHorario" styleClass="stats-insight-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="stats-insight-card"><Label text="DÍA PRINCIPAL" styleClass="metric-label"/><Label fx:id="hallazgoDia" styleClass="stats-insight-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="stats-insight-card"><Label text="CLIENTE PRINCIPAL" styleClass="metric-label"/><Label fx:id="hallazgoCliente" styleClass="stats-insight-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="stats-insight-card"><Label text="MÉTODO PRINCIPAL" styleClass="metric-label"/><Label fx:id="hallazgoMetodo" styleClass="stats-insight-value"/></VBox></HBox>
   <GridPane hgap="14" vgap="14"><columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints><VBox styleClass="stats-chart-card"><Label text="Reservas por estado" styleClass="section-title"/><PieChart fx:id="graficoEstados" prefHeight="245"/></VBox><VBox GridPane.columnIndex="1" styleClass="stats-chart-card"><Label text="Ingresos por método de pago" styleClass="section-title"/><PieChart fx:id="graficoMetodos" prefHeight="245"/></VBox><VBox GridPane.rowIndex="1" styleClass="stats-chart-card"><Label text="Uso por cancha" styleClass="section-title"/><BarChart fx:id="graficoCanchas" prefHeight="245"><xAxis><CategoryAxis/></xAxis><yAxis><NumberAxis label="Reservas"/></yAxis></BarChart></VBox><VBox GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="stats-chart-card"><Label text="Horarios más solicitados" styleClass="section-title"/><BarChart fx:id="graficoHorarios" prefHeight="245"><xAxis><CategoryAxis/></xAxis><yAxis><NumberAxis label="Reservas"/></yAxis></BarChart></VBox><VBox GridPane.rowIndex="2" styleClass="stats-chart-card"><Label text="Demanda semanal" styleClass="section-title"/><BarChart fx:id="graficoDias" prefHeight="245"><xAxis><CategoryAxis/></xAxis><yAxis><NumberAxis label="Reservas"/></yAxis></BarChart></VBox><VBox GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="stats-chart-card"><Label text="Clientes con más reservas" styleClass="section-title"/><BarChart fx:id="graficoClientes" prefHeight="245"><xAxis><CategoryAxis/></xAxis><yAxis><NumberAxis label="Reservas"/></yAxis></BarChart></VBox></GridPane>
   <VBox styleClass="stats-chart-card"><Label text="Ingresos acreditados por mes" styleClass="section-title"/><LineChart fx:id="graficoIngresos" prefHeight="265"><xAxis><CategoryAxis/></xAxis><yAxis><NumberAxis label="ARS"/></yAxis></LineChart></VBox>
   <VBox spacing="10" styleClass="stats-chart-card"><Label text="Historial de cierres de caja" styleClass="section-title"/><TableView fx:id="tablaCierres" prefHeight="240" styleClass="modern-table"><columns><TableColumn fx:id="columnaFechaCierre" text="FECHA" prefWidth="100"/><TableColumn fx:id="columnaTotalCierre" text="TOTAL" prefWidth="135"/><TableColumn fx:id="columnaEfectivoCalculado" text="EFECTIVO CALC." prefWidth="145"/><TableColumn fx:id="columnaEfectivoDeclarado" text="EFECTIVO DECL." prefWidth="145"/><TableColumn fx:id="columnaDiferencia" text="DIFERENCIA" prefWidth="130"/><TableColumn fx:id="columnaReembolsado" text="REEMBOLSADO" prefWidth="135"/><TableColumn fx:id="columnaUsuario" text="CERRADA POR" prefWidth="130"/><TableColumn fx:id="columnaFechaHoraCierre" text="CERRADA" prefWidth="155"/></columns><placeholder><Label text="No existen cierres de caja para este período." styleClass="empty-state"/></placeholder></TableView></VBox>
  </VBox>
 </VBox></ScrollPane></center>
</BorderPane>
