   <GridPane hgap="14" vgap="14"><columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints><VBox styleClass="stats-chart-card"><Label text="Clientes con más reservas" styleClass="section-title"/><Label text="Solo considera reservas efectivas del período." styleClass="stats-chart-subtitle"/><VBox fx:id="listaCliReservas" spacing="6"/></VBox><VBox GridPane.columnIndex="1" styleClass="stats-chart-card"><Label text="Clientes con más pagos recibidos" styleClass="section-title"/><Label text="Solo incluye pagos de reservas acreditados en el período." styleClass="stats-chart-subtitle"/><VBox fx:id="listaCliFacturacion" spacing="6"/></VBox><VBox GridPane.rowIndex="1" styleClass="stats-chart-card"><Label text="Clientes nuevos por mes" styleClass="section-title"/><Label text="Muestra cuándo se creó cada ficha de cliente." styleClass="stats-chart-subtitle"/><LineChart fx:id="graficoCliAltas" prefHeight="270"><xAxis><CategoryAxis/></xAxis><yAxis><NumberAxis label="Clientes"/></yAxis></LineChart></VBox><VBox GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="stats-chart-card"><Label text="Posición preferida" styleClass="section-title"/><Label text="Distribución de la base activa de clientes." styleClass="stats-chart-subtitle"/><PieChart fx:id="graficoCliPosicion" prefHeight="270"/></VBox><VBox GridPane.rowIndex="2" styleClass="stats-chart-card"><Label text="Estado de las fichas" styleClass="section-title"/><Label text="Compara clientes activos e inactivos." styleClass="stats-chart-subtitle"/><PieChart fx:id="graficoCliEstado" prefHeight="270"/></VBox><VBox GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="stats-chart-card"><Label text="Actividad del período" styleClass="section-title"/><Label text="Compara clientes que reservaron con participantes vinculados en torneos." styleClass="stats-chart-subtitle"/><PieChart fx:id="graficoCliActividad" prefHeight="270"/></VBox></GridPane>
