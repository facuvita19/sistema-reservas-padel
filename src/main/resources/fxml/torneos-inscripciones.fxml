<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" stylesheets="@../css/torneos-inscripciones.css" xmlns:fx="http://javafx.com/fxml" fx:controller="vista.controlador.TorneosInscripcionesController" styleClass="tournaments-root">
 <!-- inscripciones-centrado-colores-v1 -->
 <!-- inscripciones-texto-en-espera-v2 -->
 <!-- inscripciones-titulo-izquierda-v1 -->
 <top><HBox alignment="CENTER_LEFT" spacing="14" styleClass="module-header"><padding><Insets top="16" right="24" bottom="16" left="24"/></padding><Button text="INICIO" onAction="#volver" styleClass="admin-home-button"/><VBox alignment="CENTER_LEFT" spacing="2" styleClass="inscriptions-title-left"><Label text="Inscripciones" styleClass="page-title"/><Label text="Administración de participantes, vinculaciones y solicitudes." styleClass="page-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="AGREGAR INSCRIPCIÓN" onAction="#agregarPareja" styleClass="primary-button"/><Button text="ACTUALIZAR" onAction="#cargarInscripciones" styleClass="inscriptions-refresh-button"/></HBox></top>
 <center><HBox styleClass="tournaments-content">
  <VBox spacing="11" HBox.hgrow="ALWAYS"><padding><Insets top="14" right="14" bottom="16" left="20"/></padding>
   <HBox spacing="8"><VBox HBox.hgrow="ALWAYS" styleClass="tournament-metric"><Label text="TOTAL" styleClass="metric-label"/><Label fx:id="etiquetaTotal" text="0" styleClass="tournament-metric-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="tournament-metric,tournament-metric-pending"><Label text="PENDIENTES" styleClass="metric-label"/><Label fx:id="etiquetaPendientes" text="0" styleClass="tournament-metric-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="tournament-metric,tournament-metric-confirmed"><Label text="CONFIRMADAS" styleClass="metric-label"/><Label fx:id="etiquetaConfirmadas" text="0" styleClass="tournament-metric-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="tournament-metric,tournament-metric-wait"><Label text="EN ESPERA" styleClass="metric-label"/><Label fx:id="etiquetaEspera" text="0" styleClass="tournament-metric-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="tournament-metric,tournament-metric-final"><Label text="FINALIZADAS" styleClass="metric-label"/><Label fx:id="etiquetaFinalizadas" text="0" styleClass="tournament-metric-value"/></VBox></HBox>
   <HBox spacing="8"><TextField fx:id="campoBuscar" promptText="Buscar por torneo, categoría, integrante, teléfono o número..." HBox.hgrow="ALWAYS" styleClass="modern-field"/><ComboBox fx:id="filtroEstado" promptText="Todos los estados" prefWidth="185" styleClass="modern-combo"/><Button text="LIMPIAR" onAction="#limpiarFiltros" styleClass="inscriptions-clear-button"/></HBox>
   <Label fx:id="etiquetaMensaje" minHeight="18" styleClass="small-caption"/>
   <TableView fx:id="tablaInscripciones" VBox.vgrow="ALWAYS" styleClass="modern-table,inscriptions-table"><columns><TableColumn fx:id="columnaId" text="#" prefWidth="48" minWidth="44" maxWidth="58"/><TableColumn fx:id="columnaTorneo" text="TORNEO" prefWidth="205"/><TableColumn fx:id="columnaCategoria" text="CATEGORÍA" prefWidth="135"/><TableColumn fx:id="columnaResponsable" text="RESPONSABLE" prefWidth="195"/><TableColumn fx:id="columnaPareja" text="SEGUNDO INTEGRANTE" prefWidth="195"/><TableColumn fx:id="columnaEstado" text="ESTADO" prefWidth="105"/><TableColumn fx:id="columnaFecha" text="SOLICITUD" prefWidth="140"/></columns><placeholder><Label text="No hay inscripciones para mostrar." styleClass="empty-state"/></placeholder></TableView>
  </VBox>
  <BorderPane prefWidth="430" minWidth="390" styleClass="inscription-detail-shell">
   <top><VBox spacing="6" styleClass="inscription-detail-header"><padding><Insets top="18" right="18" bottom="14" left="18"/></padding><HBox alignment="CENTER_LEFT"><Label fx:id="detalleTitulo" text="Seleccioná una inscripción" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="detalleEstado" text="" styleClass="tournament-state"/></HBox><Label fx:id="detalleTorneo" wrapText="true" styleClass="inscription-tournament-title"/><Label fx:id="detalleCategoria" styleClass="inscription-category"/><HBox spacing="14"><Label fx:id="detalleOrigen" styleClass="inscription-meta"/><Label fx:id="detalleFecha" styleClass="inscription-meta"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="detallePrecio" styleClass="inscription-price"/></HBox></VBox></top>
   <center><ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="tournament-detail-scroll"><content><VBox spacing="10" styleClass="tournament-detail"><padding><Insets top="12" right="16" bottom="34" left="16"/></padding>
    <VBox spacing="5" styleClass="player-card"><Label text="RESPONSABLE" styleClass="field-label"/><Label fx:id="responsableNombre" text="-" wrapText="true" styleClass="player-name"/><HBox spacing="8"><Label fx:id="responsableTelefono" text="-" styleClass="tournament-detail-value"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="responsableVinculacion" text="-" wrapText="true" styleClass="link-status"/></HBox><HBox spacing="7"><Button fx:id="botonWhatsappResponsable" text="WHATSAPP" onAction="#abrirWhatsappResponsable" visible="false" managed="false" styleClass="whatsapp-button"/><Button fx:id="botonVincularResponsable" text="VINCULAR CLIENTE" onAction="#vincularResponsable" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="tournament-link-button"/><Button fx:id="botonDesvincularResponsable" text="DESVINCULAR" onAction="#desvincularResponsable" visible="false" managed="false" styleClass="tournament-unlink-button"/></HBox></VBox>
    <VBox spacing="5" styleClass="player-card"><Label text="SEGUNDO INTEGRANTE" styleClass="field-label"/><Label fx:id="parejaNombre" text="-" wrapText="true" styleClass="player-name"/><HBox spacing="8"><Label fx:id="parejaTelefono" text="-" styleClass="tournament-detail-value"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="parejaVinculacion" text="-" wrapText="true" styleClass="link-status"/></HBox><HBox spacing="7"><Button fx:id="botonWhatsappPareja" text="WHATSAPP" onAction="#abrirWhatsappPareja" visible="false" managed="false" styleClass="whatsapp-button"/><Button fx:id="botonVincularPareja" text="VINCULAR CLIENTE" onAction="#vincularPareja" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="tournament-link-button"/><Button fx:id="botonDesvincularPareja" text="DESVINCULAR" onAction="#desvincularPareja" visible="false" managed="false" styleClass="tournament-unlink-button"/></HBox></VBox>
    <Label text="COMENTARIO DE LA INSCRIPCIÓN" styleClass="field-label"/><TextArea fx:id="detalleComentarios" editable="false" wrapText="true" prefRowCount="2" styleClass="modern-area,inscription-readonly-area"/>
    <Label text="OBSERVACIÓN INTERNA" styleClass="field-label"/><TextArea fx:id="detalleObservaciones" editable="true" wrapText="true" prefRowCount="3" promptText="Información visible solo para administración" styleClass="modern-area"/>
   </VBox></content></ScrollPane></center>
   <bottom><VBox spacing="8" styleClass="management-actions-fixed"><padding><Insets top="12" right="16" bottom="16" left="16"/></padding><Button fx:id="botonGuardarObservacion" text="GUARDAR OBSERVACIÓN" onAction="#guardarObservacion" disable="true" maxWidth="Infinity" styleClass="inscription-save-note"/><HBox spacing="8"><Button fx:id="botonConfirmar" text="CONFIRMAR" onAction="#confirmarInscripcion" disable="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="tournament-action-confirm"/><Button fx:id="botonListaEspera" text="EN ESPERA" onAction="#enviarAListaEspera" disable="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="tournament-action-wait"/></HBox><HBox spacing="8"><Button fx:id="botonRechazar" text="RECHAZAR" onAction="#rechazarInscripcion" disable="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="tournament-action-reject"/><Button fx:id="botonCancelar" text="CANCELAR INSCRIPCIÓN" onAction="#cancelarInscripcion" disable="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="tournament-action-cancel"/></HBox></VBox></bottom>
  </BorderPane>
 </HBox></center>
</BorderPane>