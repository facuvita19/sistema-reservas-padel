   <center><ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="tournament-detail-scroll, inscription-detail-scroll"><content><VBox spacing="10" styleClass="tournament-detail"><padding><Insets top="12" right="16" bottom="34" left="16"/></padding>
