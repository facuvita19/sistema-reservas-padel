    <VBox spacing="5" styleClass="player-card"><Label text="SEGUNDO INTEGRANTE" styleClass="field-label"/><Label fx:id="parejaNombre" text="-" wrapText="true" styleClass="player-name"/><HBox spacing="8"><Label fx:id="parejaTelefono" text="-" styleClass="tournament-detail-value"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="parejaVinculacion" text="-" wrapText="true" styleClass="link-status"/></HBox><HBox spacing="7"><Button fx:id="botonWhatsappPareja" text="WHATSAPP" onAction="#abrirWhatsappPareja" visible="false" managed="false" styleClass="whatsapp-button"><graphic><StackPane minWidth="18" prefWidth="18" maxWidth="18" minHeight="18" prefHeight="18" maxHeight="18" styleClass="inscriptions-icon-slot-v4"><SVGPath content="M12 3 C7 3 3 6.8 3 11.5 C3 13.4 3.7 15.2 5 16.6 L4 21 L8.7 19.4 C9.7 19.8 10.8 20 12 20 C17 20 21 16.2 21 11.5 C21 6.8 17 3 12 3 Z M8.5 8.5 C9.5 12 12 14.5 15.5 15.5" styleClass="inscriptions-icon-v4"/></StackPane></graphic></Button><Button fx:id="botonVincularPareja" text="VINCULAR CLIENTE" onAction="#vincularPareja" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="tournament-link-button, tournament-link-secondary"><graphic><StackPane minWidth="18" prefWidth="18" maxWidth="18" minHeight="18" prefHeight="18" maxHeight="18" styleClass="inscriptions-icon-slot-v4"><SVGPath content="M9 15 L7 17 C5 19 2 16 4 14 L7 11 M15 9 L17 7 C19 5 22 8 20 10 L17 13 M8 12 L16 12" styleClass="inscriptions-icon-v4"/></StackPane></graphic></Button><Button fx:id="botonDesvincularPareja" text="DESVINCULAR" onAction="#desvincularPareja" visible="false" managed="false" styleClass="tournament-unlink-button"><graphic><StackPane minWidth="18" prefWidth="18" maxWidth="18" minHeight="18" prefHeight="18" maxHeight="18" styleClass="inscriptions-icon-slot-v4"><SVGPath content="M9 15 L7 17 C5 19 2 16 4 14 L7 11 M15 9 L17 7 C19 5 22 8 20 10 L17 13 M6 6 L18 18" styleClass="inscriptions-icon-v4"/></StackPane></graphic></Button></HBox></VBox>
    <VBox spacing="1"><Label text="COMENTARIO DE LA INSCRIPCIÓN" styleClass="field-label"/><Label text="Enviado con la inscripción · Solo lectura" styleClass="inscription-field-help-v2, inscription-help-received-v2"/></VBox><TextArea fx:id="detalleComentarios" editable="false" wrapText="true" prefRowCount="2" minHeight="54" prefHeight="54" maxHeight="70" promptText="Sin comentario" styleClass="modern-area, inscription-readonly-area, inscription-comment-compact, inscription-received-comment"/>
    <VBox spacing="1"><Label text="OBSERVACIÓN INTERNA" styleClass="field-label"/><Label text="Uso interno · No visible para participantes" styleClass="inscription-field-help-v2"/></VBox><TextArea fx:id="detalleObservaciones" editable="true" wrapText="true" prefRowCount="3" minHeight="76" prefHeight="76" maxHeight="92" promptText="Información visible solo para administración" styleClass="modern-area, inscription-observation-compact-v1, inscription-internal-note"/>
   </VBox></content></ScrollPane></center>
