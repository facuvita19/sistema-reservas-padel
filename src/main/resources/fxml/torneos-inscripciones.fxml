<BorderPane xmlns="http://javafx.com/javafx" stylesheets="@../css/torneos-inscripciones.css" xmlns:fx="http://javafx.com/fxml" fx:controller="vista.controlador.TorneosInscripcionesController" styleClass="tournaments-root">



 <top><HBox alignment="CENTER_LEFT" spacing="14" styleClass="module-header"><padding><Insets top="12" right="24" bottom="12" left="24"/></padding><Button onAction="#volver" minWidth="42" prefWidth="42" maxWidth="42" minHeight="42" prefHeight="42" maxHeight="42" styleClass="inscriptions-back-button-v4"><tooltip><Tooltip text="Volver a Inicio"/></tooltip><graphic><SVGPath content="M14 6 L8 12 L14 18 M8 12 L20 12" styleClass="inscriptions-back-icon-v4"/></graphic></Button><StackPane minWidth="42" prefWidth="42" maxWidth="42" minHeight="42" prefHeight="42" maxHeight="42" styleClass="inscriptions-module-icon-shell-v4"><SVGPath content="M6 5 L18 5 M6 12 L18 12 M6 19 L18 19 M3 5 L3.1 5 M3 12 L3.1 12 M3 19 L3.1 19" styleClass="inscriptions-module-icon-v4"/></StackPane><VBox alignment="CENTER_LEFT" spacing="2" styleClass="inscriptions-title-left, inscriptions-title-block-v4"><Label text="Inscripciones" styleClass="page-title"/><Label text="Administración de participantes, vinculaciones y solicitudes." styleClass="page-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="AGREGAR INSCRIPCIÓN" onAction="#agregarPareja" styleClass="primary-button"><graphic><StackPane minWidth="18" prefWidth="18" maxWidth="18" minHeight="18" prefHeight="18" maxHeight="18" styleClass="inscriptions-icon-slot-v4"><SVGPath content="M9 11 C6.8 11 5 9.2 5 7 C5 4.8 6.8 3 9 3 C11.2 3 13 4.8 13 7 C13 9.2 11.2 11 9 11 Z M3 21 C3 16 6 13 9 13 C12 13 15 16 15 21 M18 12 L18 18 M15 15 L21 15" styleClass="inscriptions-icon-v4, inscriptions-icon-primary-v4"/></StackPane></graphic></Button></HBox></top>
 <center><HBox styleClass="tournaments-content">
