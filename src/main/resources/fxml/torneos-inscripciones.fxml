   <TableView fx:id="tablaInscripciones" VBox.vgrow="ALWAYS" styleClass="modern-table,inscriptions-table"><columns><TableColumn fx:id="columnaId" text="#" prefWidth="44" minWidth="36"/><TableColumn fx:id="columnaTorneo" text="TORNEO" prefWidth="165" minWidth="90"/><TableColumn fx:id="columnaCategoria" text="CATEGORÍA" prefWidth="145" minWidth="90"/><TableColumn fx:id="columnaResponsable" text="RESPONSABLE" prefWidth="210" minWidth="120"/><TableColumn fx:id="columnaPareja" text="SEGUNDO INTEGRANTE" prefWidth="220" minWidth="130"/><TableColumn fx:id="columnaEstado" text="ESTADO" prefWidth="105" minWidth="80"/><TableColumn fx:id="columnaFecha" text="SOLICITUD" prefWidth="155" minWidth="115"/></columns><placeholder><VBox alignment="CENTER" spacing="7" styleClass="inscriptions-empty-state-v4"><StackPane minWidth="48" prefWidth="48" minHeight="48" prefHeight="48" styleClass="inscriptions-empty-icon-shell-v4"><SVGPath content="M5 5 L19 5 L19 19 L5 19 Z M8 9 L16 9 M8 13 L14 13" styleClass="inscriptions-empty-icon-v4"/></StackPane><Label text="No hay inscripciones para mostrar" styleClass="inscriptions-empty-title-v4"/><Label text="Probá cambiar los filtros o agregá una inscripción." styleClass="inscriptions-empty-copy-v4"/></VBox></placeholder></TableView>
  </VBox>
  <BorderPane prefWidth="540" minWidth="500" maxWidth="580" styleClass="inscription-detail-shell, inscription-detail-wide">
