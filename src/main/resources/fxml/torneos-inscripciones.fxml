   <HBox spacing="7" styleClass="inscriptions-metrics-compact"><VBox HBox.hgrow="ALWAYS" styleClass="tournament-metric,metric-filter-card" fx:id="metricaTotal" onMouseClicked="#filtrarTotal"><HBox alignment="CENTER_LEFT" spacing="7"><StackPane minWidth="15" prefWidth="15" minHeight="15" prefHeight="15" styleClass="inscriptions-metric-icon-slot-v4"><SVGPath content="M5 5 L19 5 M5 12 L19 12 M5 19 L19 19" styleClass="inscriptions-metric-icon-v4, inscriptions-metric-total-icon-v4"/></StackPane><Label text="TOTAL" styleClass="metric-label"/></HBox><Label fx:id="etiquetaTotal" text="0" styleClass="tournament-metric-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="tournament-metric,tournament-metric-pending,metric-filter-card" fx:id="metricaPendientes" onMouseClicked="#filtrarPendientes"><HBox alignment="CENTER_LEFT" spacing="7"><StackPane minWidth="15" prefWidth="15" minHeight="15" prefHeight="15" styleClass="inscriptions-metric-icon-slot-v4"><SVGPath content="M12 4 C16.4 4 20 7.6 20 12 C20 16.4 16.4 20 12 20 C7.6 20 4 16.4 4 12 C4 7.6 7.6 4 12 4 Z M12 8 L12 13 M12 16 L12.1 16" styleClass="inscriptions-metric-icon-v4, inscriptions-metric-pending-icon-v4"/></StackPane><Label text="PENDIENTES" styleClass="metric-label"/></HBox><Label fx:id="etiquetaPendientes" text="0" styleClass="tournament-metric-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="tournament-metric,tournament-metric-confirmed,metric-filter-card" fx:id="metricaConfirmadas" onMouseClicked="#filtrarConfirmadas"><HBox alignment="CENTER_LEFT" spacing="7"><StackPane minWidth="15" prefWidth="15" minHeight="15" prefHeight="15" styleClass="inscriptions-metric-icon-slot-v4"><SVGPath content="M5 12 L10 17 L19 7" styleClass="inscriptions-metric-icon-v4, inscriptions-metric-confirmed-icon-v4"/></StackPane><Label text="CONFIRMADAS" styleClass="metric-label"/></HBox><Label fx:id="etiquetaConfirmadas" text="0" styleClass="tournament-metric-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="tournament-metric,tournament-metric-wait,metric-filter-card" fx:id="metricaEspera" onMouseClicked="#filtrarEspera"><HBox alignment="CENTER_LEFT" spacing="7"><StackPane minWidth="15" prefWidth="15" minHeight="15" prefHeight="15" styleClass="inscriptions-metric-icon-slot-v4"><SVGPath content="M6 4 L18 4 M6 20 L18 20 M8 4 C8 8 10 10 12 12 C10 14 8 16 8 20 M16 4 C16 8 14 10 12 12 C14 14 16 16 16 20" styleClass="inscriptions-metric-icon-v4, inscriptions-metric-wait-icon-v4"/></StackPane><Label text="EN ESPERA" styleClass="metric-label"/></HBox><Label fx:id="etiquetaEspera" text="0" styleClass="tournament-metric-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="tournament-metric,tournament-metric-final,metric-filter-card" fx:id="metricaFinalizadas" onMouseClicked="#filtrarFinalizadas"><HBox alignment="CENTER_LEFT" spacing="7"><StackPane minWidth="15" prefWidth="15" minHeight="15" prefHeight="15" styleClass="inscriptions-metric-icon-slot-v4"><SVGPath content="M6 6 L18 18 M18 6 L6 18" styleClass="inscriptions-metric-icon-v4, inscriptions-metric-final-icon-v4"/></StackPane><Label text="FINALIZADAS" styleClass="metric-label"/></HBox><Label fx:id="etiquetaFinalizadas" text="0" styleClass="tournament-metric-value"/></VBox></HBox>
   <HBox spacing="8"><StackPane HBox.hgrow="ALWAYS" styleClass="inscriptions-search-shell-v4"><TextField fx:id="campoBuscar" promptText="Buscar por torneo, categoría, integrante, teléfono o número..." maxWidth="Infinity" styleClass="modern-field, inscriptions-search-with-icon-v4"/><SVGPath content="M10.5 4 C6.9 4 4 6.9 4 10.5 C4 14.1 6.9 17 10.5 17 C14.1 17 17 14.1 17 10.5 C17 6.9 14.1 4 10.5 4 Z M15.5 15.5 L21 21" mouseTransparent="true" StackPane.alignment="CENTER_LEFT" styleClass="inscriptions-search-icon-v4"/></StackPane><ComboBox fx:id="filtroEstado" promptText="Todos los estados" minWidth="178" prefWidth="178" maxWidth="178" styleClass="modern-combo, inscriptions-state-filter"/><Button text="LIMPIAR" minWidth="104" prefWidth="104" maxWidth="104" onAction="#limpiarFiltros" styleClass="inscriptions-clear-button"><graphic><StackPane minWidth="18" prefWidth="18" maxWidth="18" minHeight="18" prefHeight="18" maxHeight="18" styleClass="inscriptions-icon-slot-v4"><SVGPath content="M6 6 L18 18 M18 6 L6 18" styleClass="inscriptions-icon-v4"/></StackPane></graphic></Button><Button text="ACTUALIZAR" onAction="#cargarInscripciones" minWidth="124" prefWidth="124" maxWidth="124" styleClass="inscriptions-refresh-button"><graphic><StackPane minWidth="18" prefWidth="18" maxWidth="18" minHeight="18" prefHeight="18" maxHeight="18" styleClass="inscriptions-icon-slot-v4"><SVGPath content="M19 8 A8 8 0 1 0 20 13 M19 4 L19 8 L15 8" styleClass="inscriptions-icon-v4"/></StackPane></graphic></Button></HBox>
