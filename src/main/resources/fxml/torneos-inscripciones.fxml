<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
 fx:controller="vista.controlador.TorneosInscripcionesController" styleClass="tournaments-root">
 <top><HBox alignment="CENTER_LEFT" spacing="14" styleClass="module-header"><padding><Insets top="18" right="24" bottom="18" left="24"/></padding><Button text="INICIO" onAction="#volver" styleClass="admin-home-button"/><VBox spacing="2"><Label text="Torneos e inscripciones" styleClass="page-title"/><Label text="Revisión de parejas y solicitudes recibidas desde la web." styleClass="page-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="ACTUALIZAR" onAction="#cargarInscripciones" styleClass="primary-button"/></HBox></top>
 <center><HBox spacing="0" styleClass="tournaments-content">
  <VBox spacing="14" HBox.hgrow="ALWAYS"><padding><Insets top="16" right="16" bottom="18" left="22"/></padding>
   <HBox spacing="10"><VBox HBox.hgrow="ALWAYS" styleClass="tournament-metric"><Label text="TOTAL" styleClass="metric-label"/><Label fx:id="etiquetaTotal" text="0" styleClass="tournament-metric-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="tournament-metric, tournament-metric-pending"><Label text="PENDIENTES" styleClass="metric-label"/><Label fx:id="etiquetaPendientes" text="0" styleClass="tournament-metric-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="tournament-metric"><Label text="CONFIRMADAS" styleClass="metric-label"/><Label fx:id="etiquetaConfirmadas" text="0" styleClass="tournament-metric-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="tournament-metric"><Label text="LISTA DE ESPERA" styleClass="metric-label"/><Label fx:id="etiquetaEspera" text="0" styleClass="tournament-metric-value"/></VBox></HBox>
   <HBox spacing="10"><TextField fx:id="campoBuscar" promptText="Buscar por torneo, categoría, jugador, teléfono o número..." HBox.hgrow="ALWAYS" styleClass="modern-field"/><ComboBox fx:id="filtroEstado" promptText="Todos los estados" prefWidth="190" styleClass="modern-combo"/><Button text="LIMPIAR" onAction="#limpiarFiltros" styleClass="secondary-button"/></HBox>
   <Label fx:id="etiquetaMensaje" minHeight="20" styleClass="small-caption"/>
   <TableView fx:id="tablaInscripciones" VBox.vgrow="ALWAYS" styleClass="modern-table"><columns><TableColumn fx:id="columnaId" text="#" prefWidth="55"/><TableColumn fx:id="columnaTorneo" text="TORNEO" prefWidth="170"/><TableColumn fx:id="columnaCategoria" text="CATEGORÍA" prefWidth="130"/><TableColumn fx:id="columnaResponsable" text="RESPONSABLE" prefWidth="160"/><TableColumn fx:id="columnaPareja" text="PAREJA" prefWidth="160"/><TableColumn fx:id="columnaEstado" text="ESTADO" prefWidth="130"/><TableColumn fx:id="columnaFecha" text="SOLICITUD" prefWidth="145"/></columns><placeholder><Label text="No hay inscripciones para mostrar." styleClass="empty-state"/></placeholder></TableView>
  </VBox>
  <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="390" minWidth="360" styleClass="tournament-detail-scroll"><content><VBox spacing="12" styleClass="tournament-detail"><padding><Insets top="20" right="20" bottom="20" left="20"/></padding><Label fx:id="detalleTitulo" text="Seleccioná una inscripción" styleClass="section-title"/><GridPane hgap="10" vgap="8"><Label text="TORNEO" styleClass="field-label"/><Label fx:id="detalleTorneo" GridPane.columnIndex="1" wrapText="true" styleClass="tournament-detail-value"/><Label text="CATEGORÍA" GridPane.rowIndex="1" styleClass="field-label"/><Label fx:id="detalleCategoria" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="tournament-detail-value"/><Label text="ESTADO" GridPane.rowIndex="2" styleClass="field-label"/><Label fx:id="detalleEstado" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="tournament-state"/><Label text="ORIGEN" GridPane.rowIndex="3" styleClass="field-label"/><Label fx:id="detalleOrigen" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="tournament-detail-value"/><Label text="SOLICITUD" GridPane.rowIndex="4" styleClass="field-label"/><Label fx:id="detalleFecha" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="tournament-detail-value"/><Label text="PRECIO" GridPane.rowIndex="5" styleClass="field-label"/><Label fx:id="detallePrecio" GridPane.rowIndex="5" GridPane.columnIndex="1" styleClass="tournament-detail-value"/></GridPane><Separator/><VBox spacing="5" styleClass="player-card"><Label text="RESPONSABLE" styleClass="field-label"/><Label fx:id="responsableNombre" text="-" styleClass="player-name"/><Label fx:id="responsableTelefono" text="-" styleClass="tournament-detail-value"/><Label fx:id="responsableVinculacion" text="-" wrapText="true" styleClass="link-status"/><Button fx:id="botonWhatsappResponsable" text="WHATSAPP RESPONSABLE" onAction="#abrirWhatsappResponsable" visible="false" managed="false" maxWidth="Infinity" styleClass="whatsapp-button"/><Button fx:id="botonVincularResponsable" text="VINCULAR CLIENTE" onAction="#vincularResponsable" maxWidth="Infinity" styleClass="tournament-link-button"/><Button fx:id="botonDesvincularResponsable" text="DESVINCULAR" onAction="#desvincularResponsable" visible="false" managed="false" maxWidth="Infinity" styleClass="tournament-unlink-button"/></VBox><VBox spacing="5" styleClass="player-card"><Label text="SEGUNDO INTEGRANTE" styleClass="field-label"/><Label fx:id="parejaNombre" text="-" styleClass="player-name"/><Label fx:id="parejaTelefono" text="-" styleClass="tournament-detail-value"/><Label fx:id="parejaVinculacion" text="-" wrapText="true" styleClass="link-status"/><Button fx:id="botonWhatsappPareja" text="WHATSAPP PAREJA" onAction="#abrirWhatsappPareja" visible="false" managed="false" maxWidth="Infinity" styleClass="whatsapp-button"/><Button fx:id="botonVincularPareja" text="VINCULAR CLIENTE" onAction="#vincularPareja" maxWidth="Infinity" styleClass="tournament-link-button"/><Button fx:id="botonDesvincularPareja" text="DESVINCULAR" onAction="#desvincularPareja" visible="false" managed="false" maxWidth="Infinity" styleClass="tournament-unlink-button"/></VBox><Label text="COMENTARIOS" styleClass="field-label"/><TextArea fx:id="detalleComentarios" editable="false" wrapText="true" prefRowCount="3" styleClass="modern-area"/><Label text="OBSERVACIONES ADMINISTRATIVAS" styleClass="field-label"/><TextArea fx:id="detalleObservaciones" editable="true" wrapText="true" prefRowCount="3" styleClass="modern-area"/><VBox spacing="8" styleClass="management-actions"><Button fx:id="botonConfirmar" text="CONFIRMAR" onAction="#confirmarInscripcion" disable="true" maxWidth="Infinity" styleClass="tournament-action-confirm"/><Button fx:id="botonListaEspera" text="LISTA DE ESPERA" onAction="#enviarAListaEspera" disable="true" maxWidth="Infinity" styleClass="tournament-action-wait"/><HBox spacing="8"><Button fx:id="botonRechazar" text="RECHAZAR" onAction="#rechazarInscripcion" disable="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="tournament-action-reject"/><Button fx:id="botonCancelar" text="CANCELAR" onAction="#cancelarInscripcion" disable="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="tournament-action-cancel"/></HBox></VBox></VBox></content></ScrollPane>
 </HBox></center>
</BorderPane>
