<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="vista.controlador.DashboardAdminController" styleClass="dashboard-root-v2">
 <left>
  <VBox prefWidth="228" minWidth="228" maxWidth="228" styleClass="dashboard-sidebar-v2">
   <padding><Insets top="18" right="13" bottom="16" left="13"/></padding>
   <HBox alignment="CENTER_LEFT" spacing="10" styleClass="dashboard-brand-block">
    <StackPane prefWidth="38" prefHeight="38" minWidth="38" minHeight="38" styleClass="dashboard-brand-logo">
     <ImageView fx:id="logoComplejo" fitWidth="30" fitHeight="30" preserveRatio="true" smooth="true"/>
     <Label fx:id="logoFallback" text="P" styleClass="dashboard-brand-fallback"/>
    </StackPane>
    <VBox spacing="1"><Label fx:id="etiquetaNombreComplejo" text="Padel Reservas" wrapText="true" styleClass="dashboard-brand-name"/><Label text="Administración" styleClass="dashboard-brand-caption"/></VBox>
   </HBox>
   <Region prefHeight="15"/>
   <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS" styleClass="dashboard-nav-scroll">
    <VBox spacing="2" styleClass="dashboard-nav-list">
     <Label text="OPERACIÓN" styleClass="dashboard-nav-group"/>
     <Button text="Inicio" maxWidth="Infinity" styleClass="dashboard-nav-button, dashboard-nav-active"/>
     <Button text="Agenda" maxWidth="Infinity" onAction="#abrirAgenda" styleClass="dashboard-nav-button"/>
     <Button text="Reservas" maxWidth="Infinity" onAction="#abrirReservas" styleClass="dashboard-nav-button"/>
     <Button text="Solicitudes web" maxWidth="Infinity" onAction="#abrirSolicitudesWeb" styleClass="dashboard-nav-button"/>
     <Label text="TORNEOS" styleClass="dashboard-nav-group"/>
     <Button text="Torneos" maxWidth="Infinity" onAction="#abrirTorneos" styleClass="dashboard-nav-button"/>
     <Button text="Inscripciones" maxWidth="Infinity" onAction="#abrirTorneosInscripciones" styleClass="dashboard-nav-button"/>
     <Label text="GESTIÓN" styleClass="dashboard-nav-group"/>
     <Button text="Clientes" maxWidth="Infinity" onAction="#abrirClientes" styleClass="dashboard-nav-button"/>
     <Button fx:id="botonCanchas" text="Canchas" maxWidth="Infinity" onAction="#abrirCanchas" styleClass="dashboard-nav-button"/>
     <Button fx:id="botonBloqueos" text="Bloqueos" maxWidth="Infinity" onAction="#abrirBloqueos" styleClass="dashboard-nav-button"/>
     <Label text="FINANZAS" styleClass="dashboard-nav-group"/>
     <Button text="Pagos" maxWidth="Infinity" onAction="#abrirPagos" styleClass="dashboard-nav-button"/>
     <Button text="Cierre de caja" maxWidth="Infinity" onAction="#abrirCierreCaja" styleClass="dashboard-nav-button"/>
     <VBox fx:id="grupoAnalisis" spacing="2"><Label text="ANÁLISIS" styleClass="dashboard-nav-group"/><Button fx:id="botonEstadisticas" text="Estadísticas" maxWidth="Infinity" onAction="#abrirEstadisticas" styleClass="dashboard-nav-button"/></VBox>
     <VBox fx:id="grupoSistema" spacing="2"><Label text="SISTEMA" styleClass="dashboard-nav-group"/><Button fx:id="botonConfiguracion" text="Configuración" maxWidth="Infinity" onAction="#abrirConfiguracion" styleClass="dashboard-nav-button"/><Button fx:id="botonUsuarios" text="Usuarios" maxWidth="Infinity" onAction="#abrirUsuarios" styleClass="dashboard-nav-button"/></VBox>
    </VBox>
   </ScrollPane>
   <Button text="Cerrar sesión" maxWidth="Infinity" onAction="#cerrarSesion" styleClass="dashboard-logout"/>
  </VBox>
 </left>
 <center>
  <BorderPane styleClass="dashboard-main-v2">
   <top>
    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="dashboard-topbar">
     <VBox spacing="1"><Label text="Inicio" styleClass="dashboard-page-title"/><Label fx:id="etiquetaFecha" styleClass="dashboard-page-subtitle"/></VBox>
     <Region HBox.hgrow="ALWAYS"/>
     <VBox alignment="CENTER_RIGHT" spacing="0"><Label text="Sesión activa" styleClass="dashboard-user-caption"/><Label fx:id="etiquetaUsuario" styleClass="dashboard-user-name"/></VBox>
     <Button fx:id="botonActualizar" text="ACTUALIZAR" onAction="#actualizarDashboard" styleClass="dashboard-refresh"/>
    </HBox>
   </top>
   <center>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="dashboard-scroll-v2">
     <VBox spacing="14" styleClass="dashboard-content-v2">
      <padding><Insets top="16" right="22" bottom="24" left="22"/></padding>
      <HBox alignment="CENTER_LEFT" spacing="8" minHeight="20"><ProgressIndicator fx:id="indicadorCarga" visible="false" maxWidth="15" maxHeight="15"/><Label fx:id="etiquetaEstadoCarga" text="Preparando inicio..." styleClass="dashboard-status"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="etiquetaUltimaActualizacion" styleClass="dashboard-updated"/></HBox>

      <HBox spacing="12">
       <VBox HBox.hgrow="ALWAYS" styleClass="dashboard-kpi"><Label text="RESERVAS DE HOY" styleClass="dashboard-kpi-label"/><Label fx:id="etiquetaReservasHoy" text="0" styleClass="dashboard-kpi-value"/><Label text="Turnos activos del día" styleClass="dashboard-kpi-detail"/></VBox>
       <VBox HBox.hgrow="ALWAYS" styleClass="dashboard-kpi"><Label text="PRÓXIMO TURNO" styleClass="dashboard-kpi-label"/><Label fx:id="etiquetaProximoTurno" text="Sin turnos" styleClass="dashboard-kpi-value dashboard-kpi-time"/><Label fx:id="etiquetaDetalleProximoTurno" text="No hay reservas próximas" styleClass="dashboard-kpi-detail"/></VBox>
       <VBox HBox.hgrow="ALWAYS" styleClass="dashboard-kpi"><Label text="INGRESOS DE HOY" styleClass="dashboard-kpi-label"/><Label fx:id="etiquetaIngresosDia" text="\$ 0,00" styleClass="dashboard-kpi-value dashboard-kpi-money"/><Label text="Pagos acreditados" styleClass="dashboard-kpi-detail"/></VBox>
       <VBox HBox.hgrow="ALWAYS" styleClass="dashboard-kpi dashboard-kpi-attention"><Label text="PENDIENTES OPERATIVOS" styleClass="dashboard-kpi-label"/><Label fx:id="etiquetaPendientesOperativos" text="0" styleClass="dashboard-kpi-value"/><Label fx:id="etiquetaDetallePendientes" text="Sin acciones pendientes" styleClass="dashboard-kpi-detail"/></VBox>
      </HBox>

      <VBox fx:id="panelAlertas" spacing="9" styleClass="dashboard-attention-panel">
       <HBox alignment="CENTER_LEFT"><VBox spacing="1"><Label text="Atención requerida" styleClass="dashboard-section-title"/><Label fx:id="etiquetaResumenAlertas" text="Acciones operativas pendientes" styleClass="dashboard-section-copy"/></VBox><Region HBox.hgrow="ALWAYS"/><Label fx:id="etiquetaCantidadAlertas" text="0 pendientes" styleClass="dashboard-alert-count"/></HBox>
       <HBox fx:id="filaAlertaSenias" alignment="CENTER_LEFT" spacing="10" styleClass="dashboard-alert-row"><Label text="AVISO" styleClass="dashboard-alert-symbol dashboard-alert-warning"/><Label fx:id="alertaSenias" HBox.hgrow="ALWAYS" styleClass="dashboard-alert-text"/><Button text="REVISAR" onAction="#verEsperandoSenia" styleClass="dashboard-alert-action"/></HBox>
       <HBox fx:id="filaAlertaVencimientos" alignment="CENTER_LEFT" spacing="10" styleClass="dashboard-alert-row dashboard-alert-critical-row"><Label text="AVISO" styleClass="dashboard-alert-symbol dashboard-alert-critical"/><Label fx:id="alertaVencimientos" HBox.hgrow="ALWAYS" styleClass="dashboard-alert-text"/><Button text="REVISAR" onAction="#abrirSolicitudesWeb" styleClass="dashboard-alert-action"/></HBox>
       <HBox fx:id="filaAlertaPagos" alignment="CENTER_LEFT" spacing="10" styleClass="dashboard-alert-row"><Label text="AVISO" styleClass="dashboard-alert-symbol dashboard-alert-warning"/><Label fx:id="alertaPagos" HBox.hgrow="ALWAYS" styleClass="dashboard-alert-text"/><Button text="REVISAR" onAction="#verPagosPendientes" styleClass="dashboard-alert-action"/></HBox>
       <HBox fx:id="filaAlertaTurnos" alignment="CENTER_LEFT" spacing="10" styleClass="dashboard-alert-row"><Label text="AVISO" styleClass="dashboard-alert-symbol dashboard-alert-warning"/><Label fx:id="alertaTurnos" HBox.hgrow="ALWAYS" styleClass="dashboard-alert-text"/><Button text="REVISAR" onAction="#verTurnosPendientes" styleClass="dashboard-alert-action"/></HBox>
       <HBox fx:id="filaAlertaCaja" alignment="CENTER_LEFT" spacing="10" styleClass="dashboard-alert-row"><Label text="AVISO" styleClass="dashboard-alert-symbol dashboard-alert-warning"/><Label fx:id="alertaCaja" HBox.hgrow="ALWAYS" styleClass="dashboard-alert-text"/><Button text="ABRIR CAJA" onAction="#abrirCierreCaja" styleClass="dashboard-alert-action"/></HBox>
       <HBox fx:id="filaSinAlertas" alignment="CENTER_LEFT" spacing="10" styleClass="dashboard-all-good"><Label text="✓" styleClass="dashboard-ok-symbol"/><VBox><Label text="Operación al día" styleClass="dashboard-ok-title"/><Label text="No existen acciones urgentes pendientes." styleClass="dashboard-ok-copy"/></VBox></HBox>
      </VBox>

      <HBox spacing="14" alignment="TOP_LEFT">
       <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="dashboard-card-v2">
        <HBox alignment="CENTER_LEFT"><VBox spacing="1"><Label text="Próximas reservas" styleClass="dashboard-section-title"/><Label text="Turnos pendientes y confirmados" styleClass="dashboard-section-copy"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="VER AGENDA" onAction="#abrirAgenda" styleClass="dashboard-link-button"/></HBox>
        <TableView fx:id="tablaProximasReservas" focusTraversable="false" prefHeight="250" minHeight="220" styleClass="modern-table dashboard-table-v2">
         <columns><TableColumn fx:id="columnaFecha" text="FECHA" prefWidth="100"/><TableColumn fx:id="columnaHora" text="HORA" prefWidth="74"/><TableColumn fx:id="columnaCancha" text="CANCHA" prefWidth="125"/><TableColumn fx:id="columnaCliente" text="CLIENTE" prefWidth="185"/><TableColumn fx:id="columnaEstado" text="ESTADO" prefWidth="130"/></columns>
         <placeholder><Label text="No hay próximas reservas pendientes o confirmadas." styleClass="empty-state"/></placeholder>
        </TableView>
       </VBox>
       <VBox minWidth="300" prefWidth="320" maxWidth="340" spacing="10" styleClass="dashboard-card-v2">
        <VBox spacing="1"><Label text="Acciones rápidas" styleClass="dashboard-section-title"/><Label text="Accesos frecuentes" styleClass="dashboard-section-copy"/></VBox>
        <GridPane hgap="9" vgap="9"><columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
         <Button text="Nueva reserva" maxWidth="Infinity" onAction="#abrirReservas" styleClass="dashboard-quick-primary"/>
         <Button GridPane.columnIndex="1" text="Registrar pago" maxWidth="Infinity" onAction="#abrirPagos" styleClass="dashboard-quick-button"/>
         <Button GridPane.rowIndex="1" text="Ver agenda" maxWidth="Infinity" onAction="#abrirAgenda" styleClass="dashboard-quick-button"/>
         <Button GridPane.rowIndex="1" GridPane.columnIndex="1" text="Nuevo cliente" maxWidth="Infinity" onAction="#abrirClientes" styleClass="dashboard-quick-button"/>
         <Button fx:id="accesoRapidoCanchas" GridPane.rowIndex="2" text="Nueva cancha" maxWidth="Infinity" onAction="#abrirCanchas" styleClass="dashboard-quick-button"/>
         <Button GridPane.rowIndex="2" GridPane.columnIndex="1" text="Crear bloqueo" maxWidth="Infinity" onAction="#abrirBloqueos" styleClass="dashboard-quick-button"/>
        </GridPane>
        <Button text="Abrir cierre de caja" maxWidth="Infinity" onAction="#abrirCierreCaja" styleClass="dashboard-cash-button"/>
       </VBox>
      </HBox>

      <HBox spacing="14">
       <VBox fx:id="panelRendimientoAdministrador" HBox.hgrow="ALWAYS" spacing="10" styleClass="dashboard-summary-panel"><HBox alignment="CENTER_LEFT"><VBox><Label text="Rendimiento del mes" styleClass="dashboard-section-title"/><Label text="Vista ejecutiva para administración" styleClass="dashboard-section-copy"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="VER ESTADÍSTICAS" onAction="#abrirEstadisticas" styleClass="dashboard-link-button"/></HBox><HBox spacing="12"><VBox HBox.hgrow="ALWAYS" styleClass="dashboard-mini-stat"><Label text="INGRESOS ACREDITADOS" styleClass="dashboard-mini-label"/><Label fx:id="etiquetaIngresosMes" text="\$ 0,00" styleClass="dashboard-mini-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="dashboard-mini-stat"><Label text="PAGOS PENDIENTES" styleClass="dashboard-mini-label"/><Label fx:id="etiquetaPagosPendientes" text="0" styleClass="dashboard-mini-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="dashboard-mini-stat"><Label text="CANCHAS ACTIVAS" styleClass="dashboard-mini-label"/><Label fx:id="etiquetaCanchasActivas" text="0" styleClass="dashboard-mini-value"/></VBox></HBox></VBox>
       <VBox fx:id="panelEstadoOperador" HBox.hgrow="ALWAYS" spacing="10" styleClass="dashboard-summary-panel"><VBox><Label text="Estado operativo del día" styleClass="dashboard-section-title"/><Label text="Información necesaria para la operación cotidiana" styleClass="dashboard-section-copy"/></VBox><HBox spacing="12"><VBox HBox.hgrow="ALWAYS" styleClass="dashboard-mini-stat"><Label text="CANCHAS ACTIVAS" styleClass="dashboard-mini-label"/><Label fx:id="etiquetaCanchasActivasOperador" text="0" styleClass="dashboard-mini-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="dashboard-mini-stat"><Label text="ESPERANDO SEÑA" styleClass="dashboard-mini-label"/><Label fx:id="etiquetaSeniasOperador" text="0" styleClass="dashboard-mini-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="dashboard-mini-stat"><Label text="TURNOS POR CERRAR" styleClass="dashboard-mini-label"/><Label fx:id="etiquetaTurnosOperador" text="0" styleClass="dashboard-mini-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="dashboard-mini-stat"><Label text="ESTADO DE CAJA" styleClass="dashboard-mini-label"/><Label fx:id="etiquetaCajaOperador" text="Pendiente" styleClass="dashboard-mini-value dashboard-mini-text"/></VBox></HBox></VBox>
      </HBox>
     </VBox>
    </ScrollPane>
   </center>
  </BorderPane>
 </center>
</BorderPane>
