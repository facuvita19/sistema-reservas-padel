<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="vista.controlador.DashboardAdminController"
            styleClass="dashboard-root">
    <left>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    prefWidth="220"
                    minWidth="205"
                    maxWidth="220"
                    styleClass="sidebar-scroll">
            <content>
                <VBox minHeight="590"
                      prefWidth="220"
                      spacing="4"
                      styleClass="sidebar">
                    <padding>
                        <Insets top="22" right="14" bottom="18" left="14" />
                    </padding>
                    <children>
                        <Label text="PADEL RESERVAS" styleClass="sidebar-brand" />
                        <Label text="Administración" styleClass="sidebar-caption" />
                        <Region prefHeight="16" />

                        <Button text="Inicio"
                                maxWidth="Infinity"
                                prefHeight="39"
                                styleClass="nav-button, nav-button-active" />
                        <Button text="Agenda"
                                maxWidth="Infinity"
                                prefHeight="39"
                                onAction="#abrirAgenda"
                                styleClass="nav-button" />
                        <Button text="Solicitudes web"
                                maxWidth="Infinity"
                                prefHeight="39"
                                onAction="#abrirSolicitudesWeb"
                                styleClass="nav-button" />
                                                <Button text="Torneos e inscripciones"
                                maxWidth="Infinity"
                                prefHeight="39"
                                onAction="#abrirTorneosInscripciones"
                                styleClass="nav-button" />
<Button text="Reservas"
                                maxWidth="Infinity"
                                prefHeight="39"
                                onAction="#abrirReservas"
                                styleClass="nav-button" />
                        <Button fx:id="botonCanchas"
                                text="Canchas"
                                maxWidth="Infinity"
                                prefHeight="39"
                                onAction="#abrirCanchas"
                                styleClass="nav-button" />
                        <Button text="Clientes"
                                maxWidth="Infinity"
                                prefHeight="39"
                                onAction="#abrirClientes"
                                styleClass="nav-button" />
                        <Button text="Pagos"
                                maxWidth="Infinity"
                                prefHeight="39"
                                onAction="#abrirPagos"
                                styleClass="nav-button" />
                        <Button text="Cierre de caja"
                                maxWidth="Infinity"
                                prefHeight="39"
                                onAction="#abrirCierreCaja"
                                styleClass="nav-button" />
                        <Button fx:id="botonBloqueos"
                                text="Bloqueos"
                                maxWidth="Infinity"
                                prefHeight="39"
                                onAction="#abrirBloqueos"
                                styleClass="nav-button" />
                        <Button fx:id="botonEstadisticas"
                                text="Estadísticas"
                                maxWidth="Infinity"
                                prefHeight="39"
                                onAction="#abrirEstadisticas"
                                styleClass="nav-button" />

                        <Region minHeight="10" VBox.vgrow="ALWAYS" />
                        <Separator />

                        <Button fx:id="botonConfiguracion"
                                text="Configuración"
                                maxWidth="Infinity"
                                prefHeight="39"
                                onAction="#abrirConfiguracion"
                                styleClass="nav-button" />
                        <Button fx:id="botonUsuarios"
                                text="Usuarios"
                                maxWidth="Infinity"
                                prefHeight="39"
                                onAction="#abrirUsuarios"
                                styleClass="nav-button" />
                        <Button text="Cerrar sesión"
                                maxWidth="Infinity"
                                prefHeight="39"
                                onAction="#cerrarSesion"
                                styleClass="nav-button, logout-button" />
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </left>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="dashboard-scroll">
            <content>
                <VBox minWidth="790"
                      spacing="14"
                      styleClass="dashboard-content">
                    <padding>
                        <Insets top="20" right="24" bottom="22" left="24" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <children>
                                <VBox spacing="2">
                                    <children>
                                        <Label text="Resumen del complejo"
                                               style="-fx-font-size: 28px;"
                                               styleClass="page-title" />
                                        <Label fx:id="etiquetaFecha"
                                               styleClass="page-subtitle" />
                                    </children>
                                </VBox>

                                <Region HBox.hgrow="ALWAYS" />

                                <VBox alignment="CENTER_RIGHT" spacing="1">
                                    <children>
                                        <Label text="Sesión activa"
                                               styleClass="small-caption" />
                                        <Label fx:id="etiquetaUsuario"
                                               styleClass="user-name" />
                                    </children>
                                </VBox>

                                <Button fx:id="botonActualizar"
                                        text="Actualizar"
                                        prefHeight="38"
                                        onAction="#actualizarDashboard"
                                        styleClass="secondary-button" />
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="8" minHeight="20">
                            <children>
                                <ProgressIndicator fx:id="indicadorCarga"
                                                   visible="false"
                                                   maxWidth="16"
                                                   maxHeight="16" />
                                <Label fx:id="etiquetaEstadoCarga"
                                       text="Preparando dashboard..."
                                       styleClass="dashboard-status" />
                            </children>
                        </HBox>

                        <HBox spacing="12">
                            <children>
                                <VBox prefHeight="118"
                                      maxWidth="Infinity"
                                      spacing="5"
                                      HBox.hgrow="ALWAYS"
                                      styleClass="metric-card">
                                    <children>
                                        <Label text="RESERVAS DE HOY" styleClass="metric-label" />
                                        <Label fx:id="etiquetaReservasHoy" text="0" styleClass="metric-value" />
                                        <Label text="Agenda actual" styleClass="metric-detail" />
                                    </children>
                                </VBox>

                                <VBox prefHeight="118"
                                      maxWidth="Infinity"
                                      spacing="5"
                                      HBox.hgrow="ALWAYS"
                                      styleClass="metric-card">
                                    <children>
                                        <Label text="CANCHAS ACTIVAS" styleClass="metric-label" />
                                        <Label fx:id="etiquetaCanchasActivas" text="0" styleClass="metric-value" />
                                        <Label text="Disponibles" styleClass="metric-detail" />
                                    </children>
                                </VBox>

                                <VBox prefHeight="118"
                                      maxWidth="Infinity"
                                      spacing="5"
                                      HBox.hgrow="ALWAYS"
                                      styleClass="metric-card">
                                    <children>
                                        <Label text="INGRESOS DEL DÍA" styleClass="metric-label" />
                                        <Label fx:id="etiquetaIngresosDia" text="ARS 0" styleClass="metric-value" />
                                        <Label text="Acreditados hoy" styleClass="metric-detail" />
                                    </children>
                                </VBox>

                                <VBox fx:id="tarjetaIngresosMes"
                                      prefHeight="118"
                                      maxWidth="Infinity"
                                      spacing="5"
                                      HBox.hgrow="ALWAYS"
                                      styleClass="metric-card">
                                    <children>
                                        <Label text="INGRESOS DEL MES" styleClass="metric-label" />
                                        <Label fx:id="etiquetaIngresosMes" text="ARS 0" styleClass="metric-value" />
                                        <Label text="Acreditados del mes" styleClass="metric-detail" />
                                    </children>
                                </VBox>

                                <VBox prefHeight="118"
                                      maxWidth="Infinity"
                                      spacing="5"
                                      HBox.hgrow="ALWAYS"
                                      styleClass="metric-card">
                                    <children>
                                        <Label text="PAGOS PENDIENTES" styleClass="metric-label" />
                                        <Label fx:id="etiquetaPagosPendientes" text="0" styleClass="metric-value" />
                                        <Label text="Sin acreditar" styleClass="metric-detail" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <VBox spacing="10" styleClass="alert-panel">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="Alertas operativas" styleClass="section-title" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label text="Se actualizan con el dashboard" styleClass="small-caption" />
                                    </children>
                                </HBox>

                                <GridPane hgap="10" vgap="10">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="50" />
                                        <ColumnConstraints percentWidth="50" />
                                    </columnConstraints>
                                    <children>
                                        <HBox GridPane.columnIndex="0"
                                              alignment="CENTER_LEFT"
                                              spacing="8">
                                            <children>
                                                <Label fx:id="alertaSenias"
                                                       text="0 reservas esperando seña"
                                                       maxWidth="Infinity"
                                                       HBox.hgrow="ALWAYS"
                                                       styleClass="alert-item" />
                                                <Button text="Ver"
                                                        onAction="#verEsperandoSenia"
                                                        styleClass="alert-action" />
                                            </children>
                                        </HBox>

                                        <HBox GridPane.columnIndex="1"
                                              alignment="CENTER_LEFT"
                                              spacing="8">
                                            <children>
                                                <Label fx:id="alertaVencimientos"
                                                       text="0 solicitudes próximas a vencer"
                                                       maxWidth="Infinity"
                                                       HBox.hgrow="ALWAYS"
                                                       styleClass="alert-item" />
                                                <Button text="Ver"
                                                        onAction="#abrirSolicitudesWeb"
                                                        styleClass="alert-action" />
                                            </children>
                                        </HBox>

                                        <HBox GridPane.rowIndex="1"
                                              GridPane.columnIndex="0"
                                              alignment="CENTER_LEFT"
                                              spacing="8">
                                            <children>
                                                <Label fx:id="alertaPagos"
                                                       text="0 pagos pendientes"
                                                       maxWidth="Infinity"
                                                       HBox.hgrow="ALWAYS"
                                                       styleClass="alert-item" />
                                                <Button text="Ver"
                                                        onAction="#verPagosPendientes"
                                                        styleClass="alert-action" />
                                            </children>
                                        </HBox>

                                        <HBox GridPane.rowIndex="1"
                                              GridPane.columnIndex="1"
                                              alignment="CENTER_LEFT"
                                              spacing="8">
                                            <children>
                                                <Label fx:id="alertaTurnos"
                                                       text="0 turnos pendientes de cerrar"
                                                       maxWidth="Infinity"
                                                       HBox.hgrow="ALWAYS"
                                                       styleClass="alert-item" />
                                                <Button text="Ver"
                                                        onAction="#verTurnosPendientes"
                                                        styleClass="alert-action" />
                                            </children>
                                        </HBox>

                                        <HBox GridPane.rowIndex="2"
                                              GridPane.columnSpan="2"
                                              alignment="CENTER_LEFT"
                                              spacing="8">
                                            <children>
                                                <Label fx:id="alertaCaja"
                                                       text="Caja pendiente"
                                                       maxWidth="Infinity"
                                                       HBox.hgrow="ALWAYS"
                                                       styleClass="alert-item" />
                                                <Button text="Abrir caja"
                                                        onAction="#abrirCierreCaja"
                                                        styleClass="alert-action" />
                                            </children>
                                        </HBox>
                                    </children>
                                </GridPane>
                            </children>
                        </VBox>

                        <HBox spacing="16" alignment="TOP_LEFT" minHeight="330">
                            <children>
                                <VBox minWidth="500"
                                      spacing="10"
                                      HBox.hgrow="ALWAYS"
                                      styleClass="content-card">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="Próximas reservas" styleClass="section-title" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label text="Doble clic para abrir Reservas" styleClass="small-caption" />
                                            </children>
                                        </HBox>

                                        <TableView fx:id="tablaProximasReservas"
                                                   focusTraversable="false"
                                                   minHeight="270"
                                                   prefHeight="310"
                                                   VBox.vgrow="ALWAYS"
                                                   styleClass="modern-table, dashboard-table">
                                            <columns>
                                                <TableColumn fx:id="columnaFecha" text="FECHA" prefWidth="105" />
                                                <TableColumn fx:id="columnaHora" text="HORA" prefWidth="82" />
                                                <TableColumn fx:id="columnaCancha" text="CANCHA" prefWidth="145" />
                                                <TableColumn fx:id="columnaCliente" text="CLIENTE" prefWidth="185" />
                                                <TableColumn fx:id="columnaEstado" text="ESTADO" prefWidth="130" />
                                            </columns>
                                            <placeholder>
                                                <Label text="No hay próximas reservas pendientes o confirmadas."
                                                       styleClass="empty-state" />
                                            </placeholder>
                                        </TableView>
                                    </children>
                                </VBox>

                                <VBox minWidth="245"
                                      prefWidth="270"
                                      maxWidth="290"
                                      spacing="9"
                                      styleClass="content-card">
                                    <children>
                                        <Label text="Acciones rápidas" styleClass="section-title" />
                                        <Button text="Nueva reserva"
                                                maxWidth="Infinity"
                                                onAction="#abrirReservas"
                                                styleClass="primary-button" />
                                        <Button fx:id="accesoRapidoCanchas"
                                                text="Registrar cancha"
                                                maxWidth="Infinity"
                                                onAction="#abrirCanchas"
                                                styleClass="secondary-button" />
                                        <Button text="Registrar cliente"
                                                maxWidth="Infinity"
                                                onAction="#abrirClientes"
                                                styleClass="secondary-button" />
                                        <Button text="Registrar pago"
                                                maxWidth="Infinity"
                                                onAction="#abrirPagos"
                                                styleClass="secondary-button" />
                                        <Button text="Ver agenda diaria"
                                                maxWidth="Infinity"
                                                onAction="#abrirAgenda"
                                                styleClass="secondary-button" />
                                        <Button text="Crear bloqueo"
                                                maxWidth="Infinity"
                                                onAction="#abrirBloqueos"
                                                styleClass="secondary-button" />
                                        <Button text="Cerrar caja del día"
                                                maxWidth="Infinity"
                                                onAction="#abrirCierreCaja"
                                                styleClass="cash-close-dashboard-button" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
