<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="vista.controlador.DashboardAdminController"
            styleClass="dashboard-root">
    <left>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    prefWidth="245"
                    minWidth="220"
                    styleClass="sidebar-scroll">
            <content>
                <VBox minHeight="620"
                      prefWidth="245"
                      spacing="8"
                      styleClass="sidebar">
                    <padding>
                        <Insets top="28" right="18" bottom="24" left="18" />
                    </padding>
                    <children>
                        <Label text="PADEL RESERVAS"
                               styleClass="sidebar-brand" />
                        <Label text="Administración"
                               styleClass="sidebar-caption" />
                        <Region prefHeight="24" />

                        <Button text="Inicio"
                                maxWidth="Infinity"
                                styleClass="nav-button, nav-button-active" />
                        <Button text="Agenda"
                                maxWidth="Infinity"
                                onAction="#abrirAgenda"
                                styleClass="nav-button" />
                        <Button text="Reservas"
                                maxWidth="Infinity"
                                onAction="#abrirReservas"
                                styleClass="nav-button" />
                        <Button fx:id="botonCanchas"
                                text="Canchas"
                                maxWidth="Infinity"
                                onAction="#abrirCanchas"
                                styleClass="nav-button" />
                        <Button text="Clientes"
                                maxWidth="Infinity"
                                onAction="#abrirClientes"
                                styleClass="nav-button" />
                        <Button text="Pagos"
                                maxWidth="Infinity"
                                onAction="#abrirPagos"
                                styleClass="nav-button" />
                        <Button text="Cierre de caja"
                                maxWidth="Infinity"
                                onAction="#abrirCierreCaja"
                                styleClass="nav-button" />
                        <Button fx:id="botonBloqueos"
                                text="Bloqueos"
                                maxWidth="Infinity"
                                onAction="#abrirBloqueos"
                                styleClass="nav-button" />
                        <Button fx:id="botonEstadisticas"
                                text="Estadísticas"
                                maxWidth="Infinity"
                                onAction="#abrirEstadisticas"
                                styleClass="nav-button" />

                        <Region minHeight="20" VBox.vgrow="ALWAYS" />
                        <Separator />

                        <Button fx:id="botonConfiguracion"
                                text="Configuración"
                                maxWidth="Infinity"
                                onAction="#abrirConfiguracion"
                                styleClass="nav-button" />
                        <Button fx:id="botonUsuarios"
                                text="Usuarios"
                                maxWidth="Infinity"
                                onAction="#abrirUsuarios"
                                styleClass="nav-button" />
                        <Button text="Cerrar sesión"
                                maxWidth="Infinity"
                                onAction="#cerrarSesion"
                                styleClass="nav-button, logout-button" />
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </left>

    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="false"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="dashboard-scroll">
            <content>
                <VBox minWidth="760"
                      spacing="24"
                      styleClass="dashboard-content">
                    <padding>
                        <Insets top="30" right="34" bottom="30" left="34" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="16">
                            <children>
                                <VBox spacing="4">
                                    <children>
                                        <Label text="Resumen del complejo"
                                               wrapText="true"
                                               styleClass="page-title" />
                                        <Label fx:id="etiquetaFecha"
                                               wrapText="true"
                                               styleClass="page-subtitle" />
                                    </children>
                                </VBox>

                                <Region HBox.hgrow="ALWAYS" />

                                <HBox alignment="CENTER_RIGHT" spacing="14">
                                    <children>
                                        <VBox alignment="CENTER_RIGHT" spacing="2">
                                            <children>
                                                <Label text="Sesión activa"
                                                       styleClass="small-caption" />
                                                <Label fx:id="etiquetaUsuario"
                                                       styleClass="user-name" />
                                            </children>
                                        </VBox>

                                        <Button fx:id="botonActualizar"
                                                text="Actualizar"
                                                onAction="#actualizarDashboard"
                                                styleClass="secondary-button" />
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="9">
                            <children>
                                <ProgressIndicator fx:id="indicadorCarga"
                                                   visible="false"
                                                   maxWidth="18"
                                                   maxHeight="18" />
                                <Label fx:id="etiquetaEstadoCarga"
                                       text="Preparando dashboard..."
                                       wrapText="true"
                                       styleClass="dashboard-status" />
                            </children>
                        </HBox>

                        <VBox spacing="16">
                            <children>
                                <GridPane hgap="16" vgap="16">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="25" hgrow="ALWAYS" />
                                        <ColumnConstraints percentWidth="25" hgrow="ALWAYS" />
                                        <ColumnConstraints percentWidth="25" hgrow="ALWAYS" />
                                        <ColumnConstraints percentWidth="25" hgrow="ALWAYS" />
                                    </columnConstraints>
                                    <children>
                                        <VBox GridPane.columnIndex="0"
                                              minWidth="0"
                                              spacing="8"
                                              styleClass="metric-card">
                                            <children>
                                                <Label text="RESERVAS DE HOY"
                                                       wrapText="true"
                                                       styleClass="metric-label" />
                                                <Label fx:id="etiquetaReservasHoy"
                                                       text="0"
                                                       wrapText="true"
                                                       styleClass="metric-value" />
                                                <Label text="Agenda de la fecha actual"
                                                       wrapText="true"
                                                       styleClass="metric-detail" />
                                            </children>
                                        </VBox>

                                        <VBox GridPane.columnIndex="1"
                                              minWidth="0"
                                              spacing="8"
                                              styleClass="metric-card">
                                            <children>
                                                <Label text="CANCHAS ACTIVAS"
                                                       wrapText="true"
                                                       styleClass="metric-label" />
                                                <Label fx:id="etiquetaCanchasActivas"
                                                       text="0"
                                                       wrapText="true"
                                                       styleClass="metric-value" />
                                                <Label text="Disponibles para reservas"
                                                       wrapText="true"
                                                       styleClass="metric-detail" />
                                            </children>
                                        </VBox>

                                        <VBox GridPane.columnIndex="2"
                                              minWidth="0"
                                              spacing="8"
                                              styleClass="metric-card">
                                            <children>
                                                <Label text="INGRESOS DEL DÍA"
                                                       wrapText="true"
                                                       styleClass="metric-label" />
                                                <Label fx:id="etiquetaIngresosDia"
                                                       text="ARS 0"
                                                       wrapText="true"
                                                       styleClass="metric-value" />
                                                <Label text="Pagos acreditados hoy"
                                                       wrapText="true"
                                                       styleClass="metric-detail" />
                                            </children>
                                        </VBox>

                                        <VBox GridPane.columnIndex="3"
                                              minWidth="0"
                                              spacing="8"
                                              styleClass="metric-card">
                                            <children>
                                                <Label text="PAGOS PENDIENTES"
                                                       wrapText="true"
                                                       styleClass="metric-label" />
                                                <Label fx:id="etiquetaPagosPendientes"
                                                       text="0"
                                                       wrapText="true"
                                                       styleClass="metric-value" />
                                                <Label text="Movimientos sin acreditar"
                                                       wrapText="true"
                                                       styleClass="metric-detail" />
                                            </children>
                                        </VBox>
                                    </children>
                                </GridPane>

                                <VBox fx:id="tarjetaIngresosMes"
                                      maxWidth="Infinity"
                                      spacing="8"
                                      styleClass="metric-card">
                                    <children>
                                        <Label text="INGRESOS DEL MES"
                                               styleClass="metric-label" />
                                        <Label fx:id="etiquetaIngresosMes"
                                               text="ARS 0"
                                               wrapText="true"
                                               styleClass="metric-value" />
                                        <Label text="Pagos acreditados del mes"
                                               wrapText="true"
                                               styleClass="metric-detail" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <HBox spacing="18"
                              minHeight="430"
                              alignment="TOP_LEFT">
                            <children>
                                <VBox minWidth="500"
                                      spacing="14"
                                      HBox.hgrow="ALWAYS"
                                      styleClass="content-card">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="Próximas reservas"
                                                       styleClass="section-title" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label text="Doble clic para abrir Reservas"
                                                       wrapText="true"
                                                       styleClass="small-caption" />
                                            </children>
                                        </HBox>

                                        <TableView fx:id="tablaProximasReservas"
                                                   minHeight="320"
                                                   prefHeight="390"
                                                   VBox.vgrow="ALWAYS"
                                                   styleClass="modern-table, dashboard-table">
                                            <columns>
                                                <TableColumn fx:id="columnaFecha"
                                                             text="FECHA"
                                                             prefWidth="105" />
                                                <TableColumn fx:id="columnaHora"
                                                             text="HORA"
                                                             prefWidth="85" />
                                                <TableColumn fx:id="columnaCancha"
                                                             text="CANCHA"
                                                             prefWidth="150" />
                                                <TableColumn fx:id="columnaCliente"
                                                             text="CLIENTE"
                                                             prefWidth="190" />
                                                <TableColumn fx:id="columnaEstado"
                                                             text="ESTADO"
                                                             prefWidth="120" />
                                            </columns>
                                            <placeholder>
                                                <Label text="No hay próximas reservas pendientes o confirmadas."
                                                       wrapText="true"
                                                       styleClass="empty-state" />
                                            </placeholder>
                                        </TableView>
                                    </children>
                                </VBox>

                                <VBox minWidth="280"
                                      prefWidth="310"
                                      maxWidth="340"
                                      spacing="14"
                                      alignment="TOP_LEFT"
                                      styleClass="content-card">
                                    <children>
                                        <Label text="Acciones rápidas"
                                               styleClass="section-title" />
                                        <Button text="Nueva reserva"
                                                maxWidth="Infinity"
                                                onAction="#abrirReservas"
                                                styleClass="primary-button" />
                                        <Button fx:id="accesoRapidoCanchas"
                                                text="Registrar cancha"
                                                maxWidth="Infinity"
                                                onAction="#abrirCanchas"
                                                styleClass="secondary-button" />
                                        <Button text="Registrar cliente"
                                                maxWidth="Infinity"
                                                onAction="#abrirClientes"
                                                styleClass="secondary-button" />
                                        <Button text="Registrar pago"
                                                maxWidth="Infinity"
                                                onAction="#abrirPagos"
                                                styleClass="secondary-button" />
                                        <Button text="Ver agenda diaria"
                                                maxWidth="Infinity"
                                                onAction="#abrirAgenda"
                                                styleClass="secondary-button" />
                                        <Button text="Crear bloqueo"
                                                maxWidth="Infinity"
                                                onAction="#abrirBloqueos"
                                                styleClass="secondary-button" />

                                        <Button text="Cerrar caja del día"
                                                maxWidth="Infinity"
                                                onAction="#abrirCierreCaja"
                                                styleClass="cash-close-dashboard-button" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
