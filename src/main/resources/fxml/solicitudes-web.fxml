<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="vista.controlador.SolicitudesWebController" styleClass="web-root">
 <top><HBox alignment="CENTER_LEFT" spacing="14" styleClass="module-header"><padding><Insets top="18" right="24" bottom="18" left="24"/></padding><Button text="← Inicio" onAction="#volver" styleClass="back-button"/><VBox spacing="2"><Label text="Solicitudes web" styleClass="page-title"/><Label text="Seguimiento de solicitudes, señas y vencimientos del canal web." styleClass="page-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="ACTUALIZAR" onAction="#cargarSolicitudes" styleClass="primary-button"/></HBox></top>
 <center><HBox spacing="0" styleClass="web-content">
  <VBox spacing="14" HBox.hgrow="ALWAYS"><padding><Insets top="16" right="16" bottom="18" left="22"/></padding>
   <HBox spacing="10"><VBox HBox.hgrow="ALWAYS" styleClass="web-metric"><Label text="TOTAL WEB" styleClass="metric-label"/><Label fx:id="etiquetaTotal" text="0" styleClass="web-metric-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="web-metric"><Label text="VIGENTES" styleClass="metric-label"/><Label fx:id="etiquetaVigentes" text="0" styleClass="web-metric-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="web-metric, web-metric-warning"><Label text="PRÓXIMAS A VENCER" styleClass="metric-label"/><Label fx:id="etiquetaProximas" text="0" styleClass="web-metric-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="web-metric"><Label text="EXPIRADAS" styleClass="metric-label"/><Label fx:id="etiquetaExpiradas" text="0" styleClass="web-metric-value"/></VBox></HBox>
   <HBox spacing="10"><TextField fx:id="campoBuscar" promptText="Buscar por cliente, cancha, estado o número..." HBox.hgrow="ALWAYS" styleClass="modern-field"/><ComboBox fx:id="filtroEstado" promptText="Todos los estados" prefWidth="190" styleClass="modern-combo"/><Button text="LIMPIAR" onAction="#limpiarFiltros" styleClass="secondary-button"/></HBox>
   <Label fx:id="etiquetaMensaje" minHeight="20" styleClass="small-caption"/>
   <TableView fx:id="tablaSolicitudes" VBox.vgrow="ALWAYS" styleClass="modern-table"><columns><TableColumn fx:id="columnaId" text="#" prefWidth="58"/><TableColumn fx:id="columnaCliente" text="CLIENTE" prefWidth="190"/><TableColumn fx:id="columnaTurno" text="TURNO" prefWidth="145"/><TableColumn fx:id="columnaCancha" text="CANCHA" prefWidth="140"/><TableColumn fx:id="columnaEstado" text="ESTADO" prefWidth="130"/><TableColumn fx:id="columnaVencimiento" text="VENCIMIENTO" prefWidth="155"/><TableColumn fx:id="columnaTiempo" text="TIEMPO" prefWidth="110"/></columns><placeholder><Label text="No hay solicitudes web para mostrar." styleClass="empty-state"/></placeholder></TableView>
  </VBox>
  <VBox prefWidth="340" minWidth="320" spacing="13" styleClass="web-detail"><padding><Insets top="20" right="20" bottom="20" left="20"/></padding><Label fx:id="detalleTitulo" text="Seleccioná una solicitud" styleClass="section-title"/><Label text="CLIENTE" styleClass="field-label"/><Label fx:id="detalleCliente" text="-" wrapText="true" styleClass="web-detail-value"/><Label text="TELÉFONO" styleClass="field-label"/><Label fx:id="detalleTelefono" text="-" styleClass="web-detail-value"/><Separator/><GridPane hgap="10" vgap="8"><Label text="TURNO" styleClass="field-label"/><Label fx:id="detalleTurno" GridPane.columnIndex="1" wrapText="true" styleClass="web-detail-value"/><Label text="CANCHA" GridPane.rowIndex="1" styleClass="field-label"/><Label fx:id="detalleCancha" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="web-detail-value"/><Label text="ESTADO" GridPane.rowIndex="2" styleClass="field-label"/><Label fx:id="detalleEstado" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="web-detail-value"/><Label text="ORIGEN" GridPane.rowIndex="3" styleClass="field-label"/><Label fx:id="detalleOrigen" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="web-origin"/><Label text="TIEMPO" GridPane.rowIndex="4" styleClass="field-label"/><Label fx:id="detalleVencimiento" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="web-detail-value"/></GridPane><GridPane hgap="12" vgap="7" styleClass="web-finance"><Label text="PRECIO" styleClass="field-label"/><Label fx:id="detallePrecio" GridPane.columnIndex="1" styleClass="web-detail-value"/><Label text="ACREDITADO" GridPane.rowIndex="1" styleClass="field-label"/><Label fx:id="detalleAcreditado" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="web-paid"/><Label text="SALDO" GridPane.rowIndex="2" styleClass="field-label"/><Label fx:id="detalleSaldo" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="web-balance"/></GridPane><Region VBox.vgrow="ALWAYS"/><Button fx:id="botonReserva" text="ABRIR RESERVA" onAction="#abrirReserva" visible="false" managed="false" maxWidth="Infinity" styleClass="primary-button"/><Button fx:id="botonPagos" text="ABRIR PAGOS" onAction="#abrirPagos" visible="false" managed="false" maxWidth="Infinity" styleClass="payment-button"/><Button fx:id="botonWhatsApp" text="WHATSAPP" onAction="#abrirWhatsApp" visible="false" managed="false" maxWidth="Infinity" styleClass="whatsapp-button"/></VBox>
 </HBox></center>
</BorderPane>
