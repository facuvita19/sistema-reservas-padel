<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="vista.controlador.ClientesController" styleClass="module-root, clients-root">
  <top><HBox alignment="CENTER_LEFT" spacing="16" styleClass="module-header, clients-module-header"><padding><Insets top="12" right="24" bottom="12" left="24"/></padding>
  <Button onAction="#volver" accessibleText="Volver al inicio" minWidth="42" prefWidth="42" maxWidth="42" minHeight="42" prefHeight="42" maxHeight="42" styleClass="clients-back-button"><tooltip><Tooltip text="Volver al inicio"/></tooltip><graphic><SVGPath content="M14 6 L8 12 L14 18 M8 12 L20 12" styleClass="clients-back-icon-v9"/></graphic></Button>
  <StackPane minWidth="42" prefWidth="42" maxWidth="42" minHeight="42" prefHeight="42" maxHeight="42" styleClass="clients-header-icon-v1"><SVGPath content="M9 11 C6.8 11 5 9.2 5 7 C5 4.8 6.8 3 9 3 C11.2 3 13 4.8 13 7 C13 9.2 11.2 11 9 11 Z M3 21 C3 16 6 13 9 13 C12 13 15 16 15 21 M18 12 L18 18 M15 15 L21 15" styleClass="clients-header-icon-path"/></StackPane>
  <VBox spacing="2" styleClass="clients-title-block-v9"><Label text="Gestión de clientes" styleClass="page-title"/><Label text="Administrá los datos de contacto y consultá el historial completo." styleClass="page-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/>
  <Button text="NUEVO CLIENTE" onAction="#nuevo" styleClass="clients-new-button"><graphic><StackPane minWidth="18" prefWidth="18" maxWidth="18" minHeight="18" prefHeight="18" maxHeight="18" styleClass="clients-header-action-icon-slot-v9"><SVGPath content="M9 11 C6.8 11 5 9.2 5 7 C5 4.8 6.8 3 9 3 C11.2 3 13 4.8 13 7 C13 9.2 11.2 11 9 11 Z M3 21 C3 16 6 13 9 13 C12 13 15 16 15 21 M18 12 L18 18 M15 15 L21 15" styleClass="clients-header-action-icon-v9"/></StackPane></graphic></Button>
 </HBox></top>
 <center><SplitPane dividerPositions="0.405" styleClass="module-split, clients-split">
  <VBox spacing="16" styleClass="list-panel"><padding><Insets top="22" right="18" bottom="22" left="28"/></padding>
   <HBox alignment="CENTER_LEFT" spacing="8" styleClass="clients-filter-row">
    <HBox alignment="CENTER_LEFT" spacing="0" HBox.hgrow="ALWAYS" styleClass="clients-search-shell"><StackPane minWidth="40" prefWidth="40" maxWidth="40" minHeight="40" prefHeight="40" maxHeight="40" styleClass="clients-search-icon-box"><SVGPath content="M10.5 4 A6.5 6.5 0 1 0 10.5 17 A6.5 6.5 0 1 0 10.5 4 M15.5 15.5 L21 21" styleClass="clients-muted-icon"/></StackPane><TextField fx:id="campoBuscar" promptText="Buscar por nombre, documento o teléfono..." HBox.hgrow="ALWAYS" styleClass="modern-field, clients-search-field"/></HBox>
    <Button text="LIMPIAR" onAction="#limpiarSeleccion" styleClass="clients-filter-button, client-clear-button"><graphic><SVGPath content="M6 6 L18 18 M18 6 L6 18" styleClass="clients-button-icon"/></graphic><tooltip><Tooltip text="Limpiar búsqueda y selección"/></tooltip></Button>
    <Button text="ACTUALIZAR" onAction="#cargarClientes" accessibleText="Actualizar clientes" styleClass="clients-refresh-button"><graphic><StackPane minWidth="17" prefWidth="17" maxWidth="17" minHeight="17" prefHeight="17" maxHeight="17" styleClass="clients-refresh-icon-box-v8"><SVGPath content="M16.5 6 A6.5 6.5 0 1 0 17.5 13 M16.5 6 L16.5 2.5 M16.5 6 L13 6" styleClass="clients-refresh-icon-v8"/></StackPane></graphic><tooltip><Tooltip text="Volver a cargar la lista de clientes"/></tooltip></Button>
   </HBox>
   <HBox alignment="CENTER_LEFT" styleClass="clients-results-bar"><Label fx:id="etiquetaResultados" text="0 clientes visibles" styleClass="clients-results-text"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="etiquetaAyudaListado" text="Seleccioná un cliente para editarlo" styleClass="clients-results-hint"/></HBox>
   <TableView fx:id="tablaClientes"
              VBox.vgrow="ALWAYS"
              styleClass="modern-table"><columns><TableColumn fx:id="columnaNombre" text="CLIENTE" prefWidth="190" minWidth="155"/>
    <TableColumn fx:id="columnaDocumento" text="DOCUMENTO" prefWidth="115" minWidth="100"/>
    <TableColumn fx:id="columnaTelefono" text="TELÉFONO" prefWidth="145" minWidth="125"/>
    <TableColumn fx:id="columnaEmail" text="EMAIL" visible="false"/>
    <TableColumn fx:id="columnaEstado" text="ESTADO" prefWidth="105" minWidth="95" maxWidth="115"/></columns><placeholder><Label text="Todavía no hay clientes registrados." styleClass="empty-state"/></placeholder></TableView>
  </VBox>
  <ScrollPane fx:id="scrollDetalleCliente" fitToWidth="true" styleClass="form-scroll"><VBox spacing="16" styleClass="form-card"><padding><Insets top="24" right="28" bottom="28" left="28"/></padding>
   <VBox spacing="7" styleClass="client-detail-header">
    <HBox alignment="CENTER_LEFT" spacing="10">
     <StackPane minWidth="36" prefWidth="36" maxWidth="36" minHeight="36" prefHeight="36" maxHeight="36" styleClass="client-detail-icon-box"><SVGPath content="M12 12 C9.2 12 7 9.8 7 7 C7 4.2 9.2 2 12 2 C14.8 2 17 4.2 17 7 C17 9.8 14.8 12 12 12 Z M4 22 C4 16.5 7.5 14 12 14 C16.5 14 20 16.5 20 22" styleClass="client-detail-icon"/></StackPane>
     <VBox spacing="1"><Label fx:id="etiquetaModoCliente" text="NUEVO CLIENTE" styleClass="client-detail-eyebrow"/><Label fx:id="tituloFormulario" text="Nuevo cliente" styleClass="section-title"/></VBox>
     <Region HBox.hgrow="ALWAYS"/>
     <Label fx:id="insigniaEstadoCliente" text="ACTIVO" visible="false" managed="false" styleClass="client-detail-status"/>
     <Button fx:id="botonNuevaReserva" text="NUEVA RESERVA" onAction="#nuevaReservaParaCliente" visible="false" managed="false" styleClass="client-reservation-button"><graphic><SVGPath content="M5 3 L5 7 M19 3 L19 7 M3 9 L21 9 M4 5 L20 5 L20 21 L4 21 Z M12 12 L12 18 M9 15 L15 15" styleClass="clients-button-icon"/></graphic></Button>
    </HBox>
    <Label fx:id="subtituloFormulario" text="Registrá los datos personales y de contacto." wrapText="true" styleClass="client-detail-subtitle"/>
   </VBox>
   <GridPane hgap="12" vgap="10"><columnConstraints><ColumnConstraints percentWidth="50" hgrow="ALWAYS"/><ColumnConstraints percentWidth="50" hgrow="ALWAYS"/></columnConstraints>
    <VBox spacing="6"><Label text="Nombre *" styleClass="field-label"/><TextField fx:id="campoNombre" styleClass="modern-field"/></VBox><VBox spacing="6" GridPane.columnIndex="1"><Label text="Apellido *" styleClass="field-label"/><TextField fx:id="campoApellido" styleClass="modern-field"/></VBox>
    <VBox spacing="6" GridPane.rowIndex="1"><Label text="Documento *" styleClass="field-label"/><TextField fx:id="campoDocumento" styleClass="modern-field"/></VBox><VBox spacing="6" GridPane.rowIndex="1" GridPane.columnIndex="1"><Label text="Teléfono *" styleClass="field-label"/><TextField fx:id="campoTelefono" styleClass="modern-field"/></VBox>
    <VBox spacing="6" GridPane.rowIndex="2" GridPane.columnSpan="2"><Label text="Correo electrónico" styleClass="field-label"/><TextField fx:id="campoEmail" styleClass="modern-field"/></VBox>
   </GridPane>
   <Label fx:id="etiquetaMensaje" minHeight="34" wrapText="true" styleClass="client-form-message"/><HBox spacing="12" styleClass="client-actions-bar"><Button fx:id="botonGuardar" text="GUARDAR CLIENTE" onAction="#guardar" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="client-save-button"><graphic><SVGPath content="M4 3 L18 3 L21 6 L21 21 L3 21 L3 3 Z M7 3 L7 9 L17 9 L17 3 M7 15 L17 15 L17 21 L7 21 Z" styleClass="clients-button-icon"/></graphic></Button><Button fx:id="botonDesactivar" text="DESACTIVAR" onAction="#desactivar" styleClass="client-deactivate-button"><graphic><SVGPath content="M12 3 C7 3 3 7 3 12 C3 17 7 21 12 21 C17 21 21 17 21 12 C21 7 17 3 12 3 M7 12 L17 12" styleClass="clients-button-icon"/></graphic></Button><Button fx:id="botonReactivar" text="REACTIVAR" onAction="#reactivar" visible="false" managed="false" styleClass="reactivate-button"><graphic><SVGPath content="M20 7 L20 2 L15 2 M20 2 C15 -1 7 1 4 7 M4 17 L4 22 L9 22 M4 22 C9 25 17 23 20 17" styleClass="clients-button-icon"/></graphic></Button><Button fx:id="botonEliminarDefinitivamente" text="ELIMINAR" onAction="#eliminarDefinitivamente" visible="false" managed="false" styleClass="delete-client-button"><graphic><SVGPath content="M5 7 L19 7 M9 7 L9 4 L15 4 L15 7 M7 7 L8 21 L16 21 L17 7 M10 10 L10 18 M14 10 L14 18" styleClass="clients-button-icon"/></graphic></Button></HBox><Separator styleClass="clients-section-separator"/>
   <HBox alignment="CENTER_LEFT" spacing="9" styleClass="clients-section-header"><StackPane styleClass="clients-section-icon-box"><SVGPath content="M4 20 L4 13 L9 13 L9 20 M10 20 L10 8 L15 8 L15 20 M16 20 L16 4 L21 4 L21 20" styleClass="clients-section-icon"/></StackPane><Label text="Resumen del historial" styleClass="section-title"/></HBox>
   <GridPane hgap="8"><columnConstraints><ColumnConstraints percentWidth="16.66"/><ColumnConstraints percentWidth="16.66"/><ColumnConstraints percentWidth="16.66"/><ColumnConstraints percentWidth="16.66"/><ColumnConstraints percentWidth="16.66"/><ColumnConstraints percentWidth="16.66"/></columnConstraints>
    <VBox alignment="CENTER" styleClass="history-metric, history-metric-total"><Label text="RESERVAS" styleClass="history-metric-label"/><Label fx:id="etiquetaTotalReservas" text="0" styleClass="history-metric-value"/></VBox><VBox GridPane.columnIndex="1" alignment="CENTER" styleClass="history-metric, history-metric-completed"><Label text="COMPLETADAS" styleClass="history-metric-label"/><Label fx:id="etiquetaCompletadas" text="0" styleClass="history-metric-value"/></VBox><VBox GridPane.columnIndex="2" alignment="CENTER" styleClass="history-metric, history-metric-cancelled"><Label text="CANCELADAS" styleClass="history-metric-label"/><Label fx:id="etiquetaCanceladas" text="0" styleClass="history-metric-value"/></VBox><VBox GridPane.columnIndex="3" alignment="CENTER" styleClass="history-metric, history-metric-absence"><Label text="AUSENCIAS" styleClass="history-metric-label"/><Label fx:id="etiquetaAusencias" text="0" styleClass="history-metric-value"/></VBox><VBox GridPane.columnIndex="4" alignment="CENTER" styleClass="history-metric, history-metric-paid"><Label text="ACREDITADO" styleClass="history-metric-label"/><Label fx:id="etiquetaTotalAcreditado" text="ARS 0.00" styleClass="history-money-value"/></VBox><VBox GridPane.columnIndex="5" alignment="CENTER" styleClass="history-metric, history-metric-balance"><Label text="SALDO" styleClass="history-metric-label"/><Label fx:id="etiquetaSaldoPendiente" text="ARS 0.00" styleClass="history-balance-value"/></VBox>
   </GridPane>
   <HBox alignment="CENTER_LEFT" spacing="10" styleClass="next-reservation-card"><StackPane styleClass="next-reservation-icon-box"><SVGPath content="M5 3 L5 7 M19 3 L19 7 M3 9 L21 9 M4 5 L20 5 L20 21 L4 21 Z" styleClass="next-reservation-icon"/></StackPane><VBox spacing="1"><Label text="PRÓXIMA RESERVA" styleClass="history-metric-label"/><Label fx:id="etiquetaProximaReserva" text="Seleccioná un cliente" styleClass="next-reservation-value"/></VBox></HBox>
   <HBox alignment="CENTER_LEFT" spacing="10" styleClass="clients-history-header"><StackPane styleClass="clients-section-icon-box"><SVGPath content="M5 3 L5 7 M19 3 L19 7 M3 9 L21 9 M4 5 L20 5 L20 21 L4 21 Z M8 13 L11 16 L16 11" styleClass="clients-section-icon"/></StackPane><VBox spacing="1"><Label text="Reservas del cliente" styleClass="section-title"/><Label text="Seleccioná una reserva o hacé doble clic para abrirla" styleClass="small-caption"/></VBox><Region HBox.hgrow="ALWAYS"/><Button fx:id="botonAbrirReserva" text="ABRIR RESERVA" onAction="#abrirReservaSeleccionada" disable="true" styleClass="client-open-reservation-button"><graphic><SVGPath content="M4 5 L12 5 L14 7 L20 7 L20 20 L4 20 Z M12 11 L17 11 L17 16 M17 11 L10 18" styleClass="clients-button-icon"/></graphic></Button></HBox>
   <TableView fx:id="tablaHistorial" prefHeight="285" minHeight="230" styleClass="modern-table, client-history-table"><columns><TableColumn fx:id="columnaHistorialFecha" text="FECHA" prefWidth="90"/><TableColumn fx:id="columnaHistorialHorario" text="HORARIO" prefWidth="112"/><TableColumn fx:id="columnaHistorialCancha" text="CANCHA" prefWidth="120"/><TableColumn fx:id="columnaHistorialEstado" text="ESTADO" prefWidth="128" minWidth="120" maxWidth="140"/><TableColumn fx:id="columnaHistorialPrecio" text="PRECIO" prefWidth="100"/><TableColumn fx:id="columnaHistorialAcreditado" text="ACREDITADO" prefWidth="105"/><TableColumn fx:id="columnaHistorialSaldo" text="SALDO" prefWidth="100"/></columns><placeholder><Label text="Seleccioná un cliente para consultar el historial." styleClass="empty-state"/></placeholder></TableView>
  </VBox></ScrollPane>
 </SplitPane></center>
</BorderPane>
